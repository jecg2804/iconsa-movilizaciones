136:                   {event.registered_by.name}
137:                 </p>
138:               )}
139: 
140:               {event.event_type === 'Parada' && !isReverted && event.location && (
141:                 <div className="mt-0.5">
142:                   <span className="text-xs font-medium text-cyan-700">📍 {event.location}</span>
143:                 </div>
144:               )}
145: 
146:               {event.event_type === 'Entrega' && event.received_by_name && !isReverted && (
147:                 <p className="mt-0.5 text-xs font-medium text-iconsa-green">
148:                   Recibido por: {event.received_by_name}
149:                 </p>
150:               )}
151: 
152:               {event.notes && (
153:                 <p className={`mt-1 text-sm ${isReversion ? 'text-red-600 italic' : 'text-gray-700'}`}>
154:                   {isReversion ? `Razón: ${event.notes}` : event.notes}
155:                 </p>
156:               )}
157: 
158:               {event.attachments && event.attachments.length > 0 && (
159:                 <div className="mt-2">
160:                   <FileDisplay attachments={event.attachments} collapsible={false} />
161:                 </div>
162:               )}
163:             </div>
164:           </li>
165:         )
166:       })}
167:     </ol>
