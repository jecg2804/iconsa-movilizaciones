 719:                       className="h-4 w-4 rounded border-gray-300 text-iconsa-blue focus:ring-iconsa-blue"
 720:                     />
 721:                   </td>
 722:                   <td className="px-2 py-2 text-center">
 723:                     <input
 724:                       type="checkbox"
 725:                       checked={isReceiveAll}
 726:                       disabled={isDisabled}
 727:                       onChange={() => togglePref(person.id, 'receive_all', prefs)}
 728:                       title={`Recibir todas las notificaciones — ${person.name}`}
 729:                       className="h-4 w-4 rounded border-gray-300 text-iconsa-blue focus:ring-iconsa-blue disabled:opacity-40"
 730:                     />
