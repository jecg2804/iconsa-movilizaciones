159: /**
160:  * Crea registros en la tabla suggestions para valores de fallback (texto libre).
161:  * Se ignoran errores silenciosamente — las sugerencias son best-effort.
162:  */
163: async function createSuggestions(
164:   supabase: SupabaseClient<Database>,
165:   lines: LineInput[],
166:   personId: string,
167: ): Promise<void> {
168:   const suggestions: Array<{
169:     table_name: string
170:     suggested_value: string
171:     suggested_by: string
172:   }> = []
173: 
174:   for (const line of lines) {
175:     if (line.equipment_text) {
176:       suggestions.push({
177:         table_name: 'equipment',
178:         suggested_value: line.equipment_text,
179:         suggested_by: personId,
180:       })
181:     }
182:     if (line.from_text) {
183:       suggestions.push({
184:         table_name: 'locations',
185:         suggested_value: line.from_text,
186:         suggested_by: personId,
187:       })
188:     }
189:     if (line.to_text) {
190:       suggestions.push({
191:         table_name: 'locations',
192:         suggested_value: line.to_text,
193:         suggested_by: personId,
194:       })
195:     }
196:     if (line.unit_text) {
197:       suggestions.push({
198:         table_name: 'units',
199:         suggested_value: line.unit_text,
200:         suggested_by: personId,
201:       })
202:     }
203:   }
204: 
205:   if (suggestions.length > 0) {
206:     const { error: sugErr } = await supabase.from('suggestions').insert(suggestions)
207:     if (sugErr) console.error('[Solicitudes] Error al guardar sugerencias:', sugErr.message)
208:   }
209: }
