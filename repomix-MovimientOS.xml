230:                       {line.description}
231:                     </span>
232:                     <input
233:                       type="number"
234:                       min={0}
235:                       max={line.maxQty}
236:                       step="1"
237:                       value={line.qty}
238:                       disabled={!line.checked || !canEdit}
239:                       onChange={(e) =>
