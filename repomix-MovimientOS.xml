 51: 
 52: function LineEditor({
 53:   equipment,
 54:   locations,
 55:   units,
 56:   projectId,
 57:   initialData,
 58:   isEditing,
 59:   onSave,
 60:   onCancel,
 61:   onCheckDuplicates,
 62: }: LineEditorProps) {
 63:   // projectId se mantiene en signature por si futuras validaciones lo necesitan
 64:   void projectId
 65:   const supabase = useMemo(() => createClient(), [])
 66: 
 67:   // --- Estado del formulario ---
 68:   const [lineType, setLineType] = useState<'Equipo' | 'Material'>(
 69:     initialData?.line_type ?? 'Equipo',
 70:   )
 71:   const [equipmentValue, setEquipmentValue] = useState<SelectWithFallbackValue>(
 72:     initialData
 73:       ? toFallbackValue(initialData.equipment_id, initialData.equipment_text)
 74:       : emptyFallbackValue(),
 75:   )
 76:   const [description, setDescription] = useState(initialData?.description ?? '')
 77:   const [fromValue, setFromValue] = useState<SelectWithFallbackValue>(
 78:     initialData
 79:       ? toFallbackValue(initialData.from_location_id, initialData.from_text)
 80:       : emptyFallbackValue(),
 81:   )
 82:   const [toValue, setToValue] = useState<SelectWithFallbackValue>(
 83:     initialData
