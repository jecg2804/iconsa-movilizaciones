245: export function useSolicitudes(initialFilter?: Partial<SolicitudesFilter>) {
246:   const supabase = useMemo(() => createClient(), [])
247: 
248:   // Estado de lista
249:   const [solicitudes, setSolicitudes] = useState<SolicitudWithRelations[]>([])
250:   const [filters, setFiltersState] = useState<SolicitudesFilter>({
251:     ...DEFAULT_FILTER,
252:     ...initialFilter,
253:   })
254:   const [listLoading, setListLoading] = useState(false)
255:   const [listError, setListError] = useState<string | null>(null)
256:   const [totalCount, setTotalCount] = useState(0)
257: 
258:   // Estado de mutaciones
259:   const [saving, setSaving] = useState(false)
260:   const [saveError, setSaveError] = useState<string | null>(null)
261:   const busyRef = useRef(false)
262: 
263:   // --- Actualizar filtros parcialmente ---
264:   const setFilters = useCallback((updates: Partial<SolicitudesFilter>) => {
265:     setFiltersState((prev) => ({ ...prev, ...updates }))
266:   }, [])
267: 
268:   // --- Fetch lista ---
269:   const refetchList = useCallback(async () => {
270:     setListLoading(true)
271:     setListError(null)
272: 
273:     try {
274:       // J4-B: sort server-side. Default: date_required asc si no hay sort explícito.
275:       const sortCol = filters.sortColumn ?? 'date_required'
276:       const sortAsc = filters.sortDirection !== 'desc'
277:       let query = supabase
278:         .from('sm_requests')
279:         .select(`
280:           *,
281:           project:projects!sm_requests_project_id_fkey(id, code, name),
282:           requester:people!sm_requests_requester_id_fkey(id, name),
283:           cost_code:cost_codes!sm_requests_cost_code_id_fkey(id, phase_code, phase_description, full_code),
284:           cost_category:cost_categories!sm_requests_cost_category_id_fkey(id, code, description),
285:           lines:sm_request_lines(id, status, line_type, description, quantity, notes, from_text, to_text, unit_text, from_location:locations!sm_request_lines_from_location_id_fkey(name), to_location:locations!sm_request_lines_to_location_id_fkey(name), unit:units(code))
286:         `, { count: 'exact' })
287:         .order(sortCol, { ascending: sortAsc })
288: 
289:       // Aplicar filtros dinamicamente
290:       if (filters.projectId) {
291:         query = query.eq('project_id', filters.projectId)
292:       }
293:       if (filters.statuses.length > 0) {
294:         query = query.in('status', filters.statuses)
295:       }
296:       // Prioridad se filtra client-side (calculatePriority viva vs BD stale)
297:       if (filters.dateFrom) {
298:         query = query.gte('date_required', filters.dateFrom)
299:       }
300:       if (filters.dateTo) {
301:         query = query.lte('date_required', filters.dateTo)
302:       }
303:       // J4-A: filtro de día único (click en calendario). Solo aplica a la
304:       // tabla — la query del calendario NO incluye este filtro.
305:       if (filters.singleDay) {
306:         query = query.eq('date_required', filters.singleDay)
307:       }
308:       if (filters.search) {
309:         query = query.ilike('request_id', `%${filters.search}%`)
310:       }
311:       if (filters.requesterId) {
312:         query = query.eq('requester_id', filters.requesterId)
313:       }
314: 
315:       // Paginación server-side
316:       const from = filters.page * filters.pageSize
317:       const to = from + filters.pageSize - 1
318:       query = query.range(from, to)
319: 
320:       const { data, error, count } = await query
321: 
322:       if (error) {
323:         setListError(error.message)
324:         return
325:       }
326: 
327:       // Mapear la respuesta al tipo esperado
328:       const mapped: SolicitudWithRelations[] = (data ?? []).map((row) => {
329:         // Supabase devuelve el join como objeto o array segun cardinalidad
330:         const project = Array.isArray(row.project) ? row.project[0] : row.project
331:         const requester = Array.isArray(row.requester) ? row.requester[0] : row.requester
332:         const rawCostCode = (row as Record<string, unknown>).cost_code as SolicitudWithRelations['cost_code'] | SolicitudWithRelations['cost_code'][] | null
333:         const rawCostCategory = (row as Record<string, unknown>).cost_category as SolicitudWithRelations['cost_category'] | SolicitudWithRelations['cost_category'][] | null
334:         const costCode = Array.isArray(rawCostCode) ? rawCostCode[0] ?? null : rawCostCode
335:         const costCategory = Array.isArray(rawCostCategory) ? rawCostCategory[0] ?? null : rawCostCategory
336:         const lines = Array.isArray(row.lines) ? row.lines : []
337: 
338:         return {
339:           id: row.id,
340:           request_id: row.request_id,
341:           project_id: row.project_id,
342:           requester_id: row.requester_id,
343:           approved_by: row.approved_by,
344:           date_required: row.date_required,
345:           date_created: row.date_created,
346:           date_submitted: row.date_submitted ?? null,
347:           date_completed: row.date_completed ?? null,
348:           date_cancelled: row.date_cancelled ?? null,
349:           status: row.status,
350:           priority: row.priority,
351:           notes: row.notes,
352:           attachments: row.attachments,
353:           cost_code_id: ((row as Record<string, unknown>).cost_code_id as string | null) ?? null,
354:           cost_category_id: ((row as Record<string, unknown>).cost_category_id as string | null) ?? null,
355:           created_at: row.created_at,
356:           updated_at: row.updated_at,
357:           project: project as SolicitudWithRelations['project'],
358:           requester: requester as SolicitudWithRelations['requester'],
359:           cost_code: costCode,
360:           cost_category: costCategory,
361:           // Para la lista, las lineas solo traen id y status (sin relaciones completas)
362:           lines: lines as unknown as LineWithRelations[],
363:         }
364:       })
365: 
366:       setTotalCount(count ?? 0)
367:       setSolicitudes(mapped)
368:     } catch (err) {
369:       const message = err instanceof Error ? err.message : 'Error al cargar solicitudes'
370:       setListError(message)
371:     } finally {
372:       setListLoading(false)
373:     }
374:   }, [supabase, filters])
375: 
376:   // Auto-fetch cuando cambian los filtros
377:   useEffect(() => {
378:     void refetchList()
379:   }, [refetchList])
380: 
381:   // --- Fetch detalle de una solicitud ---
382:   const fetchSolicitud = useCallback(
383:     async (id: string): Promise<SolicitudWithRelations | null> => {
384:       const { data, error } = await supabase
385:         .from('sm_requests')
386:         .select(`
387:           *,
388:           project:projects!sm_requests_project_id_fkey(id, code, name),
389:           requester:people!sm_requests_requester_id_fkey(id, name),
390:           cost_code:cost_codes!sm_requests_cost_code_id_fkey(id, phase_code, phase_description, full_code),
391:           cost_category:cost_categories!sm_requests_cost_category_id_fkey(id, code, description),
392:           lines:sm_request_lines(
393:             *,
394:             equipment:equipment!sm_request_lines_equipment_id_fkey(id, spectrum_code, description),
395:             from_location:locations!sm_request_lines_from_location_id_fkey(id, name),
396:             to_location:locations!sm_request_lines_to_location_id_fkey(id, name),
397:             unit:units!sm_request_lines_unit_id_fkey(id, code, description),
398:             trip_assignments:trip_line_assignments(
399:               id, quantity_assigned, qty_delivered,
400:               trip:trip_id(id, trip_id, status)
401:             ),
402:             pickup_lines:pickup_order_lines(
403:               id, quantity_assigned, qty_delivered,
404:               order:pickup_order_id(id, pickup_id, status)
405:             ),
406:             external_lines:external_order_lines(
407:               id, quantity_assigned, qty_delivered,
408:               order:external_order_id(id, external_id, status, provider_name, invoice_amount)
409:             )
410:           )
411:         `)
412:         .eq('id', id)
413:         .single()
414: 
415:       if (error || !data) {
416:         return null
417:       }
418: 
419:       const project = Array.isArray(data.project) ? data.project[0] : data.project
420:       const requester = Array.isArray(data.requester) ? data.requester[0] : data.requester
421:       const rawLines = Array.isArray(data.lines) ? data.lines : []
422: 
423:       // Ordenar lineas por line_number
424:       const sortedLines = [...rawLines].sort(
425:         (a, b) => (a as { line_number: number }).line_number - (b as { line_number: number }).line_number,
426:       )
427: 
428:       // Mapear lineas con sus relaciones (cost_code/category ahora son del header — Cambio 2)
429:       const lines: LineWithRelations[] = sortedLines.map((rawLine) => {
430:         const line = rawLine as Record<string, unknown>
431:         const eq = line.equipment as LineWithRelations['equipment']
432:         const fromLoc = line.from_location as LineWithRelations['from_location']
433:         const toLoc = line.to_location as LineWithRelations['to_location']
434:         const unit = line.unit as LineWithRelations['unit']
435: 
436:         // Mapear fulfillments (3 tablas pivote) a discriminated union.
437:         // Filtro: solo orders/trips activos (status !== 'Cancelado').
438:         const tripAssignments = (line.trip_assignments as Array<Record<string, unknown>>) ?? []
439:         const pickupLines = (line.pickup_lines as Array<Record<string, unknown>>) ?? []
440:         const externalLines = (line.external_lines as Array<Record<string, unknown>>) ?? []
441: 
442:         const fulfillments: FulfillmentInfo[] = []
443: 
444:         for (const ta of tripAssignments) {
445:           const trip = (Array.isArray(ta.trip) ? ta.trip[0] : ta.trip) as { id: string; trip_id: string | null; status: string } | null
446:           if (!trip || trip.status === 'Cancelado') continue
447:           fulfillments.push({
448:             type: 'trip',
449:             id: trip.id,
450:             trip_id: trip.trip_id,
451:             status: trip.status,
452:             quantity_assigned: ta.quantity_assigned as number,
453:             qty_delivered: (ta.qty_delivered as number) ?? 0,
454:           })
455:         }
456: 
457:         for (const pl of pickupLines) {
458:           const order = (Array.isArray(pl.order) ? pl.order[0] : pl.order) as { id: string; pickup_id: string; status: string } | null
459:           if (!order || order.status === 'Cancelado') continue
460:           fulfillments.push({
461:             type: 'pickup',
462:             id: order.id,
463:             pickup_id: order.pickup_id,
464:             status: order.status,
465:             quantity_assigned: pl.quantity_assigned as number,
466:             qty_delivered: (pl.qty_delivered as number) ?? 0,
467:           })
468:         }
469: 
470:         for (const el of externalLines) {
471:           const order = (Array.isArray(el.order) ? el.order[0] : el.order) as {
472:             id: string; external_id: string; status: string; provider_name: string; invoice_amount: number
473:           } | null
474:           if (!order || order.status === 'Cancelado') continue
475:           fulfillments.push({
476:             type: 'external',
477:             id: order.id,
478:             external_id: order.external_id,
479:             status: order.status,
480:             provider_name: order.provider_name,
481:             invoice_amount: order.invoice_amount,
482:             quantity_assigned: el.quantity_assigned as number,
483:             qty_delivered: (el.qty_delivered as number) ?? 0,
484:           })
485:         }
486: 
487:         return {
488:           id: line.id as string,
489:           request_id: line.request_id as string,
490:           line_number: line.line_number as number,
491:           line_type: line.line_type as string,
492:           equipment_id: (line.equipment_id as string | null) ?? null,
493:           description: line.description as string,
494:           equipment_text: (line.equipment_text as string | null) ?? null,
495:           from_location_id: (line.from_location_id as string | null) ?? null,
496:           from_text: (line.from_text as string | null) ?? null,
497:           to_location_id: (line.to_location_id as string | null) ?? null,
498:           to_text: (line.to_text as string | null) ?? null,
499:           quantity: line.quantity as number,
500:           unit_id: (line.unit_id as string | null) ?? null,
501:           unit_text: (line.unit_text as string | null) ?? null,
502:           category: (line.category as string | null) ?? null,
503:           material_category: (line.material_category as string | null) ?? null,
504:           po_reference: (line.po_reference as string | null) ?? null,
505:           notes: (line.notes as string | null) ?? null,
506:           designated_receiver_id: (line.designated_receiver_id as string | null) ?? null,
507:           designated_receiver_name: (line.designated_receiver_name as string | null) ?? null,
508:           status: line.status as string,
509:           qty_scheduled: (line.qty_scheduled as number | null) ?? null,
510:           qty_delivered: (line.qty_delivered as number | null) ?? null,
511:           created_at: line.created_at as string,
512:           updated_at: line.updated_at as string,
513:           equipment: eq ? (Array.isArray(eq) ? eq[0] : eq) : null,
514:           from_location: fromLoc ? (Array.isArray(fromLoc) ? fromLoc[0] : fromLoc) : null,
515:           to_location: toLoc ? (Array.isArray(toLoc) ? toLoc[0] : toLoc) : null,
516:           unit: unit ? (Array.isArray(unit) ? unit[0] : unit) : null,
517:           fulfillments,
518:         }
519:       })
520: 
521:       const rawCostCode = (data as Record<string, unknown>).cost_code as SolicitudWithRelations['cost_code'] | SolicitudWithRelations['cost_code'][] | null
522:       const rawCostCategory = (data as Record<string, unknown>).cost_category as SolicitudWithRelations['cost_category'] | SolicitudWithRelations['cost_category'][] | null
523:       const costCode = Array.isArray(rawCostCode) ? rawCostCode[0] ?? null : rawCostCode
524:       const costCategory = Array.isArray(rawCostCategory) ? rawCostCategory[0] ?? null : rawCostCategory
525: 
526:       return {
527:         id: data.id,
528:         request_id: data.request_id,
529:         project_id: data.project_id,
530:         requester_id: data.requester_id,
531:         approved_by: data.approved_by,
532:         date_required: data.date_required,
533:         date_created: data.date_created,
534:         date_submitted: data.date_submitted,
535:         date_completed: data.date_completed,
536:         date_cancelled: data.date_cancelled,
537:         status: data.status,
538:         priority: data.priority,
539:         notes: data.notes,
540:         attachments: data.attachments,
541:         cost_code_id: ((data as Record<string, unknown>).cost_code_id as string | null) ?? null,
542:         cost_category_id: ((data as Record<string, unknown>).cost_category_id as string | null) ?? null,
543:         created_at: data.created_at,
544:         updated_at: data.updated_at,
545:         project: project as SolicitudWithRelations['project'],
546:         requester: requester as SolicitudWithRelations['requester'],
547:         cost_code: costCode,
548:         cost_category: costCategory,
549:         lines,
550:       }
551:     },
