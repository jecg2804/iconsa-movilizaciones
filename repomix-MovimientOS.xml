246: // --- Create a trip from backlog lines and return the DB ID ---
247: export async function createTrip(
248:   page: Page,
249:   opts?: {
250:     conductor?: RegExp
251:     vehicle?: RegExp
252:     date?: string
253:     lineCount?: number // how many lines to add (default: all available)
254:     solicitudId?: string // if provided, find trip linked to this solicitud (prevents data collision)
255:   },
256: ): Promise<{ dbId: string; displayId: string; confirmationCode: string }> {
257:   await page.goto(`${BASE}/programacion`)
258:   await page.waitForLoadState('networkidle')
259:   await page.waitForTimeout(2000)
260: 
261:   // Select lines from backlog
262:   const checkboxes = page.locator('input[type="checkbox"]')
263:   const count = await checkboxes.count()
264:   const maxLines = opts?.lineCount ?? count
265:   for (let i = 0; i < Math.min(count, maxLines); i++) {
266:     const cb = checkboxes.nth(i)
267:     if (await cb.isVisible().catch(() => false)) {
268:       await cb.click()
269:       await page.waitForTimeout(200)
270:     }
271:   }
272: 
273:   // Click programar button
274:   const programarBtn = page.getByRole('button', { name: /Programar|Nueva Movilización|Crear Movilización/ }).first()
275:   await expect(programarBtn).toBeVisible({ timeout: 3000 })
276:   await programarBtn.click()
277:   await page.waitForURL('**/viaje/nuevo**', { timeout: 10000 })
278:   await page.waitForLoadState('networkidle')
279:   await page.waitForTimeout(3000)
280: 
281:   // Wait for form
282:   await expect(page.getByText('Cargando formulario')).not.toBeVisible({ timeout: 15000 })
283: 
284:   // Date
285:   await page.locator('input[type="date"]').first().fill(opts?.date ?? '2026-04-15')
286: 
287:   // Conductor + Vehículo (siempre requeridos — pickup ya no existe a nivel trip post-Cambio 3)
288:   await pick(page, /Conductor/, opts?.conductor ?? /Rafael|Conductor|Diaz/)
289:   await pick(page, /Veh/, opts?.vehicle ?? /CAB|VOL|PIC/)
290: 
291:   // Assign lines — click "Agregar" buttons
292:   await page.waitForTimeout(1000)
293:   const agregarBtns = page.getByRole('button', { name: 'Agregar' })
294:   const btnCount = await agregarBtns.count()
295:   const linesToAdd = opts?.lineCount ?? btnCount
296:   for (let i = 0; i < Math.min(btnCount, linesToAdd); i++) {
297:     await agregarBtns.first().click()
298:     await page.waitForTimeout(500)
299:   }
300: 
301:   // Save
302:   const guardarBtn = page.getByRole('button', { name: /Guardar Movilización/ })
303:   await expect(guardarBtn).toBeEnabled({ timeout: 5000 })
304:   await guardarBtn.click()
305:   await page.waitForTimeout(3000)
306: 
307:   // Get trip from BD
308:   let data: { id: string; trip_id: string; confirmation_code: string | null } | null = null
309: 
310:   // If solicitudId provided, find trip linked to that solicitud's lines
311:   if (opts?.solicitudId) {
312:     const { data: lines } = await db
313:       .from('sm_request_lines')
314:       .select('id')
315:       .eq('request_id', opts.solicitudId)
316:       .limit(1)
317:     if (lines && lines.length > 0) {
318:       const { data: assignment } = await db
319:         .from('trip_line_assignments')
320:         .select('trip_id')
321:         .eq('request_line_id', lines[0].id)
322:         .order('created_at', { ascending: false })
323:         .limit(1)
324:         .single()
325:       if (assignment) {
326:         const { data: trip } = await db
327:           .from('trips')
328:           .select('id, trip_id, confirmation_code')
329:           .eq('id', assignment.trip_id)
330:           .single()
331:         data = trip
332:       }
333:     }
334:   }
335: 
336:   // Fallback: most recent Programado trip
337:   if (!data) {
338:     const { data: trip } = await db
339:       .from('trips')
340:       .select('id, trip_id, confirmation_code')
341:       .eq('status', 'Programado')
342:       .order('created_at', { ascending: false })
343:       .limit(1)
344:       .single()
345:     data = trip
346:   }
347: 
348:   return {
349:     dbId: data?.id ?? '',
350:     displayId: data?.trip_id ?? '',
351:     confirmationCode: data?.confirmation_code ?? '',
352:   }
353: }
354: 
355: // --- Navigate to trip detail in mis-viajes ---
356: export async function openTripDetail(page: Page, tripDbId: string) {
357:   await page.goto(`${BASE}/mis-viajes/${tripDbId}`)
358:   await page.waitForLoadState('networkidle')
359:   await page.waitForTimeout(2000)
360: }
361: 
362: // --- Dispatch (Salida) ---
363: export async function dispatch(page: Page) {
364:   const salidaBtn = page.getByRole('button', { name: 'Registrar Salida' })
365:   await expect(salidaBtn).toBeVisible({ timeout: 10000 })
366:   await salidaBtn.click()
367:   await page.waitForTimeout(1500)
368: 
369:   const confirmBtn = page.getByRole('button', { name: 'Confirmar Despacho' })
370:   await expect(confirmBtn).toBeVisible({ timeout: 5000 })
371:   await confirmBtn.click()
372:   await page.waitForTimeout(3000)
373: }
374: 
375: // --- Register Parada ---
376: /**
377:  * Registra una Parada en el trip detail page (Cambio 1 redesign).
378:  *
379:  * - Si useOther=true: selecciona "Otra ubicación" y rellena freeText.
380:  * - Si useOther=false (default): selecciona la opción de location del dropdown
381:  *   por label regex.
382:  * - lineIds: ids de líneas a marcar (≥1 requerido por el modal).
383:  *   Usa data-testid={parada-line-{lineId}} agregado en ParadaModal.
384:  * - lineStatus: aplicado al primer status select tras la primera línea checkeada
385:  *   (simplificación — todas las líneas heredan el mismo status si lineStatus se pasa).
386:  * - filePath: path absoluto a archivo a subir (≥1 requerido).
387:  * - notes: opcional, notas generales.
388:  */
389: export async function registerParada(
390:   page: Page,
391:   opts: {
392:     location?: string
393:     useOther?: boolean
394:     freeText?: string
395:     lineIds: string[]
396:     lineStatus?: 'completo' | 'parcial' | 'no_disponible'
397:     filePath: string
398:     notes?: string
399:   },
400: ) {
401:   await page.getByRole('button', { name: 'Registrar Parada' }).first().click()
402:   await page.waitForTimeout(500)
403: 
404:   // Ubicación
405:   const locationSelect = page.locator('#parada-location-select')
406:   if (opts.useOther) {
407:     await locationSelect.selectOption({ value: '__OTHER__' })
408:     const freeTextInput = page.locator('input[placeholder="Escriba la ubicación"]')
409:     await freeTextInput.fill(opts.freeText ?? '')
410:   } else {
411:     if (!opts.location) throw new Error('registerParada: location requerido cuando useOther=false')
412:     // Buscar opción cuyo texto contenga `location` y usar su value (string)
413:     const optionValue = await locationSelect
414:       .locator('option')
415:       .filter({ hasText: opts.location })
416:       .first()
417:       .getAttribute('value')
418:     if (!optionValue) {
419:       throw new Error(`registerParada: no encontré opción que matchee '${opts.location}'`)
420:     }
421:     await locationSelect.selectOption(optionValue)
422:   }
423: 
424:   // Líneas afectadas — data-testid robusto agregado en ParadaModal Task 4
425:   for (const lineId of opts.lineIds) {
426:     await page.getByTestId(`parada-line-${lineId}`).check()
427:   }
428: 
429:   // Status de línea (aplica al primer line-status select dentro del modal)
430:   if (opts.lineStatus && opts.lineStatus !== 'completo') {
431:     const lineStatusSelect = page.getByLabel('Estado de la línea').first()
432:     await lineStatusSelect.selectOption(opts.lineStatus)
433:   }
434: 
435:   // Foto de factura
436:   const fileInput = page.locator('input[type="file"]').first()
437:   await fileInput.setInputFiles(opts.filePath)
438:   await page.waitForTimeout(800)
439: 
440:   // Notas
441:   if (opts.notes) {
442:     await page.locator('#parada-notes').fill(opts.notes)
443:   }
444: 
445:   // Confirm — modal's "Registrar Parada" button (2nd con ese name)
446:   await page.getByRole('button', { name: 'Registrar Parada' }).nth(1).click()
447:   await page.waitForTimeout(3000)
448: }
449: 
450: // --- Register Entrega ---
451: export async function registerEntrega(
452:   page: Page,
453:   opts: { receiverName?: string; confirmationCode?: string },
454: ) {
455:   const entregaBtn = page.getByRole('button', { name: 'Registrar Entrega' })
456:   await expect(entregaBtn).toBeVisible({ timeout: 5000 })
457:   await entregaBtn.click()
458:   await page.waitForTimeout(1500)
459: 
460:   // Receiver — try fallback text first, then dropdown
461:   const fallbackLink = page.getByText('No esta en la lista').first()
462:   if (await fallbackLink.isVisible({ timeout: 2000 }).catch(() => false)) {
463:     await fallbackLink.click()
464:     await page.waitForTimeout(300)
465:     // Fill the text input that appears after clicking fallback
466:     const fallbackInput = page.locator('input[placeholder*="Escriba"]').last()
467:     await fallbackInput.fill(opts.receiverName ?? 'Ing. Test')
468:     // Trigger change event
469:     await fallbackInput.press('Tab')
470:     await page.waitForTimeout(500)
471:   } else {
472:     // Try selecting from dropdown
473:     await pick(page, /Recibido por/, /Admin|Jacome/)
474:   }
475: 
476:   // Confirmation code (placeholder is "4 dígitos")
477:   if (opts.confirmationCode) {
478:     const codeInput = page.getByPlaceholder('4 dígitos')
479:     if (await codeInput.isVisible({ timeout: 2000 }).catch(() => false)) {
480:       await codeInput.fill(opts.confirmationCode)
481:       await page.waitForTimeout(500)
482:     }
483:   }
484: 
485:   // Confirm
486:   const confirmBtn = page.getByRole('button', { name: 'Confirmar Entrega' })
487:   await expect(confirmBtn).toBeEnabled({ timeout: 5000 })
488:   await confirmBtn.click()
489:   await page.waitForTimeout(3000)
490: }
491: 
492: // --- Register Retorno ---
493: export async function registerRetorno(page: Page) {
494:   const retornoBtn = page.getByRole('button', { name: /Retorno/ })
495:   if (await retornoBtn.isVisible({ timeout: 3000 }).catch(() => false)) {
496:     await retornoBtn.click()
497:     await page.waitForTimeout(800)
498: 
499:     // Guard dialog aparece si hay líneas En Transito — confirmar primero
500:     const guardConfirmBtn = page.getByRole('button', { name: 'Sí, registrar Retorno' })
501:     if (await guardConfirmBtn.isVisible({ timeout: 1500 }).catch(() => false)) {
502:       await guardConfirmBtn.click()
503:       await page.waitForTimeout(800)
504:     }
505: 
506:     // EventModal de Retorno
507:     const confirmBtn = page.getByRole('button', { name: /Confirmar|Registrar/ }).last()
508:     if (await confirmBtn.isVisible().catch(() => false)) {
509:       await confirmBtn.click()
510:       await page.waitForTimeout(2000)
511:     }
512:   }
513: }
514: 
515: // --- Clean up test data by deleting a solicitud and its cascade ---
516: export async function cleanupSolicitud(solicitudId: string) {
517:   if (!solicitudId) return
518:   // Get line IDs
519:   const { data: lines } = await db
520:     .from('sm_request_lines')
521:     .select('id')
522:     .eq('request_id', solicitudId)
523:   const lineIds = (lines ?? []).map(l => l.id)
524: 
525:   // Get trip assignments
526:   if (lineIds.length > 0) {
527:     const { data: assignments } = await db
528:       .from('trip_line_assignments')
529:       .select('trip_id')
530:       .in('request_line_id', lineIds)
531:     const tripIds = [...new Set((assignments ?? []).map(a => a.trip_id))]
532: 
533:     // Delete trip data
534:     for (const tripId of tripIds) {
535:       await db.from('trip_event_lines').delete().eq('trip_event_id',
536:         (await db.from('trip_events').select('id').eq('trip_id', tripId)).data?.map(e => e.id) ?? []
537:       )
538:       await db.from('trip_events').delete().eq('trip_id', tripId)
539:       await db.from('trip_line_assignments').delete().eq('trip_id', tripId)
540:       await db.from('trips').delete().eq('id', tripId)
541:     }
542:   }
543: 
544:   // Delete lines and solicitud
545:   await db.from('sm_request_lines').delete().eq('request_id', solicitudId)
546:   await db.from('sm_requests').delete().eq('id', solicitudId)
547: }
</file>

