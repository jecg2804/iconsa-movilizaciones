 95: 
 96:   // --- Fetch tarifas ---
 97:   useEffect(() => {
 98:     async function fetchRates() {
 99:       setRatesLoading(true)
100:       const { data } = await supabase
101:         .from('mobilization_rates')
102:         .select('id, code, description, rate')
103:         .eq('is_active', true)
104:         .order('code')
105:       setRates(data ?? [])
106:       setRatesLoading(false)
107:     }
108:     fetchRates()
109:   }, [supabase])
110: 
111:   // --- Pre-poblar asignaciones desde URL params (?lines=id1,id2) ---
112:   useEffect(() => {
113:     const linesParam = searchParams.get('lines')
114:     if (!linesParam || backlog.length === 0) return
115: 
116:     const lineIds = linesParam.split(',').filter(Boolean)
117:     if (lineIds.length === 0) return
118: 
119:     const preselected: AssignmentInput[] = lineIds
120:       .map((id) => {
121:         const line = backlog.find((l) => l.id === id)
122:         if (!line) return null
123:         const availableQty = Math.max(0, line.quantity - line.qty_scheduled - (line.qty_delivered ?? 0))
124:         return {
125:           request_line_id: line.id,
126:           quantity_assigned: availableQty > 0 ? availableQty : line.quantity,
127:         }
128:       })
129:       .filter((a): a is AssignmentInput => a !== null)
130: 
131:     if (preselected.length > 0) {
132:       setAssignments(preselected)
133:     }
134:     // Solo cuando backlog se carga por primera vez
135:     // eslint-disable-next-line react-hooks/exhaustive-deps
136:   }, [backlog.length, searchParams])
137: 
138:   // --- Auto-rellenar costo cuando cambia la tarifa ---
139:   const handleRateChange = useCallback(
140:     (rateId: string | null) => {
141:       if (!rateId) return
142:       const rate = rates.find((r) => r.id === rateId)
143:       if (rate) {
144:         setTripData((prev) => ({ ...prev, cost: rate.rate }))
145:       }
146:     },
147:     [rates],
148:   )
149: 
150:   // --- Transformar datos a SelectOption ---
151: 
152:   const driverOptions: SelectOption[] = useMemo(
153:     () => drivers.map((d) => ({ value: d.id, label: d.name })),
154:     [drivers],
155:   )
156: 
157:   const vehicleOptions: SelectOption[] = useMemo(
158:     () =>
159:       vehicles.map((v) => ({
160:         value: v.id,
161:         label: `${v.spectrum_code ?? ''} – ${v.description}`.trim(),
162:       })),
163:     [vehicles],
164:   )
165: 
166:   const trailerOptions: SelectOption[] = useMemo(
167:     () =>
168:       trailers.map((t) => ({
169:         value: t.id,
170:         label: `${t.spectrum_code ?? ''} – ${t.description}`.trim(),
171:       })),
172:     [trailers],
173:   )
174: 
175:   const rateOptions: SelectOption[] = useMemo(
176:     () =>
177:       rates.map((r) => ({
178:         value: r.id,
179:         label: `${r.code} — ${r.description}`,
180:         sublabel: formatCurrency(r.rate),
181:         amount: r.rate,
182:       })),
183:     [rates],
184:   )
185: 
186:   // --- Detectar si el vehículo es cabezal ---
187:   const isCabezal = useMemo(() => {
188:     const v = vehicles.find((v) => v.id === tripData.vehicle_id)
189:     if (!v) return false
