168:                   {formatQty(ol.quantity_assigned)} {unitCode}
169:                 </span>
170:                 <span className="text-xs text-gray-400 whitespace-nowrap">{fromName} → {toName}</span>
171:                 {ol.qty_delivered > 0 && (
172:                   <span className="text-xs text-emerald-600 whitespace-nowrap">✓ {formatQty(ol.qty_delivered)}</span>
173:                 )}
174:               </div>
175:             )
176:           })}
177: 
178:           {order.notes && (
179:             <div className="mt-2 pt-2 border-t border-blue-100">
180:               <p className="text-xs italic text-gray-500">{order.notes}</p>
181:             </div>
182:           )}
183:         </div>
184:       )}
185:     </div>
186:   )
187: }
