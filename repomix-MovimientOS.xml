23: }
24: 
25: const sizeClasses: Record<ButtonSize, string> = {
26:   sm: 'px-3 py-1.5 text-sm',
27:   md: 'px-4 py-2 text-sm',
28:   lg: 'px-6 py-2.5 text-base',
29: }
30: 
31: const Button = forwardRef<HTMLButtonElement, ButtonProps>(
32:   (
33:     {
34:       variant = 'primary',
35:       size = 'md',
36:       loading = false,
37:       fullWidth = false,
38:       disabled,
39:       className = '',
40:       children,
41:       ...props
42:     },
43:     ref,
44:   ) => {
45:     return (
46:       <button
47:         ref={ref}
48:         disabled={disabled || loading}
49:         className={`
50:           inline-flex items-center justify-center gap-2
51:           rounded-lg font-medium
52:           transition-colors duration-150
53:           focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2
54:           disabled:opacity-50 disabled:cursor-not-allowed
55:           ${variantClasses[variant]}
56:           ${sizeClasses[size]}
57:           ${fullWidth ? 'w-full' : ''}
58:           ${className}
59:         `}
60:         {...props}
61:       >
62:         {loading && <Loader2 className="h-4 w-4 animate-spin" />}
63:         {children}
64:       </button>
65:     )
66:   },
67: )
