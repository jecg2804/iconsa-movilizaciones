 97:             >
 98:               Ver factura
 99:             </button>
100:           )}
101:         </div>
102: 
103:         {isActive && (canConfirmDelivery || canCancelOrder) && (
104:           <div className="flex items-center gap-2 shrink-0">
105:             {canCancelOrder && onCancelOrder && (
106:               <button
107:                 type="button"
108:                 onClick={onCancelOrder}
109:                 className="rounded-lg border border-red-300 bg-white px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-50 transition-colors"
110:               >
111:                 Cancelar viaje externo
112:               </button>
113:             )}
114:             {canConfirmDelivery && onConfirmDelivery && (
115:               <button
116:                 type="button"
117:                 onClick={onConfirmDelivery}
118:                 className="rounded-lg bg-amber-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-amber-600 transition-colors"
119:               >
120:                 Confirmar entrega
121:               </button>
122:             )}
123:           </div>
124:         )}
125: 
126:         {!isActive && (
127:           <div className="text-xs text-iconsa-gray shrink-0">
128:             {order.status === 'Entregado' && order.completed_at && (
