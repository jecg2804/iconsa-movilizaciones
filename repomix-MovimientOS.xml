<file path="src/lib/gps/skydata-client.ts">
 1: import type { VehiclePosition } from './types'
 2: 
 3: const TTL_MS = 10_000
 4: const STALE_THRESHOLD_HOURS = 48
 5: 
 6: let cache: { data: VehiclePosition[]; timestamp: number } | null = null
 7: let inflight: Promise<VehiclePosition[]> | null = null
 8: 
 9: function readCredentials(): { key: string; password: string; baseUrl: string } {
10:   const key = process.env.SKYDATA_API_KEY
11:   const password = process.env.SKYDATA_API_PASSWORD
12:   const baseUrl = process.env.SKYDATA_BASE_URL ?? 'https://app.skydataglobal.com'
13:   if (!key || !password) {
14:     throw new Error(
15:       '[skydata] SKYDATA_API_KEY or SKYDATA_API_PASSWORD missing in env',
16:     )
17:   }
18:   return { key, password, baseUrl }
19: }
20: 
21: /**
22:  * Normaliza una fila cruda del array que devuelve `/api/fleet/status` al
23:  * shape interno VehiclePosition. SkyData usa nomenclatura geográfica:
24:  *   y = latitud, x = longitud (ambos strings de número).
25:  *   vehId es number, hay que stringificar.
26:  *   event es number (código); eventDescription es el string human-readable.
27:  * Probado contra el payload real el 2026-04-20 con 13 vehículos de ICONSA.
28:  *
29:  * Exportado para `scripts/debug-skydata.ts` — consumirlo desde ahí mantiene
30:  * el debug en sync con el runtime (un solo sitio donde los nombres viven).
31:  * No usarlo desde runtime externo a este módulo.
32:  */
33: export function normalize(row: Record<string, unknown>): VehiclePosition {
34:   return {
35:     vehId: String(row.vehId ?? row.id ?? ''),
36:     lat: Number(row.y ?? row.lat ?? 0),
37:     lon: Number(row.x ?? row.lon ?? row.lng ?? 0),
38:     speed: Number(row.speed ?? 0),
39:     heading: Number(row.heading ?? row.course ?? 0),
40:     event: String(row.eventDescription ?? row.event ?? ''),
41:     place: String(row.place ?? ''),
42:     epoch: Number(row.epoch ?? 0),
43:     odometer: Number(row.odometer ?? 0),
44:   }
45: }
46: 
47: /**
48:  * Devuelve la lista completa de vehículos desde SkyData con caché compartido
49:  * de 10s. Concurrent callers comparten una sola promise inflight para evitar
50:  * stampede al expirar el TTL bajo carga.
51:  */
52: export async function getFleetStatus(): Promise<VehiclePosition[]> {
53:   if (cache && Date.now() - cache.timestamp < TTL_MS) {
54:     return cache.data
55:   }
56:   if (inflight) {
57:     return inflight
58:   }
59:   const { key, password, baseUrl } = readCredentials()
60:   const auth = Buffer.from(`${key}:${password}`).toString('base64')
61:   inflight = fetch(`${baseUrl}/api/fleet/status`, {
62:     headers: { Authorization: `Basic ${auth}` },
63:     cache: 'no-store',
64:   })
65:     .then(async (resp) => {
66:       if (!resp.ok) {
67:         if (cache) return cache.data
68:         throw new Error(`[skydata] upstream ${resp.status}`)
69:       }
70:       const raw = (await resp.json()) as unknown
71:       const list = Array.isArray(raw) ? raw : []
72:       const data = list.map((row) => normalize(row as Record<string, unknown>))
73:       cache = { data, timestamp: Date.now() }
74:       return data
75:     })
76:     .finally(() => {
77:       inflight = null
78:     })
79:   return inflight
80: }
81: 
82: /**
83:  * Filtra fleet status al vehículo específico. Devuelve null si no aparece.
84:  */
85: export async function getVehiclePosition(
86:   gpsVehicleId: string,
87: ): Promise<VehiclePosition | null> {
88:   const fleet = await getFleetStatus()
89:   return fleet.find((v) => v.vehId === gpsVehicleId) ?? null
90: }
91: 
92: /** True si el último reporte es más viejo que el threshold de stale (48h). */
93: export function isStale(position: VehiclePosition, nowMs = Date.now()): boolean {
94:   if (!position.epoch) return true
95:   const ageMs = nowMs - position.epoch * 1000
96:   return ageMs > STALE_THRESHOLD_HOURS * 60 * 60 * 1000
97: }
</file>

