131:       .from('sm_request_lines')
132:       .select('quantity, qty_scheduled, qty_delivered')
133:       .eq('request_id', bugResult.dbId)
134: 
135:     const line = lines![0]
136:     const qtyScheduled = Number(line.qty_scheduled)
137:     const qtyDispatched = qtyScheduled // In current flow, they're equal unless manually changed
138: 
139:     // The real test: backlog computation query
140:     // Available = quantity - qty_scheduled (current, buggy for dispatch reduction)
141:     // Should be = quantity - max(qty_dispatched, qty_delivered) (correct)
142: 
143:     // Clean up
144:     await cleanupSolicitud(bugResult.dbId)
145:   })
146: })
