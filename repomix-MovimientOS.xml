 295: **Steps:**
 296: 
 297: - [ ] **Step 1: Crear `src/hooks/useExternal.ts` con contenido completo**
 298: 
 299: ```typescript
 300: 'use client'
 301: 
 302: import { useState, useCallback, useMemo } from 'react'
 303: import { createClient } from '@/lib/supabase/client'
 304: import type { Attachment } from '@/lib/supabase/storage'
 305: 
 306: export interface ApproveExternalResult {
 307:   ok: boolean
 308:   error?: string
 309: }
 310: 
 311: export interface ConvertLineExternalResult {
 312:   ok: boolean
 313:   tripCancelled?: boolean
 314:   error?: string
 315: }
 316: 
 317: export interface CompleteExternalResult {
 318:   ok: boolean
 319:   error?: string
 320: }
 321: 
 322: export interface RevertExternalResult {
 323:   ok: boolean
 324:   error?: string
 325: }
 326: 
 327: /**
 328:  * Traduce errores BD a mensajes user-friendly. CHECK constraint
 329:  * sm_request_lines_pickup_external_exclusive se triggerea en concurrencia
 330:  * (2 sesiones de Charris en misma línea) — error PostgreSQL críptico se
 331:  * convierte a mensaje accionable.
 332:  */
 333: function translateBdError(message: string): string {
 334:   if (message.includes('sm_request_lines_pickup_external_exclusive')) {
 335:     return 'La línea ya tiene un fulfillment asignado. Refresca la página.'
 336:   }
 337:   return message
 338: }
 339: 
 340: /**
 341:  * Hook de operaciones externo (Cambio 4) — gemelo de usePickup.
 342:  * Externo es bandera a nivel de línea (sm_request_lines.external_by_provider),
 343:  * mutuamente excluyente con pickup_by_project (CHECK constraint BD).
 344:  *
 345:  * 4 funciones:
 346:  * - approveExternal: línea Pendiente → Externo Aprobado (sin trip)
 347:  * - convertLineToExternal: línea Programada → Externo Aprobado (DELETE
 348:  *   assignment + UPDATE atómico; auto-cancela trip si era última línea)
 349:  * - completeExternal: Externo Aprobado → Entregada (con receptor opcional,
 350:  *   notas opcionales, attachments opcionales appended)
 351:  * - revertExternalToBacklog: Externo Aprobado → Pendiente (preserva
 352:  *   external_invoice_attachments)
 353:  */
 354: export function useExternal() {
 355:   const supabase = useMemo(() => createClient(), [])
 356:   const [loading, setLoading] = useState(false)
 357:   const [error, setError] = useState<string | null>(null)
 358: 
 359:   /**
 360:    * Aprueba viaje externo desde el backlog (línea Pendiente).
 361:    * Validación: línea status='Pendiente', precondición pickup_by_project=false.
 362:    * UPDATE atómico con WHERE defensivo. cascade_request_status actualiza
 363:    * sm_requests.status a 'En Proceso' automáticamente.
 364:    */
 365:   const approveExternal = useCallback(
 366:     async (
 367:       lineId: string,
 368:       charrisId: string,
 369:       providerName: string,
 370:       invoiceAmount: number,
 371:       invoiceAttachments: Attachment[],
 372:       notes: string | null,
 373:     ): Promise<ApproveExternalResult> => {
 374:       setLoading(true)
 375:       setError(null)
 376: 
 377:       try {
 378:         // Validación campos obligatorios
 379:         if (providerName.trim() === '') {
 380:           const msg = 'El nombre del proveedor es requerido.'
 381:           setError(msg)
 382:           return { ok: false, error: msg }
 383:         }
 384:         if (invoiceAmount <= 0) {
 385:           const msg = 'El costo del servicio debe ser mayor a cero.'
 386:           setError(msg)
 387:           return { ok: false, error: msg }
 388:         }
 389:         if (invoiceAttachments.length === 0) {
 390:           const msg = 'Adjuntá al menos una cotización o factura.'
 391:           setError(msg)
 392:           return { ok: false, error: msg }
 393:         }
 394: 
 395:         const now = new Date().toISOString()
 396: 
 397:         const { data, error: updateError } = await supabase
 398:           .from('sm_request_lines')
 399:           .update({
 400:             status: 'Externo Aprobado',
 401:             external_by_provider: true,
 402:             external_approved_at: now,
 403:             external_approved_by: charrisId,
 404:             external_provider_name: providerName.trim(),
 405:             external_invoice_amount: invoiceAmount,
 406:             external_invoice_attachments: JSON.parse(JSON.stringify(invoiceAttachments)),
 407:             external_notes: notes?.trim() || null,
 408:           })
 409:           .eq('id', lineId)
 410:           .eq('status', 'Pendiente')
 411:           .eq('pickup_by_project', false)
 412:           .select('id')
 413: 
 414:         if (updateError) {
 415:           const friendly = translateBdError(updateError.message)
 416:           setError(friendly)
 417:           return { ok: false, error: friendly }
 418:         }
 419: 
 420:         if (!data || data.length === 0) {
 421:           const msg = 'La línea ya no está disponible para aprobar como externo (puede haber cambiado de estado).'
 422:           setError(msg)
 423:           return { ok: false, error: msg }
 424:         }
 425: 
 426:         return { ok: true }
 427:       } catch (err) {
 428:         const message = err instanceof Error ? err.message : 'Error al aprobar viaje externo'
 429:         setError(message)
 430:         return { ok: false, error: message }
 431:       } finally {
 432:         setLoading(false)
 433:       }
 434:     },
 435:     [supabase],
 436:   )
 437: 
 438:   /**
 439:    * Convierte una línea Programada a Externo Aprobado.
 440:    * - Bloquea si qty_delivered > 0 (E2).
 441:    * - DELETE assignment, UPDATE línea atómico (status + flags + qty_scheduled).
 442:    * - Si trip queda con 0 assignments → cancela trip.
 443:    *
 444:    * NOTA deuda técnica: DELETE + UPDATE NO es atómico server-side.
 445:    * Riesgo bajo v1 (1 Charris operando, sin concurrencia). Polish post-merge:
 446:    * convertir a RPC SQL con SECURITY DEFINER y transacción.
 447:    */
 448:   const convertLineToExternal = useCallback(
 449:     async (
 450:       lineId: string,
 451:       assignmentId: string,
 452:       quantityAssigned: number,
 453:       tripId: string,
 454:       charrisId: string,
 455:       providerName: string,
 456:       invoiceAmount: number,
 457:       invoiceAttachments: Attachment[],
 458:       notes: string | null,
 459:     ): Promise<ConvertLineExternalResult> => {
 460:       setLoading(true)
 461:       setError(null)
 462: 
 463:       try {
 464:         // Validación campos obligatorios
 465:         if (providerName.trim() === '') {
 466:           const msg = 'El nombre del proveedor es requerido.'
 467:           setError(msg)
 468:           return { ok: false, error: msg }
 469:         }
 470:         if (invoiceAmount <= 0) {
 471:           const msg = 'El costo del servicio debe ser mayor a cero.'
 472:           setError(msg)
 473:           return { ok: false, error: msg }
 474:         }
 475:         if (invoiceAttachments.length === 0) {
 476:           const msg = 'Adjuntá al menos una cotización o factura.'
 477:           setError(msg)
 478:           return { ok: false, error: msg }
 479:         }
 480: 
 481:         // 1. Validar: qty_delivered debe ser 0 + pickup_by_project debe ser false
 482:         const { data: line, error: fetchError } = await supabase
 483:           .from('sm_request_lines')
 484:           .select('qty_delivered, qty_scheduled, quantity, pickup_by_project')
 485:           .eq('id', lineId)
 486:           .single()
 487: 
 488:         if (fetchError || !line) {
 489:           const msg = fetchError?.message ?? 'Línea no encontrada'
 490:           setError(msg)
 491:           return { ok: false, error: msg }
 492:         }
 493: 
 494:         const qtyDelivered = line.qty_delivered ?? 0
 495:         if (qtyDelivered > 0) {
 496:           const msg = `No se puede convertir a externo una línea con entregas previas registradas (${qtyDelivered} de ${line.quantity} entregado). Cancelá la línea o terminá el flow actual.`
 497:           setError(msg)
 498:           return { ok: false, error: msg }
 499:         }
 500: 
 501:         if (line.pickup_by_project) {
 502:           const msg = 'La línea ya está aprobada como pickup. No se puede convertir a externo.'
 503:           setError(msg)
 504:           return { ok: false, error: msg }
 505:         }
 506: 
 507:         // 2. DELETE assignment
 508:         const { error: deleteError } = await supabase
 509:           .from('trip_line_assignments')
 510:           .delete()
 511:           .eq('id', assignmentId)
 512: 
 513:         if (deleteError) {
 514:           setError(deleteError.message)
 515:           return { ok: false, error: deleteError.message }
 516:         }
 517: 
 518:         // 3. UPDATE línea atómico
 519:         const newQtyScheduled = Math.max(0, (line.qty_scheduled ?? 0) - quantityAssigned)
 520:         const now = new Date().toISOString()
 521: 
 522:         const { error: updateError } = await supabase
 523:           .from('sm_request_lines')
 524:           .update({
 525:             status: 'Externo Aprobado',
 526:             external_by_provider: true,
 527:             external_approved_at: now,
 528:             external_approved_by: charrisId,
 529:             external_provider_name: providerName.trim(),
 530:             external_invoice_amount: invoiceAmount,
 531:             external_invoice_attachments: JSON.parse(JSON.stringify(invoiceAttachments)),
 532:             external_notes: notes?.trim() || null,
 533:             qty_scheduled: newQtyScheduled,
 534:           })
 535:           .eq('id', lineId)
 536: 
 537:         if (updateError) {
 538:           const friendly = translateBdError(updateError.message)
 539:           setError(friendly)
 540:           return { ok: false, error: friendly }
 541:         }
 542: 
 543:         // 4. Verificar si el trip quedó sin assignments
 544:         const { count: remainingCount, error: countError } = await supabase
 545:           .from('trip_line_assignments')
 546:           .select('id', { count: 'exact', head: true })
 547:           .eq('trip_id', tripId)
 548: 
 549:         if (countError) {
 550:           console.warn('[useExternal] No se pudo verificar count de assignments:', countError.message)
 551:           return { ok: true, tripCancelled: false }
 552:         }
 553: 
 554:         if ((remainingCount ?? 0) === 0) {
 555:           const { error: cancelError } = await supabase
 556:             .from('trips')
 557:             .update({ status: 'Cancelado' })
 558:             .eq('id', tripId)
 559: 
 560:           if (cancelError) {
 561:             console.warn('[useExternal] No se pudo cancelar trip vacío:', cancelError.message)
 562:             return { ok: true, tripCancelled: false }
 563:           }
 564: 
 565:           return { ok: true, tripCancelled: true }
 566:         }
 567: 
 568:         return { ok: true, tripCancelled: false }
 569:       } catch (err) {
 570:         const message = err instanceof Error ? err.message : 'Error al convertir línea a externo'
 571:         setError(message)
 572:         return { ok: false, error: message }
 573:       } finally {
 574:         setLoading(false)
 575:       }
 576:     },
 577:     [supabase],
 578:   )
 579: 
 580:   /**
 581:    * Registra entrega externa. Setea status='Entregada', qty_delivered=quantity
 582:    * (todo-o-nada paralelo a pickup), external_completed_at, receptor OPCIONAL
 583:    * (no XOR — ambos campos pueden ser NULL), append attachments y notes.
 584:    *
 585:    * cascade_request_status updatea solicitud padre automáticamente.
 586:    */
 587:   const completeExternal = useCallback(
 588:     async (
 589:       lineId: string,
 590:       receivedById: string | null,
 591:       receivedByName: string | null,
 592:       notes: string | null,
 593:       additionalAttachments: Attachment[],
 594:     ): Promise<CompleteExternalResult> => {
 595:       setLoading(true)
 596:       setError(null)
 597: 
 598:       try {
 599:         // SELECT línea: quantity (auto-fill qty_delivered) + external_notes existentes (append) + external_invoice_attachments (concat)
 600:         const { data: line, error: fetchError } = await supabase
 601:           .from('sm_request_lines')
 602:           .select('quantity, external_notes, external_invoice_attachments')
 603:           .eq('id', lineId)
 604:           .single()
 605: 
 606:         if (fetchError || !line) {
 607:           const msg = fetchError?.message ?? 'Línea no encontrada'
 608:           setError(msg)
 609:           return { ok: false, error: msg }
 610:         }
 611: 
 612:         const now = new Date().toISOString()
 613: 
 614:         // Append notes preservando approve original
 615:         const trimmedNotes = (notes ?? '').trim()
 616:         const finalNotes = trimmedNotes
 617:           ? (line.external_notes ? `${line.external_notes}\n\n[Entrega ${now}] ${trimmedNotes}` : trimmedNotes)
 618:           : line.external_notes ?? null
 619: 
 620:         // Concat attachments (approve + delivery)
 621:         const existingAttachments = Array.isArray(line.external_invoice_attachments)
 622:           ? (line.external_invoice_attachments as Attachment[])
 623:           : []
 624:         const finalAttachments = [...existingAttachments, ...additionalAttachments]
 625: 
 626:         const { error: updateError } = await supabase
 627:           .from('sm_request_lines')
 628:           .update({
 629:             status: 'Entregada',
 630:             qty_delivered: line.quantity,
 631:             external_completed_at: now,
 632:             external_received_by_id: receivedById,
 633:             external_received_by_name: receivedByName?.trim() || null,
 634:             delivered_at: now,
 635:             external_invoice_attachments: JSON.parse(JSON.stringify(finalAttachments)),
 636:             external_notes: finalNotes,
 637:           })
 638:           .eq('id', lineId)
 639: 
 640:         if (updateError) {
 641:           setError(updateError.message)
 642:           return { ok: false, error: updateError.message }
 643:         }
 644: 
 645:         return { ok: true }
 646:       } catch (err) {
 647:         const message = err instanceof Error ? err.message : 'Error al registrar entrega externa'
 648:         setError(message)
 649:         return { ok: false, error: message }
 650:       } finally {
 651:         setLoading(false)
 652:       }
 653:     },
 654:     [supabase],
 655:   )
 656: 
 657:   /**
 658:    * Reverso de externo: línea Externo Aprobado → Pendiente.
 659:    * Disponible solo desde la sección "Viajes Externos Pendientes" (UI ya
 660:    * filtra por status='Externo Aprobado' AND external_completed_at IS NULL).
 661:    *
 662:    * UPDATE con WHERE clauses defensivas (atomic): si la línea cambió de
 663:    * estado entre el render del UI y el confirm del modal, UPDATE no matchea
 664:    * y retornamos error claro.
 665:    *
 666:    * NO toca: external_completed_at, external_received_by_*, qty_scheduled,
 667:    * qty_delivered, trip_line_assignments. PRESERVA external_invoice_attachments
 668:    * (Q4 cerrado — Storage cleanup async no vale la pena v1).
 669:    *
 670:    * cascade_request_status trigger se dispara solo y reevalúa solicitud padre.
 671:    */
 672:   const revertExternalToBacklog = useCallback(
 673:     async (lineId: string): Promise<RevertExternalResult> => {
 674:       setLoading(true)
 675:       setError(null)
 676: 
 677:       try {
 678:         const { data, error: updateError } = await supabase
 679:           .from('sm_request_lines')
 680:           .update({
 681:             status: 'Pendiente',
 682:             external_by_provider: false,
 683:             external_approved_at: null,
 684:             external_approved_by: null,
 685:             external_provider_name: null,
 686:             external_invoice_amount: null,
 687:             external_notes: null,
 688:             // PRESERVA: external_invoice_attachments (Q4)
 689:           })
 690:           .eq('id', lineId)
 691:           .eq('status', 'Externo Aprobado')
 692:           .is('external_completed_at', null)
 693:           .select('id')
 694: 
 695:         if (updateError) {
 696:           setError(updateError.message)
 697:           return { ok: false, error: updateError.message }
 698:         }
 699: 
 700:         if (!data || data.length === 0) {
 701:           const msg = 'La línea ya no está disponible para devolver al backlog (puede haber cambiado de estado).'
 702:           setError(msg)
 703:           return { ok: false, error: msg }
 704:         }
 705: 
 706:         return { ok: true }
 707:       } catch (err) {
 708:         const message = err instanceof Error ? err.message : 'Error al devolver línea al backlog'
 709:         setError(message)
 710:         return { ok: false, error: message }
 711:       } finally {
 712:         setLoading(false)
 713:       }
 714:     },
 715:     [supabase],
 716:   )
 717: 
 718:   return {
 719:     loading,
 720:     error,
 721:     approveExternal,
 722:     convertLineToExternal,
 723:     completeExternal,
 724:     revertExternalToBacklog,
 725:   }
 726: }
 727: ```
