 1: import { useRef, useCallback } from 'react'
 2: 
 3: /**
 4:  * Previene doble-submit usando useRef (inmediato, no espera re-render).
 5:  * Envuelve cualquier handler async para que solo se ejecute una vez a la vez.
 6:  *
 7:  * Uso:
 8:  *   const guard = useSubmitGuard()
 9:  *   const handleSave = guard(async () => { ... })
10:  */
11: export function useSubmitGuard() {
12:   const busyRef = useRef(false)
13: 
14:   const guard = useCallback(
15:     <Args extends unknown[], T>(fn: (...args: Args) => Promise<T>): ((...args: Args) => Promise<T | undefined>) => {
16:       return async (...args: Args) => {
17:         if (busyRef.current) return undefined
18:         busyRef.current = true
19:         try {
20:           return await fn(...args)
21:         } finally {
22:           busyRef.current = false
23:         }
24:       }
25:     },
26:     [],
27:   )
28: 
29:   return guard
30: }
</file>

