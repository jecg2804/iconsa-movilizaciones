 531:           const tripId = (row as { trip_id: string | null }).trip_id
 532:           if (tripId) ids.add(tripId)
 533:         }
 534:         projectTripIds = Array.from(ids)
 535:         if (projectTripIds.length === 0) {
 536:           setTrips([])
 537:           setTripsTotalCount(0)
 538:           return
 539:         }
 540:       }
 541: 
 542:       // J4-B: sort server-side. Default: scheduled_date desc si no hay sort explícito.
 543:       const sortCol = filters.sortColumn ?? 'scheduled_date'
 544:       const sortAsc = filters.sortDirection === 'asc'
 545:       let query = supabase
 546:         .from('trips')
 547:         .select(`
 548:           *,
 549:           driver:driver_id(id, name),
 550:           vehicle:vehicle_id(id, spectrum_code, description),
 551:           trailer:trailer_id(id, spectrum_code, description),
 552:           rate:rate_id(id, code, description, rate),
 553:           assignments:trip_line_assignments(
 554:             id,
 555:             trip_id,
 556:             request_line_id,
 557:             quantity_assigned,
 558:             qty_delivered,
 559:             qty_dispatched,
 560:             line:request_line_id(
 561:               id,
 562:               line_number,
 563:               line_type,
 564:               description,
 565:               quantity,
 566:               status,
 567:               notes,
 568:               qty_scheduled,
 569:               qty_delivered,
 570:               designated_receiver_id,
 571:               designated_receiver_name,
 572:               from_location:from_location_id(id, name, location_type),
 573:               to_location:to_location_id(id, name, location_type),
 574:               from_text,
 575:               to_text,
 576:               unit_text,
 577:               unit:unit_id(id, code),
 578:               equipment:equipment_id(id, spectrum_code, description),
 579:               request:request_id(
 580:                 id,
 581:                 request_id,
 582:                 date_required,
 583:                 project:project_id(id, code, name),
 584:                 requester:requester_id(id, name)
 585:               )
 586:             )
 587:           )
 588:         `, { count: 'exact' })
 589:         .order(sortCol, { ascending: sortAsc })
 590: 
 591:       // Aplicar filtros dinámicamente
 592:       if (projectTripIds) {
 593:         query = query.in('id', projectTripIds)
 594:       }
 595:       if (filters.status) {
 596:         query = query.eq('status', filters.status)
 597:       }
 598:       if (filters.dateFrom) {
 599:         query = query.gte('scheduled_date', filters.dateFrom)
 600:       }
 601:       if (filters.dateTo) {
 602:         query = query.lte('scheduled_date', filters.dateTo)
 603:       }
 604:       // J4-A: filtro de día único (click en calendario). Solo aplica a la
 605:       // tabla — la query del calendario NO incluye este filtro.
 606:       if (filters.singleDay) {
