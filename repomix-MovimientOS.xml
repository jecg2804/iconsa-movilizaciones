  1: /**
  2:  * Debug probe for the SkyData / SkyGlobal GPS API.
  3:  *
  4:  * Correr cuando:
  5:  *   (a) SkyData responde raro (errores intermitentes, shapes inesperados).
  6:  *   (b) Un vehículo con `gps_vehicle_id` seteado no aparece en el mapa
  7:  *       (típico: placeholder "sin coordenadas válidas" o canvas gris).
  8:  *   (c) Después de un update mayor de la plataforma SkyData (field renames,
  9:  *       cambios de auth, nuevos endpoints).
 10:  *
 11:  * Uso:
 12:  *   npx tsx --env-file=.env.local scripts/debug-skydata.ts
 13:  *
 14:  * Lee credenciales de process.env (`SKYDATA_API_KEY`, `SKYDATA_API_PASSWORD`,
 15:  * opcionalmente `SKYDATA_BASE_URL`). Si falta alguna, aborta. Nada hardcoded,
 16:  * nada con fallback a un valor real.
 17:  *
 18:  * NO se ejecuta en hooks, builds, ni pipelines. Tool manual de diagnóstico.
 19:  *
 20:  * Imprime:
 21:  *   1. Ejemplo raw del primer vehículo (shape exacto de SkyData).
 22:  *   2. Ese mismo vehículo normalizado via la misma función que usa el runtime.
 23:  *   3. Breakdown fresh/stale usando el umbral de 48h.
 24:  *   4. Field presence report — el canario: si SkyData renombra o deja de
 25:  *      enviar un field, el conteo baja y el drift se ve de inmediato.
 26:  *   5. Sanity check de coords normalizadas (0/0, NaN, fuera de rango).
 27:  *
 28:  * Historia: el normalizer original asumía fields `lat`/`lon` pero SkyData usa
 29:  * `x`/`y` (convención geométrica, donde x=lon, y=lat). Todos los vehículos
 30:  * salían en (0,0) y el mapa se veía gris. Un probe manual expuso el mismatch
 31:  * en 10 segundos. Este script automatiza ese probe para la próxima vez.
 32:  */
 33: 
 34: import { normalize } from '../src/lib/gps/skydata-client'
 35: import type { VehiclePosition } from '../src/lib/gps/types'
 36: 
 37: const STALE_THRESHOLD_HOURS = 48
 38: 
 39: // Fields que la app (o su normalizer) consume del payload crudo. Incluye
 40: // ambas convenciones (x/y geométrica y lat/lon cartográfica) para detectar
 41: // rápido si SkyData alguna vez cambia de nomenclatura.
 42: const EXPECTED_FIELDS = [
 43:   'vehId', 'id',
 44:   'x', 'y', 'lat', 'lon', 'lng',
 45:   'speed', 'heading', 'course',
 46:   'event', 'eventDescription',
 47:   'place', 'epoch', 'odometer',
 48:   'description', 'licensePlate',
 49: ] as const
 50: 
 51: async function main() {
 52:   const key = process.env.SKYDATA_API_KEY
 53:   const pwd = process.env.SKYDATA_API_PASSWORD
 54:   const baseUrl = process.env.SKYDATA_BASE_URL ?? 'https://app.skydataglobal.com'
 55:   if (!key || !pwd) {
 56:     console.error('[debug-skydata] missing SKYDATA_API_KEY or SKYDATA_API_PASSWORD in env')
 57:     process.exit(1)
 58:   }
 59: 
 60:   const auth = Buffer.from(`${key}:${pwd}`).toString('base64')
 61:   const resp = await fetch(`${baseUrl}/api/fleet/status`, {
 62:     headers: { Authorization: `Basic ${auth}` },
 63:   })
 64:   if (!resp.ok) {
 65:     console.error(`[debug-skydata] upstream ${resp.status}`)
 66:     console.error((await resp.text()).slice(0, 500))
 67:     process.exit(1)
 68:   }
 69: 
 70:   const raw = (await resp.json()) as unknown
 71:   const list = Array.isArray(raw) ? (raw as Record<string, unknown>[]) : []
 72: 
 73:   console.log(`Fetched ${list.length} vehicle${list.length === 1 ? '' : 's'}`)
 74:   if (list.length === 0) {
 75:     console.warn('[debug-skydata] empty response — nothing more to report')
 76:     return
 77:   }
 78: 
 79:   console.log('\n=== Raw object example (first vehicle) ===')
 80:   console.log(JSON.stringify(list[0], null, 2))
 81: 
 82:   const normalized: VehiclePosition[] = list.map((row) => normalize(row))
 83: 
 84:   console.log('\n=== Normalized (first vehicle) ===')
 85:   console.log(JSON.stringify(normalized[0], null, 2))
 86: 
 87:   // Fresh / stale breakdown — misma lógica que isStale() del client.
 88:   const nowSec = Math.floor(Date.now() / 1000)
 89:   const thresholdSec = STALE_THRESHOLD_HOURS * 3600
 90:   let fresh = 0
 91:   let stale = 0
 92:   let noEpoch = 0
 93:   for (const v of normalized) {
 94:     if (!v.epoch) noEpoch++
 95:     else if (nowSec - v.epoch <= thresholdSec) fresh++
 96:     else stale++
 97:   }
 98:   console.log(`\n=== Fresh / stale breakdown (umbral ${STALE_THRESHOLD_HOURS}h) ===`)
 99:   console.log(`Fresh (<${STALE_THRESHOLD_HOURS}h):  ${fresh}`)
100:   console.log(`Stale (>${STALE_THRESHOLD_HOURS}h):  ${stale}`)
101:   console.log(`Sin epoch:       ${noEpoch}`)
102: 
103:   // Field presence report — el canario para drift de API.
104:   console.log('\n=== Field presence report ===')
105:   const total = list.length
106:   const maxLen = Math.max(...EXPECTED_FIELDS.map(f => f.length))
107:   for (const field of EXPECTED_FIELDS) {
108:     const present = list.filter(row => row[field] !== undefined && row[field] !== null).length
109:     const pad = ' '.repeat(maxLen - field.length)
110:     const warn = present === 0 ? '  ⚠ ningún vehículo tiene este field' : ''
111:     console.log(`  ${field}${pad}: ${present}/${total}${warn}`)
112:   }
113: 
114:   // Sanity check de coords normalizadas — espejea isValidPosition del componente.
115:   let invalidCoord = 0
116:   for (const v of normalized) {
117:     const valid = Number.isFinite(v.lat) && Number.isFinite(v.lon)
118:       && !(v.lat === 0 && v.lon === 0)
119:       && Math.abs(v.lat) <= 90 && Math.abs(v.lon) <= 180
120:     if (!valid) invalidCoord++
121:   }
122:   console.log('\n=== Normalized coord sanity ===')
123:   console.log(`Vehículos con coords inválidas (0/0, NaN, fuera de rango): ${invalidCoord}/${total}`)
124: }
125: 
126: main().catch(err => {
127:   console.error('[debug-skydata] THREW:', err)
128:   process.exit(1)
129: })
</file>

