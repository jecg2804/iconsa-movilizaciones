254: 
255:   return (
256:     <div className="mx-auto max-w-4xl space-y-6 px-4 pb-32 pt-4 sm:px-6 sm:pb-8 sm:pt-6">
257:       {/* Navegacion superior */}
258:       <div className="flex items-center gap-3">
259:         <button
260:           type="button"
261:           onClick={() => router.push('/programacion')}
262:           className="flex items-center gap-1.5 text-sm text-iconsa-gray hover:text-navy transition-colors"
263:         >
264:           <ArrowLeft className="h-4 w-4" />
265:           Programacion
266:         </button>
267:       </div>
268: 
269:       {/* Titulo */}
270:       <h1 className="text-2xl font-bold text-gray-900">Nueva Movilización</h1>
271: 
272:       {/* Error global de guardado */}
273:       {saveError && (
274:         <div className="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800">
275:           {saveError}
276:         </div>
277:       )}
278: 
279:       {/* Errores de validacion */}
280:       {validationErrors.length > 0 && (
281:         <div className="rounded-lg border border-red-300 bg-red-50 px-4 py-3">
282:           <ul className="space-y-1 text-sm text-red-800">
283:             {validationErrors.map((err) => (
284:               <li key={err}>{err}</li>
285:             ))}
286:           </ul>
287:         </div>
288:       )}
289: 
290:       {/* Formulario de cabecera del viaje */}
291:       <div className="rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
292:         <TripForm
293:           mode="create"
294:           drivers={driverOptions}
295:           vehicles={vehicleOptions}
296:           trailers={trailerOptions}
297:           rates={rateOptions}
298:           onChange={setTripData}
299:           onRateChange={handleRateChange}
300:           isTrailerRequired={isCabezal}
