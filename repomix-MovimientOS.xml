  3: import { useCallback, useEffect, useRef, useState } from 'react'
  4: import dynamic from 'next/dynamic'
  5: import { Crosshair } from 'lucide-react'
  6: // Type-only import: no afecta el bundle ni el dynamic import, solo tipado.
  7: import type { MapRef } from 'react-map-gl/maplibre'
  8: import type { GpsTripPosition, VehiclePosition } from '@/lib/gps/types'
  9: 
 10: // MapLibre touches `window`. Dynamic import + ssr:false avoids the SSR break.
 11: const Map = dynamic(
 12:   () => import('react-map-gl/maplibre').then((m) => m.default),
 13:   { ssr: false },
 14: )
 15: const Marker = dynamic(
 16:   () => import('react-map-gl/maplibre').then((m) => m.Marker),
 17:   { ssr: false },
 18: )
 19: 
 20: const TILE_STYLE_URL = 'https://tiles.openfreemap.org/styles/liberty'
 21: const POLL_INTERVAL_MS = 30_000
 22: const MAX_CONSECUTIVE_ERRORS = 3
 23: 
 24: interface TripLiveMapProps {
 25:   tripId: string
 26:   variant: 'full' | 'compact'
 27: }
 28: 
 29: interface FetchState {
 30:   data: GpsTripPosition | null
 31:   error: string | null
 32:   consecutiveErrors: number
 33:   lastFetchedAt: number | null
 34: }
 35: 
 36: function formatAgoSeconds(epochSec: number): string {
 37:   const ageSec = Math.max(0, Math.floor(Date.now() / 1000 - epochSec))
 38:   if (ageSec < 60) return `hace ${ageSec} seg`
 39:   const ageMin = Math.floor(ageSec / 60)
 40:   if (ageMin < 60) return `hace ${ageMin} min`
 41:   const ageH = Math.floor(ageMin / 60)
 42:   return `hace ${ageH} h`
 43: }
 44: 
 45: function formatHoursAgo(epochSec: number): string {
 46:   const ageH = Math.max(1, Math.floor((Date.now() / 1000 - epochSec) / 3600))
 47:   return `${ageH} h`
 48: }
 49: 
 50: function isValidPosition(p: VehiclePosition): boolean {
 51:   // SkyData puede devolver 0/0 para devices sin fix GPS o recién instalados.
 52:   // Panamá está aproximadamente en lat 7-10, lon -83 a -77.
 53:   // Filtro amplio pero descarta los 0/0 y cualquier valor obviamente inválido.
 54:   if (!Number.isFinite(p.lat) || !Number.isFinite(p.lon)) return false
 55:   if (p.lat === 0 && p.lon === 0) return false
 56:   if (Math.abs(p.lat) > 90 || Math.abs(p.lon) > 180) return false
 57:   return true
 58: }
 59: 
 60: export default function TripLiveMap({ tripId, variant }: TripLiveMapProps) {
 61:   const heightClass = variant === 'full' ? 'h-[400px]' : 'h-[250px]'
 62: 
 63:   const [state, setState] = useState<FetchState>({
 64:     data: null,
 65:     error: null,
 66:     consecutiveErrors: 0,
 67:     lastFetchedAt: null,
 68:   })
 69:   // Lazy initializer — evaluamos document.visibilityState solo al mount.
 70:   // Default true cubre el SSR/undefined path aunque el componente es 'use client'.
 71:   const [isVisible, setIsVisible] = useState(() =>
 72:     typeof document === 'undefined' ? true : document.visibilityState !== 'hidden',
 73:   )
 74:   const isUnmountedRef = useRef(false)
 75: 
 76:   // Auto-follow: el mapa se recentra en cada fix GPS nuevo hasta que el usuario
 77:   // interactúe (drag, zoom, rotate, pitch). Click en "Seguir vehículo" resetea
 78:   // el flag y retoma el seguimiento automático.
 79:   const [userInteracted, setUserInteracted] = useState(false)
 80:   const mapRef = useRef<MapRef | null>(null)
 81:   // Epoch del último fix que disparó un easeTo — evita re-seguir la misma
 82:   // posición si la API devuelve data con epoch sin cambios.
 83:   const lastFollowedEpochRef = useRef(0)
 84: 
 85:   const fetchPosition = useCallback(async () => {
 86:     try {
 87:       const resp = await fetch(`/api/gps/trip/${tripId}/position`, {
 88:         cache: 'no-store',
 89:       })
 90:       if (!resp.ok) throw new Error(`HTTP ${resp.status}`)
 91:       const json = (await resp.json()) as GpsTripPosition
 92:       if (isUnmountedRef.current) return
 93:       setState({
 94:         data: json,
 95:         error: null,
 96:         consecutiveErrors: 0,
 97:         lastFetchedAt: Date.now(),
 98:       })
 99:     } catch (err) {
100:       if (isUnmountedRef.current) return
101:       setState((prev) => ({
102:         data: prev.data,
103:         error: err instanceof Error ? err.message : 'Error desconocido',
104:         consecutiveErrors: prev.consecutiveErrors + 1,
105:         lastFetchedAt: prev.lastFetchedAt,
106:       }))
107:     }
108:   }, [tripId])
109: 
110:   // Derivado: pollear solo si la tab está visible Y el último status no es stale.
111:   // Un dispositivo stale (>48h) no va a reportar en los próximos 30s por definición;
112:   // tab oculta significa que nadie consume el dato. Los dos casos pausan requests.
113:   const isStaleStatus = state.data?.status === 'stale'
114:   const shouldPoll = isVisible && !isStaleStatus
115: 
116:   // Effect 1: mount/unmount tracking del ref. Corre UNA vez — separado del
117:   // polling effect porque ese re-corre en cada flip de shouldPoll y setearía
118:   // isUnmountedRef.current = true en cada pausa, rompiendo los setState de
119:   // los fetches in-flight.
120:   useEffect(() => {
121:     isUnmountedRef.current = false
122:     return () => {
123:       isUnmountedRef.current = true
124:     }
125:   }, [])
126: 
127:   // Effect 2: visibility listener — corre UNA vez.
128:   useEffect(() => {
129:     if (typeof document === 'undefined') return
130:     const handler = () => setIsVisible(document.visibilityState !== 'hidden')
131:     document.addEventListener('visibilitychange', handler)
132:     return () => document.removeEventListener('visibilitychange', handler)
133:   }, [])
134: 
135:   // Effect 3: polling. Re-corre cuando shouldPoll flippea (visibility o stale).
136:   // In-flight fetches al cleanup siguen vivos; el setState es idempotente con
137:   // el isUnmountedRef guard, y si el componente sigue montado el setState es
138:   // válido y actualiza state.data correctamente.
139:   useEffect(() => {
140:     if (!shouldPoll) return
141:     void fetchPosition()
142:     const id = window.setInterval(() => {
143:       setState((prev) => {
144:         if (prev.consecutiveErrors >= MAX_CONSECUTIVE_ERRORS) return prev
145:         void fetchPosition()
146:         return prev
147:       })
148:     }, POLL_INTERVAL_MS)
149:     return () => window.clearInterval(id)
150:   }, [shouldPoll, fetchPosition])
151: 
152:   // Effect 4: auto-follow. Cada vez que llega un fix nuevo Y el usuario no
153:   // interactuó con el mapa, pan suave hacia la nueva posición del vehículo.
154:   useEffect(() => {
155:     if (!state.data) return
156:     const pos =
157:       state.data.status === 'live' ? state.data.position
158:       : state.data.status === 'stale' ? state.data.lastReport
159:       : null
160:     if (!pos) return
161:     if (!Number.isFinite(pos.lat) || !Number.isFinite(pos.lon)) return
162:     if (pos.lat === 0 && pos.lon === 0) return
163:     if (pos.epoch === lastFollowedEpochRef.current) return
164:     lastFollowedEpochRef.current = pos.epoch
165:     if (userInteracted) return
166:     mapRef.current?.easeTo({ center: [pos.lon, pos.lat], duration: 500 })
167:   }, [state.data, userInteracted])
168: 
169:   // Handler del botón "Seguir vehículo". Definido antes de los early returns
170:   // para respetar las hooks rules (el número de hooks llamados tiene que ser
171:   // estable entre renders). Extrae la posición de state.data en tiempo del
172:   // click — no puede depender de `position` que se computa después.
173:   const handleRecenter = useCallback(() => {
174:     setUserInteracted(false)
175:     lastFollowedEpochRef.current = 0
176:     const data = state.data
177:     if (!data) return
178:     const p =
179:       data.status === 'live' ? data.position
180:       : data.status === 'stale' ? data.lastReport
181:       : null
182:     if (!p) return
183:     mapRef.current?.easeTo({ center: [p.lon, p.lat], duration: 500 })
184:   }, [state.data])
185: 
186:   // Condición de carrera — el parent debería haber filtrado estos estados.
187:   if (state.data?.status === 'not_in_route' || state.data?.status === 'pickup') {
188:     return null
189:   }
190: 
191:   // El vehículo no tiene GPS configurado.
192:   if (state.data?.status === 'no_gps') {
193:     return (
194:       <div className="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-iconsa-gray">
195:         Este vehículo no tiene GPS configurado.
196:       </div>
197:     )
198:   }
199: 
200:   // Error grave tras fallos consecutivos.
201:   if (state.error && state.consecutiveErrors >= MAX_CONSECUTIVE_ERRORS) {
202:     return (
203:       <div className="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 flex items-center justify-between gap-3">
204:         <span>No se pudo cargar la ubicación.</span>
205:         <button
206:           type="button"
207:           onClick={() => {
208:             setState((prev) => ({ ...prev, consecutiveErrors: 0, error: null }))
209:             void fetchPosition()
210:           }}
211:           className="rounded border border-red-300 bg-white px-3 py-1 text-xs font-medium text-red-700 hover:bg-red-100"
212:         >
213:           Reintentar
214:         </button>
215:       </div>
216:     )
217:   }
218: 
219:   // Estado de carga — el primer fetch aún no ha retornado.
220:   if (!state.data) {
221:     return (
222:       <div
223:         className={`${heightClass} rounded-lg border border-gray-200 bg-gray-50 flex items-center justify-center text-sm text-iconsa-gray`}
224:       >
225:         Cargando ubicación…
226:       </div>
227:     )
228:   }
229: 
230:   const isStale = state.data.status === 'stale'
231:   const position: VehiclePosition =
232:     state.data.status === 'live' ? state.data.position : state.data.lastReport
233: 
234:   // Guard: coordenadas inválidas (0/0, NaN, fuera de rango). Sucede con
235:   // devices sin fix GPS o recién instalados. No montamos el canvas porque
236:   // centraría el mapa en (0,0) — el Atlántico sur, gris uniforme. El
237:   // placeholder conserva la misma altura que el mapa para no colapsar layout.
238:   if (!isValidPosition(position)) {
239:     return (
240:       <div className="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
241:         <div
242:           className={`${heightClass} flex items-center justify-center bg-gray-50 text-sm text-iconsa-gray px-4 text-center`}
243:         >
244:           El dispositivo GPS no está reportando coordenadas válidas.
245:           {isStale && (
246:             <> Último reporte hace {formatHoursAgo(position.epoch)}.</>
247:           )}
248:         </div>
249:         {isStale && (
250:           <div className="border-t border-amber-200 bg-amber-50 px-4 py-2 text-xs text-amber-800 flex items-center justify-end">
251:             <button
252:               type="button"
253:               onClick={() => void fetchPosition()}
254:               className="rounded border border-amber-300 bg-white px-3 py-1 font-medium text-amber-800 hover:bg-amber-100"
255:             >
256:               Reactivar
257:             </button>
258:           </div>
259:         )}
260:       </div>
261:     )
262:   }
263: 
264:   return (
265:     <div className="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
266:       <div className={`${heightClass} relative`}>
267:         <Map
268:           ref={mapRef}
269:           mapLib={import('maplibre-gl')}
270:           mapStyle={TILE_STYLE_URL}
271:           initialViewState={{
272:             longitude: position.lon,
273:             latitude: position.lat,
274:             zoom: 13,
275:           }}
276:           // originalEvent es undefined cuando el movimiento es programático
277:           // (nuestros easeTo); defined cuando el usuario interactúa (pan/zoom/
278:           // rotate/pitch en mouse o touch). Usar onMoveStart en vez de
279:           // onDragStart+onZoomStart para no ensuciar el flag con easeTo propio.
280:           onMoveStart={(e) => {
281:             if (e.originalEvent) setUserInteracted(true)
282:           }}
283:           style={{ width: '100%', height: '100%' }}
284:         >
285:           <Marker longitude={position.lon} latitude={position.lat} anchor="center">
286:             <div
287:               title={position.place}
288:               style={{ transform: `rotate(${position.heading}deg)` }}
289:               className={`flex h-6 w-6 items-center justify-center rounded-full text-white shadow ${
290:                 isStale ? 'bg-gray-500' : 'bg-navy'
291:               }`}
292:             >
293:               ▲
294:             </div>
295:           </Marker>
296:         </Map>
297:         {userInteracted && (
298:           <button
299:             type="button"
300:             onClick={handleRecenter}
301:             title="Centrar en el vehículo y reanudar seguimiento"
302:             className="absolute top-2 right-2 flex items-center gap-1.5 rounded-md border border-gray-300 bg-white px-2 py-1.5 text-xs font-medium text-gray-700 shadow hover:bg-gray-50"
303:           >
304:             <Crosshair className="h-3.5 w-3.5" />
305:             {variant === 'full' && <span>Seguir vehículo</span>}
306:           </button>
307:         )}
308:       </div>
309:       {isStale ? (
310:         <div className="border-t border-amber-200 bg-amber-50 px-4 py-2 text-sm text-amber-800 flex items-center justify-between gap-3 flex-wrap">
311:           <span>
312:             Último reporte hace {formatHoursAgo(position.epoch)} — el dispositivo
313:             puede estar desconectado.
314:           </span>
315:           <button
316:             type="button"
317:             onClick={() => void fetchPosition()}
318:             className="shrink-0 rounded border border-amber-300 bg-white px-3 py-1 text-xs font-medium text-amber-800 hover:bg-amber-100"
319:           >
320:             Reactivar
321:           </button>
322:         </div>
323:       ) : (
324:         <div className="border-t border-gray-100 bg-white px-4 py-2 text-sm text-gray-700 flex items-center justify-between gap-2 flex-wrap">
325:           <span className="truncate">
326:             <span className="text-iconsa-gray">Ubicación:</span>{' '}
327:             {position.place || '—'}
328:           </span>
329:           <span className="shrink-0 text-iconsa-gray">
330:             {Math.round(position.speed)} km/h · {position.event} ·{' '}
331:             {formatAgoSeconds(position.epoch)}
332:           </span>
333:         </div>
334:       )}
335:     </div>
336:   )
337: }
</file>

<file path="src/components/programacion/ConfirmExternalOrderDeliveryModal.tsx">
