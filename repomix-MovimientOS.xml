<file path="src/hooks/useCostCodeCascade.ts">
  1: 'use client'
  2: 
  3: import { useState, useEffect, useMemo } from 'react'
  4: import { createClient } from '@/lib/supabase/client'
  5: import type { SelectOption } from '@/components/ui/Select'
  6: 
  7: export interface UseCostCodeCascadeReturn {
  8:   // Extras
  9:   extraOptions: SelectOption[]
 10:   hasExtras: boolean
 11:   selectedExtraId: string | null
 12:   setSelectedExtraId: (id: string | null) => void
 13:   loadingExtras: boolean
 14:   // Cost codes (filtrados por proyecto + extra)
 15:   costCodeOptions: SelectOption[]
 16:   loadingCostCodes: boolean
 17:   costCodeId: string | null
 18:   setCostCodeId: (id: string | null) => void
 19:   // Cost categories (filtrados via cost_code_categories por costCodeId)
 20:   categoryOptions: SelectOption[]
 21:   loadingCategories: boolean
 22:   costCategoryId: string | null
 23:   setCostCategoryId: (id: string | null) => void
 24: }
 25: 
 26: /**
 27:  * Cascada Proyecto → [Extra] → Fase → Categoría para selección de cost_code.
 28:  *
 29:  * - Si el proyecto tiene extras (project_extras), `hasExtras=true` y se debe
 30:  *   seleccionar uno antes de listar fases.
 31:  * - Si no, las fases se listan directamente filtrando por `project_id` y
 32:  *   `extra_id IS NULL`.
 33:  * - Categorías se listan desde `cost_code_categories` filtrado por `costCodeId`.
 34:  *
 35:  * Reset behavior:
 36:  * - Cambio de projectId → reset cost_code, category, extra, options
 37:  * - Cambio de costCodeId → reset category
 38:  *
 39:  * Si se provee `initialCostCodeId` y el proyecto tiene extras, detecta el
 40:  * extra correspondiente para hidratar `selectedExtraId` al editar.
 41:  */
 42: export function useCostCodeCascade(
 43:   projectId: string | null,
 44:   initialCostCodeId?: string | null,
 45:   initialCostCategoryId?: string | null,
 46: ): UseCostCodeCascadeReturn {
 47:   const supabase = useMemo(() => createClient(), [])
 48: 
 49:   // --- Estado público ---
 50:   const [extraOptions, setExtraOptions] = useState<SelectOption[]>([])
 51:   const [hasExtras, setHasExtras] = useState(false)
 52:   const [selectedExtraId, setSelectedExtraId] = useState<string | null>(null)
 53:   const [loadingExtras, setLoadingExtras] = useState(false)
 54: 
 55:   const [costCodeOptions, setCostCodeOptions] = useState<SelectOption[]>([])
 56:   const [loadingCostCodes, setLoadingCostCodes] = useState(false)
 57:   const [costCodeId, setCostCodeId] = useState<string | null>(initialCostCodeId ?? null)
 58: 
 59:   const [categoryOptions, setCategoryOptions] = useState<SelectOption[]>([])
 60:   const [loadingCategories, setLoadingCategories] = useState(false)
 61:   const [costCategoryId, setCostCategoryId] = useState<string | null>(initialCostCategoryId ?? null)
 62: 
 63:   // --- Reset cuando se pierde proyecto ---
 64:   useEffect(() => {
 65:     if (!projectId) {
 66:       setExtraOptions([])
 67:       setHasExtras(false)
 68:       setSelectedExtraId(null)
 69:       setCostCodeOptions([])
 70:       setCostCodeId(null)
 71:       setCategoryOptions([])
 72:       setCostCategoryId(null)
 73:     }
 74:   }, [projectId])
 75: 
 76:   // --- Fetch extras del proyecto ---
 77:   useEffect(() => {
 78:     if (!projectId) return
 79: 
 80:     let cancelled = false
 81:     setLoadingExtras(true)
 82: 
 83:     supabase
 84:       .from('project_extras')
 85:       .select('id, code, description')
 86:       .eq('project_id', projectId)
 87:       .eq('is_active', true)
 88:       .order('code')
 89:       .then(({ data }) => {
 90:         if (cancelled) return
 91:         const extras = data ?? []
 92:         if (extras.length > 0) {
 93:           setExtraOptions(extras.map((e) => ({
 94:             value: e.id,
 95:             label: `${e.code} — ${e.description ?? e.code}`,
 96:           })))
 97:           setHasExtras(true)
 98:           // Si NO estamos editando (sin initialCostCodeId), reset extra
 99:           if (!initialCostCodeId) {
100:             setSelectedExtraId(null)
101:           }
102:         } else {
103:           setExtraOptions([])
104:           setHasExtras(false)
105:           setSelectedExtraId(null)
106:         }
107:         setLoadingExtras(false)
108:       })
109: 
110:     return () => { cancelled = true }
111:   }, [projectId, supabase, initialCostCodeId])
112: 
113:   // --- Detectar extra del costCode inicial al editar ---
114:   useEffect(() => {
115:     if (!initialCostCodeId || !projectId || !hasExtras) return
116: 
117:     let cancelled = false
118:     supabase
119:       .from('cost_codes')
120:       .select('extra_id')
121:       .eq('id', initialCostCodeId)
122:       .single()
123:       .then(({ data }) => {
124:         if (cancelled) return
125:         if (data?.extra_id) {
126:           setSelectedExtraId(data.extra_id)
127:         } else {
128:           setSelectedExtraId('__base__')
129:         }
130:       })
131: 
132:     return () => { cancelled = true }
133:   }, [initialCostCodeId, projectId, hasExtras, supabase])
134: 
135:   // --- Fetch cost codes filtrados por proyecto + extra ---
136:   useEffect(() => {
137:     if (!projectId) {
138:       setCostCodeOptions([])
139:       return
140:     }
141: 
142:     if (hasExtras && selectedExtraId === null && !loadingExtras) {
143:       setCostCodeOptions([])
144:       return
145:     }
146: 
147:     if (loadingExtras) return
148: 
149:     let cancelled = false
150:     setLoadingCostCodes(true)
151: 
152:     const query = supabase
153:       .from('cost_codes')
154:       .select('id, phase_code, phase_description, full_code, extra_id')
155:       .eq('project_id', projectId)
156:       .order('full_code')
157: 
158:     const extraFilter = selectedExtraId === '__base__' ? null : selectedExtraId
159:     const finalQuery = extraFilter
160:       ? query.eq('extra_id', extraFilter)
161:       : query.is('extra_id', null)
162: 
163:     finalQuery.then(({ data }) => {
164:       if (cancelled) return
165:       const options: SelectOption[] = (data ?? []).map((cc) => ({
166:         value: cc.id,
167:         label: cc.full_code
168:           ? `${cc.full_code} — ${cc.phase_description ?? ''}`
169:           : `${cc.phase_code} — ${cc.phase_description ?? ''}`,
170:       }))
171:       setCostCodeOptions(options)
172: 
173:       if (costCodeId && !options.some((o) => o.value === costCodeId)) {
174:         setCostCodeId(null)
175:         setCostCategoryId(null)
176:       }
177:       setLoadingCostCodes(false)
178:     })
179: 
180:     return () => { cancelled = true }
181:     // eslint-disable-next-line react-hooks/exhaustive-deps
182:   }, [projectId, selectedExtraId, hasExtras, loadingExtras, supabase])
183: 
184:   // --- Fetch categorías cuando cambia costCodeId ---
185:   useEffect(() => {
186:     if (!costCodeId) {
187:       setCategoryOptions([])
188:       setCostCategoryId(null)
189:       return
190:     }
191: 
192:     let cancelled = false
193:     setLoadingCategories(true)
194: 
195:     supabase
196:       .from('cost_code_categories')
197:       .select('cost_category_id, cost_categories(id, code, description)')
198:       .eq('cost_code_id', costCodeId)
199:       .then(({ data }) => {
200:         if (cancelled) return
201:         const options: SelectOption[] = (data ?? [])
202:           .map((row) => {
203:             const rawCat = row.cost_categories as { id: string; code: string; description: string | null } | { id: string; code: string; description: string | null }[] | null
204:             const cat = Array.isArray(rawCat) ? rawCat[0] : rawCat
205:             if (!cat) return null
206:             return { value: cat.id, label: `${cat.code} — ${cat.description ?? cat.code}` }
207:           })
208:           .filter((opt): opt is SelectOption => opt !== null)
209:           .sort((a, b) => a.label.localeCompare(b.label))
210:         setCategoryOptions(options)
211: 
212:         if (costCategoryId && !options.some((o) => o.value === costCategoryId)) {
213:           setCostCategoryId(null)
214:         }
215:         setLoadingCategories(false)
216:       })
217: 
218:     return () => { cancelled = true }
219:     // eslint-disable-next-line react-hooks/exhaustive-deps
220:   }, [costCodeId, supabase])
221: 
222:   return {
223:     extraOptions,
224:     hasExtras,
225:     selectedExtraId,
226:     setSelectedExtraId,
227:     loadingExtras,
228:     costCodeOptions,
229:     loadingCostCodes,
230:     costCodeId,
231:     setCostCodeId,
232:     categoryOptions,
233:     loadingCategories,
234:     costCategoryId,
235:     setCostCategoryId,
236:   }
237: }
</file>

<file path="src/hooks/useMyTrips.ts">
