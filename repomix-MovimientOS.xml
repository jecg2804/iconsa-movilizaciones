 59: 
 60:   // Estado del formulario
 61:   const [tripData, setTripData] = useState<TripInput>({
 62:     scheduled_date: '',
 63:     scheduled_time: null,
 64:     driver_id: null,
 65:     vehicle_id: null,
 66:     trailer_id: null,
 67:     rate_id: null,
 68:     cost: null,
 69:     att_permit: false,
