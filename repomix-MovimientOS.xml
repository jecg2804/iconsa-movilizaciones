201:   }, [description, quantity, fromValue, toValue])
202: 
203:   // --- Guardar ---
204:   const handleSave = useCallback(async () => {
205:     if (!validate()) return
206: 
207:     const lineInput = buildLineInput()
208: 
209:     // Verificar duplicados si la funcion esta disponible
210:     if (onCheckDuplicates && !showDuplicateWarning) {
211:       setCheckingDuplicates(true)
212:       try {
213:         const found = await onCheckDuplicates(lineInput)
214:         if (found.length > 0) {
215:           setDuplicates(found)
216:           setShowDuplicateWarning(true)
217:           return
218:         }
219:       } finally {
220:         setCheckingDuplicates(false)
221:       }
222:     }
223: 
224:     onSave(lineInput)
225:   }, [validate, buildLineInput, onCheckDuplicates, showDuplicateWarning, onSave])
226: 
227:   // --- Continuar despues de warning de duplicados ---
228:   const handleDuplicateContinue = useCallback(() => {
229:     setShowDuplicateWarning(false)
230:     setDuplicates(null)
231:     const lineInput = buildLineInput()
232:     onSave(lineInput)
233:   }, [buildLineInput, onSave])
234: 
235:   const handleDuplicateCancel = useCallback(() => {
236:     setShowDuplicateWarning(false)
237:     setDuplicates(null)
238:   }, [])
239: 
240:   return (
241:     <div className="rounded-lg border border-gray-200 bg-gray-50 p-4 space-y-4">
242:       {/* Titulo */}
243:       <h3 className="text-sm font-semibold text-gray-900">
244:         {isEditing ? 'Editar Linea' : 'Agregar Linea'}
245:       </h3>
246: 
247:       {/* Toggle de tipo de linea */}
248:       <div className="flex gap-2">
249:         <button
250:           type="button"
251:           onClick={() => handleTypeChange('Equipo')}
252:           className={`
253:             flex flex-1 items-center justify-center gap-2 rounded-lg border-2 px-4 py-2.5 text-sm font-medium transition-colors
254:             ${
255:               lineType === 'Equipo'
256:                 ? 'border-navy bg-navy text-white'
257:                 : 'border-gray-300 bg-white text-gray-700 hover:bg-gray-50'
258:             }
259:           `}
260:         >
261:           <Wrench className="h-4 w-4" />
262:           Equipo
263:         </button>
264:         <button
265:           type="button"
266:           onClick={() => handleTypeChange('Material')}
267:           className={`
268:             flex flex-1 items-center justify-center gap-2 rounded-lg border-2 px-4 py-2.5 text-sm font-medium transition-colors
269:             ${
270:               lineType === 'Material'
271:                 ? 'border-gold bg-gold text-white'
272:                 : 'border-gray-300 bg-white text-gray-700 hover:bg-gray-50'
273:             }
274:           `}
275:         >
276:           <Package className="h-4 w-4" />
277:           Material
278:         </button>
279:       </div>
280: 
281:       {/* Campos del formulario */}
282:       <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
283:         {/* Campos especificos segun tipo */}
284:         {lineType === 'Equipo' ? (
285:           <>
286:             <SelectWithFallback
287:               label="Equipo"
288:               placeholder="Buscar equipo..."
289:               options={equipment}
290:               value={equipmentValue}
291:               onChange={setEquipmentValue}
292:               fallbackLabel="No esta en la lista"
293:               fallbackPlaceholder="Escriba el nombre del equipo..."
294:             />
295:             <Input
296:               label="Descripcion"
297:               value={description}
298:               onChange={(e) => setDescription(e.target.value)}
299:               placeholder="Se rellena al seleccionar equipo"
300:               error={errors.description}
301:             />
302:           </>
303:         ) : (
304:           <>
305:             <div className="md:col-span-2">
306:               <Input
307:                 label="Descripcion del material"
308:                 value={description}
309:                 onChange={(e) => setDescription(e.target.value)}
310:                 placeholder="Describa el material a movilizar..."
311:                 error={errors.description}
312:               />
313:             </div>
314:             <div className="md:col-span-2">
315:               <Input
316:                 label="Categoria de Material"
317:                 value={materialCategory ?? ''}
318:                 onChange={(e) => setMaterialCategory(e.target.value || null)}
319:                 placeholder="Ej: Agregados, Acero, Electrico, Plomeria..."
320:               />
321:             </div>
322:           </>
323:         )}
324: 
325:         {/* Campos comunes */}
326:         <SelectWithFallback
327:           label="Desde"
328:           placeholder="Seleccionar origen..."
329:           options={locations}
330:           value={fromValue}
331:           onChange={setFromValue}
332:           error={errors.from}
333:           fallbackLabel="No esta en la lista"
334:           fallbackPlaceholder="Escriba la ubicacion de origen..."
335:         />
336: 
337:         <SelectWithFallback
338:           label="Hasta"
339:           placeholder="Seleccionar destino..."
340:           options={locations}
341:           value={toValue}
342:           onChange={setToValue}
343:           error={errors.to}
344:           fallbackLabel="No esta en la lista"
345:           fallbackPlaceholder="Escriba la ubicacion de destino..."
346:         />
347: 
348:         <Input
349:           label="Cantidad"
350:           type="number"
351:           min="1"
352:           step="1"
353:           value={quantity}
354:           onChange={(e) => setQuantity(e.target.value)}
355:           error={errors.quantity}
356:         />
357: 
358:         <SelectWithFallback
359:           label="Unidad"
360:           placeholder="Seleccionar unidad..."
361:           options={units}
362:           value={unitValue}
363:           onChange={setUnitValue}
364:           fallbackLabel="No esta en la lista"
365:           fallbackPlaceholder="Escriba la unidad..."
366:         />
367: 
368:         {/* Cost code / category eliminados — ahora viven en SolicitudForm header (Cambio 2) */}
369: 
370:         <Input
371:           label="Referencia OC"
372:           value={poReference}
373:           onChange={(e) => setPoReference(e.target.value)}
374:           placeholder="Orden de compra (opcional)"
375:         />
376: 
377:         <div className="md:col-span-2">
378:           <label
379:             htmlFor="line-notes"
380:             className="mb-1 block text-sm font-medium text-gray-700"
381:           >
382:             Notas de linea
383:           </label>
384:           <textarea
385:             id="line-notes"
386:             value={lineNotes}
387:             onChange={(e) => setLineNotes(e.target.value)}
388:             placeholder="Observaciones sobre esta linea (opcional)"
389:             rows={2}
390:             className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue disabled:bg-gray-50 disabled:text-gray-500"
391:           />
392:         </div>
393:       </div>
394: 
395:       {/* Códigos de confirmación siempre obligatorios (decisión 2026-04-16) */}
396: 
397:       {/* Warning de duplicados */}
398:       {showDuplicateWarning && duplicates && duplicates.length > 0 && (
399:         <DuplicateWarning
400:           matches={duplicates}
401:           onContinue={handleDuplicateContinue}
402:           onCancel={handleDuplicateCancel}
403:         />
404:       )}
405: 
406:       {/* Botones de accion */}
407:       <div className="flex items-center justify-end gap-3 border-t border-gray-200 pt-4">
