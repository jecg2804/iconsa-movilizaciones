 45:     await onConfirm({
 46:       receivedById: receiver.id,
 47:       receivedByName: (receiver.text ?? '').trim(),
 48:       notes: notes.trim(),
 49:       additionalAttachments,
 50:     })
 51:   }, [confirmed, receiver, notes, additionalAttachments, onConfirm])
 52: 
 53:   return (
 54:     <div className="fixed inset-0 z-50 flex items-end justify-center bg-black/50 p-4 sm:items-center">
 55:       <div className="w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-t-2xl bg-white p-4 shadow-xl sm:rounded-2xl sm:p-6">
 56:         <h3 className="mb-4 text-lg font-semibold text-gray-900">
 57:           Confirmar entrega pickup {order.pickup_id}
 58:         </h3>
 59: 
 60:         <div className="mb-4 rounded-lg border border-amber-200 bg-amber-50 p-3 space-y-1">
 61:           <p className="text-xs font-semibold text-amber-900 mb-2">
 62:             {order.lines.length} {order.lines.length === 1 ? 'línea' : 'líneas'} a entregar:
 63:           </p>
 64:           {order.lines.map((ol) => {
 65:             if (!ol.line) return null
 66:             const isEquipo = ol.line.line_type === 'Equipo'
 67:             const unitCode = ol.line.unit?.code ?? ol.line.unit_text ?? ''
 68:             return (
 69:               <div key={ol.id} className="flex items-center gap-2 text-sm">
 70:                 {isEquipo ? <Wrench className="h-3.5 w-3.5 text-iconsa-blue" /> : <Package className="h-3.5 w-3.5 text-gold" />}
 71:                 <span className="font-medium text-gray-900">{ol.line.description}</span>
 72:                 <span className="text-gray-300">·</span>
 73:                 <span className="font-semibold text-gray-700 whitespace-nowrap">
 74:                   {formatQty(ol.quantity_assigned)} {unitCode}
 75:                 </span>
 76:               </div>
 77:             )
 78:           })}
 79:         </div>
 80: 
 81:         <div className="space-y-4">
 82:           <label className="flex items-start gap-2 cursor-pointer">
 83:             <input
 84:               type="checkbox"
 85:               checked={confirmed}
 86:               onChange={(e) => setConfirmed(e.target.checked)}
 87:               disabled={loading}
 88:               className="mt-0.5 rounded border-gray-300 text-navy focus:ring-navy"
 89:             />
 90:             <span className="text-sm text-gray-700">
 91:               Confirmo que las {order.lines.length} líneas fueron entregadas. <span className="text-red-600">*</span>
 92:             </span>
 93:           </label>
 94: 
 95:           <SelectWithFallback
 96:             label="Receptor (opcional)"
 97:             placeholder="Seleccionar persona..."
 98:             options={receiverOptions}
 99:             value={receiver}
100:             onChange={setReceiver}
101:             fallbackPlaceholder="Escribir nombre del receptor"
102:           />
103: 
104:           <div>
105:             <label htmlFor="confirm-pickup-notes" className="mb-1 block text-sm font-medium text-gray-700">
106:               Notas adicionales (opcional)
107:             </label>
108:             <textarea
109:               id="confirm-pickup-notes"
110:               value={notes}
111:               onChange={(e) => setNotes(e.target.value)}
112:               placeholder="Observaciones de la entrega..."
113:               rows={2}
114:               maxLength={500}
115:               className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
116:             />
117:           </div>
118: 
119:           <FileUploader
120:             attachments={additionalAttachments}
121:             folder={folderId}
122:             onChange={setAdditionalAttachments}
123:             label="Foto adicional (opcional)"
124:             hint="Se agrega a las attachments existentes del order (max 10MB)"
125:           />
126: 
127:           {error && <p className="text-sm text-red-600">{error}</p>}
128: 
129:           <div className="flex gap-2 pt-2">
130:             <Button variant="primary" onClick={handleSubmit} loading={loading} disabled={!canConfirm}>
131:               Confirmar entrega
132:             </Button>
133:             <Button variant="ghost" onClick={onClose} disabled={loading}>
134:               Cancelar
135:             </Button>
136:           </div>
137:         </div>
138:       </div>
139:     </div>
140:   )
141: }
