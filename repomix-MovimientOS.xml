  3: import { useState, useEffect, useCallback, useRef } from 'react'
  4: import { Select, type SelectOption } from '@/components/ui/Select'
  5: import { Input } from '@/components/ui/Input'
  6: import { Badge } from '@/components/ui/Badge'
  7: import FileUploader from '@/components/ui/FileUploader'
  8: import FileDisplay from '@/components/ui/FileDisplay'
  9: import { formatDate, formatDateTime, formatDaysUntilDue, daysUntilDue, daysUntilDueColor, formatCompletionDelta } from '@/lib/utils/format'
 10: import type { SolicitudInput } from '@/hooks/useSolicitudes'
 11: import { useCostCodeCascade } from '@/hooks/useCostCodeCascade'
 12: import type { Attachment } from '@/lib/supabase/storage'
 13: 
 14: type FormMode = 'create' | 'edit' | 'readonly'
 15: 
 16: interface SolicitudFormProps {
 17:   mode: FormMode
 18:   initialData?: {
 19:     requestId?: string | null
 20:     projectId: string
 21:     requesterId: string
 22:     approvedBy: string | null
 23:     dateRequired: string
 24:     dateCreated?: string
 25:     notes: string | null
 26:     status: string
 27:     priority: string | null
 28:     dateSubmitted?: string | null
 29:     dateCompleted?: string | null
 30:     dateCancelled?: string | null
 31:     costCodeId?: string | null
 32:     costCategoryId?: string | null
 33:   }
 34:   /** Proyectos disponibles para el dropdown (para PM, solo sus proyectos asignados) */
 35:   projects: SelectOption[]
 36:   /** Personas disponibles para el dropdown de solicitante */
 37:   people: SelectOption[]
 38:   /** Personas disponibles para el dropdown "Aprobado por". Si no se provee, usa people. */
 39:   approvers?: SelectOption[]
 40:   /** Callback cada vez que cambian los datos del header */
 41:   onChange: (data: SolicitudInput) => void
 42:   /** ID de la persona actualmente logueada (auto-rellena solicitante en modo creacion) */
 43:   currentPersonId: string
 44:   /** Rol del usuario logueado — admin puede editar solicitante */
 45:   role?: string | null
 46:   /** UUID de la solicitud (para folder de storage). En modo crear se genera uno temporal. */
 47:   solicitudId?: string
 48:   /** Adjuntos iniciales de la solicitud */
 49:   initialAttachments?: Attachment[]
 50: }
 51: 
 52: function SolicitudForm({
 53:   mode,
 54:   initialData,
 55:   projects,
 56:   people,
 57:   approvers,
 58:   onChange,
 59:   currentPersonId,
 60:   role,
 61:   solicitudId,
 62:   initialAttachments,
 63: }: SolicitudFormProps) {
 64:   const approverOptions = approvers ?? people
 65:   const isReadonly = mode === 'readonly'
 66: 
 67:   // --- Estado interno del formulario ---
 68:   const [projectId, setProjectId] = useState<string>(
 69:     initialData?.projectId ?? '',
 70:   )
 71:   const [requesterId, setRequesterId] = useState<string>(
 72:     initialData?.requesterId ?? currentPersonId,
 73:   )
 74:   const [approvedBy, setApprovedBy] = useState<string | null>(
 75:     initialData?.approvedBy ?? null,
 76:   )
 77:   const [dateRequired, setDateRequired] = useState<string>(
 78:     initialData?.dateRequired ?? '',
 79:   )
 80:   const [notes, setNotes] = useState<string>(initialData?.notes ?? '')
 81:   const [attachments, setAttachments] = useState<Attachment[]>(initialAttachments ?? [])
 82:   // UUID estable para folder de storage (en modo crear, genera uno temporal)
 83:   const folderIdRef = useRef(solicitudId ?? crypto.randomUUID())
 84: 
 85:   // Cascada cost_code header (Cambio 2): Proyecto → [Extra] → Fase → Categoría
 86:   const cascade = useCostCodeCascade(
 87:     projectId || null,
 88:     initialData?.costCodeId ?? null,
 89:     initialData?.costCategoryId ?? null,
 90:   )
 91: 
 92:   // --- Propagar cambios al padre ---
 93:   const propagate = useCallback(
 94:     (overrides?: Partial<SolicitudInput>) => {
 95:       const data: SolicitudInput = {
 96:         project_id: overrides?.project_id ?? projectId,
 97:         requester_id: overrides?.requester_id ?? requesterId,
 98:         approved_by: overrides?.approved_by !== undefined ? overrides.approved_by : approvedBy,
 99:         date_required: overrides?.date_required ?? dateRequired,
100:         notes: overrides?.notes !== undefined ? overrides.notes : notes || null,
101:         attachments: overrides?.attachments !== undefined ? overrides.attachments : attachments,
102:         cost_code_id: overrides?.cost_code_id !== undefined ? overrides.cost_code_id : cascade.costCodeId,
103:         cost_category_id: overrides?.cost_category_id !== undefined ? overrides.cost_category_id : cascade.costCategoryId,
104:       }
105:       onChange(data)
106:     },
107:     [projectId, requesterId, approvedBy, dateRequired, notes, attachments, cascade.costCodeId, cascade.costCategoryId, onChange],
108:   )
109: 
110:   // Propagar el estado inicial al montar
111:   useEffect(() => {
112:     propagate()
113:     // Solo en el montaje inicial
114:     // eslint-disable-next-line react-hooks/exhaustive-deps
115:   }, [])
116: 
117:   // Propagar cuando cambia cost_code/category (cascada interna del hook)
118:   useEffect(() => {
119:     propagate()
120:     // eslint-disable-next-line react-hooks/exhaustive-deps
121:   }, [cascade.costCodeId, cascade.costCategoryId])
122: 
123:   // --- Handlers de cambio ---
124:   const handleProjectChange = useCallback(
125:     (value: string | null) => {
126:       const newVal = value ?? ''
127:       setProjectId(newVal)
128:       propagate({ project_id: newVal })
129:     },
130:     [propagate],
131:   )
132: 
133:   const handleApprovedByChange = useCallback(
134:     (value: string | null) => {
135:       setApprovedBy(value)
136:       propagate({ approved_by: value })
137:     },
138:     [propagate],
139:   )
140: 
141:   const handleDateChange = useCallback(
142:     (e: React.ChangeEvent<HTMLInputElement>) => {
143:       const newVal = e.target.value
144:       setDateRequired(newVal)
145:       propagate({ date_required: newVal })
146:     },
147:     [propagate],
148:   )
149: 
150:   const handleNotesChange = useCallback(
151:     (e: React.ChangeEvent<HTMLTextAreaElement>) => {
152:       const newVal = e.target.value
153:       setNotes(newVal)
154:       propagate({ notes: newVal || null })
155:     },
156:     [propagate],
157:   )
158: 
159:   // Datos de visualizacion
160:   const requestId = initialData?.requestId
161:   const status = initialData?.status
162:   const isCancelled = status === 'Cancelada'
163:   const isCompleted = status === 'Completada'
164:   const isTerminal = isCancelled || isCompleted
165: 
166:   // Delta de completación (solo para Completada)
167:   const completionDelta = isCompleted && dateRequired && initialData?.dateCompleted
168:     ? formatCompletionDelta(dateRequired, initialData.dateCompleted)
169:     : null
170: 
171:   return (
172:     <div className="space-y-4">
173:       {/* Barra de identificacion */}
174:       <div className="flex flex-col gap-2 rounded-lg bg-gray-100 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
175:         <div>
176:           {requestId ? (
177:             <span className="text-lg font-bold font-mono text-navy">
178:               {requestId}
179:             </span>
180:           ) : (
181:             <span className="text-sm italic text-iconsa-gray">
182:               Se generara al guardar
183:             </span>
184:           )}
185:         </div>
186:         {(status || dateRequired) && (
187:           <div className="flex items-center gap-2">
188:             {status && <Badge variant="status" label={status} />}
189:             {completionDelta ? (
190:               <span className={`text-xs font-medium ${completionDelta.color}`}>
191:                 {completionDelta.text}
192:               </span>
193:             ) : !isTerminal && dateRequired ? (
194:               <span className={`text-xs font-medium ${daysUntilDueColor(daysUntilDue(dateRequired))}`}>
195:                 {formatDaysUntilDue(dateRequired)}
196:               </span>
197:             ) : null}
198:           </div>
199:         )}
200:       </div>
201: 
202:       {/* Campos del header */}
203:       <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
204:         <Select
205:           label="Proyecto"
206:           placeholder="Seleccionar proyecto..."
207:           options={projects}
208:           value={projectId || null}
209:           onChange={handleProjectChange}
210:           disabled={isReadonly}
211:           searchable
212:         />
213: 
214:         {/* Solicitante — editable solo para admin */}
215:         {role === 'admin' ? (
216:           <Select
217:             label="Solicitante"
218:             placeholder="Seleccionar solicitante..."
219:             options={people}
220:             value={requesterId}
221:             onChange={(val) => {
222:               setRequesterId(val ?? '')
223:               propagate({ requester_id: val ?? '' })
224:             }}
225:             disabled={isReadonly}
226:             searchable
227:           />
228:         ) : (
229:           <div>
230:             <label className="mb-1 block text-sm font-medium text-gray-700">
231:               Solicitante
232:             </label>
233:             <div className="rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-700">
234:               {people.find((p) => p.value === requesterId)?.label ?? '—'}
235:             </div>
236:           </div>
237:         )}
238: 
239:         <Select
240:           label="Aprobado por"
241:           placeholder="Seleccionar (opcional)..."
242:           options={approverOptions}
243:           value={approvedBy}
244:           onChange={handleApprovedByChange}
245:           disabled={isReadonly}
246:           searchable
247:         />
248: 
249:         <Input
250:           label="Fecha Requerida"
251:           type="date"
252:           value={dateRequired}
253:           onChange={handleDateChange}
254:           disabled={isReadonly}
255:         />
256: 
257:         {/* Cost code header — cascada Proyecto → [Extra] → Fase → Categoría (Cambio 2) */}
258:         {cascade.hasExtras && (
259:           <Select
260:             label="Extra / Sección *"
261:             placeholder={cascade.loadingExtras ? 'Cargando...' : 'Seleccionar extra...'}
262:             options={[
263:               { value: '__base__', label: '(Proyecto Base)' },
264:               ...cascade.extraOptions,
265:             ]}
266:             value={cascade.selectedExtraId}
267:             onChange={(val) => cascade.setSelectedExtraId(val)}
268:             disabled={isReadonly || cascade.loadingExtras}
269:           />
270:         )}
271: 
272:         <Select
273:           label="Fase / Código de Costo *"
274:           placeholder={
275:             cascade.loadingCostCodes
276:               ? 'Cargando...'
277:               : cascade.hasExtras && !cascade.selectedExtraId
278:                 ? 'Seleccione un extra primero'
279:                 : 'Seleccionar fase...'
280:           }
281:           options={cascade.costCodeOptions}
282:           value={cascade.costCodeId}
283:           onChange={(val) => cascade.setCostCodeId(val)}
284:           disabled={isReadonly || cascade.loadingCostCodes || (cascade.hasExtras && !cascade.selectedExtraId)}
285:           searchable
286:         />
287: 
288:         <Select
289:           label="Categoría de Costo *"
290:           placeholder={
291:             cascade.loadingCategories
292:               ? 'Cargando...'
293:               : cascade.costCodeId
294:                 ? 'Seleccionar categoría...'
295:                 : 'Seleccione una fase primero'
296:           }
297:           options={cascade.categoryOptions}
298:           value={cascade.costCategoryId}
299:           onChange={(val) => cascade.setCostCategoryId(val)}
300:           disabled={isReadonly || !cascade.costCodeId || cascade.loadingCategories}
301:         />
302: 
303:         {/* Lifecycle timestamps */}
304:         {initialData?.dateCreated && (
305:           <div>
306:             <label className="mb-1 block text-sm font-medium text-gray-700">
307:               Fechas del Ciclo
308:             </label>
309:             <div className="flex flex-wrap gap-2 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2">
310:               <span className="inline-flex items-center gap-1 rounded-full bg-gray-200 px-2 py-0.5 text-xs text-gray-700">
311:                 Creada: {formatDate(initialData.dateCreated)}
312:               </span>
313:               {initialData.dateSubmitted && (
314:                 <span className="inline-flex items-center gap-1 rounded-full bg-blue-100 px-2 py-0.5 text-xs text-iconsa-blue">
315:                   Enviada: {formatDateTime(initialData.dateSubmitted)}
316:                 </span>
317:               )}
318:               {initialData.dateCompleted && (
319:                 <span className="inline-flex items-center gap-1 rounded-full bg-green-100 px-2 py-0.5 text-xs text-iconsa-green">
320:                   Completada: {formatDateTime(initialData.dateCompleted)}
321:                 </span>
322:               )}
323:               {initialData.dateCancelled && (
324:                 <span className="inline-flex items-center gap-1 rounded-full bg-red-100 px-2 py-0.5 text-xs text-iconsa-red">
325:                   Cancelada: {formatDateTime(initialData.dateCancelled)}
326:                 </span>
327:               )}
328:             </div>
329:           </div>
330:         )}
331: 
332:         {/* Notas — full width */}
333:         <div className="md:col-span-2">
334:           <label
335:             htmlFor="solicitud-notes"
336:             className="mb-1 block text-sm font-medium text-gray-700"
337:           >
338:             Notas
339:           </label>
340:           <textarea
341:             id="solicitud-notes"
342:             value={notes}
343:             onChange={handleNotesChange}
344:             disabled={isReadonly}
345:             placeholder="Observaciones generales sobre la solicitud (opcional)"
346:             rows={3}
347:             className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue disabled:bg-gray-50 disabled:text-gray-500"
348:           />
349:         </div>
350:       </div>
351: 
352:       {/* Adjuntos */}
353:       {isReadonly ? (
354:         <FileDisplay attachments={attachments} />
355:       ) : (
356:         <FileUploader
357:           attachments={attachments}
358:           folder={`requests/${folderIdRef.current}`}
359:           onChange={(files) => {
360:             setAttachments(files)
361:             propagate({ attachments: files })
362:           }}
363:         />
364:       )}
365:     </div>
366:   )
367: }
368: 
369: export { SolicitudForm }
370: export type { SolicitudFormProps, FormMode }
</file>

<file path="src/components/viajes/EventTimeline.tsx">
