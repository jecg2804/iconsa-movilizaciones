 38: 
 39: export function DispatchModal({ trip, onConfirm, onClose, loading, role }: DispatchModalProps) {
 40:   // --- ALL hooks at top, before any conditionals ---
 41:   // Solo logística/admin editan vehículo, conductor, líneas y cantidades al despachar.
 42:   // Conductores (campo) solo confirman lo pre-programado.
 43:   const canEdit = role === 'logistica' || role === 'admin'
 44:   const supabase = useMemo(() => createClient(), [])
 45:   const { vehicles: rawVehicles, trailers: rawTrailers, loading: vehiclesLoading } = useVehicles()
 46: 
 47:   // UUID estable del evento — mismo valor para retries del mismo modal (idempotencia)
 48:   const eventIdRef = useRef<string>(crypto.randomUUID())
 49: 
 50:   const [driverId, setDriverId] = useState<string | null>(trip.driver?.id ?? null)
 51:   const [vehicleId, setVehicleId] = useState<string | null>(trip.vehicle?.id ?? null)
 52:   const [trailerId, setTrailerId] = useState<string | null>(trip.trailer?.id ?? null)
 53:   const [notes, setNotes] = useState('')
 54:   const [drivers, setDrivers] = useState<Array<{ id: string; name: string }>>([])
 55:   const [driversLoading, setDriversLoading] = useState(true)
 56:   const [lines, setLines] = useState<LineState[]>([])
 57: 
 58:   // Inicializar líneas desde assignments del viaje
 59:   useEffect(() => {
 60:     const initial: LineState[] = trip.assignments.map((a) => ({
 61:       request_line_id: a.request_line_id,
 62:       checked: true,
 63:       qty: a.quantity_assigned,
 64:       maxQty: a.quantity_assigned,
 65:       description: a.line?.description ?? 'Línea',
 66:       unitCode: a.line?.unit?.code ?? '',
 67:       lineType: a.line?.line_type ?? 'Equipo',
 68:     }))
 69:     setLines(initial)
 70:   }, [trip.assignments])
 71: 
 72:   // Fetch conductores (campo + logistica)
 73:   useEffect(() => {
 74:     async function fetchDrivers() {
 75:       setDriversLoading(true)
 76:       const { data } = await supabase
 77:         .from('people')
 78:         .select('id, name')
 79:         .eq('status', 'Activo')
 80:         .eq('app_role', 'campo')
 81:         .order('name')
 82:       setDrivers(data ?? [])
 83:       setDriversLoading(false)
 84:     }
 85:     fetchDrivers()
 86:   }, [supabase])
 87: 
 88:   // Opciones para dropdowns
 89:   const driverOptions: SelectOption[] = useMemo(
