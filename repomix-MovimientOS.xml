 608:       }
 609:       if (filters.conductorId) {
 610:         query = query.eq('driver_id', filters.conductorId)
 611:       }
 612:       if (filters.search) {
 613:         query = query.ilike('trip_id', `%${filters.search}%`)
 614:       }
 615: 
 616:       // Paginación server-side
 617:       const from = filters.page * filters.pageSize
 618:       const to = from + filters.pageSize - 1
 619:       query = query.range(from, to)
 620: 
 621:       const { data, error, count } = await query
 622: 
 623:       if (error) {
 624:         setListError(error.message)
 625:         return
 626:       }
 627: 
 628:       const mapped: TripWithRelations[] = (data ?? []).map((row) =>
 629:         mapTripRow(row as unknown as Record<string, unknown>),
 630:       )
 631: 
 632:       setTripsTotalCount(count ?? 0)
 633:       setTrips(mapped)
 634:     } catch (err) {
 635:       const message = err instanceof Error ? err.message : 'Error al cargar viajes'
 636:       setListError(message)
 637:     } finally {
 638:       setListLoading(false)
 639:     }
 640:   }, [supabase, filters])
