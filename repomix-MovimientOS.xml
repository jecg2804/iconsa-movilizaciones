 748:   // --- Crear viaje nuevo con asignaciones ---
 749:   const saveTrip = useCallback(
 750:     async (
 751:       input: TripInput,
 752:       assignments: AssignmentInput[],
 753:       personId?: string,
 754:     ): Promise<{ id: string; tripId: string | null } | null> => {
 755:       if (busyRef.current) return null
 756:       busyRef.current = true
 757:       setSaving(true)
 758:       setSaveError(null)
 759: 
 760:       // Guard server-side: scheduled_date no puede ser en el pasado.
 761:       // El input HTML min={today} ya lo bloquea en UI, pero un user puede
 762:       // bypassarlo editando el DOM.
 763:       if (input.scheduled_date < todayStrInPanama()) {
 764:         setSaveError('La fecha programada no puede ser en el pasado')
 765:         busyRef.current = false
 766:         setSaving(false)
 767:         return null
 768:       }
 769: 
 770:       // Cambio 6: tarifa obligatoria (BD trips.rate_id NOT NULL).
 771:       // Defense-in-depth pre-INSERT — frontend valida primero pero la BD es
 772:       // la fuente de verdad. Sin este guard, TypeScript correctamente rechaza
 773:       // el insert porque Insert.rate_id ahora es required (no nullable).
 774:       if (!input.rate_id) {
 775:         setSaveError('La tarifa es obligatoria.')
 776:         busyRef.current = false
 777:         setSaving(false)
 778:         return null
 779:       }
 780:       if (input.cost == null || input.cost <= 0) {
 781:         setSaveError('El costo debe ser mayor a cero.')
 782:         busyRef.current = false
 783:         setSaving(false)
 784:         return null
 785:       }
 786: 
 787:       try {
 788:         // 1. Insertar el viaje. Los triggers BD asignan trip_id y
 789:         //    confirmation_code (generate_confirmation_code). No generamos
 790:         //    el código en cliente para evitar doble-generación.
 791:         const { data: insertedTrip, error: tripError } = await supabase
 792:           .from('trips')
 793:           .insert({
 794:             scheduled_date: input.scheduled_date,
 795:             scheduled_time: input.scheduled_time ?? null,
 796:             driver_id: input.driver_id,
 797:             vehicle_id: input.vehicle_id,
 798:             trailer_id: input.trailer_id,
 799:             rate_id: input.rate_id,
 800:             cost: input.cost,
 801:             att_permit: input.att_permit,
 802:             escort: input.escort,
 803:             notes: input.notes,
 804:             attachments: JSON.parse(JSON.stringify(input.attachments ?? [])),
 805:             created_by: personId ?? null,
 806:           })
 807:           .select('id, trip_id')
 808:           .single()
 809: 
 810:         if (tripError || !insertedTrip) {
 811:           setSaveError(tripError?.message ?? 'Error al crear el viaje')
 812:           return null
 813:         }
 814: 
 815:         const newTripId = insertedTrip.id
 816: 
 817:         // 2. Insertar asignaciones de líneas al viaje
 818:         if (assignments.length > 0) {
 819:           const assignmentRows = assignments.map((a) => ({
 820:             trip_id: newTripId,
 821:             request_line_id: a.request_line_id,
 822:             quantity_assigned: a.quantity_assigned,
 823:           }))
 824: 
 825:           const { error: assignError } = await supabase
 826:             .from('trip_line_assignments')
 827:             .insert(assignmentRows)
 828: 
 829:           if (assignError) {
 830:             // Limpiar viaje huérfano para no dejar datos inconsistentes
 831:             await supabase.from('trips').delete().eq('id', newTripId)
 832:             setSaveError(`Error al asignar líneas: ${assignError.message}`)
 833:             return null
 834:           }
 835: 
 836:           // El trigger BD recalc_qty_for_line se dispara automáticamente
 837:           // al insertar trip_line_assignments y reconcilia qty_scheduled
 838:           // y status='Programada' en sm_request_lines.
 839:         }
 840: 
 841:         // Re-fetch para obtener el trip_id auto-generado por el trigger
 842:         const { data: refreshed } = await supabase
 843:           .from('trips')
 844:           .select('trip_id')
 845:           .eq('id', newTripId)
 846:           .single()
 847: 
 848:         // Notificaciones: líneas programadas a PMs + viaje asignado a conductor
 849:         const { data: lineRequests } = await supabase
 850:           .from('sm_request_lines')
 851:           .select('request_id')
 852:           .in('id', assignments.map(a => a.request_line_id))
 853: 
 854:         const uniqueRequestIds = [...new Set((lineRequests ?? []).map(l => l.request_id))]
 855:         for (const reqId of uniqueRequestIds) {
 856:           notifyLineasProgramadas(newTripId, reqId).catch(console.error)
 857:         }
 858:         notifyViajeAsignadoConductor(newTripId).catch(console.error)
 859: 
 860:         return {
 861:           id: newTripId,
 862:           tripId: refreshed?.trip_id ?? null,
 863:         }
 864:       } catch (err) {
 865:         const message = err instanceof Error ? err.message : 'Error inesperado al guardar viaje'
 866:         setSaveError(message)
 867:         return null
 868:       } finally {
 869:         busyRef.current = false
 870:         setSaving(false)
 871:       }
 872:     },
 873:     [supabase],
 874:   )
 875: 
 876:   // --- Actualizar viaje existente ---
 877:   const updateTrip = useCallback(
 878:     async (
 879:       id: string,
 880:       input: TripInput,
 881:       addAssignments: AssignmentInput[],
 882:       removeAssignmentIds: string[],
 883:       personId?: string,
 884:       modifiedAssignments?: ModifiedAssignment[],
 885:     ): Promise<boolean> => {
 886:       if (busyRef.current) return false
 887:       busyRef.current = true
 888:       setSaving(true)
 889:       setSaveError(null)
 890: 
 891:       // Cambio 6: tarifa obligatoria (BD trips.rate_id NOT NULL).
 892:       if (!input.rate_id) {
 893:         setSaveError('La tarifa es obligatoria.')
 894:         busyRef.current = false
 895:         setSaving(false)
 896:         return false
 897:       }
 898:       if (input.cost == null || input.cost <= 0) {
 899:         setSaveError('El costo debe ser mayor a cero.')
 900:         busyRef.current = false
 901:         setSaving(false)
 902:         return false
 903:       }
 904: 
 905:       try {
 906:         // 1. Actualizar los campos del viaje
 907:         const { error: updateError } = await supabase
 908:           .from('trips')
 909:           .update({
 910:             scheduled_date: input.scheduled_date,
 911:             scheduled_time: input.scheduled_time ?? null,
 912:             driver_id: input.driver_id,
 913:             vehicle_id: input.vehicle_id,
 914:             trailer_id: input.trailer_id,
 915:             rate_id: input.rate_id,
 916:             cost: input.cost,
 917:             att_permit: input.att_permit,
 918:             escort: input.escort,
 919:             notes: input.notes,
 920:             attachments: JSON.parse(JSON.stringify(input.attachments ?? [])),
 921:             updated_by: personId ?? null,
 922:           })
 923:           .eq('id', id)
 924: 
 925:         if (updateError) {
 926:           setSaveError(updateError.message)
 927:           return false
 928:         }
 929: 
 930:         // 2. Eliminar asignaciones removidas. El trigger BD recalc_qty_for_line
 931:         //    se dispara en DELETE y reconcilia qty_scheduled + status de la línea.
 932:         if (removeAssignmentIds.length > 0) {
 933:           const { error: deleteError } = await supabase
 934:             .from('trip_line_assignments')
 935:             .delete()
 936:             .in('id', removeAssignmentIds)
 937: 
 938:           if (deleteError) {
 939:             setSaveError(`Error al eliminar asignaciones: ${deleteError.message}`)
 940:             return false
 941:           }
 942:         }
 943: 
 944:         // 3. Actualizar cantidades de asignaciones existentes modificadas.
 945:         //    El trigger BD se dispara en UPDATE y reconcilia qty_scheduled.
 946:         if (modifiedAssignments && modifiedAssignments.length > 0) {
 947:           for (const mod of modifiedAssignments) {
 948:             await supabase
 949:               .from('trip_line_assignments')
 950:               .update({ quantity_assigned: mod.quantity_assigned })
 951:               .eq('id', mod.id)
 952:           }
 953:         }
 954: 
 955:         // 4. Agregar nuevas asignaciones. El trigger BD se dispara en INSERT
 956:         //    y reconcilia qty_scheduled + status='Programada' de la línea.
 957:         if (addAssignments.length > 0) {
 958:           const newRows = addAssignments.map((a) => ({
 959:             trip_id: id,
 960:             request_line_id: a.request_line_id,
 961:             quantity_assigned: a.quantity_assigned,
 962:           }))
 963: 
 964:           const { error: insertError } = await supabase
 965:             .from('trip_line_assignments')
 966:             .insert(newRows)
 967: 
 968:           if (insertError) {
 969:             setSaveError(`Error al agregar asignaciones: ${insertError.message}`)
 970:             return false
 971:           }
 972:         }
 973: 
 974:         return true
 975:       } catch (err) {
 976:         const message = err instanceof Error ? err.message : 'Error inesperado al actualizar viaje'
 977:         setSaveError(message)
 978:         return false
 979:       } finally {
 980:         busyRef.current = false
 981:         setSaving(false)
 982:       }
 983:     },
 984:     [supabase],
 985:   )
 986: 
 987:   // --- Cancelar viaje ---
 988:   const cancelTrip = useCallback(
 989:     async (id: string, cancellationReason: string | null): Promise<boolean> => {
 990:       if (busyRef.current) return false
 991:       busyRef.current = true
 992:       setSaving(true)
 993:       setSaveError(null)
 994: 
 995:       try {
 996:         // Cambio 6 Bug #1 fix: NO MORE DELETE assignments.
 997:         // Trigger trg_recalc_from_trip_status_change (existe desde Cambio 5)
 998:         // recalcula líneas automáticamente al cambio de status. Trigger Bug #2
 999:         // fix asegura que líneas sin assignments activos no quedan zombie
1000:         // 'En Transito'. Assignments preservados para histórico operacional.
1001:         const { error: cancelError } = await supabase
1002:           .from('trips')
1003:           .update({
1004:             status: 'Cancelado',
1005:             cancellation_reason: cancellationReason?.trim() || null,
1006:           })
1007:           .eq('id', id)
1008: 
1009:         if (cancelError) {
1010:           // Trigger BD enforce_cancellation_reason_trips puede rechazar
1011:           // si qty_delivered>0 y razón inválida (≥10 chars).
1012:           const friendly = cancelError.message.includes('cancellation_reason requerido')
1013:             ? 'Debes proveer una razón (≥10 caracteres) para cancelar este viaje porque tiene entregas registradas.'
1014:             : cancelError.message
1015:           setSaveError(friendly)
1016:           return false
1017:         }
1018: 
1019:         // Notificar cancelación de viaje a PMs afectados
1020:         notifyViajeCancelado(id).catch(console.error)
1021: 
1022:         return true
1023:       } catch (err) {
1024:         const message = err instanceof Error ? err.message : 'Error inesperado al cancelar viaje'
1025:         setSaveError(message)
1026:         return false
1027:       } finally {
1028:         busyRef.current = false
1029:         setSaving(false)
1030:       }
1031:     },
1032:     [supabase],
1033:   )
1034: 
1035:   return {
1036:     // Backlog de líneas pendientes (vista de Charris)
1037:     backlog,
1038:     backlogLoading,
1039:     refetchBacklog,
1040: 
1041:     // Lista de viajes
1042:     trips,
1043:     tripsTotalCount,
1044:     listLoading,
1045:     listError,
1046:     refetchTrips,
1047: 
1048:     // Filtros de la lista
1049:     filters,
1050:     setFilters,
1051: 
1052:     // Detalle de un viaje individual
1053:     fetchTrip,
1054: 
1055:     // Mutaciones
1056:     saveTrip,
1057:     updateTrip,
1058:     cancelTrip,
1059: 
1060:     // Estado de mutaciones
1061:     saving,
1062:     saveError,
1063:   }
1064: }
