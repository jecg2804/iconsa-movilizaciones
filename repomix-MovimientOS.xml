<file path="src/components/ui/FileDisplay.tsx">
  1: 'use client'
  2: 
  3: import { useState, useCallback, useEffect } from 'react'
  4: import { type Attachment, getFileUrl, formatFileSize, isImageType } from '@/lib/supabase/storage'
  5: 
  6: interface FileDisplayProps {
  7:   attachments: Attachment[]
  8:   collapsible?: boolean
  9:   label?: string
 10: }
 11: 
 12: export default function FileDisplay({
 13:   attachments,
 14:   collapsible = true,
 15:   label = 'Documentos Adjuntos',
 16: }: FileDisplayProps) {
 17:   const [expanded, setExpanded] = useState(!collapsible)
 18:   const [signedUrls, setSignedUrls] = useState<Record<string, string>>({})
 19:   const [lightboxSrc, setLightboxSrc] = useState<string | null>(null)
 20:   const [loadingUrls, setLoadingUrls] = useState(false)
 21: 
 22:   // Cargar signed URLs cuando se expande la sección
 23:   const loadUrls = useCallback(async () => {
 24:     if (loadingUrls || attachments.length === 0) return
 25:     setLoadingUrls(true)
 26: 
 27:     const urls: Record<string, string> = {}
 28:     for (const file of attachments) {
 29:       const url = await getFileUrl(file.path)
 30:       if (url) urls[file.path] = url
 31:     }
 32:     setSignedUrls(urls)
 33:     setLoadingUrls(false)
 34:   }, [attachments, loadingUrls])
 35: 
 36:   useEffect(() => {
 37:     if (expanded && Object.keys(signedUrls).length === 0 && attachments.length > 0) {
 38:       void loadUrls()
 39:     }
 40:   }, [expanded, signedUrls, attachments.length, loadUrls])
 41: 
 42:   if (attachments.length === 0) return null
 43: 
 44:   const images = attachments.filter((f) => isImageType(f.type))
 45:   const documents = attachments.filter((f) => !isImageType(f.type))
 46: 
 47:   return (
 48:     <div className="space-y-2">
 49:       {/* Header colapsable */}
 50:       <button
 51:         type="button"
 52:         onClick={() => setExpanded(!expanded)}
 53:         className="flex items-center gap-2 text-sm font-medium text-gray-700 hover:text-gray-900"
 54:       >
 55:         <span className={`transition-transform ${expanded ? 'rotate-90' : ''}`}>▶</span>
 56:         📎 {label} ({attachments.length})
 57:       </button>
 58: 
 59:       {expanded && (
 60:         <div className="space-y-3 pl-5">
 61:           {loadingUrls && (
 62:             <div className="flex items-center gap-2 text-sm text-gray-400">
 63:               <div className="h-3 w-3 animate-spin rounded-full border-2 border-gray-300 border-t-blue-500" />
 64:               Cargando archivos...
 65:             </div>
 66:           )}
 67: 
 68:           {/* Imágenes — grid de thumbnails */}
 69:           {images.length > 0 && (
