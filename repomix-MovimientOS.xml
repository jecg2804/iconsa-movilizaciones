 203: /**
 204:  * Mapea una fila cruda de la lista de viajes al tipo TripWithRelations.
 205:  * Las asignaciones en la lista no incluyen detalles de línea.
 206:  */
 207: function mapTripRow(row: Record<string, unknown>): TripWithRelations {
 208:   const driver = unwrapRelation(row.driver as TripWithRelations['driver'] | TripWithRelations['driver'][])
 209:   const vehicle = unwrapRelation(row.vehicle as TripWithRelations['vehicle'] | TripWithRelations['vehicle'][])
 210:   const trailer = unwrapRelation(row.trailer as TripWithRelations['trailer'] | TripWithRelations['trailer'][])
 211:   const rate = unwrapRelation(row.rate as TripWithRelations['rate'] | TripWithRelations['rate'][])
 212:   const rawAssignments = Array.isArray(row.assignments) ? row.assignments : []
 213: 
 214:   // Las asignaciones de la lista incluyen datos mínimos de línea (solo from/to para ruta)
 215:   const assignments: TripAssignment[] = (rawAssignments as Record<string, unknown>[]).map((a) => {
 216:     const rawLine = a.line as Record<string, unknown> | null
 217:     let line: TripAssignment['line'] = null
 218:     if (rawLine) {
 219:       const fromLoc = unwrapRelation(rawLine.from_location as { id: string; name: string; location_type: string | null } | null)
 220:       const toLoc = unwrapRelation(rawLine.to_location as { id: string; name: string; location_type: string | null } | null)
 221:       const rawRequest = unwrapRelation(rawLine.request as Record<string, unknown> | null) as Record<string, unknown> | null
 222:       const unitRel = unwrapRelation(rawLine.unit as { id: string; code: string } | null)
 223:       const equipRel = unwrapRelation(rawLine.equipment as { id: string; spectrum_code: string | null; description: string } | null)
 224:       line = {
 225:         id: rawLine.id as string,
 226:         line_number: (rawLine.line_number as number) ?? 0,
 227:         line_type: (rawLine.line_type as string) ?? '',
 228:         description: (rawLine.description as string) ?? '',
 229:         quantity: (rawLine.quantity as number) ?? 0,
 230:         status: (rawLine.status as string) ?? '',
 231:         notes: (rawLine.notes as string | null) ?? null,
 232:         qty_scheduled: (rawLine.qty_scheduled as number) ?? 0,
 233:         qty_delivered: (rawLine.qty_delivered as number) ?? 0,
 234:         from_location: fromLoc,
 235:         to_location: toLoc,
 236:         unit: unitRel,
 237:         from_text: (rawLine.from_text as string | null) ?? null,
 238:         to_text: (rawLine.to_text as string | null) ?? null,
 239:         unit_text: (rawLine.unit_text as string | null) ?? null,
 240:         designated_receiver_id: (rawLine.designated_receiver_id as string | null) ?? null,
 241:         designated_receiver_name: (rawLine.designated_receiver_name as string | null) ?? null,
 242:         equipment: equipRel,
 243:         request: rawRequest
 244:           ? {
 245:               id: rawRequest['id'] as string,
 246:               request_id: (rawRequest['request_id'] as string | null) ?? null,
 247:               date_required: (rawRequest['date_required'] as string | null) ?? null,
 248:               project: unwrapRelation(rawRequest['project'] as { id: string; code: string; name: string } | null),
 249:               requester: unwrapRelation(rawRequest['requester'] as { id: string; name: string } | null),
 250:             }
 251:           : { id: '', request_id: null, date_required: null, project: null, requester: null },
 252:       }
 253:     }
 254:     return {
 255:       id: a.id as string,
 256:       trip_id: a.trip_id as string,
 257:       request_line_id: a.request_line_id as string,
 258:       quantity_assigned: a.quantity_assigned as number,
 259:       qty_delivered: (a.qty_delivered as number) ?? 0,
 260:       qty_dispatched: (a.qty_dispatched as number) ?? 0,
 261:       line,
 262:     }
 263:   })
 264: 
 265:   return {
 266:     id: row.id as string,
 267:     trip_id: (row.trip_id as string | null) ?? null,
 268:     scheduled_date: row.scheduled_date as string,
 269:     driver_id: (row.driver_id as string | null) ?? null,
 270:     vehicle_id: (row.vehicle_id as string | null) ?? null,
 271:     trailer_id: (row.trailer_id as string | null) ?? null,
 272:     rate_id: (row.rate_id as string | null) ?? null,
 273:     cost: (row.cost as number | null) ?? null,
 274:     att_permit: (row.att_permit as boolean | null) ?? null,
 275:     escort: (row.escort as boolean | null) ?? null,
 276:     confirmation_code: (row.confirmation_code as string | null) ?? null,
 277:     status: row.status as string,
 278:     notes: (row.notes as string | null) ?? null,
 279:     actual_departure: (row.actual_departure as string | null) ?? null,
 280:     actual_arrival: (row.actual_arrival as string | null) ?? null,
 281:     route_summary: (row.route_summary as string | null) ?? null,
 282:     attachments: (row.attachments as unknown[] | null) ?? null,
 283:     created_at: row.created_at as string,
 284:     updated_at: row.updated_at as string,
 285:     driver,
