123: UPDATE public.equipment SET gps_vehicle_id = '5061' WHERE spectrum_code = 'PUP467';
124: UPDATE public.equipment SET gps_vehicle_id = '5062' WHERE spectrum_code = 'PUP468';
125: UPDATE public.equipment SET gps_vehicle_id = '5063' WHERE spectrum_code = 'PUP245';
