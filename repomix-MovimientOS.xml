 745:         // 5. UPDATE sm_request_lines.delivered_at (no calculado por trigger).
 746:         //    Setear timestamp solo cuando la línea quedó completamente Entregada.
 747:         //    Re-leer post-trigger para saber el status actualizado.
 748:         for (const line of accepted) {
 749:           const { data: postTrigger } = await supabase
 750:             .from('sm_request_lines')
 751:             .select('status')
 752:             .eq('id', line.request_line_id)
 753:             .single()
 754: 
 755:           if (postTrigger?.status === 'Entregada') {
 756:             await supabase
 757:               .from('sm_request_lines')
 758:               .update({ delivered_at: new Date().toISOString() })
 759:               .eq('id', line.request_line_id)
 760:           }
 761:         }
