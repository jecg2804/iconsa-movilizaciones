555:   // --- Crear solicitud nueva ---
556:   const saveSolicitud = useCallback(
557:     async (
558:       header: SolicitudInput,
559:       lines: LineInput[],
560:       _deletedLineIds: string[],
561:       status: 'Borrador' | 'Enviada',
562:       personId?: string,
563:     ): Promise<{ id: string; requestId: string } | null> => {
564:       if (busyRef.current) return null
565:       busyRef.current = true
566:       setSaving(true)
567:       setSaveError(null)
568: 
569:       try {
570:         const headerPayload = {
571:           project_id: header.project_id,
572:           requester_id: header.requester_id,
573:           approved_by: header.approved_by ?? null,
574:           date_required: header.date_required,
575:           notes: header.notes ?? null,
576:           attachments: JSON.parse(JSON.stringify(header.attachments ?? [])),
577:           cost_code_id: header.cost_code_id ?? null,
578:           cost_category_id: header.cost_category_id ?? null,
579:           created_by: personId ?? null,
580:         }
581: 
582:         // 1. Insertar el header SIEMPRE como Borrador.
583:         //    El trigger BD `enforce_line_add_delete_only_in_borrador` (Fase
584:         //    B.1 Bloque 2.A) bloquea INSERT/DELETE de líneas mientras el
585:         //    parent no esté en Borrador. Por eso el flow es: crear header
586:         //    en Borrador → insertar líneas → promover a Enviada si aplica.
587:         //    Antes del trigger, el código insertaba con status='Enviada'
588:         //    directo y funcionaba por accidente; el trigger expuso que el
589:         //    orden correcto es el que usa la UI de edición.
590:         const { data: insertedRequest, error: headerError } = await supabase
591:           .from('sm_requests')
592:           .insert({ ...headerPayload, status: 'Borrador' })
593:           .select('id, request_id')
594:           .single()
595: 
596:         if (headerError || !insertedRequest) {
597:           setSaveError(headerError?.message ?? 'Error al crear la solicitud')
598:           return null
599:         }
600: 
601:         const newId = insertedRequest.id
602: 
603:         // 2. Insertar lineas (parent en Borrador, trigger acepta)
604:         if (lines.length > 0) {
605:           const lineRows = lines.map((line, index) =>
606:             lineInputToRow(line, newId, index + 1),
607:           )
608: 
609:           const { error: linesError } = await supabase
610:             .from('sm_request_lines')
611:             .insert(lineRows)
612: 
613:           if (linesError) {
614:             setSaveError(`Solicitud creada pero error al guardar líneas: ${linesError.message}`)
615:             return null
616:           }
617:         }
618: 
619:         // 3. Crear sugerencias para valores de fallback
620:         await createSuggestions(supabase, lines, header.requester_id)
621: 
622:         // 4. Promover a Enviada si el usuario eligió enviar directamente.
623:         //    Ahora que las líneas están insertadas, el cambio de status pasa
624:         //    los triggers (cascade_request_status no aplica a Borrador→Enviada,
625:         //    y lifecycle_timestamps captura date_submitted=now() en el UPDATE).
626:         if (status === 'Enviada') {
627:           const { error: promoteError } = await supabase
628:             .from('sm_requests')
629:             .update({ status: 'Enviada' })
630:             .eq('id', newId)
631: 
632:           if (promoteError) {
633:             setSaveError(`Líneas guardadas pero error al enviar: ${promoteError.message}`)
634:             return null
635:           }
636:         }
637: 
638:         // 5. Re-fetch para obtener el request_id auto-generado por trigger
639:         const { data: refreshed } = await supabase
640:           .from('sm_requests')
641:           .select('request_id')
642:           .eq('id', newId)
643:           .single()
644: 
645:         // Notificar si se envió directamente (status = Enviada)
646:         if (status === 'Enviada') {
647:           notifySolicitudEnviada(newId).catch(console.error)
648:           notifySolicitudUrgenteNueva(newId).catch(console.error)
649:         }
650: 
651:         return {
652:           id: newId,
653:           requestId: refreshed?.request_id ?? '',
654:         }
655:       } catch (err) {
656:         const message = err instanceof Error ? err.message : 'Error inesperado al guardar'
657:         setSaveError(message)
658:         return null
659:       } finally {
660:         busyRef.current = false
661:         setSaving(false)
662:       }
663:     },
664:     [supabase],
665:   )
