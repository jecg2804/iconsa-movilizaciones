 193: /**
 194:  * Extrae un objeto de relación Supabase que puede llegar como array o como objeto.
 195:  * Supabase devuelve joins como objetos para to-one y arrays para to-many.
 196:  */
 197: function unwrapRelation<T>(value: T | T[] | null | undefined): T | null {
 198:   if (value === null || value === undefined) return null
 199:   if (Array.isArray(value)) return value[0] ?? null
 200:   return value
 201: }
