 662:     const toggleEnabled = async (personId: string, currentValue: boolean) => {
 663:       const newValue = !currentValue
 664:       setNotifPeople(prev => prev.map(p => p.id === personId ? { ...p, notifications_enabled: newValue } : p))
 665:       await supabase.from('people').update({ notifications_enabled: newValue }).eq('id', personId)
 666:     }
 667: 
 668:     const togglePref = async (personId: string, key: string, currentPrefs: Record<string, boolean> | null) => {
 669:       const prefs = { ...(currentPrefs ?? {}) }
 670:       prefs[key] = !prefs[key]
 671:       setNotifPeople(prev => prev.map(p => p.id === personId ? { ...p, notification_preferences: prefs } : p))
 672:       await supabase.from('people').update({ notification_preferences: prefs }).eq('id', personId)
 673:     }
 674: 
 675:     if (loadingData) {
 676:       return <div className="py-8 text-center text-gray-500">Cargando...</div>
 677:     }
