194:   }, [vehicles, tripData.vehicle_id])
195: 
196:   // --- Validacion ---
197:   const validate = useCallback((): boolean => {
198:     const errors: string[] = []
199:     if (!tripData.scheduled_date) errors.push('Seleccione la fecha programada')
200:     if (!tripData.driver_id) errors.push('Seleccione un conductor')
201:     if (!tripData.vehicle_id) errors.push('Seleccione un vehiculo')
202:     // Remolque requerido para cabezal
