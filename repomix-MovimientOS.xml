171:     const { data: drivers } = await db
172:       .from('people')
173:       .select('id')
174:       .eq('status', 'Activo')
175:       .limit(2)
176:     expect(drivers?.length).toBeGreaterThanOrEqual(2)
177: 
178:     const { data: vehicle } = await db
