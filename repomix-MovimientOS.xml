 123:   receiverOptions: Array<{ value: string; label: string }>
 124:   assignments?: Array<{
 125:     request_line_id: string
 126:     quantity_assigned: number
 127:     line: { description: string; quantity: number; unit?: { code: string } | null } | null
 128:   }>
 129:   onConfirm: (input: TripEventInput) => void
 130:   onClose: () => void
 131:   loading: boolean
 132: }
 133: 
 134: function EventModal({ eventType, confirmationCode, receiverOptions, assignments, onConfirm, onClose, loading }: EventModalProps) {
 135:   const [notes, setNotes] = useState('')
 136:   const [location, setLocation] = useState('')
 137:   const [attachments, setAttachments] = useState<Attachment[]>([])
 138:   const [validationError, setValidationError] = useState<string | null>(null)
 139:   const eventIdRef = useRef(crypto.randomUUID())
 140:   const deliveredQtys = useRef<Record<string, number>>({})
 141: 
 142:   useEffect(() => {
 143:     if (assignments) {
 144:       const defaults: Record<string, number> = {}
 145:       for (const a of assignments) {
 146:         defaults[a.request_line_id] = a.quantity_assigned
 147:       }
 148:       deliveredQtys.current = defaults
 149:     }
 150:   }, [assignments])
 151: 
 152:   const handleConfirmCode = useCallback(
 153:     (codeUsed: string, receivedById: string | null, receivedByName: string) => {
 154:       onConfirm({
 155:         id: eventIdRef.current,
 156:         event_type: eventType,
 157:         event_timestamp: new Date().toISOString(),
 158:         location: location.trim() || null,
 159:         notes: notes.trim() || null,
 160:         confirmation_code_used: codeUsed || null,
 161:         received_by_id: receivedById ?? null,
 162:         received_by_name: receivedByName || null,
 163:         attachments,
 164:       })
 165:       eventIdRef.current = crypto.randomUUID()
 166:     },
 167:     [eventType, location, notes, attachments, onConfirm],
 168:   )
 169: 
 170:   const handleDirectConfirm = useCallback(() => {
 171:     // G10: Incidencia requiere notas descriptivas (mínimo 10 caracteres)
 172:     if (eventType === 'Incidencia' && notes.trim().length < 10) {
 173:       setValidationError('La descripción de la incidencia debe tener al menos 10 caracteres.')
 174:       return
 175:     }
 176:     setValidationError(null)
 177:     onConfirm({
 178:       id: eventIdRef.current,
 179:       event_type: eventType,
 180:       event_timestamp: new Date().toISOString(),
 181:       location: location.trim() || null,
 182:       notes: notes.trim() || null,
 183:       attachments,
 184:     })
 185:     eventIdRef.current = crypto.randomUUID()
 186:   }, [eventType, location, notes, attachments, onConfirm])
 187: 
 188:   return (
 189:     <div className="fixed inset-0 z-50 flex items-end justify-center bg-black/50 p-4 sm:items-center">
 190:       <div className="w-full max-w-md rounded-t-2xl bg-white p-6 shadow-xl sm:rounded-2xl">
 191:         <h3 className="mb-4 text-lg font-semibold text-gray-900">
 192:           Registrar {eventType}
 193:         </h3>
 194: 
 195:         <div className="space-y-3">
 196:           {/* Ubicacion */}
 197:           <Input
 198:             label="Ubicación (opcional)"
 199:             type="text"
 200:             placeholder="Ej: Muelle 14, Taller Chilibre"
 201:             value={location}
 202:             onChange={(e) => setLocation(e.target.value)}
 203:           />
 204: 
 205:           {/* Notas */}
 206:           <div>
 207:             <label className="mb-1 block text-sm font-medium text-gray-700">
 208:               Notas (opcional)
 209:             </label>
 210:             <textarea
 211:               value={notes}
 212:               onChange={(e) => setNotes(e.target.value)}
 213:               placeholder="Observaciones del evento"
 214:               rows={2}
 215:               className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
 216:             />
 217:           </div>
 218: 
 219:           {/* Fotos / Adjuntos */}
 220:           <FileUploader
 221:             attachments={attachments}
 222:             folder={`events/${eventIdRef.current}`}
 223:             onChange={setAttachments}
 224:             label="Fotos"
 225:             hint="PDF, JPG, PNG o WEBP (max 10MB)"
 226:           />
 227:         </div>
 228: 
 229:         {/* Cantidades a entregar (solo Entrega) */}
 230:         {eventType === 'Entrega' && assignments && assignments.length > 0 && (
 231:           <div className="mt-4 space-y-2">
 232:             <p className="text-sm font-medium text-gray-700">Cantidades a entregar</p>
 233:             {assignments.map((a) => {
 234:               const desc = a.line?.description ?? 'Línea'
 235:               const unitCode = a.line?.unit?.code ?? ''
 236:               return (
 237:                 <div key={a.request_line_id} className="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 p-2">
 238:                   <span className="flex-1 text-sm text-gray-700 truncate">{desc}</span>
 239:                   <input
 240:                     type="number"
 241:                     min={0}
 242:                     max={Math.round(a.quantity_assigned)}
 243:                     step="1"
 244:                     defaultValue={Math.round(a.quantity_assigned)}
 245:                     title={`Cantidad a entregar de ${desc}`}
 246:                     onChange={(e) => {
 247:                       deliveredQtys.current[a.request_line_id] = parseFloat(e.target.value) || 0
 248:                     }}
 249:                     className="w-20 rounded border border-gray-300 px-2 py-1 text-sm text-right focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
 250:                   />
 251:                   <span className="text-xs text-iconsa-gray whitespace-nowrap">/ {formatQty(a.quantity_assigned)} {unitCode}</span>
 252:                 </div>
 253:               )
 254:             })}
 255:           </div>
 256:         )}
 257: 
 258:         {/* Confirmacion de entrega con codigo */}
 259:         {eventType === 'Entrega' ? (
 260:           <div className="mt-4">
 261:             <hr className="mb-4 border-gray-200" />
 262:             <p className="mb-3 text-sm font-medium text-gray-900">Verificar entrega</p>
 263:             <CodeConfirmation
 264:               expectedCode={confirmationCode}
 265:               receiverOptions={receiverOptions}
 266:               onConfirm={handleConfirmCode}
 267:               onCancel={onClose}
 268:               loading={loading}
 269:             />
 270:           </div>
 271:         ) : (
 272:           <div className="mt-4 space-y-2">
 273:             {validationError && (
 274:               <p className="text-sm text-iconsa-red">{validationError}</p>
 275:             )}
 276:             <div className="flex gap-2">
 277:               <Button variant="primary" onClick={handleDirectConfirm} loading={loading}>
 278:                 Confirmar
 279:               </Button>
 280:               <Button variant="ghost" onClick={onClose} disabled={loading}>
 281:                 Cancelar
 282:               </Button>
 283:             </div>
 284:           </div>
 285:         )}
 286:       </div>
 287:     </div>
 288:   )
 289: }
