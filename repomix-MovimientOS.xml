 162:           .select('trip_id, line:request_line_id!inner(request:request_id!inner(project_id))')
 163:           .eq('line.request.project_id', tripFilters.projectId)
 164:         const ids = new Set<string>()
 165:         for (const row of linkData ?? []) {
