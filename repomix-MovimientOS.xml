115:             {canConfirmDelivery && onConfirmDelivery && (
116:               <button
117:                 type="button"
118:                 onClick={onConfirmDelivery}
119:                 className="rounded-lg bg-amber-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-amber-600 transition-colors"
120:               >
121:                 Confirmar entrega
122:               </button>
123:             )}
124:           </div>
125:         )}
126: 
127:         {!isActive && (
128:           <div className="text-xs text-iconsa-gray shrink-0">
129:             {order.status === 'Entregado' && order.completed_at && (
130:               <span title={`Recibido por ${order.received_by_name ?? '(no captado)'}`}>
131:                 Entregado {formatDate(order.completed_at)}
132:               </span>
133:             )}
134:             {order.status === 'Cancelado' && order.cancelled_at && (
135:               <span>Cancelado {formatDate(order.cancelled_at)}</span>
136:             )}
137:           </div>
138:         )}
139:       </div>
140: 
141:       {expanded && (
142:         <div className="px-4 py-3 space-y-2">
143:           {order.lines.map((ol) => {
144:             if (!ol.line) return null
145:             const fromName = ol.line.from_location?.name ?? ol.line.from_text ?? '—'
146:             const toName = ol.line.to_location?.name ?? ol.line.to_text ?? '—'
147:             const unitCode = ol.line.unit?.code ?? ol.line.unit_text ?? ''
148:             const isEquipo = ol.line.line_type === 'Equipo'
149:             const requestDisplayId = ol.line.request.request_id ?? ol.line.request.id.slice(0, 8)
150:             return (
151:               <div key={ol.id} className="flex items-center gap-2 text-sm py-1 flex-wrap">
152:                 {isEquipo ? (
153:                   <Wrench className="h-3.5 w-3.5 shrink-0 text-iconsa-blue" />
154:                 ) : (
155:                   <Package className="h-3.5 w-3.5 shrink-0 text-gold" />
156:                 )}
157:                 <span className="font-medium text-gray-900" title={ol.line.description}>
158:                   {ol.line.description}
159:                 </span>
160:                 <Link
161:                   href={`/solicitudes/${ol.line.request.id}`}
162:                   className="font-mono text-xs text-iconsa-gray hover:text-iconsa-blue hover:underline whitespace-nowrap"
163:                   title={`Ir a solicitud ${requestDisplayId}`}
164:                 >
165:                   {requestDisplayId}
166:                 </Link>
167:                 <span className="text-gray-300">·</span>
168:                 <span className="font-semibold text-gray-700 whitespace-nowrap bg-gray-100 px-1.5 py-0.5 rounded text-xs">
169:                   {formatQty(ol.quantity_assigned)} {unitCode}
170:                 </span>
171:                 <span className="text-xs text-gray-400 whitespace-nowrap">{fromName} → {toName}</span>
172:                 {ol.qty_delivered > 0 && (
173:                   <span className="text-xs text-emerald-600 whitespace-nowrap" title={`Entregado: ${formatQty(ol.qty_delivered)}`}>
174:                     ✓ {formatQty(ol.qty_delivered)}
175:                   </span>
176:                 )}
177:               </div>
178:             )
179:           })}
180: 
181:           {order.notes && (
182:             <div className="mt-2 pt-2 border-t border-amber-100">
183:               <p className="text-xs italic text-gray-500">{order.notes}</p>
184:             </div>
185:           )}
186:         </div>
187:       )}
188:     </div>
189:   )
190: }
</file>

<file path="src/components/programacion/TripForm.tsx">
  1: 'use client'
  2: 
  3: import { useState, useEffect, useCallback, useRef } from 'react'
  4: import { Select, type SelectOption } from '@/components/ui/Select'
  5: import { Input } from '@/components/ui/Input'
  6: import { Badge } from '@/components/ui/Badge'
  7: import FileUploader from '@/components/ui/FileUploader'
  8: import FileDisplay from '@/components/ui/FileDisplay'
  9: import type { TripInput } from '@/hooks/useTrips'
 10: import type { Attachment } from '@/lib/supabase/storage'
 11: import { todayStrInPanama } from '@/lib/utils/datetime'
 12: 
 13: /** Genera opciones de hora de 4:00 AM a 8:00 PM cada 5 min */
 14: function generateTimeOptions(): SelectOption[] {
 15:   const options: SelectOption[] = []
 16:   for (let h = 4; h <= 20; h++) {
 17:     for (let m = 0; m < 60; m += 5) {
 18:       if (h === 20 && m > 0) break
 19:       const value = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`
 20:       const h12 = h === 0 ? 12 : h > 12 ? h - 12 : h
 21:       const ampm = h >= 12 ? 'PM' : 'AM'
 22:       const label = `${h12}:${String(m).padStart(2, '0')} ${ampm}`
 23:       options.push({ value, label })
 24:     }
 25:   }
 26:   return options
 27: }
 28: 
 29: const TIME_OPTIONS = generateTimeOptions()
 30: 
 31: type TripFormMode = 'create' | 'edit' | 'readonly'
 32: 
 33: interface TripFormProps {
 34:   mode: TripFormMode
 35:   initialData?: {
 36:     tripId?: string | null
 37:     scheduledDate: string
 38:     scheduledTime?: string | null
 39:     driverId: string | null
 40:     vehicleId: string | null
 41:     trailerId: string | null
 42:     rateId: string | null
 43:     cost: number | null
 44:     attPermit: boolean
 45:     escort: boolean
 46:     notes: string | null
 47:     status?: string
 48:     confirmationCode?: string | null
 49:   }
 50:   /** Conductores disponibles para el dropdown */
 51:   drivers: SelectOption[]
 52:   /** Vehiculos (cabezales) disponibles para el dropdown */
 53:   vehicles: SelectOption[]
 54:   /** Remolques disponibles para el dropdown */
 55:   trailers: SelectOption[]
 56:   /**
 57:    * Tarifas disponibles para el dropdown.
 58:    * sublabel debe contener el monto formateado, ej: "B/. 2,000.00"
 59:    */
 60:   rates: SelectOption[]
 61:   /** Callback cada vez que cambian los datos del formulario */
 62:   onChange: (data: TripInput) => void
 63:   /**
 64:    * Callback opcional para cuando cambia la tarifa seleccionada.
 65:    * El padre puede usar esto para auto-rellenar el costo.
 66:    */
 67:   onRateChange?: (rateId: string | null) => void
 68:   /** Si true, el remolque es obligatorio (vehículo es cabezal) */
 69:   isTrailerRequired?: boolean
 70:   /** UUID del viaje (para folder de storage). En modo crear se genera uno temporal. */
 71:   tripId?: string
 72:   /** Adjuntos iniciales del viaje */
 73:   initialAttachments?: Attachment[]
 74: }
 75: 
 76: function TripForm({
 77:   mode,
 78:   initialData,
 79:   drivers,
 80:   vehicles,
 81:   trailers,
 82:   rates,
 83:   onChange,
 84:   onRateChange,
 85:   isTrailerRequired = false,
 86:   tripId: tripIdProp,
 87:   initialAttachments,
 88: }: TripFormProps) {
 89:   // En modo edicion con viaje En Ruta, solo las notas son editables
 90:   const isEnRuta = mode === 'edit' && initialData?.status === 'En Ruta'
 91:   const isReadonly = mode === 'readonly'
 92:   const fieldsDisabled = isReadonly || isEnRuta
 93: 
 94:   // --- Estado interno del formulario ---
 95:   const [scheduledDate, setScheduledDate] = useState<string>(
 96:     initialData?.scheduledDate ?? '',
 97:   )
 98:   const [scheduledTime, setScheduledTime] = useState<string>(
 99:     initialData?.scheduledTime ?? '',
100:   )
101:   const [driverId, setDriverId] = useState<string | null>(
102:     initialData?.driverId ?? null,
103:   )
104:   const [vehicleId, setVehicleId] = useState<string | null>(
105:     initialData?.vehicleId ?? null,
106:   )
107:   const [trailerId, setTrailerId] = useState<string | null>(
108:     initialData?.trailerId ?? null,
109:   )
110:   const [rateId, setRateId] = useState<string | null>(
111:     initialData?.rateId ?? null,
112:   )
113:   const [cost, setCost] = useState<string>(
114:     initialData?.cost != null ? String(initialData.cost) : '',
115:   )
116:   const [attPermit, setAttPermit] = useState<boolean>(
117:     initialData?.attPermit ?? false,
118:   )
119:   const [escort, setEscort] = useState<boolean>(
120:     initialData?.escort ?? false,
121:   )
122:   const [notes, setNotes] = useState<string>(initialData?.notes ?? '')
123:   const [attachments, setAttachments] = useState<Attachment[]>(initialAttachments ?? [])
124:   // UUID estable para folder de storage (en modo crear, genera uno temporal)
125:   const folderIdRef = useRef(tripIdProp ?? crypto.randomUUID())
126: 
127:   // --- Propagar cambios al padre ---
128:   const propagate = useCallback(
129:     (overrides?: Partial<TripInput>) => {
130:       const data: TripInput = {
131:         scheduled_date: overrides?.scheduled_date ?? scheduledDate,
132:         scheduled_time: overrides?.scheduled_time !== undefined ? overrides.scheduled_time : (scheduledTime || null),
133:         driver_id: overrides?.driver_id !== undefined ? overrides.driver_id : driverId,
134:         vehicle_id: overrides?.vehicle_id !== undefined ? overrides.vehicle_id : vehicleId,
135:         trailer_id: overrides?.trailer_id !== undefined ? overrides.trailer_id : trailerId,
136:         rate_id: overrides?.rate_id !== undefined ? overrides.rate_id : rateId,
137:         cost: overrides?.cost !== undefined ? overrides.cost : (parseFloat(cost) || null),
138:         att_permit: overrides?.att_permit !== undefined ? overrides.att_permit : attPermit,
139:         escort: overrides?.escort !== undefined ? overrides.escort : escort,
140:         notes: overrides?.notes !== undefined ? overrides.notes : (notes.trim() || null),
141:         attachments: overrides?.attachments !== undefined ? overrides.attachments : attachments,
142:       }
143:       onChange(data)
144:     },
145:     [scheduledDate, scheduledTime, driverId, vehicleId, trailerId, rateId, cost, attPermit, escort, notes, attachments, onChange],
146:   )
147: 
148:   // Propagar el estado inicial al montar
149:   useEffect(() => {
150:     propagate()
151:     // Solo en el montaje inicial
152:     // eslint-disable-next-line react-hooks/exhaustive-deps
153:   }, [])
154: 
155:   // --- Handlers de cambio ---
156:   const handleDateChange = useCallback(
157:     (e: React.ChangeEvent<HTMLInputElement>) => {
158:       const val = e.target.value
159:       setScheduledDate(val)
160:       propagate({ scheduled_date: val })
161:     },
162:     [propagate],
163:   )
164: 
165:   const handleTimeChange = useCallback(
166:     (val: string | null) => {
167:       setScheduledTime(val ?? '')
168:       propagate({ scheduled_time: val })
169:     },
170:     [propagate],
171:   )
172: 
173:   const handleDriverChange = useCallback(
174:     (val: string | null) => {
175:       setDriverId(val)
176:       propagate({ driver_id: val })
177:     },
178:     [propagate],
179:   )
180: 
181:   const handleVehicleChange = useCallback(
182:     (val: string | null) => {
183:       setVehicleId(val)
184:       propagate({ vehicle_id: val })
185:     },
186:     [propagate],
187:   )
188: 
189:   const handleTrailerChange = useCallback(
190:     (val: string | null) => {
191:       setTrailerId(val)
192:       propagate({ trailer_id: val })
193:     },
194:     [propagate],
195:   )
196: 
197:   const handleRateChange = useCallback(
198:     (val: string | null) => {
199:       // Cambio 4 (revert J6): seleccionar rate pre-rellena cost del rate.amount
200:       // pero el campo SIGUE editable como override manual. Movimientos internos
201:       // o casos especiales pueden requerir cost custom incluso con rate.
202:       if (val) {
203:         const selectedRate = rates.find((r) => r.value === val)
204:         if (selectedRate?.amount != null) {
205:           setRateId(val)
206:           setCost(String(selectedRate.amount))
207:           onRateChange?.(val)
208:           propagate({ rate_id: val, cost: selectedRate.amount })
209:           return
210:         }
211:       }
212:       setRateId(val)
213:       onRateChange?.(val)
214:       propagate({ rate_id: val })
215:     },
216:     [propagate, onRateChange, rates],
217:   )
218: 
219:   const handleCostChange = useCallback(
220:     (e: React.ChangeEvent<HTMLInputElement>) => {
221:       const val = e.target.value
222:       setCost(val)
223:       propagate({ cost: parseFloat(val) || null })
224:     },
225:     [propagate],
226:   )
227: 
228:   const handleAttPermitChange = useCallback(
229:     (e: React.ChangeEvent<HTMLInputElement>) => {
230:       const val = e.target.checked
231:       setAttPermit(val)
232:       propagate({ att_permit: val })
233:     },
234:     [propagate],
235:   )
236: 
237:   const handleEscortChange = useCallback(
238:     (e: React.ChangeEvent<HTMLInputElement>) => {
239:       const val = e.target.checked
240:       setEscort(val)
241:       propagate({ escort: val })
242:     },
243:     [propagate],
244:   )
245: 
246:   const handleNotesChange = useCallback(
247:     (e: React.ChangeEvent<HTMLTextAreaElement>) => {
248:       const val = e.target.value
249:       setNotes(val)
250:       propagate({ notes: val.trim() || null })
251:     },
252:     [propagate],
253:   )
254: 
255:   // Datos de visualizacion de la barra de identificacion
256:   const tripId = initialData?.tripId
257:   const status = initialData?.status
258:   const confirmationCode = initialData?.confirmationCode
259: 
260:   return (
261:     <div className="space-y-4">
262:       {/* Barra de identificacion */}
263:       <div className="flex flex-col gap-2 rounded-lg bg-gray-100 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
264:         {/* ID del viaje */}
265:         <div className="flex items-center gap-3 flex-wrap">
266:           {tripId ? (
267:             <span className="text-lg font-bold font-mono text-navy">
268:               {tripId}
269:             </span>
270:           ) : (
271:             <span className="text-sm italic text-iconsa-gray">
272:               Se generara al guardar
273:             </span>
274:           )}
275: 
276:           {/* Badges de estado y permisos especiales */}
277:           {status && (
278:             <div className="flex items-center gap-2">
279:               <Badge variant="trip" label={status} />
280:               {attPermit && (
281:                 <Badge
282:                   variant="custom"
283:                   label="ATTT"
284:                   bg="bg-purple-100"
285:                   text="text-purple-800"
286:                 />
287:               )}
288:               {escort && (
289:                 <Badge
290:                   variant="custom"
291:                   label="Escolta"
292:                   bg="bg-orange-100"
293:                   text="text-orange-800"
294:                 />
295:               )}
296:             </div>
297:           )}
298:         </div>
299: 
300:         {/* Codigo de confirmacion (solo en modo edicion o lectura si ya existe) */}
301:         {confirmationCode && (mode === 'edit' || mode === 'readonly') && (
302:           <div className="flex items-center gap-1.5 text-sm text-iconsa-gray">
303:             <span>Codigo:</span>
304:             <span className="font-mono font-bold text-gray-900 tracking-widest">
305:               {confirmationCode}
306:             </span>
307:           </div>
308:         )}
309:       </div>
310: 
311:       {/* Campos del formulario */}
312:       <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
313:         {/* Fecha Programada — min = hoy Panamá (solo creación) */}
314:         <Input
315:           label="Fecha Programada"
316:           type="date"
317:           value={scheduledDate}
318:           onChange={handleDateChange}
319:           disabled={fieldsDisabled}
320:           min={mode === 'create' ? todayStrInPanama() : undefined}
321:         />
322: 
323:         {/* Hora de Salida (opcional) — dropdown filtrable 12h */}
324:         <Select
325:           label="Hora de Salida (opcional)"
326:           placeholder="Seleccionar hora..."
327:           options={TIME_OPTIONS}
328:           value={scheduledTime || null}
329:           onChange={handleTimeChange}
330:           disabled={fieldsDisabled}
331:           searchable
332:         />
333: 
334:         {/* Conductor */}
335:         <Select
336:           label="Conductor"
337:           placeholder="Seleccionar conductor..."
338:           options={drivers}
339:           value={driverId}
340:           onChange={handleDriverChange}
341:           disabled={fieldsDisabled}
342:           searchable
343:         />
344: 
345:         {/* Vehiculo */}
346:         <Select
347:           label="Vehiculo (Cabezal)"
348:           placeholder="Seleccionar vehiculo..."
349:           options={vehicles}
350:           value={vehicleId}
351:           onChange={handleVehicleChange}
352:           disabled={fieldsDisabled}
353:           searchable
354:         />
355: 
356:         {/* Remolque — requerido si el vehículo es cabezal */}
357:         <div>
358:           <Select
359:             label={isTrailerRequired ? 'Remolque (requerido)' : 'Remolque (opcional)'}
360:             placeholder="Seleccionar remolque..."
361:             options={trailers}
362:             value={trailerId}
363:             onChange={handleTrailerChange}
364:             disabled={fieldsDisabled}
365:             searchable
366:           />
367:           {isTrailerRequired && !trailerId && !fieldsDisabled && (
368:             <p className="mt-1 text-xs text-red-600">
369:               El remolque es obligatorio para vehículos cabezal.
370:             </p>
371:           )}
372:         </div>
373: 
374:         {/* Tarifa */}
375:         <Select
376:           label="Tarifa de Movilizacion"
377:           placeholder="Seleccionar tarifa..."
378:           options={rates}
379:           value={rateId}
380:           onChange={handleRateChange}
381:           disabled={fieldsDisabled}
382:           searchable
383:         />
384: 
385:         {/* Costo — siempre editable; rate solo pre-rellena (Cambio 4 — revert J6) */}
386:         <Input
387:           label="Costo (B/.)"
388:           type="number"
389:           step="0.01"
390:           min="0"
391:           value={cost}
392:           onChange={handleCostChange}
393:           disabled={fieldsDisabled}
394:           placeholder="0.00"
395:         />
396: 
397:         {/* Toggles: ATTT Permit + Escolta — fila completa en mobile, columna par en desktop */}
398:         <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6 md:col-span-2">
399:           {/* Requiere Permiso ATTT */}
400:           <label className="flex items-center gap-2 cursor-pointer">
401:             <input
402:               type="checkbox"
403:               checked={attPermit}
404:               onChange={handleAttPermitChange}
405:               disabled={fieldsDisabled}
406:               className="rounded border-gray-300 text-navy focus:ring-navy disabled:cursor-not-allowed"
407:             />
408:             <span className="text-sm font-medium text-gray-700">
409:               Requiere Permiso ATTT
410:             </span>
411:           </label>
412: 
413:           {/* Requiere Escolta */}
414:           <label className="flex items-center gap-2 cursor-pointer">
415:             <input
416:               type="checkbox"
417:               checked={escort}
418:               onChange={handleEscortChange}
419:               disabled={fieldsDisabled}
420:               className="rounded border-gray-300 text-navy focus:ring-navy disabled:cursor-not-allowed"
421:             />
422:             <span className="text-sm font-medium text-gray-700">
423:               Requiere Escolta
424:             </span>
425:           </label>
426:         </div>
427: 
428:         {/* Adjuntos */}
429:         <div className="md:col-span-2">
430:           {isReadonly ? (
431:             <FileDisplay attachments={attachments} />
432:           ) : (
433:             <FileUploader
434:               attachments={attachments}
435:               folder={`trips/${folderIdRef.current}`}
436:               onChange={(files) => {
437:                 setAttachments(files)
438:                 propagate({ attachments: files })
439:               }}
440:               disabled={fieldsDisabled}
441:             />
442:           )}
443:           {attPermit && attachments.length === 0 && !isReadonly && (
444:             <p className="mt-1 text-xs text-blue-600">
445:               ℹ️ Este viaje requiere permiso ATTT. Puede adjuntarlo cuando esté disponible.
446:             </p>
447:           )}
448:         </div>
449: 
450:         {/* Notas — ancho completo. En modo En Ruta, este campo SI es editable */}
451:         <div className="md:col-span-2">
452:           <label
453:             htmlFor="trip-notes"
454:             className="mb-1 block text-sm font-medium text-gray-700"
455:           >
456:             Notas
457:           </label>
458:           <textarea
459:             id="trip-notes"
460:             value={notes}
461:             onChange={handleNotesChange}
462:             // Las notas son editables incluso en modo En Ruta
463:             disabled={isReadonly}
464:             placeholder="Observaciones operativas de la movilización (opcional)"
465:             rows={3}
466:             className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue disabled:bg-gray-50 disabled:text-gray-500"
467:           />
468:         </div>
469:       </div>
470:     </div>
471:   )
472: }
473: 
474: export { TripForm }
475: export type { TripFormProps, TripFormMode }
</file>

<file path="src/components/programacion/BacklogTable.tsx">
  1: 'use client'
  2: 
  3: import { Wrench, Package, ArrowRight, Loader2, Paperclip } from 'lucide-react'
  4: import { formatDate, formatDaysUntilDue, daysUntilDue, daysUntilDueColor, formatQty } from '@/lib/utils/format'
  5: import type { BacklogLine } from '@/hooks/useTrips'
  6: 
  7: interface BacklogTableProps {
  8:   lines: BacklogLine[]
  9:   loading: boolean
 10:   /** Si true, muestra checkboxes para seleccion multiple */
 11:   selectable?: boolean
 12:   selectedLineIds?: Set<string>
 13:   onToggleSelect?: (lineId: string) => void
 14:   onSelectAll?: (selected: boolean) => void
 15:   /** Callback cuando se hace click en el ID de solicitud */
 16:   onRequestClick?: (requestId: string) => void
 17: }
 18: 
 19: /** Resuelve el nombre de origen de una linea de backlog */
 20: function resolveFrom(line: BacklogLine): string {
 21:   return line.from_location?.name ?? line.from_text ?? '—'
 22: }
 23: 
 24: /** Resuelve el nombre de destino de una linea de backlog */
 25: function resolveTo(line: BacklogLine): string {
 26:   return line.to_location?.name ?? line.to_text ?? '—'
 27: }
 28: 
 29: /** Resuelve la unidad de una linea de backlog */
 30: function resolveUnit(line: BacklogLine): string {
 31:   return line.unit?.code ?? line.unit_text ?? ''
 32: }
 33: 
 34: function BacklogTable({
 35:   lines,
 36:   loading,
 37:   selectable = false,
 38:   selectedLineIds,
 39:   onToggleSelect,
 40:   onSelectAll,
 41:   onRequestClick,
 42: }: BacklogTableProps) {
 43:   // Determinar si todas las lineas estan seleccionadas
 44:   const allSelected =
 45:     lines.length > 0 &&
 46:     !!selectedLineIds &&
 47:     lines.every((l) => selectedLineIds.has(l.id))
 48: 
 49:   const someSelected =
 50:     !!selectedLineIds &&
 51:     lines.some((l) => selectedLineIds.has(l.id)) &&
 52:     !allSelected
 53: 
 54:   // --- Estado de carga ---
 55:   if (loading) {
 56:     return (
 57:       <div className="flex items-center justify-center py-12 text-iconsa-gray">
 58:         <Loader2 className="h-5 w-5 animate-spin mr-2" />
 59:         <span className="text-sm">Cargando backlog...</span>
 60:       </div>
 61:     )
 62:   }
 63: 
 64:   // --- Estado vacio ---
 65:   if (lines.length === 0) {
