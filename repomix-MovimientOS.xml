  3: import { useState, useEffect, useCallback, useMemo } from 'react'
  4: import { useRouter } from 'next/navigation'
  5: import { createClient } from '@/lib/supabase/client'
  6: import { Badge } from '@/components/ui/Badge'
  7: import { Button } from '@/components/ui/Button'
  8: import { startOfWeek, addDays, format, isSameDay } from 'date-fns'
  9: import { es } from 'date-fns/locale'
 10: import Link from 'next/link'
 11: import { CalendarDays, ChevronLeft, ChevronRight, Info } from 'lucide-react'
 12: import { todayStrInPanama, parseDateStrInPanama } from '@/lib/utils/datetime'
 13: 
 14: interface CalendarTrip {
 15:   id: string
 16:   trip_id: string | null
 17:   scheduled_date: string
 18:   status: string
 19:   att_permit: boolean | null
 20:   escort: boolean | null
 21:   driver: { id: string; name: string } | null
 22:   vehicle: { id: string; spectrum_code: string | null; description: string } | null
 23:   assignments: Array<{
 24:     line: {
 25:       from_location: { name: string } | null
 26:       to_location: { name: string } | null
 27:       from_text: string | null
 28:       to_text: string | null
 29:     } | null
 30:   }>
 31: }
 32: 
 33: const DAY_NAMES = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom']
 34: 
 35: export default function CalendarioPage() {
 36:   const router = useRouter()
 37:   const supabase = useMemo(() => createClient(), [])
 38: 
 39:   // weekStart = lunes de la semana actual (en Panamá, no en timezone del runtime)
 40:   const [weekStart, setWeekStart] = useState(() =>
 41:     startOfWeek(parseDateStrInPanama(todayStrInPanama()), { weekStartsOn: 1 }),
 42:   )
 43:   const [trips, setTrips] = useState<CalendarTrip[]>([])
 44:   const [loading, setLoading] = useState(true)
 45: 
 46:   // Rango: 2 semanas (14 días)
 47:   const dateFrom = format(weekStart, 'yyyy-MM-dd')
 48:   const dateTo = format(addDays(weekStart, 13), 'yyyy-MM-dd')
 49: 
 50:   const fetchTrips = useCallback(async () => {
 51:     setLoading(true)
 52:     const { data } = await supabase
 53:       .from('trips')
 54:       .select(`
 55:         id, trip_id, scheduled_date, status, att_permit, escort,
 56:         driver:driver_id(id, name),
 57:         vehicle:vehicle_id(id, spectrum_code, description),
 58:         assignments:trip_line_assignments(
 59:           line:request_line_id(
 60:             from_location:from_location_id(name),
 61:             to_location:to_location_id(name),
 62:             from_text, to_text
 63:           )
 64:         )
 65:       `)
 66:       .gte('scheduled_date', dateFrom)
 67:       .lte('scheduled_date', dateTo)
 68:       .order('scheduled_date')
 69: 
 70:     setTrips((data as unknown as CalendarTrip[] | null) ?? [])
 71:     setLoading(false)
 72:   }, [supabase, dateFrom, dateTo])
 73: 
 74:   useEffect(() => {
 75:     void fetchTrips()
 76:   }, [fetchTrips])
 77: 
 78:   // Agrupar viajes por fecha
 79:   const tripsByDate = useMemo(() => {
 80:     const map = new Map<string, CalendarTrip[]>()
 81:     for (const trip of trips) {
 82:       const key = trip.scheduled_date
 83:       if (!map.has(key)) map.set(key, [])
 84:       map.get(key)!.push(trip)
 85:     }
 86:     return map
 87:   }, [trips])
 88: 
 89:   // Generar los 14 días
 90:   const days = useMemo(() => {
 91:     const result: Date[] = []
 92:     for (let i = 0; i < 14; i++) {
 93:       result.push(addDays(weekStart, i))
 94:     }
 95:     return result
 96:   }, [weekStart])
 97: 
 98:   const today = useMemo(() => parseDateStrInPanama(todayStrInPanama()), [])
 99: 
100:   const goBack = () => setWeekStart((prev) => addDays(prev, -7))
101:   const goForward = () => setWeekStart((prev) => addDays(prev, 7))
102:   const goToday = () => setWeekStart(startOfWeek(parseDateStrInPanama(todayStrInPanama()), { weekStartsOn: 1 }))
103: 
104:   // Ruta principal del viaje (primera asignación)
105:   function getRoute(trip: CalendarTrip): string {
106:     const a = trip.assignments?.[0]?.line
107:     if (!a) return ''
108:     const from = a.from_location?.name ?? a.from_text ?? ''
109:     const to = a.to_location?.name ?? a.to_text ?? ''
110:     if (!from && !to) return ''
111:     return `${from} → ${to}`
112:   }
113: 
114:   // Label del rango visible
115:   const rangeLabel = `${format(weekStart, "d 'de' MMMM", { locale: es })} — ${format(addDays(weekStart, 13), "d 'de' MMMM yyyy", { locale: es })}`
116: 
117:   return (
118:     <div className="space-y-4">
119:       {/* Banner */}
120:       <div className="flex items-center gap-2 rounded-lg bg-blue-50 px-4 py-2.5 text-sm text-iconsa-blue">
121:         <Info className="h-4 w-4 shrink-0" />
122:         <span>
123:           Vista integrada disponible en{' '}
124:           <Link href="/programacion" className="font-medium underline hover:text-blue-800">
125:             Programación
126:           </Link>
127:         </span>
128:       </div>
129: 
130:       {/* Header */}
131:       <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
132:         <div className="flex items-center gap-2">
133:           <CalendarDays className="h-5 w-5 text-iconsa-navy" />
134:           <h1 className="text-lg font-semibold text-iconsa-navy">
135:             Calendario de Viajes
136:           </h1>
137:         </div>
138:         <p className="text-sm text-iconsa-gray capitalize">{rangeLabel}</p>
139:       </div>
140: 
141:       {/* Navegación */}
142:       <div className="flex items-center gap-2">
143:         <Button variant="secondary" size="sm" onClick={goBack}>
144:           <ChevronLeft className="h-4 w-4" />
145:           <span className="hidden sm:inline ml-1">Anterior</span>
146:         </Button>
147:         <Button variant="secondary" size="sm" onClick={goToday}>
148:           Hoy
149:         </Button>
150:         <Button variant="secondary" size="sm" onClick={goForward}>
151:           <span className="hidden sm:inline mr-1">Siguiente</span>
152:           <ChevronRight className="h-4 w-4" />
153:         </Button>
154:       </div>
155: 
156:       {loading ? (
157:         <div className="flex justify-center py-12">
158:           <div className="h-8 w-8 animate-spin rounded-full border-4 border-gray-200 border-t-iconsa-blue" />
159:         </div>
160:       ) : (
161:         <>
162:           {/* Desktop: grid 7 columnas */}
163:           <div className="hidden md:block">
164:             {/* Cabecera días */}
165:             <div className="grid grid-cols-7 gap-px bg-gray-200 rounded-t-lg overflow-hidden">
166:               {DAY_NAMES.map((name) => (
167:                 <div
168:                   key={name}
169:                   className="bg-iconsa-navy px-2 py-1.5 text-center text-xs font-semibold text-white"
170:                 >
171:                   {name}
172:                 </div>
173:               ))}
174:             </div>
175: 
176:             {/* 2 filas de 7 días */}
177:             {[0, 1].map((row) => (
178:               <div
179:                 key={row}
180:                 className="grid grid-cols-7 gap-px bg-gray-200"
181:               >
182:                 {days.slice(row * 7, row * 7 + 7).map((day) => {
183:                   const key = format(day, 'yyyy-MM-dd')
184:                   const dayTrips = tripsByDate.get(key) ?? []
185:                   const isToday = isSameDay(day, today)
186: 
187:                   return (
188:                     <div
189:                       key={key}
190:                       className={`min-h-[120px] bg-white p-2 ${
191:                         isToday ? 'ring-2 ring-inset ring-iconsa-blue' : ''
192:                       }`}
193:                     >
194:                       {/* Número del día */}
195:                       <div className="flex items-center gap-1 mb-1">
196:                         <span
197:                           className={`text-sm font-medium ${
198:                             isToday
199:                               ? 'bg-iconsa-blue text-white rounded-full w-6 h-6 flex items-center justify-center'
200:                               : 'text-gray-700'
201:                           }`}
202:                         >
203:                           {format(day, 'd')}
204:                         </span>
205:                         {isToday && (
206:                           <span className="text-[10px] text-iconsa-blue font-medium">
207:                             Hoy
208:                           </span>
209:                         )}
210:                       </div>
211: 
212:                       {/* Viajes del día */}
213:                       <div className="space-y-1">
214:                         {dayTrips.map((trip) => (
215:                           <button
216:                             key={trip.id}
217:                             onClick={() =>
218:                               router.push(`/programacion/viaje/${trip.id}`)
219:                             }
220:                             className="w-full rounded border p-1.5 text-left text-[11px] leading-tight hover:bg-gray-50 transition-colors"
221:                           >
222:                             <div className="flex items-center justify-between gap-1 mb-0.5">
223:                               <span className="font-mono font-medium text-iconsa-navy truncate">
224:                                 {trip.trip_id ?? '—'}
225:                               </span>
226:                               <Badge
227:                                 label={trip.status}
228:                                 variant="trip"
229:                                 className="text-[9px] px-1.5 py-0"
230:                               />
231:                             </div>
232:                             {trip.driver && (
233:                               <p className="text-gray-600 truncate">
234:                                 {trip.driver.name}
235:                               </p>
236:                             )}
237:                             {trip.vehicle && (
238:                               <p className="text-gray-500 truncate">
239:                                 {trip.vehicle.spectrum_code ?? trip.vehicle.description}
240:                               </p>
241:                             )}
242:                             {getRoute(trip) && (
243:                               <p className="text-gray-400 truncate">
244:                                 {getRoute(trip)}
245:                               </p>
246:                             )}
247:                           </button>
248:                         ))}
249:                       </div>
250:                     </div>
