 692: // 10. SALIDA REGISTRADA → Charris + ALL PMs of ALL affected projects
 693: // =============================================================================
 694: export async function notifySalidaRegistrada(tripId: string): Promise<void> {
 695:   try {
 696:     console.log('[Notify] salida_registrada called', { tripId })
 697:     const supabase = createServiceClient()
 698:     const { data: trip } = await supabase
 699:       .from('trips')
 700:       .select('id, trip_id, status')
 701:       .eq('id', tripId)
 702:       .single()
 703: 
 704:     if (!trip) { console.warn('[Notify] salida_registrada: trip not found'); return }
 705:     if (trip.status === 'Cancelado') {
 706:       console.log('[Notify] salida_registrada: skipped, trip cancelled')
 707:       return
 708:     }
 709: 
 710:     const { data: assignments } = await supabase
 711:       .from('trip_line_assignments')
 712:       .select('request_line_id')
 713:       .eq('trip_id', tripId)
 714: 
 715:     // Pairs of (requester_id, request.id) for every line in this trip.
 716:     // Used below to personalize each recipient's email link.
 717:     type RequestLink = { requester_id: string; request_id: string }
 718:     let requestLinks: RequestLink[] = []
 719: 
 720:     const destinations = new Set<string>()
 721:     if (assignments?.length) {
 722:       const lineIds = assignments.map(a => a.request_line_id)
 723: 
 724:       // Cada PM recibe link a UNA de SUS solicitudes en este trip.
 725:       // Multi-PM-per-trip es estructural en ICONSA (solicitante, gerente,
 726:       // superintendente pueden ser distintos y estar en el mismo trip). Si un
 727:       // PM tiene varias solicitudes en el trip, cualquiera es válida — el
 728:       // primer match gana.
 729:       const { data: linesWithRequest } = await supabase
 730:         .from('sm_request_lines')
 731:         .select('request:request_id(id, requester_id)')
 732:         .in('id', lineIds)
 733: 
 734:       requestLinks = (linesWithRequest ?? [])
 735:         .map(row => {
 736:           const req = (row as { request: { id: string; requester_id: string } | null }).request
 737:           return req ? { requester_id: req.requester_id, request_id: req.id } : null
 738:         })
 739:         .filter((x): x is RequestLink => x !== null)
 740: 
 741:       const { data: lines } = await supabase
 742:         .from('sm_request_lines')
 743:         .select('to_location_id, to_text')
 744:         .in('id', lineIds)
 745: 
 746:       for (const l of lines ?? []) {
 747:         if (l.to_text) {
 748:           destinations.add(l.to_text)
 749:         } else if (l.to_location_id) {
 750:           const { data: loc } = await supabase
 751:             .from('locations')
 752:             .select('name')
 753:             .eq('id', l.to_location_id)
 754:             .single()
 755:           if (loc?.name) destinations.add(loc.name)
 756:         }
 757:       }
 758:     }
 759: 
 760:     const requestIds = await getTripRequestIds(tripId)
 761:     const charris = await getPeopleByRole('logistica')
 762:     const pms = await getTripProjectPMs(tripId)
 763:     const receiveAll = await getReceiveAllUsers()
 764:     const recipients = dedup(charris, pms, receiveAll)
 765: 
 766:     const now = new Date()
 767:     const departureTime = now.toLocaleTimeString('es-PA', { hour: '2-digit', minute: '2-digit', timeZone: 'America/Panama' })
 768: 
 769:     // Build per-recipient solicitudId map. Fallback chain:
 770:     //   1) first request in trip whose requester_id matches this recipient
 771:     //   2) first request_id seen in the trip (any solicitud → valid landing page)
 772:     //   3) trip.id (so the email link is never broken even with no requests)
 773:     const fallbackSolicitudId = requestLinks[0]?.request_id ?? trip.id
 774:     const recipientSolicitudIds = new Map<string, string>()
 775:     for (const recipient of recipients) {
 776:       const match = requestLinks.find(rl => rl.requester_id === recipient.id)
 777:       recipientSolicitudIds.set(recipient.id, match?.request_id ?? fallbackSolicitudId)
 778:     }
 779: 
 780:     for (const recipient of recipients) {
 781:       const solicitudId = recipientSolicitudIds.get(recipient.id) ?? fallbackSolicitudId
 782:       const template = templates.salidaRegistrada({
 783:         tripId: trip.trip_id ?? '',
 784:         departureTime,
 785:         destination: [...destinations].join(', ') || '—',
 786:         requestIds: requestIds.join(', ') || '—',
 787:         referenceId: trip.id,
 788:         solicitudId,
 789:       })
 790: 
 791:       await sendNotification({
 792:         eventType: 'salida_registrada',
 793:         referenceType: 'trip',
 794:         referenceId: trip.id,
 795:         recipients: [recipient],
 796:         ...template,
 797:       })
 798:     }
 799:   } catch (err) {
 800:     console.error('[Notify] salida_registrada FAILED:', err)
 801:   }
 802: }
