<file path="src/lib/sentry/redact.ts">
 1: import type { ErrorEvent, EventHint } from '@sentry/nextjs'
 2: 
 3: /**
 4:  * Redacta PII de eventos Sentry antes de enviar. Usamos `sendDefaultPii: true`
 5:  * para capturar IPs y breadcrumbs útiles, pero estrimamos campos sensibles
 6:  * (emails, tokens, nombres) para cumplir privacidad.
 7:  */
 8: 
 9: const SENSITIVE_KEYS = new Set([
10:   'authorization',
11:   'cookie',
12:   'set-cookie',
13:   'x-api-key',
14:   'api-key',
15:   'apikey',
16:   'token',
17:   'access_token',
18:   'refresh_token',
19:   'password',
20:   'email',
21:   'user_email',
22:   'phone',
23:   'license_number',
24:   'confirmation_code',
25: ])
26: 
27: const REDACTED = '[redacted]'
28: 
29: function redactObject(obj: unknown, depth = 0): unknown {
30:   if (depth > 6 || obj == null) return obj
31:   if (Array.isArray(obj)) return obj.map((v) => redactObject(v, depth + 1))
32:   if (typeof obj !== 'object') return obj
33: 
34:   const out: Record<string, unknown> = {}
35:   for (const [key, val] of Object.entries(obj as Record<string, unknown>)) {
36:     if (SENSITIVE_KEYS.has(key.toLowerCase())) {
37:       out[key] = REDACTED
38:     } else {
39:       out[key] = redactObject(val, depth + 1)
40:     }
41:   }
42:   return out
43: }
44: 
45: export function sentryBeforeSend(
46:   event: ErrorEvent,
47:   _hint: EventHint,
48: ): ErrorEvent | null {
49:   if (event.user) {
50:     const { id, ...rest } = event.user
51:     event.user = { id, ...(redactObject(rest) as typeof rest) }
52:   }
53: 
54:   if (event.request) {
55:     if (event.request.headers) {
56:       event.request.headers = redactObject(event.request.headers) as typeof event.request.headers
57:     }
58:     if (event.request.cookies) {
59:       event.request.cookies = REDACTED as unknown as typeof event.request.cookies
60:     }
61:     if (event.request.data) {
62:       event.request.data = redactObject(event.request.data)
63:     }
64:     if (event.request.query_string && typeof event.request.query_string === 'string') {
65:       event.request.query_string = event.request.query_string.replace(
66:         /(token|access_token|refresh_token|api[_-]?key|password)=[^&]*/gi,
67:         '$1=' + REDACTED,
68:       )
69:     }
70:   }
71: 
72:   if (event.extra) {
73:     event.extra = redactObject(event.extra) as typeof event.extra
74:   }
75:   if (event.contexts) {
76:     event.contexts = redactObject(event.contexts) as typeof event.contexts
77:   }
78: 
79:   if (event.breadcrumbs) {
80:     event.breadcrumbs = event.breadcrumbs.map((crumb) => ({
81:       ...crumb,
82:       data: crumb.data ? (redactObject(crumb.data) as typeof crumb.data) : crumb.data,
83:     }))
84:   }
85: 
86:   return event
87: }
</file>

