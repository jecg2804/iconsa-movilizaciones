153:       .from('sm_request_lines')
154:       .update({
155:         status: 'Cancelada',
156:         qty_scheduled: 0,
157:         notes: nextNotes,
158:         updated_by: person?.id ?? null,
159:       })
160:       .eq('id', confirmLine.line_id)
