 796:   // --- Reversión de eventos ---
 797:   const handleRevert = useCallback(
 798:     async (reason: string) => {
 799:       if (!revertEvent || !trip) return
 800: 
 801:       // G1: solo admin puede revertir eventos de OTRO usuario. Logistica
 802:       // solo puede revertir eventos que ella misma registró.
 803:       if (role !== 'admin' && revertEvent.registered_by?.id !== person?.id) {
 804:         setEventError('Solo puedes revertir eventos que tú registraste. Contacta a un administrador.')
 805:         return
 806:       }
 807: 
 808:       setReverting(true)
 809:       setEventError(null)
 810: 
 811:       try {
 812:         const eventType = revertEvent.event_type
 813: 
 814:         // Guard: no permitir revertir Llegada si hay Entrega/Parada
 815:         // no-reverted registrada después de esta Llegada. Revertir Llegada
 816:         // en ese caso dejaría el trip inconsistente (sin actual_arrival pero
 817:         // con líneas ya marcadas Entregada).
 818:         if (eventType === 'Llegada') {
 819:           const llegadaTime = new Date(revertEvent.event_timestamp).getTime()
 820:           const laterBlocking = events.some(
 821:             (e) =>
 822:               !revertedIds.has(e.id) &&
 823:               ['Entrega', 'Parada'].includes(e.event_type) &&
 824:               new Date(e.event_timestamp).getTime() > llegadaTime,
 825:           )
 826:           if (laterBlocking) {
 827:             setEventError('No se puede revertir Llegada porque existen eventos posteriores (Entrega/Parada). Revierta esos primero.')
 828:             setReverting(false)
 829:             return
 830:           }
 831:         }
 832: 
 833:         // 1. INSERT Reversion event (eventos INMUTABLES — no DELETE/UPDATE)
 834:         await supabase.from('trip_events').insert({
 835:           trip_id: trip.id,
 836:           event_type: 'Reversion',
 837:           event_timestamp: new Date().toISOString(),
 838:           registered_by: person?.id ?? null,
 839:           notes: reason,
 840:           reverts_event_id: revertEvent.id,
 841:         })
 842: 
 843:         // Notificar reversión
 844:         notifyReversionRegistrada(trip.id, reason, eventType, person?.id ?? null).catch(console.error)
 845: 
 846:         // 2. Revert state changes
 847:         if (eventType === 'Salida') {
 848:           // Cambio 6 D8 pre-flight: H8 constraint (qty_delivered ≤ qty_dispatched)
 849:           // rechazaría UPDATE qty_dispatched=0 si hay qty_delivered>0. Damos
 850:           // mensaje claro al usuario ANTES de que la BD falle con error genérico.
 851:           // Flow correcto: reversar Entregas primero, luego Salida.
 852:           const linesWithDeliveries = trip.assignments.filter((a) => (a.qty_delivered ?? 0) > 0)
 853:           if (linesWithDeliveries.length > 0) {
 854:             setEventError(
 855:               `Para revertir Salida, reversá primero las Entregas registradas. Hay ${linesWithDeliveries.length} línea${linesWithDeliveries.length === 1 ? '' : 's'} con entregas activas en este viaje.`,
 856:             )
 857:             setReverting(false)
 858:             return
 859:           }
 860: 
 861:           // Trip → Programado
 862:           await supabase
 863:             .from('trips')
 864:             .update({ status: 'Programado', actual_departure: null })
 865:             .eq('id', trip.id)
 866: 
 867:           // Reset qty_dispatched en assignments. El trigger BD recalc_qty_for_line
 868:           // se dispara al UPDATE y reconcilia qty_scheduled + status='Programada'
 869:           // en sm_request_lines.
 870:           for (const a of trip.assignments) {
 871:             await supabase
 872:               .from('trip_line_assignments')
 873:               .update({ qty_dispatched: 0 })
 874:               .eq('trip_id', trip.id)
 875:               .eq('request_line_id', a.request_line_id)
 876:           }
 877:         }
 878: 
 879:         if (eventType === 'Llegada') {
 880:           // Clear actual_arrival
 881:           await supabase
 882:             .from('trips')
 883:             .update({ actual_arrival: null })
 884:             .eq('id', trip.id)
 885:         }
 886: 
 887:         if (eventType === 'Entrega') {
 888:           // Decrementar qty_delivered en trip_line_assignments. El trigger BD
 889:           // recalc_qty_for_line se dispara al UPDATE y reconcilia
 890:           // qty_scheduled + qty_delivered + status en sm_request_lines.
 891:           // Las filas de delivery_observations sobreviven intactas — son
 892:           // evidencia histórica inmutable del reporte original del conductor.
 893:           const { data: eventLines } = await supabase
 894:             .from('trip_event_lines')
 895:             .select('request_line_id, quantity')
 896:             .eq('trip_event_id', revertEvent.id)
 897: 
 898:           for (const el of eventLines ?? []) {
 899:             const { data: tla } = await supabase
 900:               .from('trip_line_assignments')
 901:               .select('qty_delivered')
 902:               .eq('trip_id', trip.id)
 903:               .eq('request_line_id', el.request_line_id)
 904:               .single()
 905: 
 906:             await supabase
 907:               .from('trip_line_assignments')
 908:               .update({ qty_delivered: Math.max(0, (tla?.qty_delivered ?? 0) - el.quantity) })
 909:               .eq('trip_id', trip.id)
 910:               .eq('request_line_id', el.request_line_id)
 911:           }
 912: 
 913:           // Limpiar delivered_at en sm_request_lines: el trigger ya recalculó
 914:           // el status, pero delivered_at no es trigger-managed.
 915:           for (const el of eventLines ?? []) {
 916:             const { data: postTrigger } = await supabase
 917:               .from('sm_request_lines')
 918:               .select('status')
 919:               .eq('id', el.request_line_id)
 920:               .single()
 921: 
 922:             if (postTrigger?.status !== 'Entregada') {
 923:               await supabase
 924:                 .from('sm_request_lines')
 925:                 .update({ delivered_at: null })
 926:                 .eq('id', el.request_line_id)
 927:             }
 928:           }
 929:           // NO revertir ubicación de equipo — refleja realidad física
 930:         }
 931: 
 932:         if (eventType === 'Retorno') {
 933:           // Trip → En Ruta. NO tocar actual_arrival (pertenece a Llegada, no a Retorno).
 934:           await supabase
 935:             .from('trips')
 936:             .update({ status: 'En Ruta' })
 937:             .eq('id', trip.id)
 938:         }
 939: 
 940:         // 3. Reload
 941:         setRevertEvent(null)
 942:         const tripData = await fetchTrip(id)
 943:         setTrip(tripData)
 944:         await loadEvents()
 945:       } catch (err) {
 946:         setEventError(
 947:           err instanceof Error ? err.message : 'Error al revertir evento',
 948:         )
 949:       } finally {
 950:         setReverting(false)
 951:       }
 952:     },
 953:     [supabase, trip, person, revertEvent, fetchTrip, id, loadEvents],
 954:   )
