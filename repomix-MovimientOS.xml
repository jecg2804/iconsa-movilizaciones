283: }
</file>

<file path="src/components/programacion/CreatePickupOrderModal.tsx">
  1: 'use client'
  2: 
  3: import { useState, useMemo } from 'react'
  4: import { Wrench, Package } from 'lucide-react'
  5: import { Button } from '@/components/ui/Button'
  6: import { formatQty } from '@/lib/utils/format'
  7: import { todayStrInPanama } from '@/lib/utils/datetime'
  8: import type { BacklogLine } from '@/hooks/useTrips'
  9: import type { PickupOrderLineInput } from '@/hooks/usePickupOrders'
 10: 
 11: interface LineQuantityState {
 12:   request_line_id: string
 13:   quantity_assigned: string
 14: }
 15: 
 16: interface CreatePickupOrderModalProps {
 17:   selectedLines: BacklogLine[]
 18:   onConfirm: (lines: PickupOrderLineInput[], scheduledDate: string, notes: string | null) => Promise<void>
 19:   onClose: () => void
 20:   loading: boolean
 21:   error: string | null
 22: }
 23: 
 24: export function CreatePickupOrderModal({
 25:   selectedLines,
 26:   onConfirm,
 27:   onClose,
 28:   loading,
 29:   error,
 30: }: CreatePickupOrderModalProps) {
 31:   const initialState: LineQuantityState[] = useMemo(
 32:     () =>
 33:       selectedLines.map((line) => {
 34:         const available = Math.max(
 35:           0,
 36:           line.quantity - (line.qty_scheduled ?? 0) - (line.qty_delivered ?? 0),
 37:         )
 38:         return { request_line_id: line.id, quantity_assigned: String(available) }
 39:       }),
 40:     [selectedLines],
 41:   )
 42: 
 43:   // Default scheduled_date = MIN(selectedLines.request.date_required) (la fecha
 44:   // requerida más temprana). Si por algún motivo todas son null/inválidas,
 45:   // fallback a hoy en zona horaria de Panamá.
 46:   const defaultScheduledDate = useMemo(() => {
 47:     const dates = selectedLines
 48:       .map((l) => l.request.date_required)
 49:       .filter((d): d is string => Boolean(d) && /^\d{4}-\d{2}-\d{2}$/.test(d as string))
 50:     if (dates.length === 0) return todayStrInPanama()
 51:     return [...dates].sort()[0]
 52:   }, [selectedLines])
 53: 
 54:   const [quantities, setQuantities] = useState<LineQuantityState[]>(initialState)
 55:   const [scheduledDate, setScheduledDate] = useState<string>(defaultScheduledDate)
 56:   const [notes, setNotes] = useState('')
 57:   const [dateError, setDateError] = useState<string | null>(null)
 58: 
 59:   const handleQtyChange = (lineId: string, value: string) => {
 60:     setQuantities((prev) =>
 61:       prev.map((q) => (q.request_line_id === lineId ? { ...q, quantity_assigned: value } : q)),
 62:     )
 63:   }
 64: 
 65:   const handleSubmit = async () => {
 66:     if (!scheduledDate || !/^\d{4}-\d{2}-\d{2}$/.test(scheduledDate)) {
 67:       setDateError('La fecha programada es requerida.')
 68:       return
 69:     }
 70:     setDateError(null)
 71: 
 72:     const validLines: PickupOrderLineInput[] = quantities
 73:       .map((q) => ({
 74:         request_line_id: q.request_line_id,
 75:         quantity_assigned: parseFloat(q.quantity_assigned) || 0,
 76:       }))
 77:       .filter((l) => l.quantity_assigned > 0)
 78: 
 79:     if (validLines.length === 0) return
 80:     await onConfirm(validLines, scheduledDate, notes.trim() || null)
 81:   }
 82: 
 83:   return (
 84:     <div className="fixed inset-0 z-50 flex items-end justify-center bg-black/50 p-4 sm:items-center">
 85:       <div className="w-full max-w-2xl max-h-[90vh] overflow-y-auto rounded-t-2xl bg-white p-4 shadow-xl sm:rounded-2xl sm:p-6">
 86:         <h3 className="mb-4 text-lg font-semibold text-gray-900">
 87:           Aprobar pickup ({selectedLines.length} {selectedLines.length === 1 ? 'línea' : 'líneas'})
 88:         </h3>
 89: 
 90:         <div className="space-y-3">
 91:           {selectedLines.map((line) => {
 92:             const isEquipo = line.line_type === 'Equipo'
 93:             const available = Math.max(
 94:               0,
 95:               line.quantity - (line.qty_scheduled ?? 0) - (line.qty_delivered ?? 0),
 96:             )
 97:             const fromName = line.from_location?.name ?? line.from_text ?? '—'
 98:             const toName = line.to_location?.name ?? line.to_text ?? '—'
 99:             const unitCode = line.unit?.code ?? line.unit_text ?? ''
100:             const qty = quantities.find((q) => q.request_line_id === line.id)
101:             const parsedQty = parseFloat(qty?.quantity_assigned ?? '0') || 0
102:             const willInclude = parsedQty > 0
103: 
104:             return (
105:               <div
106:                 key={line.id}
107:                 className={`rounded-lg border p-3 ${willInclude ? 'border-amber-200 bg-amber-50/50' : 'border-gray-200 bg-gray-50/50 opacity-60'}`}
108:               >
109:                 <div className="flex items-center gap-2 mb-2">
110:                   {isEquipo ? (
111:                     <Wrench className="h-4 w-4 text-iconsa-blue" />
112:                   ) : (
113:                     <Package className="h-4 w-4 text-gold" />
114:                   )}
115:                   <span className="text-sm font-medium text-gray-900" title={line.description}>
116:                     {line.description}
117:                   </span>
118:                 </div>
119:                 <div className="flex items-center gap-2 text-xs text-iconsa-gray mb-2">
120:                   <span>{fromName} → {toName}</span>
121:                   <span className="text-gray-300">·</span>
122:                   <span>Disponible: {formatQty(available)} {unitCode}</span>
123:                 </div>
124:                 <div className="flex items-center gap-2">
125:                   <label className="text-xs text-gray-700 whitespace-nowrap">
126:                     Cantidad a aprobar:
127:                   </label>
128:                   <input
129:                     type="number"
130:                     min="0"
131:                     max={available}
132:                     step="1"
133:                     value={qty?.quantity_assigned ?? ''}
134:                     onChange={(e) => handleQtyChange(line.id, e.target.value)}
135:                     onFocus={(e) => e.target.select()}
136:                     disabled={loading}
137:                     className="w-24 rounded border border-gray-300 px-2 py-1 text-sm text-right focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
138:                   />
139:                   <span className="text-xs text-gray-500">{unitCode}</span>
140:                   {!willInclude && (
141:                     <span className="text-xs italic text-gray-500">No se incluirá</span>
142:                   )}
143:                 </div>
144:               </div>
145:             )
146:           })}
147:         </div>
148: 
149:         <div className="mt-4">
150:           <label htmlFor="pickup-order-scheduled-date" className="mb-1 block text-sm font-medium text-gray-700">
151:             Fecha programada <span className="text-red-600">*</span>
152:           </label>
153:           <input
154:             id="pickup-order-scheduled-date"
155:             type="date"
156:             value={scheduledDate}
157:             onChange={(e) => {
158:               setScheduledDate(e.target.value)
159:               if (dateError) setDateError(null)
160:             }}
161:             disabled={loading}
162:             className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
163:           />
164:           {dateError && <p className="mt-1 text-xs text-red-600">{dateError}</p>}
165:         </div>
166: 
167:         <div className="mt-4">
168:           <label htmlFor="pickup-order-notes" className="mb-1 block text-sm font-medium text-gray-700">
169:             Notas (opcional)
170:           </label>
171:           <textarea
172:             id="pickup-order-notes"
173:             value={notes}
174:             onChange={(e) => setNotes(e.target.value)}
175:             placeholder="Observaciones del pickup..."
176:             rows={2}
177:             maxLength={500}
178:             disabled={loading}
179:             className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
180:           />
181:         </div>
182: 
183:         {error && <p className="mt-3 text-sm text-red-600">{error}</p>}
184: 
185:         <div className="mt-4 flex items-center justify-end gap-3">
186:           <Button variant="ghost" size="sm" onClick={onClose} disabled={loading}>
187:             Cancelar
188:           </Button>
189:           <Button variant="primary" size="sm" onClick={handleSubmit} loading={loading}>
190:             Aprobar pickup
191:           </Button>
192:         </div>
193:       </div>
194:     </div>
195:   )
196: }
</file>

<file path="src/components/viajes/ParadaModal.tsx">
  1: 'use client'
  2: 
  3: import { useState, useCallback, useMemo } from 'react'
  4: import { MapPin, Wrench, Package } from 'lucide-react'
  5: import type { TripWithRelations } from '@/hooks/useTrips'
  6: import { Button } from '@/components/ui/Button'
  7: import FileUploader from '@/components/ui/FileUploader'
  8: import { formatQty } from '@/lib/utils/format'
  9: import type { Attachment } from '@/lib/supabase/storage'
 10: 
 11: export interface ParadaData {
 12:   location: string
 13:   lines: { request_line_id: string; line_status: string; quantity: number; notes?: string }[]
 14:   notes: string
 15:   attachments: Attachment[]
 16: }
 17: 
 18: interface ParadaModalProps {
 19:   trip: TripWithRelations
 20:   onConfirm: (data: ParadaData) => Promise<void>
 21:   onClose: () => void
 22:   loading: boolean
 23: }
 24: 
 25: const LINE_STATUSES = [
 26:   { value: 'completo', label: 'Completo' },
 27:   { value: 'parcial', label: 'Parcial' },
 28:   { value: 'no_disponible', label: 'No disponible' },
 29: ] as const
 30: 
 31: const OTHER_OPTION = '__OTHER__'
 32: 
 33: interface LocationOption {
 34:   label: string
 35: }
 36: 
 37: export function ParadaModal({ trip, onConfirm, onClose, loading }: ParadaModalProps) {
 38:   // Selección del dropdown: '' (sin elegir), label de opción, o OTHER_OPTION
 39:   const [selectedOption, setSelectedOption] = useState<string>('')
 40:   // Free-text aplica solo cuando selectedOption === OTHER_OPTION
 41:   const [freeText, setFreeText] = useState('')
 42:   const [notes, setNotes] = useState('')
 43:   const [attachments, setAttachments] = useState<Attachment[]>([])
 44:   const [selectedLines, setSelectedLines] = useState<Record<string, { checked: boolean; status: string; notes: string }>>({})
 45:   const [submitAttempted, setSubmitAttempted] = useState(false)
 46: 
 47:   // Construir opciones del dropdown desde las líneas del trip.
 48:   // Filtro lowercase 'proyecto' / 'taller' per Decisión 24 (BD verificada).
 49:   // Entradas con location_type=null o 'otro' pasan al dropdown.
 50:   // Dedup por label (Q4 confirmado en brainstorming).
 51:   const dropdownOptions = useMemo<LocationOption[]>(() => {
 52:     const seen = new Set<string>()
 53:     const opts: LocationOption[] = []
 54:     for (const a of trip.assignments) {
 55:       const line = a.line
 56:       if (!line) continue
 57:       const fromLabel = line.from_location?.name ?? line.from_text
 58:       const fromType = line.from_location?.location_type ?? null
 59:       if (fromLabel && fromType !== 'proyecto' && fromType !== 'taller') {
 60:         if (!seen.has(fromLabel)) {
 61:           seen.add(fromLabel)
 62:           opts.push({ label: fromLabel })
 63:         }
 64:       }
 65:       const toLabel = line.to_location?.name ?? line.to_text
 66:       const toType = line.to_location?.location_type ?? null
 67:       if (toLabel && toType !== 'proyecto' && toType !== 'taller') {
 68:         if (!seen.has(toLabel)) {
 69:           seen.add(toLabel)
 70:           opts.push({ label: toLabel })
 71:         }
 72:       }
 73:     }
 74:     return opts
 75:   }, [trip.assignments])
 76: 
 77:   const finalLocation =
 78:     selectedOption === OTHER_OPTION ? freeText.trim() : selectedOption
 79:   const checkedLineEntries = Object.entries(selectedLines).filter(([, v]) => v.checked)
 80:   const linesValid = checkedLineEntries.length >= 1
 81:   const attachmentsValid = attachments.length >= 1
 82:   const locationValid = finalLocation.length > 0
 83: 
 84:   const canConfirm = locationValid && linesValid && attachmentsValid && !loading
 85: 
 86:   const handleSelectChange = useCallback((value: string) => {
 87:     setSelectedOption(value)
 88:     if (value !== OTHER_OPTION) {
 89:       // Limpiar free-text al volver al dropdown (E2 confirmado)
 90:       setFreeText('')
 91:     }
 92:   }, [])
 93: 
 94:   const handleLineToggle = useCallback((lineId: string, checked: boolean) => {
 95:     setSelectedLines(prev => ({
 96:       ...prev,
 97:       [lineId]: {
 98:         ...prev[lineId],
 99:         checked,
100:         status: prev[lineId]?.status || 'completo',
101:         notes: prev[lineId]?.notes || '',
102:       },
103:     }))
104:   }, [])
105: 
106:   const handleLineStatusChange = useCallback((lineId: string, status: string) => {
107:     setSelectedLines(prev => ({
108:       ...prev,
109:       [lineId]: { ...prev[lineId], status },
110:     }))
111:   }, [])
112: 
113:   const handleLineNotesChange = useCallback((lineId: string, lineNotes: string) => {
114:     setSelectedLines(prev => ({
115:       ...prev,
116:       [lineId]: { ...prev[lineId], notes: lineNotes },
117:     }))
118:   }, [])
119: 
120:   const handleConfirm = useCallback(async () => {
121:     setSubmitAttempted(true)
122:     if (!canConfirm) return
123: 
124:     const checkedLines = checkedLineEntries.map(([id, v]) => {
125:       const assignment = trip.assignments.find(a => a.request_line_id === id)
126:       return {
127:         request_line_id: id,
128:         line_status: v.status,
129:         quantity: assignment?.quantity_assigned ?? 0,
130:         notes: v.notes.trim() || undefined,
131:       }
132:     })
133: 
134:     await onConfirm({
135:       location: finalLocation,
136:       lines: checkedLines,
137:       notes: notes.trim(),
138:       attachments,
139:     })
140:   }, [canConfirm, checkedLineEntries, finalLocation, notes, attachments, trip.assignments, onConfirm])
141: 
142:   return (
143:     <div className="fixed inset-0 z-50 flex items-end justify-center bg-black/50 p-4 sm:items-center">
144:       <div className="max-h-[90vh] w-full max-w-lg overflow-y-auto rounded-t-2xl bg-white p-4 shadow-xl sm:rounded-2xl sm:p-6">
145:         <div className="mb-4 flex items-center gap-2">
146:           <MapPin className="h-5 w-5 text-cyan-600" />
147:           <h3 className="text-lg font-semibold text-gray-900">
148:             Parada Intermedia — {trip.trip_id}
149:           </h3>
150:         </div>
151: 
152:         <div className="space-y-4">
153:           {/* Ubicación */}
154:           <div>
155:             <label htmlFor="parada-location-select" className="mb-1 block text-sm font-medium text-gray-700">
156:               Ubicación <span className="text-red-500">*</span>
157:             </label>
158:             <select
159:               id="parada-location-select"
160:               value={selectedOption}
161:               onChange={(e) => handleSelectChange(e.target.value)}
162:               className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500"
163:             >
164:               <option value="">Seleccionar...</option>
165:               {dropdownOptions.map((opt) => (
166:                 <option key={opt.label} value={opt.label}>📍 {opt.label}</option>
167:               ))}
168:               <option value={OTHER_OPTION}>✏️ Otra ubicación (escribir libre)</option>
169:             </select>
170:             {selectedOption === OTHER_OPTION && (
171:               <input
172:                 type="text"
173:                 value={freeText}
174:                 onChange={(e) => setFreeText(e.target.value)}
175:                 placeholder="Escriba la ubicación"
176:                 className="mt-2 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500"
177:               />
178:             )}
179:             {submitAttempted && !locationValid && (
180:               <p className="mt-1 text-xs text-red-600">La ubicación es requerida.</p>
181:             )}
182:           </div>
183: 
184:           {/* Líneas afectadas (siempre visible, requeridas ≥1) */}
185:           <div className="rounded-lg border border-gray-200">
186:             <div className="border-b border-gray-200 bg-gray-50 px-3 py-2 text-sm font-medium text-gray-700">
187:               Líneas afectadas <span className="text-red-500">*</span>
188:               <span className="ml-1 text-xs font-normal text-gray-500">(marcar al menos una)</span>
189:             </div>
190:             <div className="space-y-2 p-3">
191:               {trip.assignments.length === 0 && (
192:                 <p className="text-sm italic text-gray-500">El viaje no tiene líneas asignadas.</p>
193:               )}
194:               {trip.assignments.map((a) => {
195:                 const lineState = selectedLines[a.request_line_id]
196:                 return (
197:                   <div key={a.request_line_id} className="space-y-1">
198:                     <label className="flex items-center gap-2">
199:                       <input
200:                         type="checkbox"
201:                         data-testid={`parada-line-${a.request_line_id}`}
202:                         checked={lineState?.checked ?? false}
203:                         onChange={(e) => handleLineToggle(a.request_line_id, e.target.checked)}
204:                         className="accent-cyan-600"
205:                       />
206:                       {a.line?.line_type === 'Equipo' ? (
207:                         <Wrench className="h-3.5 w-3.5 shrink-0 text-iconsa-blue" />
208:                       ) : (
209:                         <Package className="h-3.5 w-3.5 shrink-0 text-iconsa-gold" />
210:                       )}
211:                       <span className="flex-1 truncate text-sm text-gray-700">
212:                         {a.line?.po_reference && (
213:                           <span className="mr-2 font-mono text-xs text-iconsa-gray">
214:                             OC {a.line.po_reference}
215:                           </span>
216:                         )}
217:                         {a.line?.description ?? 'Línea'}
218:                       </span>
219:                       <span className="text-xs text-iconsa-gray">
220:                         {formatQty(a.quantity_assigned)} {a.line?.unit?.code ?? ''}
221:                       </span>
222:                     </label>
223:                     {lineState?.checked && (
224:                       <div className="ml-6 flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-2">
225:                         <select
226:                           aria-label="Estado de la línea"
227:                           value={lineState.status}
228:                           onChange={(e) => handleLineStatusChange(a.request_line_id, e.target.value)}
229:                           className="rounded border border-gray-300 px-2 py-1 text-xs focus:border-cyan-500 focus:outline-none"
230:                         >
231:                           {LINE_STATUSES.map((ls) => (
232:                             <option key={ls.value} value={ls.value}>{ls.label}</option>
233:                           ))}
234:                         </select>
235:                         <input
236:                           type="text"
237:                           value={lineState.notes}
238:                           onChange={(e) => handleLineNotesChange(a.request_line_id, e.target.value)}
239:                           placeholder="Notas (ej: faltan 65 tubos)"
240:                           className="flex-1 rounded border border-gray-300 px-2 py-1 text-xs placeholder:text-gray-400 focus:border-cyan-500 focus:outline-none"
241:                         />
242:                       </div>
243:                     )}
244:                   </div>
245:                 )
246:               })}
247:             </div>
248:             {submitAttempted && !linesValid && (
249:               <p className="border-t border-gray-200 px-3 py-2 text-xs text-red-600">
250:                 Marcar al menos una línea afectada.
251:               </p>
252:             )}
253:           </div>
254: 
255:           {/* Foto de factura (requerida ≥1) */}
256:           <div>
257:             <FileUploader
258:               attachments={attachments}
259:               folder={`events/${trip.id}`}
260:               onChange={setAttachments}
261:               label="Foto de factura *"
262:               hint="Foto / PDF (max 10MB). Al menos 1 archivo requerido."
263:             />
264:             {submitAttempted && !attachmentsValid && (
265:               <p className="mt-1 text-xs text-red-600">Subir al menos un archivo (foto de factura).</p>
266:             )}
267:           </div>
268: 
269:           {/* Notas generales (opcional) */}
270:           <div>
271:             <label htmlFor="parada-notes" className="mb-1 block text-sm font-medium text-gray-700">
272:               Notas generales (opcional)
273:             </label>
274:             <textarea
275:               id="parada-notes"
276:               value={notes}
277:               onChange={(e) => setNotes(e.target.value)}
278:               placeholder="Ej: Material parcial, restan 65 tubos PVC para el jueves"
279:               rows={2}
280:               className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500"
281:             />
282:           </div>
283:         </div>
284: 
285:         <div className="mt-5 flex gap-2">
286:           <Button variant="primary" onClick={handleConfirm} loading={loading} disabled={loading}>
287:             Registrar Parada
288:           </Button>
289:           <Button variant="ghost" onClick={onClose} disabled={loading}>
290:             Cancelar
291:           </Button>
292:         </div>
293:       </div>
294:     </div>
295:   )
296: }
</file>

<file path="src/hooks/useExternalOrders.ts">
  1: 'use client'
  2: 
  3: import { useState, useCallback, useMemo } from 'react'
  4: import { createClient } from '@/lib/supabase/client'
  5: import type { Attachment } from '@/lib/supabase/storage'
  6: 
  7: export interface ExternalOrderLineInput {
  8:   request_line_id: string
  9:   quantity_assigned: number
 10: }
 11: 
 12: export interface CreateExternalOrderResult {
 13:   ok: boolean
 14:   orderId?: string
 15:   externalId?: string  // EXT-2026-NNN auto-gen por trigger BD
 16:   error?: string
 17: }
 18: 
 19: export interface CompleteExternalResult {
 20:   ok: boolean
 21:   error?: string
 22: }
 23: 
 24: export interface CancelExternalResult {
 25:   ok: boolean
 26:   deliveredCount?: number
 27:   deliveredQty?: number
 28:   error?: string
 29: }
 30: 
 31: export interface RemoveLineExternalResult {
 32:   ok: boolean
 33:   orderCancelled?: boolean
 34:   orderId?: string
 35:   error?: string
 36: }
 37: 
 38: function translateBdError(message: string): string {
 39:   if (message.includes('qty_invariant') || message.includes('sm_request_lines_qty_invariant')) {
 40:     return 'Esta línea ya fue asignada en otro fulfillment. Refrescá la página.'
 41:   }
 42:   return message
 43: }
 44: 
 45: /**
 46:  * Hook de operaciones external_orders (Cambio 5 — modelo bulk).
 47:  * Reemplaza el modelo flag-en-línea de Cambio 4 (useExternal eliminado en T1).
 48:  *
 49:  * 4 funciones paralelas a usePickupOrders + provider/invoice/cost:
 50:  * - createExternalOrder: validaciones strict (provider trim, amount > 0,
 51:  *   attachments.length >= 1) + crea order con metadata + N order_lines.
 52:  * - completeExternalOrder: paralelo a completePickupOrder.
 53:  * - cancelExternalOrder: paralelo + PRESERVA invoice_attachments (Q4
 54:  *   cerrado en Cambio 4 — Storage cleanup async no vale la pena v1).
 55:  * - removeLineFromExternalOrder: paralelo + auto_cancel_empty.
 56:  */
 57: export function useExternalOrders() {
 58:   const supabase = useMemo(() => createClient(), [])
 59:   const [loading, setLoading] = useState(false)
 60:   const [error, setError] = useState<string | null>(null)
 61: 
 62:   const createExternalOrder = useCallback(
 63:     async (
 64:       charrisId: string,
 65:       lines: ExternalOrderLineInput[],
 66:       providerName: string,
 67:       invoiceAmount: number,
 68:       invoiceAttachments: Attachment[],
 69:       scheduledDate: string,
 70:       notes?: string | null,
 71:     ): Promise<CreateExternalOrderResult> => {
 72:       setLoading(true)
 73:       setError(null)
 74: 
 75:       try {
 76:         if (lines.length === 0) {
 77:           const msg = 'Debe seleccionar al menos una línea para aprobar viaje externo.'
 78:           setError(msg)
 79:           return { ok: false, error: msg }
 80:         }
 81:         if (providerName.trim() === '') {
 82:           const msg = 'El nombre del proveedor es requerido.'
 83:           setError(msg)
 84:           return { ok: false, error: msg }
 85:         }
 86:         if (invoiceAmount <= 0) {
 87:           const msg = 'El costo del servicio debe ser mayor a cero.'
 88:           setError(msg)
 89:           return { ok: false, error: msg }
 90:         }
 91:         if (invoiceAttachments.length === 0) {
 92:           const msg = 'Adjunta al menos una cotización o factura.'
 93:           setError(msg)
 94:           return { ok: false, error: msg }
 95:         }
 96:         // Cambio 5 polish-#5b: scheduled_date NOT NULL, validación strict
 97:         if (!scheduledDate || !/^\d{4}-\d{2}-\d{2}$/.test(scheduledDate)) {
 98:           const msg = 'La fecha programada es requerida (formato YYYY-MM-DD).'
 99:           setError(msg)
100:           return { ok: false, error: msg }
101:         }
102: 
103:         // Validar quantities pre-INSERT (mismo patrón que usePickupOrders)
104:         const lineIds = lines.map((l) => l.request_line_id)
105:         const { data: dbLines, error: fetchError } = await supabase
106:           .from('sm_request_lines')
107:           .select('id, quantity, qty_scheduled, qty_delivered, description')
108:           .in('id', lineIds)
109: 
110:         if (fetchError || !dbLines) {
111:           const msg = fetchError?.message ?? 'Error al validar líneas'
112:           setError(msg)
113:           return { ok: false, error: msg }
114:         }
115: 
116:         for (const input of lines) {
117:           if (input.quantity_assigned <= 0) {
118:             const msg = `Cantidad inválida (${input.quantity_assigned}). Debe ser mayor a cero.`
119:             setError(msg)
120:             return { ok: false, error: msg }
121:           }
122:           const dbLine = dbLines.find((dl) => dl.id === input.request_line_id)
123:           if (!dbLine) {
124:             const msg = `Línea ${input.request_line_id.slice(0, 8)} no encontrada.`
125:             setError(msg)
126:             return { ok: false, error: msg }
127:           }
128:           const available = dbLine.quantity - (dbLine.qty_scheduled ?? 0) - (dbLine.qty_delivered ?? 0)
129:           if (input.quantity_assigned > available) {
130:             const msg = `"${dbLine.description}": cantidad ${input.quantity_assigned} excede disponible (${available}).`
131:             setError(msg)
132:             return { ok: false, error: msg }
133:           }
134:         }
135: 
136:         // INSERT external_orders header con provider/invoice/cost + scheduled_date
137:         const { data: orderRow, error: insertError } = await supabase
138:           .from('external_orders')
139:           .insert({
140:             status: 'Aprobado',
141:             approved_by: charrisId,
142:             approved_at: new Date().toISOString(),
143:             scheduled_date: scheduledDate,
144:             provider_name: providerName.trim(),
145:             invoice_amount: invoiceAmount,
146:             invoice_attachments: JSON.parse(JSON.stringify(invoiceAttachments)),
147:             notes: notes?.trim() || null,
148:             created_by: charrisId,
149:           })
150:           .select('id, external_id')
151:           .single()
152: 
153:         if (insertError || !orderRow) {
154:           const friendly = translateBdError(insertError?.message ?? 'Error al crear external order')
155:           setError(friendly)
156:           return { ok: false, error: friendly }
157:         }
158: 
159:         // INSERT external_order_lines (bulk)
160:         const linesPayload = lines.map((l) => ({
161:           external_order_id: orderRow.id,
162:           request_line_id: l.request_line_id,
163:           quantity_assigned: l.quantity_assigned,
164:           qty_delivered: 0,
165:         }))
166: 
167:         const { error: linesError } = await supabase
168:           .from('external_order_lines')
169:           .insert(linesPayload)
170: 
171:         if (linesError) {
172:           await supabase.from('external_orders').delete().eq('id', orderRow.id)
173:           const friendly = translateBdError(linesError.message)
174:           setError(friendly)
175:           return { ok: false, error: friendly }
176:         }
177: 
178:         return { ok: true, orderId: orderRow.id, externalId: orderRow.external_id ?? undefined }
179:       } catch (err) {
180:         const message = err instanceof Error ? err.message : 'Error inesperado al crear external order'
181:         setError(message)
182:         return { ok: false, error: message }
183:       } finally {
184:         setLoading(false)
185:       }
186:     },
187:     [supabase],
188:   )
189: 
190:   const completeExternalOrder = useCallback(
191:     async (
192:       orderId: string,
193:       completedById: string,
194:       receivedById: string | null,
195:       receivedByName: string,
196:       notes: string,
197:       additionalAttachments: Attachment[],
198:     ): Promise<CompleteExternalResult> => {
199:       setLoading(true)
200:       setError(null)
201: 
202:       try {
203:         const now = new Date().toISOString()
204: 
205:         // SELECT existing notes + invoice_attachments
206:         const { data: existing, error: fetchError } = await supabase
207:           .from('external_orders')
208:           .select('notes, invoice_attachments')
209:           .eq('id', orderId)
210:           .single()
211: 
212:         if (fetchError || !existing) {
213:           const msg = fetchError?.message ?? 'External order no encontrado'
214:           setError(msg)
215:           return { ok: false, error: msg }
216:         }
217: 
218:         // Append additionalAttachments al invoice_attachments existente
219:         const existingAttachments = Array.isArray(existing.invoice_attachments)
220:           ? (existing.invoice_attachments as unknown as Attachment[])
221:           : []
222:         const finalAttachments = [...existingAttachments, ...additionalAttachments]
223: 
224:         const trimmedNotes = notes.trim()
225:         const finalNotes = trimmedNotes
226:           ? (existing.notes ? `${existing.notes}\n\n[Entrega ${now}] ${trimmedNotes}` : trimmedNotes)
227:           : existing.notes ?? null
228: 
229:         // UPDATE external_order_lines (todo-o-nada)
230:         const { data: orderLines, error: linesError } = await supabase
231:           .from('external_order_lines')
232:           .select('id, quantity_assigned')
233:           .eq('external_order_id', orderId)
234: 
235:         if (linesError || !orderLines) {
236:           setError(linesError?.message ?? 'Error al obtener líneas')
237:           return { ok: false, error: linesError?.message ?? 'Líneas no encontradas' }
238:         }
239: 
240:         for (const line of orderLines) {
241:           const { error: updateLineError } = await supabase
242:             .from('external_order_lines')
243:             .update({ qty_delivered: line.quantity_assigned })
244:             .eq('id', line.id)
245:           if (updateLineError) {
246:             setError(updateLineError.message)
247:             return { ok: false, error: updateLineError.message }
248:           }
249:         }
250: 
251:         const { error: orderUpdateError } = await supabase
252:           .from('external_orders')
253:           .update({
254:             status: 'Entregado',
255:             completed_at: now,
256:             completed_by: completedById,
257:             received_by_id: receivedById,
258:             received_by_name: receivedByName.trim() || null,
259:             notes: finalNotes,
260:             invoice_attachments: JSON.parse(JSON.stringify(finalAttachments)),
261:           })
262:           .eq('id', orderId)
263:           .eq('status', 'Aprobado')
264:           .select('id')
265: 
266:         if (orderUpdateError) {
267:           setError(orderUpdateError.message)
268:           return { ok: false, error: orderUpdateError.message }
269:         }
270: 
271:         return { ok: true }
272:       } catch (err) {
273:         const message = err instanceof Error ? err.message : 'Error inesperado al completar external order'
274:         setError(message)
275:         return { ok: false, error: message }
276:       } finally {
277:         setLoading(false)
278:       }
279:     },
280:     [supabase],
281:   )
282: 
283:   /**
284:    * Cancela external_order. PERMITIDO con qty_delivered > 0.
285:    * PRESERVA invoice_attachments (NO se setea a NULL — Q4 cerrado en Cambio 4).
286:    * Storage cleanup async no vale la pena v1.
287:    */
288:   const cancelExternalOrder = useCallback(
289:     async (
290:       orderId: string,
291:       cancelledById: string,
292:       cancellationReason: string | null,
293:     ): Promise<CancelExternalResult> => {
294:       setLoading(true)
295:       setError(null)
296: 
297:       try {
298:         const { data: lines, error: fetchError } = await supabase
299:           .from('external_order_lines')
300:           .select('id, qty_delivered')
301:           .eq('external_order_id', orderId)
302: 
303:         if (fetchError || !lines) {
304:           const msg = fetchError?.message ?? 'External order no encontrado'
305:           setError(msg)
306:           return { ok: false, error: msg }
307:         }
308: 
309:         const deliveredLines = lines.filter((l) => (l.qty_delivered ?? 0) > 0)
310:         const deliveredCount = deliveredLines.length
311:         const deliveredQty = deliveredLines.reduce((sum, l) => sum + (l.qty_delivered ?? 0), 0)
312: 
313:         // UPDATE external_orders SET status='Cancelado' + cancellation_reason
314:         // Cambio 6: trigger BD enforce_cancellation_reason_external_orders
315:         // ataja si deliveredCount>0 y razón inválida (≥10 chars).
316:         // NOTA: NO setear invoice_attachments a NULL — preservar (Q4 Cambio 4)
317:         const { error: updateError } = await supabase
318:           .from('external_orders')
319:           .update({
320:             status: 'Cancelado',
321:             cancelled_at: new Date().toISOString(),
322:             cancelled_by: cancelledById,
323:             cancellation_reason: cancellationReason?.trim() || null,
324:           })
325:           .eq('id', orderId)
326:           .eq('status', 'Aprobado')
327:           .select('id')
328: 
329:         if (updateError) {
330:           const friendly = updateError.message.includes('cancellation_reason requerido')
331:             ? 'Debes proveer una razón (≥10 caracteres) para cancelar este viaje externo porque tiene entregas registradas.'
332:             : updateError.message
333:           setError(friendly)
334:           return { ok: false, error: friendly }
335:         }
336: 
337:         return { ok: true, deliveredCount, deliveredQty }
338:       } catch (err) {
339:         const message = err instanceof Error ? err.message : 'Error inesperado al cancelar external order'
340:         setError(message)
341:         return { ok: false, error: message }
342:       } finally {
343:         setLoading(false)
344:       }
345:     },
346:     [supabase],
347:   )
348: 
349:   const removeLineFromExternalOrder = useCallback(
350:     async (
351:       orderId: string,
352:       externalOrderLineId: string,
353:     ): Promise<RemoveLineExternalResult> => {
354:       setLoading(true)
355:       setError(null)
356: 
357:       try {
358:         const { error: deleteError } = await supabase
359:           .from('external_order_lines')
360:           .delete()
361:           .eq('id', externalOrderLineId)
362: 
363:         if (deleteError) {
364:           setError(deleteError.message)
365:           return { ok: false, error: deleteError.message }
366:         }
367: 
368:         const { data: orderRow, error: fetchError } = await supabase
369:           .from('external_orders')
370:           .select('id, external_id, status')
371:           .eq('id', orderId)
372:           .single()
373: 
374:         if (fetchError || !orderRow) {
375:           return { ok: true, orderCancelled: true }
376:         }
377: 
378:         const orderCancelled = orderRow.status === 'Cancelado'
379:         return {
380:           ok: true,
381:           orderCancelled,
382:           orderId: orderCancelled ? (orderRow.external_id ?? undefined) : undefined,
383:         }
384:       } catch (err) {
385:         const message = err instanceof Error ? err.message : 'Error inesperado al eliminar línea'
386:         setError(message)
387:         return { ok: false, error: message }
388:       } finally {
389:         setLoading(false)
390:       }
391:     },
392:     [supabase],
393:   )
394: 
395:   return {
396:     loading,
397:     error,
398:     createExternalOrder,
399:     completeExternalOrder,
400:     cancelExternalOrder,
401:     removeLineFromExternalOrder,
402:   }
403: }
</file>

<file path="src/hooks/usePickupOrders.ts">
  1: 'use client'
  2: 
  3: import { useState, useCallback, useMemo } from 'react'
  4: import { createClient } from '@/lib/supabase/client'
  5: 
  6: export interface PickupOrderLineInput {
  7:   request_line_id: string
  8:   quantity_assigned: number
  9: }
 10: 
 11: export interface CreatePickupOrderResult {
 12:   ok: boolean
 13:   orderId?: string
 14:   pickupId?: string  // PKP-2026-NNN auto-generado por trigger BD
 15:   error?: string
 16: }
 17: 
 18: export interface CompletePickupResult {
 19:   ok: boolean
 20:   error?: string
 21: }
 22: 
 23: export interface CancelPickupResult {
 24:   ok: boolean
 25:   deliveredCount?: number  // # líneas con qty_delivered > 0 (para UI confirmation modal)
 26:   deliveredQty?: number    // SUM qty_delivered total
 27:   error?: string
 28: }
 29: 
 30: export interface RemoveLineResult {
 31:   ok: boolean
 32:   orderCancelled?: boolean   // true si era última línea (auto_cancel_empty trigger se disparó)
 33:   orderId?: string           // PKP-... para toast UI
 34:   error?: string
 35: }
 36: 
 37: /**
 38:  * Traduce errores BD a mensajes user-friendly. CHECK constraint qty_invariant
 39:  * se triggerea en race condition (2 sesiones de Charris asignando la misma
 40:  * línea a fulfillments diferentes simultáneamente). Error PostgreSQL críptico
 41:  * se convierte a mensaje accionable.
 42:  */
 43: function translateBdError(message: string): string {
 44:   if (message.includes('qty_invariant') || message.includes('sm_request_lines_qty_invariant')) {
 45:     return 'Esta línea ya fue asignada en otro fulfillment. Refrescá la página.'
 46:   }
 47:   return message
 48: }
 49: 
 50: /**
 51:  * Hook de operaciones pickup_orders (Cambio 5 — modelo bulk).
 52:  * Reemplaza el modelo flag-en-línea de Cambio 3 (usePickup eliminado en T1).
 53:  *
 54:  * 4 funciones:
 55:  * - createPickupOrder: crea pickup_order + N pickup_order_lines en una transacción.
 56:  *   Trigger BD recalcula sm_request_lines.qty_scheduled automáticamente.
 57:  * - completePickupOrder: marca order como Entregado, setea qty_delivered=quantity_assigned
 58:  *   per línea (todo-o-nada v1). Trigger recalcula qty_delivered + status de las líneas.
 59:  * - cancelPickupOrder: UPDATE pickup_orders.status='Cancelado'. Trigger recalcula:
 60:  *   qty_scheduled de no-entregadas vuelve a 0, qty_delivered HISTÓRICA preservada.
 61:  *   PERMITIDO con qty_delivered>0 — pre-flight stats para UI confirmation modal.
 62:  * - removeLineFromPickupOrder: DELETE de pickup_order_lines. Si era la última línea,
 63:  *   auto_cancel_empty_pickup_order trigger cancela el order automáticamente.
 64:  *   Hook detecta count post-DELETE y devuelve { orderCancelled, orderId } para toast.
 65:  */
 66: export function usePickupOrders() {
 67:   const supabase = useMemo(() => createClient(), [])
 68:   const [loading, setLoading] = useState(false)
 69:   const [error, setError] = useState<string | null>(null)
 70: 
 71:   /**
 72:    * Crea pickup_order con N líneas. Validaciones:
 73:    * - lines.length > 0
 74:    * - cada quantity_assigned > 0
 75:    * - cada quantity_assigned <= available (quantity - qty_scheduled - qty_delivered)
 76:    *
 77:    * Trigger BD recalc_qty_for_line se dispara automáticamente desde el INSERT
 78:    * en pickup_order_lines y actualiza sm_request_lines.qty_scheduled.
 79:    */
 80:   const createPickupOrder = useCallback(
 81:     async (
 82:       charrisId: string,
 83:       lines: PickupOrderLineInput[],
 84:       scheduledDate: string,
 85:       notes?: string | null,
 86:     ): Promise<CreatePickupOrderResult> => {
 87:       setLoading(true)
 88:       setError(null)
 89: 
 90:       try {
 91:         if (lines.length === 0) {
 92:           const msg = 'Debe seleccionar al menos una línea para aprobar pickup.'
 93:           setError(msg)
 94:           return { ok: false, error: msg }
 95:         }
 96: 
 97:         // Cambio 5 polish-#5b: scheduled_date NOT NULL, validación strict
 98:         if (!scheduledDate || !/^\d{4}-\d{2}-\d{2}$/.test(scheduledDate)) {
 99:           const msg = 'La fecha programada es requerida (formato YYYY-MM-DD).'
100:           setError(msg)
101:           return { ok: false, error: msg }
102:         }
103: 
104:         // 1. Validar quantities pre-INSERT con SELECT fresh
105:         const lineIds = lines.map((l) => l.request_line_id)
106:         const { data: dbLines, error: fetchError } = await supabase
107:           .from('sm_request_lines')
108:           .select('id, quantity, qty_scheduled, qty_delivered, description')
109:           .in('id', lineIds)
110: 
111:         if (fetchError || !dbLines) {
112:           const msg = fetchError?.message ?? 'Error al validar líneas'
113:           setError(msg)
114:           return { ok: false, error: msg }
115:         }
116: 
117:         for (const input of lines) {
118:           if (input.quantity_assigned <= 0) {
119:             const msg = `Cantidad inválida (${input.quantity_assigned}). Debe ser mayor a cero.`
120:             setError(msg)
121:             return { ok: false, error: msg }
122:           }
123:           const dbLine = dbLines.find((dl) => dl.id === input.request_line_id)
124:           if (!dbLine) {
125:             const msg = `Línea ${input.request_line_id.slice(0, 8)} no encontrada.`
126:             setError(msg)
127:             return { ok: false, error: msg }
128:           }
129:           const available = dbLine.quantity - (dbLine.qty_scheduled ?? 0) - (dbLine.qty_delivered ?? 0)
130:           if (input.quantity_assigned > available) {
131:             const msg = `"${dbLine.description}": cantidad ${input.quantity_assigned} excede disponible (${available}).`
132:             setError(msg)
133:             return { ok: false, error: msg }
134:           }
135:         }
136: 
137:         // 2. INSERT pickup_orders header
138:         const { data: orderRow, error: insertError } = await supabase
139:           .from('pickup_orders')
140:           .insert({
141:             status: 'Aprobado',
142:             approved_by: charrisId,
143:             approved_at: new Date().toISOString(),
144:             scheduled_date: scheduledDate,
145:             notes: notes?.trim() || null,
146:             created_by: charrisId,
147:           })
148:           .select('id, pickup_id')
149:           .single()
150: 
151:         if (insertError || !orderRow) {
152:           const friendly = translateBdError(insertError?.message ?? 'Error al crear pickup order')
153:           setError(friendly)
154:           return { ok: false, error: friendly }
155:         }
156: 
157:         // 3. INSERT pickup_order_lines (bulk)
158:         const linesPayload = lines.map((l) => ({
159:           pickup_order_id: orderRow.id,
160:           request_line_id: l.request_line_id,
161:           quantity_assigned: l.quantity_assigned,
162:           qty_delivered: 0,
163:         }))
164: 
165:         const { error: linesError } = await supabase
166:           .from('pickup_order_lines')
167:           .insert(linesPayload)
168: 
169:         if (linesError) {
170:           // Rollback: DELETE el order para no dejar huérfano
171:           await supabase.from('pickup_orders').delete().eq('id', orderRow.id)
172:           const friendly = translateBdError(linesError.message)
173:           setError(friendly)
174:           return { ok: false, error: friendly }
175:         }
176: 
177:         // Trigger BD recalc_qty_for_line ya actualizó sm_request_lines.qty_scheduled
178:         return { ok: true, orderId: orderRow.id, pickupId: orderRow.pickup_id ?? undefined }
179:       } catch (err) {
180:         const message = err instanceof Error ? err.message : 'Error inesperado al crear pickup order'
181:         setError(message)
182:         return { ok: false, error: message }
183:       } finally {
184:         setLoading(false)
185:       }
186:     },
187:     [supabase],
188:   )
189: 
190:   /**
191:    * Completa pickup_order: setea qty_delivered = quantity_assigned per línea
192:    * (todo-o-nada v1) y status='Entregado'. Trigger BD recalcula qty_delivered
193:    * + status de las sm_request_lines automáticamente.
194:    *
195:    * receivedById/receivedByName son OPCIONALES (no XOR). Ambos pueden ser NULL.
196:    */
197:   const completePickupOrder = useCallback(
198:     async (
199:       orderId: string,
200:       completedById: string,
201:       receivedById: string | null,
202:       receivedByName: string,
203:       notes: string,
204:       additionalAttachments: unknown[],
205:     ): Promise<CompletePickupResult> => {
206:       setLoading(true)
207:       setError(null)
208: 
209:       try {
210:         const now = new Date().toISOString()
211: 
212:         // 1. SELECT existing attachments + notes para append
213:         const { data: existing, error: fetchError } = await supabase
214:           .from('pickup_orders')
215:           .select('attachments, notes')
216:           .eq('id', orderId)
217:           .single()
218: 
219:         if (fetchError || !existing) {
220:           const msg = fetchError?.message ?? 'Pickup order no encontrado'
221:           setError(msg)
222:           return { ok: false, error: msg }
223:         }
224: 
225:         const existingAttachments = Array.isArray(existing.attachments)
226:           ? (existing.attachments as unknown[])
227:           : []
228:         const finalAttachments = [...existingAttachments, ...additionalAttachments]
229: 
230:         const trimmedNotes = notes.trim()
231:         const finalNotes = trimmedNotes
232:           ? (existing.notes ? `${existing.notes}\n\n[Entrega ${now}] ${trimmedNotes}` : trimmedNotes)
233:           : existing.notes ?? null
234: 
235:         // 2. UPDATE pickup_order_lines: qty_delivered = quantity_assigned (todo-o-nada)
236:         const { data: orderLines, error: linesError } = await supabase
237:           .from('pickup_order_lines')
238:           .select('id, quantity_assigned')
239:           .eq('pickup_order_id', orderId)
240: 
241:         if (linesError || !orderLines) {
242:           setError(linesError?.message ?? 'Error al obtener líneas del order')
243:           return { ok: false, error: linesError?.message ?? 'Líneas no encontradas' }
244:         }
245: 
246:         for (const line of orderLines) {
247:           const { error: updateLineError } = await supabase
248:             .from('pickup_order_lines')
249:             .update({ qty_delivered: line.quantity_assigned })
250:             .eq('id', line.id)
251:           if (updateLineError) {
252:             setError(updateLineError.message)
253:             return { ok: false, error: updateLineError.message }
254:           }
255:         }
256: 
257:         // 3. UPDATE pickup_orders: status='Entregado' + completed_at + receptor + notas + attachments
258:         const { error: orderUpdateError } = await supabase
259:           .from('pickup_orders')
260:           .update({
261:             status: 'Entregado',
262:             completed_at: now,
263:             completed_by: completedById,
264:             received_by_id: receivedById,
265:             received_by_name: receivedByName.trim() || null,
266:             notes: finalNotes,
267:             attachments: JSON.parse(JSON.stringify(finalAttachments)),
268:           })
269:           .eq('id', orderId)
270:           .eq('status', 'Aprobado')  // WHERE defensive
271:           .select('id')
272: 
273:         if (orderUpdateError) {
274:           setError(orderUpdateError.message)
275:           return { ok: false, error: orderUpdateError.message }
276:         }
277: 
278:         return { ok: true }
279:       } catch (err) {
280:         const message = err instanceof Error ? err.message : 'Error inesperado al completar pickup order'
281:         setError(message)
282:         return { ok: false, error: message }
283:       } finally {
284:         setLoading(false)
285:       }
286:     },
287:     [supabase],
288:   )
289: 
290:   /**
291:    * Cancela pickup_order. PERMITIDO con qty_delivered > 0.
292:    * Trigger BD preserva qty_delivered HISTÓRICA — entregas son hechos físicos
293:    * que sobreviven al cancel.
294:    *
295:    * Pre-flight SELECT devuelve stats para que UI muestre confirmation modal
296:    * con copy contextual: "Las {N} líneas ya entregadas ({Q} unidades) quedan
297:    * registradas como entregadas. ¿Confirmar?"
298:    */
299:   const cancelPickupOrder = useCallback(
300:     async (
301:       orderId: string,
302:       cancelledById: string,
303:       cancellationReason: string | null,
304:     ): Promise<CancelPickupResult> => {
305:       setLoading(true)
306:       setError(null)
307: 
308:       try {
309:         // Pre-flight stats
310:         const { data: lines, error: fetchError } = await supabase
311:           .from('pickup_order_lines')
312:           .select('id, qty_delivered')
313:           .eq('pickup_order_id', orderId)
314: 
315:         if (fetchError || !lines) {
316:           const msg = fetchError?.message ?? 'Pickup order no encontrado'
317:           setError(msg)
318:           return { ok: false, error: msg }
319:         }
320: 
321:         const deliveredLines = lines.filter((l) => (l.qty_delivered ?? 0) > 0)
322:         const deliveredCount = deliveredLines.length
323:         const deliveredQty = deliveredLines.reduce((sum, l) => sum + (l.qty_delivered ?? 0), 0)
324: 
325:         // UPDATE pickup_orders SET status='Cancelado' + cancellation_reason
326:         // Cambio 6: trigger BD enforce_cancellation_reason_pickup_orders ataja
327:         // si deliveredCount>0 y razón inválida (≥10 chars).
328:         const { error: updateError } = await supabase
329:           .from('pickup_orders')
330:           .update({
331:             status: 'Cancelado',
332:             cancelled_at: new Date().toISOString(),
333:             cancelled_by: cancelledById,
334:             cancellation_reason: cancellationReason?.trim() || null,
335:           })
336:           .eq('id', orderId)
337:           .eq('status', 'Aprobado')  // WHERE defensive
338:           .select('id')
339: 
340:         if (updateError) {
341:           const friendly = updateError.message.includes('cancellation_reason requerido')
342:             ? 'Debes proveer una razón (≥10 caracteres) para cancelar este pickup porque tiene entregas registradas.'
343:             : updateError.message
344:           setError(friendly)
345:           return { ok: false, error: friendly }
346:         }
347: 
348:         // Trigger BD ya recalculó: qty_scheduled de no-entregadas → 0,
349:         // qty_delivered HISTÓRICA preservada.
350:         return { ok: true, deliveredCount, deliveredQty }
351:       } catch (err) {
352:         const message = err instanceof Error ? err.message : 'Error inesperado al cancelar pickup order'
353:         setError(message)
354:         return { ok: false, error: message }
355:       } finally {
356:         setLoading(false)
357:       }
358:     },
359:     [supabase],
360:   )
361: 
362:   /**
363:    * Elimina una línea de pickup_order. Si era la última línea, el trigger BD
364:    * auto_cancel_empty_pickup_order cancela el order automáticamente.
365:    *
366:    * Hook detecta count post-DELETE y devuelve { orderCancelled, orderId }
367:    * para que UI muestre toast: "Pickup PKP-2026-X cancelado al eliminar
368:    * última línea".
369:    */
370:   const removeLineFromPickupOrder = useCallback(
371:     async (
372:       orderId: string,
373:       pickupOrderLineId: string,
374:     ): Promise<RemoveLineResult> => {
375:       setLoading(true)
376:       setError(null)
377: 
378:       try {
379:         // 1. DELETE de pickup_order_lines
380:         const { error: deleteError } = await supabase
381:           .from('pickup_order_lines')
382:           .delete()
383:           .eq('id', pickupOrderLineId)
384: 
385:         if (deleteError) {
386:           setError(deleteError.message)
387:           return { ok: false, error: deleteError.message }
388:         }
389: 
390:         // 2. SELECT count remaining + status del order (post-trigger)
391:         const { data: orderRow, error: fetchError } = await supabase
392:           .from('pickup_orders')
393:           .select('id, pickup_id, status')
394:           .eq('id', orderId)
395:           .single()
396: 
397:         if (fetchError || !orderRow) {
398:           // Order ya fue eliminado o no existe — asumir cancelled
399:           return { ok: true, orderCancelled: true }
400:         }
401: 
402:         const orderCancelled = orderRow.status === 'Cancelado'
403:         return {
404:           ok: true,
405:           orderCancelled,
406:           orderId: orderCancelled ? (orderRow.pickup_id ?? undefined) : undefined,
407:         }
408:       } catch (err) {
409:         const message = err instanceof Error ? err.message : 'Error inesperado al eliminar línea'
410:         setError(message)
411:         return { ok: false, error: message }
412:       } finally {
413:         setLoading(false)
414:       }
415:     },
416:     [supabase],
417:   )
418: 
419:   return {
420:     loading,
421:     error,
422:     createPickupOrder,
423:     completePickupOrder,
424:     cancelPickupOrder,
425:     removeLineFromPickupOrder,
426:   }
427: }
</file>

