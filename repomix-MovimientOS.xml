<file path="src/components/viajes/DeliveryModal.tsx">
  1: 'use client'
  2: 
  3: import { useState, useMemo, useCallback, useRef } from 'react'
  4: import { Wrench, Package } from 'lucide-react'
  5: import type { TripWithRelations } from '@/hooks/useTrips'
  6: import { Select, type SelectOption } from '@/components/ui/Select'
  7: import { SelectWithFallback, type SelectWithFallbackValue } from '@/components/ui/SelectWithFallback'
  8: import { Button } from '@/components/ui/Button'
  9: import FileUploader from '@/components/ui/FileUploader'
 10: import { formatQty } from '@/lib/utils/format'
 11: import type { Attachment } from '@/lib/supabase/storage'
 12: 
 13: // --- Types ---
 14: 
 15: export interface DeliveryLineData {
 16:   request_line_id: string
 17:   quantity: number
 18:   line_status: 'ok' | 'with_observations' | 'rejected'
 19:   observation_type?: string
 20:   observation_notes?: string
 21: }
 22: 
 23: export interface DeliveryData {
 24:   event_id: string // UUID pre-generado para idempotencia (retry de red)
 25:   received_by_id: string | null
 26:   received_by_name: string
 27:   confirmation_code?: string
 28:   lines: DeliveryLineData[]
 29:   notes: string
 30:   attachments: Attachment[]
 31: }
 32: 
 33: interface DeliveryModalProps {
 34:   trip: TripWithRelations
 35:   onConfirm: (data: DeliveryData) => Promise<void>
 36:   onClose: () => void
 37:   loading: boolean
 38:   receiverOptions: { value: string; label: string }[]
 39:   person: { id: string; name: string } | null
 40: }
 41: 
 42: interface LineState {
 43:   request_line_id: string
 44:   description: string
 45:   lineType: string
 46:   unitCode: string
 47:   maxQty: number
 48:   qty: number
 49:   status: 'ok' | 'with_observations' | 'rejected'
 50:   observationType: string
 51:   observationNotes: string
 52: }
 53: 
 54: const STATUS_OPTIONS: SelectOption[] = [
 55:   { value: 'ok', label: 'OK' },
 56:   { value: 'with_observations', label: 'Con observaciones' },
 57:   { value: 'rejected', label: 'Rechazado' },
 58: ]
 59: 
 60: const OBSERVATION_TYPES: SelectOption[] = [
 61:   { value: 'damaged', label: 'Material dañado' },
 62:   { value: 'wrong_qty', label: 'Cantidad incorrecta' },
 63:   { value: 'wrong_item', label: 'Item equivocado' },
 64:   { value: 'other', label: 'Otro' },
 65: ]
 66: 
 67: export function DeliveryModal({
 68:   trip,
 69:   onConfirm,
 70:   onClose,
 71:   loading,
 72:   receiverOptions,
 73:   person,
 74: }: DeliveryModalProps) {
 75:   // --- ALL hooks at top ---
 76: 
 77:   // UUID estable del evento — mismo valor para retries del mismo modal (idempotencia)
 78:   const eventIdRef = useRef<string>(crypto.randomUUID())
 79: 
 80:   // Cambio 6 D5: separar líneas operables (entregables ahora) de las ya entregadas
 81:   // en este trip (qty_delivered>0 en el assignment). Las ya entregadas se renderizan
 82:   // greyed disabled para visibilidad operativa — Charris ve progreso del trip
 83:   // ("voy 2 de 3 líneas"). Bug #4 BD trigger es la fuente de verdad; este UI es
 84:   // defense-in-depth.
 85:   const deliverableAssignments = useMemo(
 86:     () => trip.assignments.filter(
 87:       (a) => a.line?.status === 'En Transito' && (a.qty_delivered ?? 0) === 0,
 88:     ),
 89:     [trip.assignments],
 90:   )
 91: 
 92:   // Líneas ya entregadas en este trip (qty_delivered>0). Render disabled con badge.
 93:   const alreadyDeliveredAssignments = useMemo(
 94:     () => trip.assignments.filter((a) => (a.qty_delivered ?? 0) > 0),
 95:     [trip.assignments],
 96:   )
 97: 
 98:   // Initialize line states (solo entregables — las ya entregadas no van al state
 99:   // porque no son editables)
100:   const [lines, setLines] = useState<LineState[]>(() =>
101:     deliverableAssignments.map((a) => ({
102:       request_line_id: a.request_line_id,
103:       description: a.line?.description ?? 'Línea',
104:       lineType: a.line?.line_type ?? 'Equipo',
105:       unitCode: a.line?.unit?.code ?? '',
106:       maxQty: a.qty_dispatched || a.quantity_assigned,
107:       qty: a.qty_dispatched || a.quantity_assigned,
108:       status: 'ok' as const,
109:       observationType: '',
110:       observationNotes: '',
111:     })),
112:   )
113: 
114:   // Código siempre obligatorio (decisión 2026-04-16)
115: 
116:   // Auto-select receiver if person matches designated_receiver
117:   const initialReceiver = useMemo((): SelectWithFallbackValue => {
118:     if (person) {
119:       // Check if current user is a designated receiver for any line
120:       const match = deliverableAssignments.find(
121:         (a) => a.line?.designated_receiver_id === person.id,
122:       )
123:       if (match) {
124:         return { id: person.id, text: null }
125:       }
126:     }
127:     return { id: null, text: null }
128:   }, [person, deliverableAssignments])
129: 
130:   const [receiver, setReceiver] = useState<SelectWithFallbackValue>(initialReceiver)
131:   const [code, setCode] = useState('')
132:   const [notes, setNotes] = useState('')
133:   const [attachments, setAttachments] = useState<Attachment[]>([])
134: 
135:   // Validation
136:   const receiverFilled = (receiver.id !== null && receiver.id !== '') || (receiver.text !== null && receiver.text.trim() !== '')
137:   const codeValid = code.length === 4 && code === trip.confirmation_code
138:   const codeIncorrect = code.length === 4 && code !== trip.confirmation_code
139:   const hasDeliverableLines = lines.some((l) => l.status !== 'rejected' && l.qty > 0)
140:   const canConfirm = receiverFilled && codeValid && hasDeliverableLines && !loading
141: 
142:   const handleLineStatusChange = useCallback((idx: number, newStatus: string) => {
143:     setLines((prev) =>
144:       prev.map((l, i) => {
145:         if (i !== idx) return l
146:         const updated = { ...l, status: newStatus as LineState['status'] }
147:         if (newStatus === 'rejected') {
148:           updated.qty = 0
149:           updated.observationType = ''
150:           updated.observationNotes = ''
151:         }
152:         if (newStatus === 'ok') {
153:           updated.observationType = ''
154:           updated.observationNotes = ''
155:         }
156:         return updated
157:       }),
158:     )
159:   }, [])
160: 
161:   const handleQtyChange = useCallback((idx: number, value: number) => {
162:     setLines((prev) =>
163:       prev.map((l, i) =>
164:         i === idx ? { ...l, qty: Math.max(0, Math.min(value, l.maxQty)) } : l,
165:       ),
166:     )
167:   }, [])
168: 
169:   const handleObservationTypeChange = useCallback((idx: number, value: string | null) => {
170:     setLines((prev) =>
171:       prev.map((l, i) => (i === idx ? { ...l, observationType: value ?? '' } : l)),
172:     )
173:   }, [])
174: 
175:   const handleObservationNotesChange = useCallback((idx: number, value: string) => {
176:     setLines((prev) =>
177:       prev.map((l, i) => (i === idx ? { ...l, observationNotes: value } : l)),
178:     )
179:   }, [])
180: 
181:   const handleConfirm = useCallback(async () => {
182:     const receiverName = receiver.id
183:       ? receiverOptions.find((r) => r.value === receiver.id)?.label ?? ''
184:       : receiver.text?.trim() ?? ''
185: 
186:     try {
187:       await onConfirm({
188:         event_id: eventIdRef.current,
189:         received_by_id: receiver.id,
190:         received_by_name: receiverName,
191:         confirmation_code: code,
192:         lines: lines.map((l) => ({
193:           request_line_id: l.request_line_id,
194:           quantity: l.qty,
195:           line_status: l.status,
196:           observation_type: l.status === 'with_observations' ? l.observationType || undefined : undefined,
197:           observation_notes: l.status === 'with_observations' ? l.observationNotes || undefined : undefined,
198:         })),
199:         notes: notes.trim(),
200:         attachments,
201:       })
202:     } catch (err) {
203:       eventIdRef.current = crypto.randomUUID()
204:       throw err
205:     }
206:   }, [receiver, receiverOptions, code, lines, notes, attachments, onConfirm])
207: 
208:   // --- Render ---
209:   if (deliverableAssignments.length === 0 && alreadyDeliveredAssignments.length === 0) {
210:     return (
211:       <div className="fixed inset-0 z-50 flex items-end justify-center bg-black/50 p-4 sm:items-center">
212:         <div className="w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-t-2xl bg-white p-4 shadow-xl sm:rounded-2xl sm:p-6">
213:           <p className="text-sm text-iconsa-gray">No hay líneas pendientes de entrega.</p>
214:           <Button variant="ghost" onClick={onClose} className="mt-4">
215:             Cerrar
216:           </Button>
217:         </div>
218:       </div>
219:     )
220:   }
221: 
222:   return (
223:     <div className="fixed inset-0 z-50 flex items-end justify-center bg-black/50 p-4 sm:items-center">
224:       <div className="w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-t-2xl bg-white p-4 shadow-xl sm:rounded-2xl sm:p-6">
225:         <h3 className="mb-4 text-lg font-semibold text-gray-900">
226:           Confirmar Entrega — {trip.trip_id}
227:         </h3>
228: 
229:         <div className="space-y-4">
230:           {/* Receptor */}
231:           <SelectWithFallback
232:             label="Recibido por"
233:             placeholder="Seleccionar receptor..."
234:             options={receiverOptions}
235:             value={receiver}
236:             onChange={setReceiver}
237:             fallbackLabel="No está en la lista"
238:             fallbackPlaceholder="Nombre del receptor"
239:           />
240: 
241:           {/* Líneas */}
242:           <div>
243:             <p className="mb-2 text-sm font-medium text-gray-700">
244:               Líneas por recibir ({lines.filter((l) => l.status !== 'rejected').length} de{' '}
245:               {lines.length})
246:               {alreadyDeliveredAssignments.length > 0 && (
247:                 <span className="ml-1 text-xs text-iconsa-gray font-normal">
248:                   · {alreadyDeliveredAssignments.length} ya entregada{alreadyDeliveredAssignments.length === 1 ? '' : 's'}
249:                 </span>
250:               )}
251:             </p>
252: 
253:             {/* Cambio 6 D5: líneas ya entregadas en este trip (greyed disabled) */}
254:             {alreadyDeliveredAssignments.length > 0 && (
255:               <div className="mb-3 space-y-2">
256:                 {alreadyDeliveredAssignments.map((a) => {
257:                   const isEquipo = a.line?.line_type === 'Equipo'
258:                   const unitCode = a.line?.unit?.code ?? a.line?.unit_text ?? ''
259:                   return (
260:                     <div
261:                       key={a.request_line_id}
262:                       className="rounded-lg border border-emerald-200 bg-emerald-50/30 p-3 opacity-70"
263:                       title="Esta línea ya fue entregada en este viaje. Para corregir, reversá la Entrega anterior primero."
264:                     >
265:                       <div className="flex items-center gap-2">
266:                         {isEquipo ? (
267:                           <Wrench className="h-3.5 w-3.5 shrink-0 text-iconsa-blue" />
268:                         ) : (
269:                           <Package className="h-3.5 w-3.5 shrink-0 text-iconsa-gold" />
270:                         )}
271:                         <span className="flex-1 text-sm text-gray-700 truncate">
272:                           {a.line?.description ?? '—'}
273:                         </span>
274:                         <span className="text-xs font-medium text-emerald-700 whitespace-nowrap">
275:                           ✓ Entregada — {formatQty(a.qty_delivered ?? 0)} {unitCode}
276:                         </span>
277:                       </div>
278:                     </div>
279:                   )
280:                 })}
281:               </div>
282:             )}
283: 
284:             <div className="space-y-3">
285:               {lines.map((line, idx) => (
286:                 <div
287:                   key={line.request_line_id}
288:                   className={`rounded-lg border p-3 transition-colors ${
289:                     line.status === 'rejected'
290:                       ? 'border-red-200 bg-red-50/50 opacity-60'
291:                       : line.status === 'with_observations'
292:                         ? 'border-orange-200 bg-orange-50/50'
293:                         : 'border-gray-200 bg-gray-50'
294:                   }`}
295:                 >
296:                   {/* Line header */}
297:                   <div className="flex items-center gap-2">
298:                     {line.lineType === 'Equipo' ? (
299:                       <Wrench className="h-3.5 w-3.5 shrink-0 text-iconsa-blue" />
300:                     ) : (
301:                       <Package className="h-3.5 w-3.5 shrink-0 text-iconsa-gold" />
302:                     )}
303:                     <span className="flex-1 text-sm text-gray-700 truncate">
304:                       {line.description}
305:                     </span>
306:                     <input
307:                       type="number"
308:                       min={0}
309:                       max={line.maxQty}
310:                       step="1"
311:                       value={line.qty}
312:                       disabled={line.status === 'rejected'}
313:                       onChange={(e) => handleQtyChange(idx, parseFloat(e.target.value) || 0)}
314:                       title={`Cantidad a entregar de ${line.description}`}
315:                       className="w-16 rounded border border-gray-300 px-2 py-1 text-sm text-right disabled:bg-gray-100 disabled:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
316:                     />
317:                     <span className="text-xs text-iconsa-gray whitespace-nowrap">
318:                       / {formatQty(line.maxQty)} {line.unitCode}
319:                     </span>
320:                   </div>
321: 
322:                   {/* Status selector */}
323:                   <div className="mt-2">
324:                     <Select
325:                       placeholder="Estado"
326:                       options={STATUS_OPTIONS}
327:                       value={line.status}
328:                       onChange={(val) => handleLineStatusChange(idx, val ?? 'ok')}
329:                     />
330:                   </div>
331: 
332:                   {/* Observation fields (only for with_observations) */}
333:                   {line.status === 'with_observations' && (
334:                     <div className="mt-2 space-y-2 pl-2 border-l-2 border-orange-300">
335:                       <Select
336:                         label="Tipo de observación"
337:                         placeholder="Seleccionar..."
338:                         options={OBSERVATION_TYPES}
339:                         value={line.observationType || null}
340:                         onChange={(val) => handleObservationTypeChange(idx, val)}
341:                       />
342:                       <textarea
343:                         value={line.observationNotes}
344:                         onChange={(e) => handleObservationNotesChange(idx, e.target.value)}
345:                         placeholder="Detalle de la observación"
346:                         rows={2}
347:                         className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
348:                       />
349:                     </div>
350:                   )}
351:                 </div>
352:               ))}
353:             </div>
354:           </div>
355: 
356:           {/* Código de confirmación (siempre obligatorio) */}
357:           <div>
358:             <label className="mb-1 block text-sm font-medium text-gray-700">
359:               Código de confirmación
360:             </label>
361:             <input
362:               type="text"
363:               inputMode="numeric"
364:               maxLength={4}
365:               value={code}
366:               onChange={(e) => setCode(e.target.value.replace(/\D/g, '').slice(0, 4))}
367:               placeholder="4 dígitos"
368:               className={`w-32 rounded-lg border px-3 py-2 text-center font-mono text-lg tracking-widest focus:outline-none focus:ring-1 ${
369:                 codeIncorrect
370:                   ? 'border-red-500 bg-red-50 text-red-700 focus:border-red-500 focus:ring-red-500'
371:                   : 'border-gray-300 focus:border-iconsa-blue focus:ring-iconsa-blue'
372:               }`}
373:             />
374:             {codeIncorrect && (
375:               <p className="mt-1 text-xs text-red-600">
376:                 Código incorrecto. Verifique con el solicitante.
377:               </p>
378:             )}
379:           </div>
380: 
381:           {/* Fotos */}
382:           <FileUploader
383:             attachments={attachments}
384:             folder={`events/${trip.id}`}
385:             onChange={setAttachments}
386:             label="Fotos de entrega"
387:             hint="PDF, JPG, PNG o WEBP (max 10MB)"
388:           />
389: 
390:           {/* Notas */}
391:           <div>
392:             <label className="mb-1 block text-sm font-medium text-gray-700">
393:               Notas (opcional)
394:             </label>
395:             <textarea
396:               value={notes}
397:               onChange={(e) => setNotes(e.target.value)}
398:               placeholder="Observaciones de la entrega"
399:               rows={2}
400:               className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
401:             />
402:           </div>
403: 
404:           {/* Acciones */}
405:           <div className="flex gap-2 pt-2">
406:             <Button
407:               variant="primary"
408:               onClick={handleConfirm}
409:               loading={loading}
410:               disabled={!canConfirm}
411:             >
412:               Confirmar Entrega
413:             </Button>
414:             <Button variant="ghost" onClick={onClose} disabled={loading}>
415:               Cancelar
416:             </Button>
417:           </div>
418:         </div>
419:       </div>
420:     </div>
421:   )
422: }
</file>

