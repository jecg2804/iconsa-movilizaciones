667:   // --- Actualizar solicitud existente ---
668:   const updateSolicitud = useCallback(
669:     async (
670:       id: string,
671:       header: Partial<SolicitudInput>,
672:       lines: LineInput[],
673:       deletedLineIds: string[],
674:       personId?: string,
675:     ): Promise<boolean> => {
676:       if (busyRef.current) return false
677:       busyRef.current = true
678:       setSaving(true)
679:       setSaveError(null)
680: 
681:       try {
682:         // 1. Actualizar header
683:         const headerUpdate: Record<string, unknown> = {}
684:         if (header.project_id !== undefined) headerUpdate.project_id = header.project_id
685:         if (header.requester_id !== undefined) headerUpdate.requester_id = header.requester_id
686:         if (header.approved_by !== undefined) headerUpdate.approved_by = header.approved_by
687:         if (header.date_required !== undefined) headerUpdate.date_required = header.date_required
688:         if (header.notes !== undefined) headerUpdate.notes = header.notes
689:         if (header.attachments !== undefined) headerUpdate.attachments = header.attachments
690:         if (header.cost_code_id !== undefined) headerUpdate.cost_code_id = header.cost_code_id
691:         if (header.cost_category_id !== undefined) headerUpdate.cost_category_id = header.cost_category_id
692:         if (personId) headerUpdate.updated_by = personId
693: 
694:         if (Object.keys(headerUpdate).length > 0) {
695:           const { error: headerError } = await supabase
696:             .from('sm_requests')
697:             .update(headerUpdate)
698:             .eq('id', id)
699: 
700:           if (headerError) {
701:             setSaveError(headerError.message)
702:             return false
703:           }
704:         }
705: 
706:         // 2. Eliminar lineas marcadas para eliminacion
707:         for (const lineId of deletedLineIds) {
708:           // Primero eliminar asignaciones de viaje (si existen)
709:           await supabase
710:             .from('trip_line_assignments')
711:             .delete()
712:             .eq('request_line_id', lineId)
713: 
714:           // Luego eliminar la linea
715:           const { error: deleteError } = await supabase
716:             .from('sm_request_lines')
717:             .delete()
718:             .eq('id', lineId)
719: 
720:           if (deleteError) {
721:             setSaveError(`Error al eliminar línea: ${deleteError.message}`)
722:             return false
723:           }
724:         }
725: 
726:         // 3. Calcular el proximo line_number para lineas nuevas
727:         const { data: existingLines } = await supabase
728:           .from('sm_request_lines')
729:           .select('line_number')
730:           .eq('request_id', id)
731:           .order('line_number', { ascending: false })
732:           .limit(1)
733: 
734:         let nextLineNumber = (existingLines?.[0]?.line_number ?? 0) + 1
735: 
736:         // 4. Actualizar lineas existentes e insertar nuevas
737:         for (const line of lines) {
738:           if (line.id) {
739:             // Linea existente: actualizar
740:             const lineUpdate: Record<string, unknown> = {
741:                 line_type: line.line_type,
742:                 equipment_id: line.equipment_id,
743:                 equipment_text: line.equipment_text,
744:                 description: line.description,
745:                 from_location_id: line.from_location_id,
746:                 from_text: line.from_text,
747:                 to_location_id: line.to_location_id,
748:                 to_text: line.to_text,
749:                 quantity: line.quantity,
750:                 unit_id: line.unit_id,
751:                 unit_text: line.unit_text,
752:                 category: line.category,
753:                 material_category: line.material_category,
754:                 po_reference: line.po_reference,
755:                 notes: line.notes,
756:                             designated_receiver_id: line.designated_receiver_id ?? null,
757:                 designated_receiver_name: line.designated_receiver_name ?? null,
758:               }
759:             if (personId) lineUpdate.updated_by = personId
760: 
761:             const { error: updateError } = await supabase
762:               .from('sm_request_lines')
763:               .update(lineUpdate)
764:               .eq('id', line.id)
765: 
766:             if (updateError) {
767:               setSaveError(`Error al actualizar línea: ${updateError.message}`)
768:               return false
769:             }
770:           } else {
771:             // Linea nueva: insertar (solo permitido en Borrador)
772:             const { error: insertError } = await supabase
773:               .from('sm_request_lines')
774:               .insert(lineInputToRow(line, id, nextLineNumber))
775: 
776:             if (insertError) {
777:               setSaveError(`Error al agregar línea: ${insertError.message}`)
778:               return false
779:             }
780:             nextLineNumber++
781:           }
782:         }
783: 
784:         // 5. Crear sugerencias para valores de fallback de lineas nuevas
785:         const newLines = lines.filter((l) => !l.id)
786:         if (newLines.length > 0) {
787:           const requesterId = header.requester_id
788:           if (requesterId) {
789:             await createSuggestions(supabase, newLines, requesterId)
790:           }
791:         }
792: 
793:         // Notificar edición (action verifica que status sea Enviada/En Proceso)
794:         if (personId) {
795:           notifySolicitudEditada(id, personId).catch(console.error)
796:         }
797: 
798:         return true
799:       } catch (err) {
800:         const message = err instanceof Error ? err.message : 'Error inesperado al actualizar'
801:         setSaveError(message)
802:         return false
803:       } finally {
804:         busyRef.current = false
805:         setSaving(false)
806:       }
807:     },
808:     [supabase],
809:   )
810: 
811:   // --- Cancelar solicitud ---
812:   // Cambio 5 T10: cancela pickup_orders + external_orders relacionados con lógica G:
813:   //   - Si TODAS las líneas del order son de la solicitud → cancel order entero
814:   //   - Si solo ALGUNAS → DELETE de order_lines selectivo (auto_cancel_empty trigger
815:   //     maneja último caso si quedan 0 líneas)
816:   const cancelSolicitud = useCallback(
817:     async (id: string, personId?: string): Promise<boolean> => {
818:       if (busyRef.current) return false
819:       busyRef.current = true
820:       setSaving(true)
821:       setSaveError(null)
822: 
823:       try {
824:         // 1. Obtener líneas de la solicitud
825:         const { data: lines, error: fetchError } = await supabase
826:           .from('sm_request_lines')
827:           .select('id, status')
828:           .eq('request_id', id)
829: 
830:         if (fetchError) {
831:           setSaveError(fetchError.message)
832:           return false
833:         }
834: 
835:         const lineIds = (lines ?? []).map((l) => l.id)
836: 
837:         // 2. Cancel pickup_orders relacionados con lógica G
838:         // SELECT pickup_orders activos que tienen AT LEAST 1 línea de esta solicitud.
839:         const { data: pickupOrdersData } = await supabase
840:           .from('pickup_orders')
841:           .select(`
842:             id, pickup_id,
843:             lines:pickup_order_lines!inner(id, request_line_id)
844:           `)
845:           .eq('status', 'Aprobado')
846:           .in('lines.request_line_id', lineIds.length > 0 ? lineIds : ['__none__'])
847: 
848:         for (const order of pickupOrdersData ?? []) {
849:           // Fetch ALL lines del order (no solo las JOINed)
850:           const { data: allOrderLines } = await supabase
851:             .from('pickup_order_lines')
852:             .select('id, request_line_id')
853:             .eq('pickup_order_id', order.id)
854: 
855:           const allOrderLinesArr = allOrderLines ?? []
856:           const linesFromThisRequest = allOrderLinesArr.filter((ol) => lineIds.includes(ol.request_line_id))
857: 
858:           if (linesFromThisRequest.length === allOrderLinesArr.length) {
859:             // TODAS las líneas son de la solicitud → cancel order entero
860:             await supabase
861:               .from('pickup_orders')
862:               .update({
863:                 status: 'Cancelado',
864:                 cancelled_at: new Date().toISOString(),
865:                 cancelled_by: personId ?? null,
866:               })
867:               .eq('id', order.id)
868:           } else if (linesFromThisRequest.length > 0) {
869:             // Solo ALGUNAS son de la solicitud → DELETE selectivo
870:             // (auto_cancel_empty trigger maneja si quedan 0 líneas)
871:             const lineIdsToRemove = linesFromThisRequest.map((ol) => ol.id)
872:             await supabase
873:               .from('pickup_order_lines')
874:               .delete()
875:               .in('id', lineIdsToRemove)
876:           }
877:         }
878: 
879:         // 3. Cancel external_orders relacionados (paralelo)
880:         const { data: externalOrdersData } = await supabase
881:           .from('external_orders')
882:           .select(`
883:             id, external_id,
884:             lines:external_order_lines!inner(id, request_line_id)
885:           `)
886:           .eq('status', 'Aprobado')
887:           .in('lines.request_line_id', lineIds.length > 0 ? lineIds : ['__none__'])
888: 
889:         for (const order of externalOrdersData ?? []) {
890:           const { data: allOrderLines } = await supabase
891:             .from('external_order_lines')
892:             .select('id, request_line_id')
893:             .eq('external_order_id', order.id)
894: 
895:           const allOrderLinesArr = allOrderLines ?? []
896:           const linesFromThisRequest = allOrderLinesArr.filter((ol) => lineIds.includes(ol.request_line_id))
897: 
898:           if (linesFromThisRequest.length === allOrderLinesArr.length) {
899:             await supabase
900:               .from('external_orders')
901:               .update({
902:                 status: 'Cancelado',
903:                 cancelled_at: new Date().toISOString(),
904:                 cancelled_by: personId ?? null,
905:               })
906:               .eq('id', order.id)
907:           } else if (linesFromThisRequest.length > 0) {
908:             const lineIdsToRemove = linesFromThisRequest.map((ol) => ol.id)
909:             await supabase
910:               .from('external_order_lines')
911:               .delete()
912:               .in('id', lineIdsToRemove)
913:           }
914:         }
915: 
916:         // 4. Eliminar trip_line_assignments para líneas Programadas
917:         // (el trigger BD recalcula sm_request_lines.qty_scheduled automáticamente)
918:         const programmedLines = (lines ?? []).filter((l) => l.status === 'Programada')
919:         for (const line of programmedLines) {
920:           await supabase
921:             .from('trip_line_assignments')
922:             .delete()
923:             .eq('request_line_id', line.id)
924:         }
925: 
926:         // 5. UPDATE líneas Pendiente/Programada/Parcial a 'Cancelada'
927:         // (post-Migration 4: status 'Pickup Aprobado'/'Externo Aprobado' eliminados)
928:         const lineIdsToCancel = (lines ?? [])
929:           .filter((l) => l.status === 'Pendiente' || l.status === 'Programada' || l.status === 'Parcial')
930:           .map((l) => l.id)
931: 
932:         if (lineIdsToCancel.length > 0) {
933:           const { error: cancelLinesError } = await supabase
934:             .from('sm_request_lines')
935:             .update({ status: 'Cancelada' })
936:             .in('id', lineIdsToCancel)
937: 
938:           if (cancelLinesError) {
939:             setSaveError(cancelLinesError.message)
940:             return false
941:           }
942:         }
943: 
944:         // 6. UPDATE sm_requests.status='Cancelada'
945:         const { error: cancelError } = await supabase
946:           .from('sm_requests')
947:           .update({ status: 'Cancelada' })
948:           .eq('id', id)
949: 
950:         if (cancelError) {
951:           setSaveError(cancelError.message)
952:           return false
953:         }
954: 
955:         // Notificar
956:         notifySolicitudCancelada(id, personId).catch(console.error)
957: 
958:         return true
959:       } catch (err) {
960:         const message = err instanceof Error ? err.message : 'Error inesperado al cancelar'
961:         setSaveError(message)
962:         return false
963:       } finally {
964:         busyRef.current = false
965:         setSaving(false)
966:       }
967:     },
968:     [supabase],
969:   )
970: 
971:   return {
972:     // Lista
973:     solicitudes,
974:     totalCount,
975:     filters,
976:     setFilters,
977:     listLoading,
978:     listError,
979:     refetchList,
