 80:             title={`Fecha programada: ${formatDate(order.scheduled_date)}`}
 81:           >
 82:             <CalendarDays className="h-3 w-3" />
 83:             {formatDate(order.scheduled_date)}
 84:           </span>
 85:           <span className="text-xs text-iconsa-gray" title={`Aprobado ${formatDateTime(order.approved_at)}`}>
 86:             {formatDate(order.approved_at)}
 87:             {order.approved_by_name && <span> · {order.approved_by_name}</span>}
 88:           </span>
 89:           <span className="text-xs text-iconsa-gray">{order.lines.length} {order.lines.length === 1 ? 'línea' : 'líneas'}</span>
