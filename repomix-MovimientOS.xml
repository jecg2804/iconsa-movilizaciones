<file path="src/lib/utils/datetime.ts">
 1: import { differenceInCalendarDays } from 'date-fns'
 2: 
 3: /**
 4:  * Timezone utilities for Panama (UTC-5, sin DST).
 5:  *
 6:  * Motivación: Next.js server runtime es UTC (Vercel), cliente es timezone del usuario.
 7:  * Usar `new Date()` produce resultados distintos entre server y client. Para una app
 8:  * que opera exclusivamente en Panamá, todo cálculo de "hoy" / "esta semana" debe
 9:  * hacerse en timezone Panama explícitamente.
10:  *
11:  * Patrón: trabajamos con strings "YYYY-MM-DD" siempre que sea posible, y solo
12:  * construimos Date objects cuando necesitamos aritmética de fechas (date-fns).
13:  */
14: 
15: const PANAMA_TZ = 'America/Panama'
16: 
17: /**
18:  * Hoy como "YYYY-MM-DD" en timezone Panamá.
19:  * Funciona correctamente en cualquier runtime (UTC server, cualquier cliente).
20:  */
21: export function todayStrInPanama(): string {
22:   return new Intl.DateTimeFormat('en-CA', {
23:     timeZone: PANAMA_TZ,
24:     year: 'numeric',
25:     month: '2-digit',
26:     day: '2-digit',
27:   }).format(new Date())
28: }
29: 
30: /**
31:  * Extrae "YYYY-MM-DD" en timezone Panamá de cualquier Date o ISO timestamp.
32:  * Crítico para campos TIMESTAMPTZ que necesitan comparación date-only.
33:  */
34: export function dateStrInPanama(timestamp: string | Date): string {
35:   const d = typeof timestamp === 'string' ? new Date(timestamp) : timestamp
36:   return new Intl.DateTimeFormat('en-CA', {
37:     timeZone: PANAMA_TZ,
38:     year: 'numeric',
39:     month: '2-digit',
40:     day: '2-digit',
41:   }).format(d)
42: }
43: 
44: /**
45:  * Día de la semana (0=domingo, 1=lunes, ..., 6=sábado) en timezone Panamá.
46:  * Usar para gates tipo "saltar domingos" en crons.
47:  */
48: export function dayOfWeekInPanama(ref?: Date): number {
49:   const d = ref ?? new Date()
50:   const weekdayShort = new Intl.DateTimeFormat('en-US', {
51:     timeZone: PANAMA_TZ,
52:     weekday: 'short',
53:   }).format(d)
54:   const map: Record<string, number> = {
55:     Sun: 0,
56:     Mon: 1,
57:     Tue: 2,
58:     Wed: 3,
59:     Thu: 4,
60:     Fri: 5,
61:     Sat: 6,
62:   }
63:   return map[weekdayShort] ?? 0
64: }
65: 
66: /**
67:  * Parsea "YYYY-MM-DD" como start-of-day en Panamá (UTC-5 fijo, sin DST).
68:  * Retorna Date object que compara y ordena correctamente sin importar el runtime timezone.
69:  * Para strings no-date-only (ISO full), delega a new Date() normal.
70:  */
71: export function parseDateStrInPanama(dateStr: string): Date {
72:   if (/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) {
73:     return new Date(dateStr + 'T00:00:00-05:00')
74:   }
75:   return new Date(dateStr)
76: }
77: 
78: /**
79:  * Diferencia en días entre dos fechas, ambas interpretadas en timezone Panamá.
80:  * Acepta mix de strings "YYYY-MM-DD" y TIMESTAMPTZ ISO.
81:  * Positivo si `to` es después de `from`.
82:  */
83: export function daysBetweenInPanama(from: string | Date, to: string | Date): number {
84:   const fromStr =
85:     typeof from === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(from) ? from : dateStrInPanama(from)
86:   const toStr =
87:     typeof to === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(to) ? to : dateStrInPanama(to)
88:   const fromDate = parseDateStrInPanama(fromStr)
89:   const toDate = parseDateStrInPanama(toStr)
90:   return differenceInCalendarDays(toDate, fromDate)
91: }
</file>

<file path="src/lib/utils/duplicates.ts">
  1: import type { SupabaseClient } from '@supabase/supabase-js'
  2: import type { Database } from '@/lib/types/database'
  3: 
  4: interface DuplicateCheckParams {
  5:   lineType: 'Equipo' | 'Material'
  6:   equipmentId: string | null
  7:   description: string
  8:   fromLocationId: string | null
  9:   toLocationId: string | null
 10:   excludeRequestId?: string
 11: }
 12: 
 13: export interface DuplicateResult {
 14:   requestId: string
 15:   lineNumber: number
 16:   description: string
 17:   status: string
 18:   fromName: string
 19:   toName: string
 20: }
 21: 
 22: /**
 23:  * Busca lineas activas similares en otras solicitudes.
 24:  * Para tipo Equipo: coincidencia exacta por equipment_id.
 25:  * Para tipo Material: coincidencia parcial por descripcion (ILIKE).
 26:  * Opcionalmente filtra por ruta (from/to location).
 27:  * Excluye solicitudes canceladas/completadas y lineas canceladas/entregadas.
 28:  */
 29: export async function checkDuplicateLines(
 30:   supabase: SupabaseClient<Database>,
 31:   params: DuplicateCheckParams,
 32: ): Promise<DuplicateResult[]> {
 33:   const {
 34:     lineType,
 35:     equipmentId,
 36:     description,
 37:     fromLocationId,
 38:     toLocationId,
 39:     excludeRequestId,
 40:   } = params
 41: 
 42:   // Para Equipo necesitamos un equipment_id real para buscar duplicados
 43:   if (lineType === 'Equipo' && !equipmentId) {
 44:     return []
 45:   }
 46: 
 47:   // Para Material necesitamos al menos una descripcion con contenido
 48:   if (lineType === 'Material' && description.trim().length < 3) {
 49:     return []
 50:   }
 51: 
 52:   // Construir query base: lineas con su solicitud padre
 53:   let query = supabase
 54:     .from('sm_request_lines')
 55:     .select(`
 56:       line_number,
 57:       description,
 58:       status,
 59:       equipment_id,
 60:       from_location_id,
 61:       to_location_id,
 62:       request:sm_requests!sm_request_lines_request_id_fkey (
 63:         id,
 64:         request_id,
 65:         status
 66:       )
 67:     `)
 68:     .not('status', 'in', '("Cancelada","Entregada")')
 69: 
 70:   // Filtrar por tipo de coincidencia
 71:   if (lineType === 'Equipo') {
 72:     query = query.eq('equipment_id', equipmentId!)
 73:   } else {
 74:     // Busqueda parcial por descripcion para materiales
 75:     query = query.ilike('description', `%${description.trim()}%`)
 76:   }
 77: 
 78:   // Filtrar por ruta si se proporcionan ubicaciones
 79:   if (fromLocationId) {
 80:     query = query.eq('from_location_id', fromLocationId)
 81:   }
 82:   if (toLocationId) {
 83:     query = query.eq('to_location_id', toLocationId)
 84:   }
 85: 
 86:   const { data: lines, error: linesError } = await query
 87: 
 88:   if (linesError || !lines) {
 89:     return []
 90:   }
 91: 
 92:   // Filtrar: solicitud no cancelada/completada, y excluir solicitud actual
 93:   const activeLine = lines.filter((line) => {
 94:     // El join con sm_requests puede devolver un objeto o un array
 95:     const request = Array.isArray(line.request) ? line.request[0] : line.request
 96:     if (!request) return false
 97:     const reqStatus = (request as { id: string; request_id: string; status: string }).status
 98:     if (reqStatus === 'Cancelada' || reqStatus === 'Completada') return false
 99:     if (excludeRequestId && (request as { id: string }).id === excludeRequestId) return false
100:     return true
101:   })
102: 
103:   if (activeLine.length === 0) {
104:     return []
105:   }
106: 
107:   // Recopilar IDs de ubicaciones unicos para obtener nombres
108:   const locationIds = new Set<string>()
109:   for (const line of activeLine) {
110:     if (line.from_location_id) locationIds.add(line.from_location_id)
111:     if (line.to_location_id) locationIds.add(line.to_location_id)
112:   }
113: 
114:   // Obtener nombres de ubicaciones
115:   const locationMap = new Map<string, string>()
116:   if (locationIds.size > 0) {
117:     const { data: locations } = await supabase
118:       .from('locations')
119:       .select('id, name')
120:       .in('id', Array.from(locationIds))
121: 
122:     if (locations) {
123:       for (const loc of locations) {
124:         locationMap.set(loc.id, loc.name)
125:       }
126:     }
127:   }
128: 
129:   // Construir resultados
130:   const results: DuplicateResult[] = activeLine.map((line) => {
131:     const request = Array.isArray(line.request) ? line.request[0] : line.request
132:     const reqData = request as { id: string; request_id: string; status: string }
133: 
134:     const fromName = line.from_location_id
135:       ? (locationMap.get(line.from_location_id) ?? 'Desconocido')
136:       : 'Sin origen'
137:     const toName = line.to_location_id
138:       ? (locationMap.get(line.to_location_id) ?? 'Desconocido')
139:       : 'Sin destino'
140: 
141:     return {
142:       requestId: reqData.request_id ?? 'Sin ID',
143:       lineNumber: line.line_number,
144:       description: line.description ?? '',
145:       status: line.status,
146:       fromName,
147:       toName,
148:     }
149:   })
150: 
151:   return results
152: }
</file>

<file path="src/lib/utils/roles.ts">
 1: import { ROLE_ROUTES, type AppRole } from './constants'
 2: 
 3: /**
 4:  * Verifica si un rol puede acceder a una ruta.
 5:  * Compara el inicio de la ruta con las rutas permitidas del rol.
 6:  */
 7: export function canAccess(role: string | null, route: string): boolean {
 8:   if (!role) return false
 9:   const allowedRoutes = ROLE_ROUTES[role as AppRole]
10:   if (!allowedRoutes) return false
11:   return allowedRoutes.some((r) => route.startsWith(r))
12: }
13: 
14: /**
15:  * PM y admin pueden crear solicitudes.
16:  * Logística NO crea solicitudes (solo edita).
17:  */
18: export function canCreateSolicitud(role: string | null): boolean {
19:   return role === 'pm' || role === 'admin'
20: }
21: 
22: /**
23:  * PM puede editar solo solicitudes de SUS proyectos.
24:  * Admin puede editar cualquier solicitud.
25:  * Logística NO edita solicitudes (RLS lo bloquea).
26:  */
27: export function canEditSolicitud(
28:   role: string | null,
29:   projectId: string,
30:   userProjectIds: string[],
31: ): boolean {
32:   if (!role) return false
33:   if (role === 'admin') return true
34:   if (role === 'pm') return userProjectIds.includes(projectId)
35:   return false
36: }
37: 
38: /**
39:  * Solo logística y admin pueden crear/editar viajes.
40:  */
41: export function canCreateTrip(role: string | null): boolean {
42:   return role === 'logistica' || role === 'admin'
43: }
44: 
45: /**
46:  * Logística, campo, almacén, admin, y PM pueden registrar eventos de viaje.
47:  * PM necesita registrar entregas (confirmación con código).
48:  * Sin restricción por driver_id en MVP.
49:  */
50: export function canRegisterEvent(role: string | null): boolean {
51:   return (
52:     role === 'logistica' ||
53:     role === 'campo' ||
54:     role === 'almacen' ||
55:     role === 'admin' ||
56:     role === 'pm'
57:   )
58: }
59: 
60: /**
61:  * Solo admin puede acceder a tablas maestras.
62:  */
63: export function canAccessAdmin(role: string | null): boolean {
64:   return role === 'admin'
65: }
