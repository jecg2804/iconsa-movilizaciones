<file path="src/hooks/useAuth.ts">
  1: 'use client'
  2: 
  3: import { useEffect, useState, useCallback } from 'react'
  4: import { createClient } from '@/lib/supabase/client'
  5: import type { User } from '@supabase/supabase-js'
  6: import type { Row } from '@/lib/types/database'
  7: import type { AppRole } from '@/lib/utils/constants'
  8: 
  9: interface AuthState {
 10:   user: User | null
 11:   person: Row<'people'> | null
 12:   role: AppRole | null
 13:   loading: boolean
 14:   userProjects: Row<'projects'>[]
 15: }
 16: 
 17: export function useAuth() {
 18:   const [state, setState] = useState<AuthState>({
 19:     user: null,
 20:     person: null,
 21:     role: null,
 22:     loading: true,
 23:     userProjects: [],
 24:   })
 25: 
 26:   const supabase = createClient()
 27: 
 28:   const fetchPersonAndProjects = useCallback(
 29:     async (userId: string) => {
 30:       // Buscar persona por auth_id
 31:       const { data: person } = await supabase
 32:         .from('people')
 33:         .select('*')
 34:         .eq('auth_id', userId)
 35:         .single()
 36: 
 37:       if (!person) {
 38:         setState((prev) => ({ ...prev, person: null, role: null, userProjects: [], loading: false }))
 39:         return
 40:       }
 41: 
 42:       // Buscar proyectos asignados (para PM)
 43:       const { data: personProjects } = await supabase
 44:         .from('person_projects')
 45:         .select('project_id')
 46:         .eq('person_id', person.id)
 47:         .eq('is_active', true)
 48: 
 49:       const projectIds = personProjects?.map((pp) => pp.project_id) ?? []
 50: 
 51:       let projects: Row<'projects'>[] = []
 52:       if (projectIds.length > 0) {
 53:         const { data } = await supabase
 54:           .from('projects')
 55:           .select('*')
 56:           .in('id', projectIds)
 57:         projects = data ?? []
 58:       }
 59: 
 60:       setState((prev) => ({
 61:         ...prev,
 62:         person,
 63:         role: person.app_role as AppRole | null,
 64:         userProjects: projects,
 65:         loading: false,
 66:       }))
 67:     },
 68:     [supabase],
 69:   )
 70: 
 71:   useEffect(() => {
 72:     // Obtener sesión actual
 73:     supabase.auth.getUser()
 74:       .then(({ data: { user } }) => {
 75:         if (user) {
 76:           setState((prev) => ({ ...prev, user }))
 77:           fetchPersonAndProjects(user.id)
 78:         } else {
 79:           setState((prev) => ({ ...prev, loading: false }))
 80:         }
 81:       })
 82:       .catch((err) => {
 83:         console.error('[useAuth] getUser failed:', err)
 84:         setState((prev) => ({ ...prev, loading: false }))
 85:       })
 86: 
 87:     // Escuchar cambios de autenticación
 88:     const {
 89:       data: { subscription },
 90:     } = supabase.auth.onAuthStateChange((_event, session) => {
 91:       const user = session?.user ?? null
 92:       setState((prev) => ({ ...prev, user }))
 93: 
 94:       if (user) {
 95:         fetchPersonAndProjects(user.id)
 96:       } else {
 97:         setState({
 98:           user: null,
 99:           person: null,
100:           role: null,
101:           loading: false,
102:           userProjects: [],
103:         })
104:       }
105:     })
106: 
107:     return () => subscription.unsubscribe()
108:   }, [fetchPersonAndProjects, supabase.auth])
109: 
110:   const signOut = useCallback(async () => {
111:     await supabase.auth.signOut()
112:   }, [supabase.auth])
113: 
114:   return {
115:     ...state,
116:     signOut,
117:     userProjectIds: state.userProjects.map((p) => p.id),
118:   }
119: }
</file>

<file path="src/hooks/useEquipment.ts">
 1: 'use client'
