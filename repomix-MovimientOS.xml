 11:    * J4-B: nombre de la columna en la BD para server-side sort. Si se provee,
 12:    * esta columna se puede ordenar a nivel de query cuando DataTable está en
 13:    * modo `externalSort`. Si no se provee y externalSort está activo, esta
 14:    * columna no muestra indicador de sort (no-op).
 15:    */
 16:   serverSortKey?: string
 17:   className?: string
 18:   render: (row: T) => React.ReactNode
 19:   sortValue?: (row: T) => string | number | Date
 20: }
 21: 
 22: type SortDirection = 'asc' | 'desc'
 23: 
 24: /**
 25:  * J4-B: contrato para sort controlado externamente (server-side).
 26:  * Cuando se provee, DataTable NO sortea client-side — delega al callback
 27:  * para que el parent actualice el query del hook.
 28:  */
 29: export interface ExternalSort {
 30:   column: string | null
 31:   direction: SortDirection
 32:   onSortChange: (column: string | null, direction: SortDirection) => void
 33: }
 34: 
 35: interface DataTableProps<T> {
 36:   columns: Column<T>[]
 37:   data: T[]
 38:   keyExtractor: (row: T) => string
 39:   emptyMessage?: string
 40:   onRowClick?: (row: T) => void
 41:   loading?: boolean
 42:   className?: string
 43:   mobileRender?: (row: T) => React.ReactNode
 44:   /** Función opcional para aplicar clases CSS condicionales a cada fila */
 45:   rowClassName?: (row: T) => string
 46:   /** Contenido expandible debajo de cada fila. Si se provee, click en fila togglea expansión. */
 47:   expandRender?: (row: T) => React.ReactNode
 48:   /** Controlled: keys expandidas (si se pasa, DataTable no maneja su propio state) */
 49:   expandedKeys?: Set<string>
 50:   /** Controlled: callback cuando cambian las keys expandidas */
 51:   onExpandedKeysChange?: (keys: Set<string>) => void
 52: 
 53:   /** Modo de paginación. Default: 'none'.
 54:    *  'client' = DataTable pagina internamente
 55:    *  'server' = parent controla la data por página */
 56:   pagination?: 'none' | 'client' | 'server'
 57:   /** Filas por página. Default: 20 */
 58:   pageSize?: number
 59:   /** Opciones de page size para el selector. Default: [10, 20, 50] */
 60:   pageSizeOptions?: number[]
 61:   /** Total de registros (para calcular páginas). Solo server mode. */
 62:   totalCount?: number
 63:   /** Página actual (0-indexed). Solo server mode. */
 64:   currentPage?: number
 65:   /** Callback cuando cambia la página. Solo server mode. */
 66:   onPageChange?: (page: number) => void
 67:   /** Callback cuando cambia el page size. Solo server mode. */
 68:   onPageSizeChange?: (size: number) => void
 69:   /**
 70:    * J4-B: sort controlado externamente. Si se provee, DataTable delega el
 71:    * sort al parent (que lo pushea al query server-side). Sort client-side
 72:    * se desactiva. Requiere que los columns tengan `serverSortKey` para
 73:    * ser clickeables.
 74:    */
 75:   externalSort?: ExternalSort
 76: }
 77: 
 78: function DataTable<T>({
 79:   columns,
 80:   data,
 81:   keyExtractor,
 82:   emptyMessage = 'No hay datos para mostrar',
 83:   onRowClick,
 84:   loading = false,
 85:   className = '',
 86:   mobileRender,
 87:   rowClassName,
 88:   expandRender,
 89:   expandedKeys: controlledExpandedKeys,
 90:   onExpandedKeysChange,
 91:   pagination = 'none',
 92:   pageSize = 20,
 93:   pageSizeOptions = [10, 20, 50],
 94:   totalCount,
 95:   currentPage,
 96:   onPageChange,
 97:   onPageSizeChange,
 98:   externalSort,
 99: }: DataTableProps<T>) {
100:   const [sortKey, setSortKey] = useState<string | null>(null)
101:   const [sortDirection, setSortDirection] = useState<SortDirection>('asc')
102:   const [internalExpandedKeys, setInternalExpandedKeys] = useState<Set<string>>(new Set())
103: 
104:   // --- Pagination internal state (client mode) ---
105:   const [clientPage, setClientPage] = useState(0)
106:   const [internalPageSize, setInternalPageSize] = useState(pageSize)
107: 
108:   // Resetear página client cuando data cambia (filtros aplicados)
109:   useEffect(() => {
110:     setClientPage(0)
111:   }, [data.length])
112: 
113:   // Controlled vs uncontrolled expand state
114:   const isControlled = controlledExpandedKeys !== undefined
115:   const expandedKeys = isControlled ? controlledExpandedKeys : internalExpandedKeys
116:   const setExpandedKeys = isControlled ? (onExpandedKeysChange ?? setInternalExpandedKeys) : setInternalExpandedKeys
117: 
118:   const handleSort = useCallback(
119:     (columnKey: string) => {
120:       // J4-B: modo externalSort — delegar al parent para server-side sort
121:       if (externalSort) {
122:         const column = columns.find((c) => c.key === columnKey)
123:         if (!column?.serverSortKey) return
124:         const target = column.serverSortKey
125:         if (externalSort.column === target) {
126:           // Toggle: asc → desc → null (quitar sort)
127:           if (externalSort.direction === 'asc') {
128:             externalSort.onSortChange(target, 'desc')
129:           } else {
130:             externalSort.onSortChange(null, 'asc')
131:           }
132:         } else {
133:           externalSort.onSortChange(target, 'asc')
134:         }
135:         return
136:       }
137: 
138:       // Modo interno (client-side sort)
139:       if (sortKey === columnKey) {
140:         if (sortDirection === 'asc') {
141:           setSortDirection('desc')
142:         } else {
143:           // Tercer click: quitar sort
144:           setSortKey(null)
145:           setSortDirection('asc')
146:         }
147:       } else {
148:         setSortKey(columnKey)
149:         setSortDirection('asc')
150:       }
151:     },
152:     [sortKey, sortDirection, externalSort, columns],
153:   )
154: 
155:   const toggleExpand = useCallback(
156:     (key: string) => {
157:       const next = new Set(expandedKeys)
158:       if (next.has(key)) next.delete(key)
159:       else next.add(key)
160:       setExpandedKeys(next)
161:     },
162:     [expandedKeys, setExpandedKeys],
163:   )
164: 
165:   const sortedData = useMemo(() => {
166:     // J4-B: en modo externalSort, data ya viene ordenada del server
167:     if (externalSort) return data
168: 
169:     if (!sortKey) return data
170: 
171:     const column = columns.find((col) => col.key === sortKey)
172:     if (!column) return data
173: 
174:     const sorted = [...data].sort((a, b) => {
175:       let aVal: string | number | Date
176:       let bVal: string | number | Date
177: 
178:       if (column.sortValue) {
179:         aVal = column.sortValue(a)
180:         bVal = column.sortValue(b)
181:       } else {
182:         // Intentar extraer texto del resultado de render
183:         const aRender = column.render(a)
184:         const bRender = column.render(b)
185:         aVal = typeof aRender === 'string' || typeof aRender === 'number' ? aRender : String(aRender ?? '')
186:         bVal = typeof bRender === 'string' || typeof bRender === 'number' ? bRender : String(bRender ?? '')
187:       }
188: 
189:       // Comparacion
190:       if (aVal instanceof Date && bVal instanceof Date) {
191:         return aVal.getTime() - bVal.getTime()
192:       }
193:       if (typeof aVal === 'number' && typeof bVal === 'number') {
194:         return aVal - bVal
195:       }
196:       return String(aVal).localeCompare(String(bVal), 'es')
197:     })
198: 
199:     return sortDirection === 'desc' ? sorted.reverse() : sorted
200:   }, [data, sortKey, sortDirection, columns, externalSort])
201: 
202:   // --- Paginación ---
203:   const paginatedData = useMemo(() => {
204:     if (pagination === 'none') return sortedData
205:     if (pagination === 'client') {
206:       const start = clientPage * internalPageSize
207:       return sortedData.slice(start, start + internalPageSize)
208:     }
209:     // server: data ya viene paginada del parent
210:     return sortedData
211:   }, [sortedData, pagination, clientPage, internalPageSize])
212: 
213:   const total = pagination === 'server' ? (totalCount ?? data.length) : data.length
214:   const activePage = pagination === 'server' ? (currentPage ?? 0) : clientPage
215:   const activePageSize = pagination === 'server' ? pageSize : internalPageSize
216:   const totalPages = Math.ceil(total / activePageSize)
217: 
218:   const handlePageChange = useCallback(
219:     (newPage: number) => {
220:       if (pagination === 'server') {
221:         onPageChange?.(newPage)
222:       } else {
223:         setClientPage(newPage)
224:       }
225:     },
226:     [pagination, onPageChange],
227:   )
228: 
229:   const handlePageSizeChange = useCallback(
230:     (newSize: number) => {
231:       if (pagination === 'server') {
232:         onPageSizeChange?.(newSize)
233:         onPageChange?.(0)
234:       } else {
235:         setInternalPageSize(newSize)
236:         setClientPage(0)
237:       }
238:     },
239:     [pagination, onPageSizeChange, onPageChange],
240:   )
241: 
242:   // Estado de carga
243:   if (loading) {
244:     return (
245:       <div className={`flex items-center justify-center py-16 ${className}`}>
246:         <Loader2 className="h-8 w-8 animate-spin text-iconsa-gray" />
247:       </div>
248:     )
249:   }
250: 
251:   // Sin datos
252:   if (data.length === 0) {
253:     return (
254:       <div className={`flex items-center justify-center py-16 ${className}`}>
255:         <p className="text-sm text-iconsa-gray">{emptyMessage}</p>
256:       </div>
257:     )
258:   }
259: 
260:   const renderSortIcon = (column: Column<T>) => {
261:     if (!column.sortable) return null
262: 
263:     // J4-B: externalSort mode
264:     if (externalSort) {
265:       if (!column.serverSortKey) return null
266:       if (externalSort.column !== column.serverSortKey) {
267:         return <ArrowUpDown className="ml-1 inline h-3.5 w-3.5 text-gray-400" />
268:       }
269:       return externalSort.direction === 'asc' ? (
270:         <ArrowUp className="ml-1 inline h-3.5 w-3.5 text-iconsa-blue" />
271:       ) : (
272:         <ArrowDown className="ml-1 inline h-3.5 w-3.5 text-iconsa-blue" />
273:       )
274:     }
275: 
276:     // Modo interno
277:     if (sortKey !== column.key) {
278:       return <ArrowUpDown className="ml-1 inline h-3.5 w-3.5 text-gray-400" />
279:     }
280: 
281:     return sortDirection === 'asc' ? (
282:       <ArrowUp className="ml-1 inline h-3.5 w-3.5 text-iconsa-blue" />
283:     ) : (
284:       <ArrowDown className="ml-1 inline h-3.5 w-3.5 text-iconsa-blue" />
285:     )
286:   }
287: 
288:   // --- Pagination UI component ---
289:   const paginationUI = pagination !== 'none' && totalPages > 1 && (
290:     <div className="flex items-center justify-between border-t border-gray-200 px-4 py-3 text-sm">
291:       <span className="text-gray-500">
292:         {activePage * activePageSize + 1}–{Math.min((activePage + 1) * activePageSize, total)} de {total}
293:       </span>
294: 
295:       <div className="flex items-center gap-2">
296:         <span className="text-gray-500 text-xs hidden sm:inline">Filas:</span>
297:         <select
298:           title="Filas por página"
299:           value={activePageSize}
300:           onChange={(e) => handlePageSizeChange(Number(e.target.value))}
301:           className="rounded border border-gray-200 px-2 py-1 text-xs"
302:         >
303:           {pageSizeOptions.map((n) => (
304:             <option key={n} value={n}>{n}</option>
305:           ))}
306:         </select>
307:       </div>
308: 
309:       <div className="flex items-center gap-1">
310:         <button
311:           type="button"
312:           title="Página anterior"
313:           onClick={() => handlePageChange(activePage - 1)}
314:           disabled={activePage === 0}
315:           className="rounded px-2 py-1 text-gray-600 hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed"
316:         >
317:           <ChevronLeft className="h-4 w-4" />
318:         </button>
319:         <span className="text-gray-700 px-2">
320:           {activePage + 1} / {totalPages}
321:         </span>
322:         <button
323:           type="button"
324:           title="Página siguiente"
325:           onClick={() => handlePageChange(activePage + 1)}
326:           disabled={activePage >= totalPages - 1}
327:           className="rounded px-2 py-1 text-gray-600 hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed"
328:         >
329:           <ChevronRight className="h-4 w-4" />
330:         </button>
331:       </div>
332:     </div>
333:   )
334: 
335:   return (
336:     <div className={className}>
337:       {/* Vista desktop */}
338:       <div className="hidden md:block">
339:         <div className="overflow-hidden rounded-xl ring-1 ring-gray-200">
340:           <table className="w-full text-left text-sm">
341:             <thead>
342:               <tr className="border-b border-gray-200 bg-gray-50">
343:                 {expandRender && <th className="w-8 px-2 py-3"><span className="sr-only">Expandir</span></th>}
344:                 {columns.map((column) => {
345:                   // J4-B: en externalSort, solo clickeable si la columna tiene serverSortKey
346:                   const effectivelySortable = column.sortable && (!externalSort || !!column.serverSortKey)
347:                   return (
348:                   <th
349:                     key={column.key}
350:                     className={`px-4 py-3 text-xs font-semibold uppercase tracking-wider text-iconsa-gray ${
351:                       effectivelySortable ? 'cursor-pointer select-none hover:text-navy' : ''
352:                     } ${column.className ?? ''}`}
353:                     onClick={effectivelySortable ? () => handleSort(column.key) : undefined}
354:                   >
355:                     <span className="inline-flex items-center">
356:                       {column.header}
357:                       {renderSortIcon(column)}
358:                     </span>
359:                   </th>
360:                   )
361:                 })}
362:               </tr>
363:             </thead>
364:             <tbody className="divide-y divide-gray-100">
365:               {paginatedData.map((row) => {
366:                 const rowKey = keyExtractor(row)
367:                 const isExpanded = expandedKeys.has(rowKey)
368:                 const handleRowClick = expandRender
369:                   ? () => toggleExpand(rowKey)
370:                   : onRowClick
371:                     ? () => onRowClick(row)
372:                     : undefined
373:                 const colCount = columns.length + (expandRender ? 1 : 0)
374: 
375:                 return (
376:                   <React.Fragment key={rowKey}>
377:                     <tr
378:                       onClick={handleRowClick}
379:                       className={`bg-white transition-colors ${
380:                         handleRowClick ? 'cursor-pointer hover:bg-gray-50' : ''
381:                       } ${rowClassName ? rowClassName(row) : ''}`}
382:                     >
383:                       {expandRender && (
384:                         <td className="w-8 px-2 py-3">
385:                           <ChevronRight
386:                             className={`h-4 w-4 text-gray-400 transition-transform ${isExpanded ? 'rotate-90' : ''}`}
387:                           />
388:                         </td>
389:                       )}
390:                       {columns.map((column) => (
391:                         <td
392:                           key={column.key}
393:                           className={`px-4 py-3 ${column.className ?? ''}`}
394:                         >
395:                           {column.render(row)}
396:                         </td>
397:                       ))}
398:                     </tr>
399:                     {isExpanded && expandRender && (
400:                       <tr>
401:                         <td colSpan={colCount} className="border-t-0 bg-gray-50 px-6 py-3">
402:                           {expandRender(row)}
403:                         </td>
404:                       </tr>
405:                     )}
406:                   </React.Fragment>
407:                 )
408:               })}
409:             </tbody>
410:           </table>
411:           {paginationUI}
412:         </div>
413:       </div>
414: 
415:       {/* Vista mobile */}
416:       <div className="flex flex-col gap-3 md:hidden">
417:         {paginatedData.map((row) => {
418:           const key = keyExtractor(row)
419:           const isExpanded = expandedKeys.has(key)
420:           const handleMobileClick = expandRender
421:             ? () => toggleExpand(key)
422:             : onRowClick
423:               ? () => onRowClick(row)
424:               : undefined
425: 
426:           if (mobileRender) {
427:             return (
428:               <div key={key}>
429:                 <div
430:                   onClick={handleMobileClick}
431:                   className={`${handleMobileClick ? 'cursor-pointer' : ''} ${rowClassName ? rowClassName(row) : ''}`}
432:                 >
433:                   {mobileRender(row)}
434:                 </div>
435:                 {isExpanded && expandRender && (
436:                   <div className="rounded-b-xl border border-t-0 border-gray-200 bg-gray-50 px-4 py-3">
437:                     {expandRender(row)}
438:                   </div>
439:                 )}
440:               </div>
441:             )
442:           }
443: 
444:           // Vista mobile por defecto: tarjeta con columnas apiladas
445:           return (
446:             <div key={key}>
447:               <div
448:                 onClick={handleMobileClick}
449:                 className={`rounded-xl border border-gray-200 bg-white p-4 ${
450:                   handleMobileClick ? 'cursor-pointer hover:bg-gray-50' : ''
451:                 } ${rowClassName ? rowClassName(row) : ''} ${isExpanded ? 'rounded-b-none' : ''}`}
452:               >
453:                 <div className="space-y-2">
454:                   {columns.map((column) => (
455:                     <div key={column.key} className="flex items-start justify-between gap-2">
456:                       <span className="shrink-0 text-xs font-medium text-iconsa-gray">
457:                         {column.header}
458:                       </span>
459:                       <span className="text-right text-sm text-gray-900">
460:                         {column.render(row)}
461:                       </span>
462:                     </div>
463:                   ))}
464:                 </div>
465:               </div>
466:               {isExpanded && expandRender && (
467:                 <div className="rounded-b-xl border border-t-0 border-gray-200 bg-gray-50 px-4 py-3">
468:                   {expandRender(row)}
469:                 </div>
470:               )}
471:             </div>
472:           )
473:         })}
474:         {/* Paginación mobile — debajo de las cards */}
475:         {paginationUI}
476:       </div>
477:     </div>
478:   )
479: }
480: 
481: export { DataTable }
</file>

