  5: import { Loader2 } from 'lucide-react'
  6: import { createClient } from '@/lib/supabase/client'
  7: import { useAuth } from '@/hooks/useAuth'
  8: import { useMyTrips } from '@/hooks/useMyTrips'
  9: import { TripCard } from '@/components/viajes/TripCard'
 10: import { Select, type SelectOption } from '@/components/ui/Select'
 11: 
 12: export default function MisViajesPage() {
 13:   const router = useRouter()
 14:   const supabase = useMemo(() => createClient(), [])
 15:   const { role, loading: authLoading } = useAuth()
 16:   const { trips, loading: tripsLoading, error } = useMyTrips()
 17: 
 18:   // Filtros client-side
 19:   const [statusFilter, setStatusFilter] = useState<string | null>(null)
 20:   const [dateFrom, setDateFrom] = useState<string | null>(null)
 21:   const [dateTo, setDateTo] = useState<string | null>(null)
 22:   const [driverFilter, setDriverFilter] = useState<string | null>(null)
 23:   const [drivers, setDrivers] = useState<{ id: string; name: string }[]>([])
 24: 
 25:   // Fetch conductores (campo) para filtro — solo relevante para roles que ven múltiples conductores
 26:   const showDriverFilter = role !== 'campo'
 27: 
 28:   useEffect(() => {
 29:     if (!showDriverFilter) return
 30:     supabase
 31:       .from('people')
 32:       .select('id, name')
 33:       .eq('status', 'Activo')
 34:       .eq('app_role', 'campo')
 35:       .order('name')
 36:       .then(({ data }) => setDrivers(data ?? []))
 37:   }, [supabase, showDriverFilter])
 38: 
 39:   const statusOptions: SelectOption[] = [
 40:     { value: 'Programado', label: 'Programado' },
 41:     { value: 'En Ruta', label: 'En Ruta' },
 42:     { value: 'Completado', label: 'Completado' },
 43:     { value: 'Cancelado', label: 'Cancelado' },
 44:   ]
 45: 
 46:   const driverOptions: SelectOption[] = useMemo(
 47:     () => drivers.map((d) => ({ value: d.id, label: d.name })),
 48:     [drivers],
 49:   )
 50: 
 51:   const filteredTrips = useMemo(() => {
 52:     return trips.filter((t) => {
 53:       if (statusFilter && t.status !== statusFilter) return false
 54:       if (dateFrom && t.scheduled_date < dateFrom) return false
 55:       if (dateTo && t.scheduled_date > dateTo) return false
 56:       if (driverFilter && t.driver?.id !== driverFilter) return false
 57:       return true
 58:     })
 59:   }, [trips, statusFilter, dateFrom, dateTo, driverFilter])
 60: 
 61:   if (authLoading || tripsLoading) {
 62:     return (
 63:       <div className="flex min-h-[50vh] items-center justify-center">
 64:         <div className="flex flex-col items-center gap-3">
 65:           <Loader2 className="h-8 w-8 animate-spin text-navy" />
 66:           <p className="text-sm text-iconsa-gray">Cargando movilizaciones...</p>
 67:         </div>
 68:       </div>
 69:     )
 70:   }
 71: 
 72:   return (
 73:     <div className="mx-auto max-w-2xl space-y-4 px-4 pb-8 pt-4 sm:px-6 sm:pt-6">
 74:       <h1 className="text-2xl font-bold text-gray-900">Mis Movilizaciones</h1>
 75: 
 76:       {/* Filtros */}
 77:       <div className="grid grid-cols-2 gap-3 lg:grid-cols-4">
 78:         <Select
 79:           placeholder="Todos los estados"
 80:           options={statusOptions}
 81:           value={statusFilter}
 82:           onChange={setStatusFilter}
 83:         />
 84:         <input
 85:           type="date"
 86:           value={dateFrom ?? ''}
 87:           onChange={(e) => setDateFrom(e.target.value || null)}
 88:           className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
 89:           title="Fecha desde"
 90:         />
 91:         <input
 92:           type="date"
 93:           value={dateTo ?? ''}
 94:           onChange={(e) => setDateTo(e.target.value || null)}
 95:           className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
 96:           title="Fecha hasta"
 97:         />
 98:         {showDriverFilter && (
 99:           <Select
100:             placeholder="Todos los conductores"
101:             options={driverOptions}
102:             value={driverFilter}
103:             onChange={setDriverFilter}
104:           />
105:         )}
106:       </div>
107: 
108:       {error && (
109:         <div className="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800">
110:           {error}
111:         </div>
112:       )}
113: 
114:       {filteredTrips.length === 0 ? (
115:         <div className="rounded-lg border border-gray-200 bg-white p-8 text-center shadow-sm">
116:           <p className="text-base font-medium text-gray-900">No hay movilizaciones registradas</p>
117:           <p className="mt-1 text-sm text-iconsa-gray">
118:             {trips.length > 0
119:               ? 'Ninguna movilización coincide con los filtros seleccionados.'
120:               : 'Las movilizaciones aparecerán aquí cuando se creen.'}
121:           </p>
122:         </div>
123:       ) : (
124:         <div className="space-y-3">
125:           {filteredTrips.map((trip) => (
126:             <TripCard
127:               key={trip.id}
128:               trip={trip}
129:               onClick={() => router.push(`/mis-viajes/${trip.id}`)}
130:             />
131:           ))}
132:         </div>
133:       )}
134:     </div>
135:   )
136: }
