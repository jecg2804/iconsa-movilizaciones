 10: import type { Attachment } from '@/lib/supabase/storage'
 11: import type { ExternalOrderWithLines } from './ExternalOrderCard'
 12: 
 13: interface ConfirmExternalOrderDeliveryModalProps {
 14:   order: ExternalOrderWithLines
 15:   receiverOptions: { value: string; label: string }[]
 16:   onConfirm: (data: {
 17:     receivedById: string | null
 18:     receivedByName: string
 19:     notes: string
 20:     additionalAttachments: Attachment[]
 21:   }) => Promise<void>
