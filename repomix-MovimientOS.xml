 42: 
 43:     // Trips Completados recientes
 44:     const { data: completedTrips } = await supabase
 45:       .from('trips')
 46:       .select('id, trip_id, updated_at')
 47:       .eq('status', 'Completado')
 48:       .gte('updated_at', since)
 49:       .order('updated_at', { ascending: false })
 50: 
 51:     if (!completedTrips || completedTrips.length === 0) {
 52:       setLines([])
 53:       setLoading(false)
 54:       return
 55:     }
 56: 
 57:     // Assignments de esos trips cuyas líneas sigan En Transito
 58:     const tripIds = completedTrips.map((t) => t.id)
 59:     const { data: rows } = await supabase
 60:       .from('trip_line_assignments')
 61:       .select(`
 62:         trip_id,
 63:         request_line_id,
 64:         qty_dispatched,
 65:         qty_delivered,
 66:         quantity_assigned,
 67:         line:request_line_id (
 68:           id,
 69:           description,
 70:           status,
 71:           quantity,
 72:           qty_delivered,
 73:           unit:unit_id ( code ),
 74:           request:request_id ( request_id )
 75:         )
 76:       `)
 77:       .in('trip_id', tripIds)
 78: 
 79:     type LineRel = {
 80:       id: string
 81:       description: string
 82:       status: string
 83:       quantity: number
 84:       qty_delivered: number | null
 85:       unit: { code: string } | { code: string }[] | null
 86:       request: { request_id: string } | { request_id: string }[] | null
 87:     }
 88:     type Row = {
 89:       trip_id: string
 90:       request_line_id: string
 91:       qty_dispatched: number | null
 92:       qty_delivered: number | null
 93:       quantity_assigned: number
 94:       line: LineRel | LineRel[] | null
 95:     }
 96: 
 97:     const tripMap = new Map(completedTrips.map((t) => [t.id, t.trip_id]))
 98:     const pending: PendingLine[] = []
 99: 
100:     for (const r of (rows ?? []) as Row[]) {
101:       const line = Array.isArray(r.line) ? r.line[0] : r.line
102:       if (!line || line.status !== 'En Transito') continue
103:       const unit = Array.isArray(line.unit) ? line.unit[0] : line.unit
104:       const req = Array.isArray(line.request) ? line.request[0] : line.request
105:       pending.push({
106:         trip_db_id: r.trip_id,
107:         trip_id: tripMap.get(r.trip_id) ?? r.trip_id,
108:         line_id: line.id,
109:         line_description: line.description,
110:         request_code: req?.request_id ?? '',
111:         qty_dispatched: r.qty_dispatched ?? r.quantity_assigned,
112:         qty_delivered: line.qty_delivered ?? 0,
113:         quantity: line.quantity,
