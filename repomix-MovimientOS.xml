103:   const [duplicates, setDuplicates] = useState<DuplicateMatch[] | null>(null)
104:   const [showDuplicateWarning, setShowDuplicateWarning] = useState(false)
105:   const [checkingDuplicates, setCheckingDuplicates] = useState(false)
106: 
107:   // --- Auto-rellenar descripcion al seleccionar equipo del dropdown ---
108:   useEffect(() => {
109:     if (lineType === 'Equipo' && equipmentValue.id) {
