 735:                         type="checkbox"
 736:                         checked={!!prefs[e.key]}
 737:                         disabled={isDisabled || isReceiveAll}
 738:                         onChange={() => togglePref(person.id, e.key, prefs)}
 739:                         title={`${e.label} — ${person.name}`}
 740:                         className="h-4 w-4 rounded border-gray-300 text-iconsa-blue focus:ring-iconsa-blue disabled:opacity-40"
 741:                       />
 742:                     </td>
 743:                   ))}
 744:                 </tr>
 745:               )
 746:             })}
 747:           </tbody>
 748:         </table>
 749:         {filtered.length === 0 && (
