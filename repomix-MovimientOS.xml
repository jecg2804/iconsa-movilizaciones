 260: # Expected: pasa
 261: ```
 262: 
 263: **Steps:**
 264: 
 265: - [ ] **Step 1: Crear `src/hooks/useCostCodeCascade.ts`**
 266: 
 267: ```typescript
 268: 'use client'
 269: 
 270: import { useState, useEffect, useMemo } from 'react'
 271: import { createClient } from '@/lib/supabase/client'
 272: import type { SelectOption } from '@/components/ui/Select'
 273: 
 274: export interface UseCostCodeCascadeReturn {
 275:   // Extras
 276:   extraOptions: SelectOption[]
 277:   hasExtras: boolean
 278:   selectedExtraId: string | null
 279:   setSelectedExtraId: (id: string | null) => void
 280:   loadingExtras: boolean
 281:   // Cost codes (filtrados por proyecto + extra)
 282:   costCodeOptions: SelectOption[]
 283:   loadingCostCodes: boolean
 284:   costCodeId: string | null
 285:   setCostCodeId: (id: string | null) => void
 286:   // Cost categories (filtrados via cost_code_categories por costCodeId)
 287:   categoryOptions: SelectOption[]
 288:   loadingCategories: boolean
 289:   costCategoryId: string | null
 290:   setCostCategoryId: (id: string | null) => void
 291: }
 292: 
 293: /**
 294:  * Cascada Proyecto → [Extra] → Fase → Categoría para selección de cost_code.
 295:  *
 296:  * - Si el proyecto tiene extras (project_extras), `hasExtras=true` y se debe
 297:  *   seleccionar uno antes de listar fases.
 298:  * - Si no, las fases se listan directamente filtrando por `project_id` y
 299:  *   `extra_id IS NULL`.
 300:  * - Categorías se listan desde `cost_code_categories` filtrado por `costCodeId`.
 301:  *
 302:  * Reset behavior:
 303:  * - Cambio de projectId → reset cost_code, category, extra
 304:  * - Cambio de costCodeId → reset category
 305:  *
 306:  * Si se provee `initialCostCodeId` y el proyecto tiene extras, detecta el
 307:  * extra correspondiente para hidratar `selectedExtraId` al editar.
 308:  */
 309: export function useCostCodeCascade(
 310:   projectId: string | null,
 311:   initialCostCodeId?: string | null,
 312:   initialCostCategoryId?: string | null,
 313: ): UseCostCodeCascadeReturn {
 314:   const supabase = useMemo(() => createClient(), [])
 315: 
 316:   // --- Estado público ---
 317:   const [extraOptions, setExtraOptions] = useState<SelectOption[]>([])
 318:   const [hasExtras, setHasExtras] = useState(false)
 319:   const [selectedExtraId, setSelectedExtraId] = useState<string | null>(null)
 320:   const [loadingExtras, setLoadingExtras] = useState(false)
 321: 
 322:   const [costCodeOptions, setCostCodeOptions] = useState<SelectOption[]>([])
 323:   const [loadingCostCodes, setLoadingCostCodes] = useState(false)
 324:   const [costCodeId, setCostCodeId] = useState<string | null>(initialCostCodeId ?? null)
 325: 
 326:   const [categoryOptions, setCategoryOptions] = useState<SelectOption[]>([])
 327:   const [loadingCategories, setLoadingCategories] = useState(false)
 328:   const [costCategoryId, setCostCategoryId] = useState<string | null>(initialCostCategoryId ?? null)
 329: 
 330:   // --- Reset al cambiar proyecto ---
 331:   // (No resetea en mount cuando initialCostCodeId está provisto — lo respeta)
 332:   useEffect(() => {
 333:     if (!projectId) {
 334:       setExtraOptions([])
 335:       setHasExtras(false)
 336:       setSelectedExtraId(null)
 337:       setCostCodeOptions([])
 338:       setCostCodeId(null)
 339:       setCategoryOptions([])
 340:       setCostCategoryId(null)
 341:     }
 342:   }, [projectId])
 343: 
 344:   // --- Fetch extras del proyecto ---
 345:   useEffect(() => {
 346:     if (!projectId) return
 347: 
 348:     let cancelled = false
 349:     setLoadingExtras(true)
 350: 
 351:     ;(supabase.from.bind(supabase) as (table: string) => ReturnType<typeof supabase.from>)('project_extras')
 352:       .select('id, code, description')
 353:       .eq('project_id', projectId)
 354:       .eq('is_active', true)
 355:       .order('code')
 356:       .then(({ data }: { data: Array<{ id: string; code: string; description: string | null }> | null }) => {
 357:         if (cancelled) return
 358:         const extras = data ?? []
 359:         if (extras.length > 0) {
 360:           setExtraOptions(extras.map((e) => ({
 361:             value: e.id,
 362:             label: `${e.code} — ${e.description ?? e.code}`,
 363:           })))
 364:           setHasExtras(true)
 365:           // Si NO estamos editando (no hay initialCostCodeId), reset extra
 366:           if (!initialCostCodeId) {
 367:             setSelectedExtraId(null)
 368:           }
 369:         } else {
 370:           setExtraOptions([])
 371:           setHasExtras(false)
 372:           setSelectedExtraId(null)
 373:         }
 374:         setLoadingExtras(false)
 375:       })
 376: 
 377:     return () => { cancelled = true }
 378:   }, [projectId, supabase, initialCostCodeId])
 379: 
 380:   // --- Detectar extra del costCode inicial al editar ---
 381:   useEffect(() => {
 382:     if (!initialCostCodeId || !projectId || !hasExtras) return
 383: 
 384:     let cancelled = false
 385:     supabase
 386:       .from('cost_codes')
 387:       .select('extra_id')
 388:       .eq('id', initialCostCodeId)
 389:       .single()
 390:       .then(({ data }) => {
 391:         if (cancelled) return
 392:         if (data?.extra_id) {
 393:           setSelectedExtraId(data.extra_id as string)
 394:         } else {
 395:           setSelectedExtraId('__base__')
 396:         }
 397:       })
 398: 
 399:     return () => { cancelled = true }
 400:   }, [initialCostCodeId, projectId, hasExtras, supabase])
 401: 
 402:   // --- Fetch cost codes filtrados por proyecto + extra ---
 403:   useEffect(() => {
 404:     if (!projectId) {
 405:       setCostCodeOptions([])
 406:       return
 407:     }
 408: 
 409:     if (hasExtras && selectedExtraId === null && !loadingExtras) {
 410:       setCostCodeOptions([])
 411:       return
 412:     }
 413: 
 414:     if (loadingExtras) return
 415: 
 416:     let cancelled = false
 417:     setLoadingCostCodes(true)
 418: 
 419:     const query = supabase
 420:       .from('cost_codes')
 421:       .select('id, phase_code, phase_description, full_code, extra_id')
 422:       .eq('project_id', projectId)
 423:       .order('full_code')
 424: 
 425:     const extraFilter = selectedExtraId === '__base__' ? null : selectedExtraId
 426:     const finalQuery = extraFilter
 427:       ? query.eq('extra_id', extraFilter)
 428:       : query.is('extra_id', null)
 429: 
 430:     finalQuery.then(({ data }) => {
 431:       if (cancelled) return
 432:       const options: SelectOption[] = (data ?? []).map((cc) => ({
 433:         value: cc.id,
 434:         label: cc.full_code
 435:           ? `${cc.full_code} — ${cc.phase_description ?? ''}`
 436:           : `${cc.phase_code} — ${cc.phase_description ?? ''}`,
 437:       }))
