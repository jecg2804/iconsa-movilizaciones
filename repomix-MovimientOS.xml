 775:         // 7. Reload
 776:         setActiveEvent(null)
 777:         const tripData = await fetchTrip(id)
 778:         setTrip(tripData)
 779:         await loadEvents()
 780:       } catch (err) {
 781:         const errMsg = err instanceof Error ? err.message : 'Error al registrar entrega'
 782:         // Cambio 6 Bug #4: trigger BD enforce_one_active_delivery_trg rechaza
 783:         // segundo INSERT en trip_event_lines si ya hay Entrega no-revertida.
 784:         if (errMsg.includes('ya tiene una Entrega activa')) {
 785:           setEventError('Esta línea ya fue entregada en este viaje. Reversá la Entrega anterior primero si necesitás corregir.')
 786:         } else {
 787:           setEventError(errMsg)
 788:         }
 789:       } finally {
 790:         setDelivering(false)
 791:       }
 792:     },
 793:     [supabase, trip, person, fetchTrip, id, loadEvents],
 794:   )
