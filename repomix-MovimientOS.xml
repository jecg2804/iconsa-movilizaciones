 768:         const reqIds = [...new Set(
 769:           trip.assignments.map((a) => a.line?.request?.id).filter(Boolean),
 770:         )] as string[]
 771:         for (const reqId of reqIds) {
 772:           notifySolicitudCompletada(reqId).catch(console.error)
 773:         }
