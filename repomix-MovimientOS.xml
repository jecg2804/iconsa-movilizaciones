 26: 
 27: export function ConfirmExternalOrderDeliveryModal({
 28:   order,
 29:   receiverOptions,
 30:   onConfirm,
 31:   onClose,
 32:   loading,
 33:   error,
 34: }: ConfirmExternalOrderDeliveryModalProps) {
 35:   const [confirmed, setConfirmed] = useState(false)
 36:   const [receiver, setReceiver] = useState<SelectWithFallbackValue>({ id: null, text: null })
 37:   const [notes, setNotes] = useState('')
 38:   const [additionalAttachments, setAdditionalAttachments] = useState<Attachment[]>([])
 39: 
 40:   const folderId = useMemo(() => `external/${order.id}`, [order.id])
 41:   const canConfirm = confirmed && !loading
 42: 
 43:   const handleViewInvoice = useCallback(async () => {
 44:     if (order.invoice_attachments.length === 0) return
 45:     const url = await getFileUrl(order.invoice_attachments[0].path)
 46:     if (url) window.open(url, '_blank', 'noopener,noreferrer')
 47:   }, [order.invoice_attachments])
 48: 
 49:   const handleSubmit = useCallback(async () => {
 50:     if (!confirmed) return
 51:     await onConfirm({
 52:       receivedById: receiver.id,
 53:       receivedByName: (receiver.text ?? '').trim(),
 54:       notes: notes.trim(),
 55:       additionalAttachments,
 56:     })
 57:   }, [confirmed, receiver, notes, additionalAttachments, onConfirm])
 58: 
 59:   return (
 60:     <div className="fixed inset-0 z-50 flex items-end justify-center bg-black/50 p-4 sm:items-center">
 61:       <div className="w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-t-2xl bg-white p-4 shadow-xl sm:rounded-2xl sm:p-6">
 62:         <h3 className="mb-4 text-lg font-semibold text-gray-900">
 63:           Confirmar entrega externo {order.external_id}
 64:         </h3>
 65: 
 66:         <div className="mb-4 rounded-lg border border-blue-200 bg-blue-50 p-3 space-y-1">
 67:           <p className="text-xs font-semibold text-blue-900">
 68:             {order.lines.length} {order.lines.length === 1 ? 'línea' : 'líneas'} a entregar
 69:           </p>
 70:           <p className="text-xs text-iconsa-gray">
 71:             Proveedor: <span className="font-medium">{order.provider_name}</span>
 72:             {' · '}
 73:             Costo: <span className="font-medium">{formatCurrency(order.invoice_amount)}</span>
 74:             {order.invoice_attachments.length > 0 && (
 75:               <>
 76:                 {' · '}
 77:                 <button
 78:                   type="button"
 79:                   onClick={handleViewInvoice}
 80:                   className="text-blue-600 hover:underline"
 81:                 >
 82:                   Ver factura
 83:                 </button>
 84:               </>
 85:             )}
 86:           </p>
 87:           <div className="mt-2 space-y-0.5">
 88:             {order.lines.map((ol) => {
 89:               if (!ol.line) return null
 90:               const isEquipo = ol.line.line_type === 'Equipo'
 91:               const unitCode = ol.line.unit?.code ?? ol.line.unit_text ?? ''
 92:               return (
 93:                 <div key={ol.id} className="flex items-center gap-2 text-sm">
 94:                   {isEquipo ? <Wrench className="h-3.5 w-3.5 text-iconsa-blue" /> : <Package className="h-3.5 w-3.5 text-gold" />}
 95:                   <span className="font-medium text-gray-900">{ol.line.description}</span>
 96:                   <span className="text-gray-300">·</span>
 97:                   <span className="font-semibold text-gray-700 whitespace-nowrap">
 98:                     {formatQty(ol.quantity_assigned)} {unitCode}
 99:                   </span>
100:                 </div>
101:               )
102:             })}
103:           </div>
104:         </div>
105: 
106:         <div className="space-y-4">
107:           <label className="flex items-start gap-2 cursor-pointer">
108:             <input
109:               type="checkbox"
110:               checked={confirmed}
111:               onChange={(e) => setConfirmed(e.target.checked)}
112:               disabled={loading}
113:               className="mt-0.5 rounded border-gray-300 text-navy focus:ring-navy"
114:             />
115:             <span className="text-sm text-gray-700">
116:               Confirmo que el material llegó al proyecto destino. <span className="text-red-600">*</span>
117:             </span>
118:           </label>
119: 
120:           <SelectWithFallback
121:             label="Receptor en proyecto (opcional)"
122:             placeholder="Seleccionar persona..."
123:             options={receiverOptions}
124:             value={receiver}
125:             onChange={setReceiver}
126:             fallbackPlaceholder="Escribir nombre del receptor"
127:           />
128:           <p className="-mt-2 text-xs text-iconsa-gray">
129:             La factura ya subida es la prueba primaria. Receptor opcional.
130:           </p>
131: 
132:           <div>
133:             <label htmlFor="confirm-ext-notes" className="mb-1 block text-sm font-medium text-gray-700">
134:               Notas adicionales (opcional)
135:             </label>
136:             <textarea
137:               id="confirm-ext-notes"
138:               value={notes}
139:               onChange={(e) => setNotes(e.target.value)}
140:               placeholder="Observaciones de la entrega..."
141:               rows={2}
142:               maxLength={500}
143:               className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
144:             />
145:           </div>
146: 
147:           <FileUploader
148:             attachments={additionalAttachments}
149:             folder={folderId}
150:             onChange={setAdditionalAttachments}
151:             label="Foto adicional (opcional)"
152:             hint="Se agrega a las facturas existentes del order (max 10MB)"
153:           />
154: 
155:           {error && <p className="text-sm text-red-600">{error}</p>}
156: 
157:           <div className="flex gap-2 pt-2">
158:             <Button variant="primary" onClick={handleSubmit} loading={loading} disabled={!canConfirm}>
159:               Confirmar entrega
160:             </Button>
161:             <Button variant="ghost" onClick={onClose} disabled={loading}>
162:               Cancelar
163:             </Button>
164:           </div>
165:         </div>
166:       </div>
167:     </div>
168:   )
169: }
