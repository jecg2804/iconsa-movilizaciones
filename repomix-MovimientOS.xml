 84:     if (invoiceAttachments.length === 0) errs.invoiceAttachments = 'Adjunta al menos una cotización o factura'
 85:     if (!scheduledDate || !/^\d{4}-\d{2}-\d{2}$/.test(scheduledDate)) errs.scheduledDate = 'La fecha programada es requerida'
 86:     if (notes.length > 500) errs.notes = 'Máximo 500 caracteres'
