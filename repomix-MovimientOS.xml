<file path="src/components/ui/Select.tsx">
  1: 'use client'
  2: 
  3: import { useState, useRef, useEffect, useCallback, useMemo } from 'react'
  4: import { ChevronDown, X } from 'lucide-react'
  5: 
  6: export interface SelectOption {
  7:   value: string
  8:   label: string
  9:   sublabel?: string
 10:   /** Valor numérico opcional — usado para auto-fill (ej: monto de tarifa de movilización) */
 11:   amount?: number
 12: }
 13: 
 14: interface SelectProps {
 15:   label?: string
 16:   placeholder?: string
 17:   options: SelectOption[]
 18:   value: string | null
 19:   onChange: (value: string | null) => void
 20:   error?: string
 21:   disabled?: boolean
 22:   searchable?: boolean
 23:   emptyMessage?: string
 24:   className?: string
 25:   id?: string
 26: }
 27: 
 28: function Select({
 29:   label,
 30:   placeholder = 'Seleccionar...',
 31:   options,
 32:   value,
 33:   onChange,
 34:   error,
 35:   disabled = false,
 36:   searchable = true,
 37:   emptyMessage = 'No se encontraron resultados',
 38:   className = '',
 39:   id,
 40: }: SelectProps) {
 41:   const [isOpen, setIsOpen] = useState(false)
 42:   const [search, setSearch] = useState('')
 43:   const [highlightedIndex, setHighlightedIndex] = useState(-1)
 44:   const containerRef = useRef<HTMLDivElement>(null)
 45:   const searchInputRef = useRef<HTMLInputElement>(null)
 46:   const listRef = useRef<HTMLUListElement>(null)
 47: 
 48:   const inputId = id ?? label?.toLowerCase().replace(/\s+/g, '-')
 49: 
 50:   const selectedOption = useMemo(
 51:     () => options.find((opt) => opt.value === value) ?? null,
 52:     [options, value],
 53:   )
 54: 
 55:   const filteredOptions = useMemo(() => {
 56:     if (!search) return options
 57:     const term = search.toLowerCase()
 58:     return options.filter((opt) => opt.label.toLowerCase().includes(term))
 59:   }, [options, search])
 60: 
 61:   // Cerrar al hacer click afuera
 62:   useEffect(() => {
 63:     function handleMouseDown(e: MouseEvent) {
 64:       if (containerRef.current && !containerRef.current.contains(e.target as Node)) {
 65:         setIsOpen(false)
 66:         setSearch('')
 67:       }
 68:     }
 69:     document.addEventListener('mousedown', handleMouseDown)
 70:     return () => document.removeEventListener('mousedown', handleMouseDown)
 71:   }, [])
 72: 
 73:   // Auto-focus en el input de busqueda al abrir
 74:   useEffect(() => {
 75:     if (isOpen && searchable && searchInputRef.current) {
 76:       searchInputRef.current.focus()
 77:     }
 78:   }, [isOpen, searchable])
 79: 
 80:   const handleToggle = useCallback(() => {
 81:     if (disabled) return
 82:     setIsOpen((prev) => {
 83:       if (prev) setSearch('')
 84:       return !prev
 85:     })
 86:   }, [disabled])
 87: 
 88:   const handleSelect = useCallback(
 89:     (optionValue: string) => {
 90:       onChange(optionValue)
 91:       setIsOpen(false)
 92:       setSearch('')
 93:     },
 94:     [onChange],
 95:   )
 96: 
 97:   const handleClear = useCallback(
 98:     (e: React.MouseEvent) => {
 99:       e.stopPropagation()
100:       onChange(null)
101:       setIsOpen(false)
102:       setSearch('')
103:     },
104:     [onChange],
105:   )
106: 
107:   // Reset highlight cuando cambian las opciones filtradas
108:   useEffect(() => {
109:     setHighlightedIndex(-1)
110:   }, [filteredOptions.length])
111: 
112:   const handleKeyDown = useCallback(
113:     (e: React.KeyboardEvent) => {
114:       if (e.key === 'Escape') {
115:         setIsOpen(false)
116:         setSearch('')
117:         return
118:       }
119: 
120:       if (!isOpen) {
121:         if (e.key === 'ArrowDown' || e.key === 'Enter') {
122:           e.preventDefault()
123:           setIsOpen(true)
124:         }
125:         return
126:       }
127: 
128:       if (e.key === 'ArrowDown') {
129:         e.preventDefault()
130:         setHighlightedIndex((prev) => {
131:           const next = prev < filteredOptions.length - 1 ? prev + 1 : 0
132:           listRef.current?.children[next]?.scrollIntoView({ block: 'nearest' })
133:           return next
134:         })
135:       } else if (e.key === 'ArrowUp') {
136:         e.preventDefault()
137:         setHighlightedIndex((prev) => {
138:           const next = prev > 0 ? prev - 1 : filteredOptions.length - 1
139:           listRef.current?.children[next]?.scrollIntoView({ block: 'nearest' })
140:           return next
141:         })
142:       } else if (e.key === 'Enter') {
143:         e.preventDefault()
144:         if (highlightedIndex >= 0 && highlightedIndex < filteredOptions.length) {
145:           handleSelect(filteredOptions[highlightedIndex].value)
146:         }
147:       }
148:     },
149:     [isOpen, filteredOptions, highlightedIndex, handleSelect],
150:   )
151: 
152:   return (
153:     <div ref={containerRef} className={`relative w-full ${className}`}>
154:       {label && (
155:         <label
156:           htmlFor={inputId}
157:           className="mb-1 block text-sm font-medium text-gray-700"
158:         >
159:           {label}
160:         </label>
161:       )}
162: 
163:       {/* Trigger */}
164:       <button
165:         type="button"
166:         id={inputId}
167:         onClick={handleToggle}
168:         onKeyDown={handleKeyDown}
169:         disabled={disabled}
170:         className={`
171:           flex w-full items-center justify-between rounded-lg border px-3 py-2 text-sm text-left
172:           focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue
173:           disabled:bg-gray-50 disabled:text-gray-500 disabled:cursor-not-allowed
174:           ${error ? 'border-iconsa-red' : 'border-gray-300'}
175:         `}
176:       >
177:         <span className={selectedOption ? 'text-gray-900' : 'text-gray-400'}>
178:           {selectedOption?.label ?? placeholder}
179:         </span>
180:         <span className="flex items-center gap-1">
181:           {value !== null && !disabled && (
182:             <span
183:               role="button"
184:               title="Limpiar selección"
185:               tabIndex={-1}
186:               onClick={handleClear}
187:               onKeyDown={(e) => {
188:                 if (e.key === 'Enter') handleClear(e as unknown as React.MouseEvent)
189:               }}
190:               className="rounded p-0.5 hover:bg-gray-100"
191:             >
192:               <X className="h-3.5 w-3.5 text-gray-400" />
193:             </span>
194:           )}
195:           <ChevronDown
196:             className={`h-4 w-4 text-gray-400 transition-transform ${isOpen ? 'rotate-180' : ''}`}
197:           />
198:         </span>
199:       </button>
200: 
201:       {/* Dropdown */}
202:       {isOpen && (
203:         <div
204:           className="absolute z-50 mt-1 w-full max-h-60 overflow-auto rounded-lg border border-gray-300 bg-white shadow-lg"
205:         >
206:           {searchable && (
207:             <div className="sticky top-0 border-b border-gray-200 bg-white p-2">
208:               <input
209:                 ref={searchInputRef}
210:                 type="text"
211:                 value={search}
212:                 onChange={(e) => setSearch(e.target.value)}
213:                 onKeyDown={handleKeyDown}
214:                 placeholder="Buscar..."
215:                 className="w-full rounded border border-gray-300 px-2.5 py-1.5 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
216:               />
217:             </div>
218:           )}
219: 
220:           {filteredOptions.length === 0 ? (
221:             <div className="px-3 py-4 text-center text-sm text-gray-500">
222:               {emptyMessage}
223:             </div>
224:           ) : (
225:             <ul role="listbox" aria-label={label ?? placeholder} ref={listRef}>
226:               {filteredOptions.map((option, idx) => (
227:                 <li
228:                   key={option.value}
229:                   role="option"
230:                   aria-selected={option.value === value ? true : undefined}
231:                   onClick={() => handleSelect(option.value)}
232:                   onMouseEnter={() => setHighlightedIndex(idx)}
233:                   className={`
234:                     cursor-pointer px-3 py-2 text-sm
235:                     ${idx === highlightedIndex ? 'bg-gray-100' : 'hover:bg-gray-50'}
236:                     ${option.value === value ? 'bg-iconsa-blue/5 font-medium text-iconsa-blue' : 'text-gray-900'}
237:                   `}
238:                 >
239:                   <span className="block">{option.label}</span>
240:                   {option.sublabel && (
241:                     <span className="block text-xs text-gray-500">{option.sublabel}</span>
242:                   )}
243:                 </li>
244:               ))}
245:             </ul>
246:           )}
247:         </div>
248:       )}
249: 
250:       {error && (
251:         <p className="mt-1 text-sm text-iconsa-red">{error}</p>
252:       )}
253:     </div>
254:   )
255: }
256: 
257: export { Select }
258: export type { SelectProps }
</file>

<file path="src/components/ui/SelectWithFallback.tsx">
  1: 'use client'
  2: 
  3: import { useState, useCallback } from 'react'
  4: import { Select, type SelectOption } from '@/components/ui/Select'
  5: import { Input } from '@/components/ui/Input'
  6: 
  7: export interface SelectWithFallbackValue {
  8:   id: string | null
  9:   text: string | null
 10: }
 11: 
 12: interface SelectWithFallbackProps {
 13:   label?: string
 14:   placeholder?: string
 15:   options: SelectOption[]
 16:   value: SelectWithFallbackValue
 17:   onChange: (value: SelectWithFallbackValue) => void
 18:   error?: string
 19:   disabled?: boolean
 20:   fallbackLabel?: string
 21:   fallbackPlaceholder?: string
 22:   className?: string
 23: }
 24: 
 25: function SelectWithFallback({
 26:   label,
 27:   placeholder = 'Seleccionar...',
 28:   options,
 29:   value,
 30:   onChange,
 31:   error,
 32:   disabled = false,
 33:   fallbackLabel = 'No está en la lista',
 34:   fallbackPlaceholder = 'Escriba el valor...',
 35:   className = '',
 36: }: SelectWithFallbackProps) {
 37:   // Si el valor actual tiene text pero no id, estamos en modo fallback
 38:   const [isFallback, setIsFallback] = useState(
 39:     value.text !== null && value.id === null,
 40:   )
 41: 
 42:   const handleToggleToFallback = useCallback(() => {
 43:     setIsFallback(true)
 44:     onChange({ id: null, text: '' })
 45:   }, [onChange])
 46: 
 47:   const handleToggleToList = useCallback(() => {
 48:     setIsFallback(false)
 49:     onChange({ id: null, text: null })
 50:   }, [onChange])
 51: 
 52:   const handleSelectChange = useCallback(
 53:     (selectedId: string | null) => {
 54:       onChange({ id: selectedId, text: null })
 55:     },
 56:     [onChange],
 57:   )
 58: 
 59:   const handleTextChange = useCallback(
 60:     (e: React.ChangeEvent<HTMLInputElement>) => {
 61:       onChange({ id: null, text: e.target.value })
 62:     },
 63:     [onChange],
 64:   )
 65: 
 66:   if (isFallback) {
 67:     return (
 68:       <div className={className}>
 69:         <Input
 70:           label={label}
 71:           placeholder={fallbackPlaceholder}
 72:           value={value.text ?? ''}
 73:           onChange={handleTextChange}
 74:           error={error}
 75:           disabled={disabled}
 76:         />
 77:         {!disabled && (
 78:           <button
 79:             type="button"
 80:             onClick={handleToggleToList}
 81:             className="mt-1 text-xs font-medium text-iconsa-blue hover:text-iconsa-blue/80 hover:underline"
 82:           >
 83:             Volver a la lista
 84:           </button>
 85:         )}
 86:       </div>
 87:     )
 88:   }
 89: 
 90:   return (
 91:     <div className={className}>
 92:       <Select
 93:         label={label}
 94:         placeholder={placeholder}
 95:         options={options}
 96:         value={value.id}
 97:         onChange={handleSelectChange}
 98:         error={error}
 99:         disabled={disabled}
100:         searchable
101:       />
102:       {!disabled && (
103:         <button
104:           type="button"
105:           onClick={handleToggleToFallback}
106:           className="mt-1 text-xs font-medium text-iconsa-gray hover:text-iconsa-blue hover:underline"
107:         >
108:           {fallbackLabel}
109:         </button>
110:       )}
111:     </div>
112:   )
113: }
114: 
115: export { SelectWithFallback }
</file>

<file path="src/components/viajes/CodeConfirmation.tsx">
  1: 'use client'
  2: 
  3: import { useState, useMemo } from 'react'
  4: import { Input } from '@/components/ui/Input'
  5: import { Button } from '@/components/ui/Button'
  6: import { SelectWithFallback, type SelectWithFallbackValue } from '@/components/ui/SelectWithFallback'
  7: import type { SelectOption } from '@/components/ui/Select'
  8: 
  9: interface CodeConfirmationProps {
 10:   /** Código esperado — usado SOLO para validación interna. NUNCA mostrar en UI. */
 11:   expectedCode: string | null
 12:   /** Opciones para el dropdown de receptor */
 13:   receiverOptions: SelectOption[]
 14:   onConfirm: (codeUsed: string, receivedById: string | null, receivedByName: string) => void
 15:   onCancel: () => void
 16:   loading?: boolean
 17: }
 18: 
 19: export function CodeConfirmation({
 20:   expectedCode,
 21:   receiverOptions,
 22:   onConfirm,
 23:   onCancel,
 24:   loading,
 25: }: CodeConfirmationProps) {
 26:   const [code, setCode] = useState('')
 27:   const [receiver, setReceiver] = useState<SelectWithFallbackValue>({ id: null, text: null })
 28:   const [showHelp, setShowHelp] = useState(false)
 29: 
 30:   // Validación del código
 31:   const codeComplete = code.trim().length === 4
 32:   const codeCorrect = codeComplete && expectedCode !== null && code.trim() === expectedCode
 33:   const codeIncorrect = codeComplete && expectedCode !== null && code.trim() !== expectedCode
 34: 
 35:   // Receptor lleno: seleccionó del dropdown (id) o escribió texto (text)
 36:   const receiverFilled = (receiver.id !== null) || (receiver.text !== null && receiver.text.trim().length > 0)
 37: 
 38:   // Nombre del receptor para denormalización
 39:   const receiverName = useMemo(() => {
 40:     if (receiver.id) {
 41:       const opt = receiverOptions.find((o) => o.value === receiver.id)
 42:       return opt?.label ?? ''
 43:     }
 44:     return receiver.text?.trim() ?? ''
 45:   }, [receiver, receiverOptions])
 46: 
 47:   const canConfirm = codeCorrect && receiverFilled
 48: 
 49:   const handleConfirm = () => {
 50:     if (!canConfirm) return
 51:     onConfirm(code.trim(), receiver.id, receiverName)
 52:   }
 53: 
 54:   return (
 55:     <div className="space-y-4">
 56:       <p className="text-sm text-gray-700">
 57:         Solicite el código de confirmación al receptor en campo e ingréselo aquí.
 58:       </p>
 59: 
 60:       <div className="space-y-3">
 61:         {/* Código de confirmación */}
 62:         <Input
 63:           label="Código de confirmación (4 dígitos)"
 64:           type="text"
 65:           inputMode="numeric"
 66:           maxLength={4}
 67:           placeholder="0000"
 68:           value={code}
 69:           onChange={(e) => setCode(e.target.value.replace(/\D/g, ''))}
 70:           error={codeIncorrect ? 'Código incorrecto. Verifique con el solicitante.' : undefined}
 71:         />
 72: 
 73:         {/* Mensaje de código correcto */}
 74:         {codeCorrect && (
 75:           <p className="text-sm font-medium text-iconsa-green">Código verificado ✓</p>
 76:         )}
 77: 
 78:         {/* Recibido por — SelectWithFallback */}
 79:         <SelectWithFallback
 80:           label="Recibido por"
 81:           placeholder="Seleccionar receptor..."
 82:           options={receiverOptions}
 83:           value={receiver}
 84:           onChange={setReceiver}
 85:           fallbackLabel="No está en la lista"
 86:           fallbackPlaceholder="Nombre del receptor"
 87:         />
 88:       </div>
 89: 
 90:       {/* Link de ayuda */}
 91:       <button
 92:         type="button"
 93:         onClick={() => setShowHelp(!showHelp)}
 94:         className="text-xs font-medium text-iconsa-blue hover:underline"
 95:       >
 96:         ¿No tiene el código?
 97:       </button>
 98: 
 99:       {showHelp && (
100:         <div className="rounded-lg border border-blue-200 bg-blue-50 px-4 py-3">
101:           <p className="text-sm text-blue-800">
102:             Contacte al solicitante o al coordinador de logística para obtener el código de confirmación.
103:             La entrega no puede registrarse sin el código correcto.
104:           </p>
105:         </div>
106:       )}
107: 
108:       {/* Acciones */}
109:       <div className="flex gap-2">
110:         <Button variant="primary" onClick={handleConfirm} disabled={!canConfirm} loading={loading}>
