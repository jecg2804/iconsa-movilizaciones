186:                           </p>
187:                         )}
188:                       </button>
189:                     ))}
190:                     {overflow > 0 && (
191:                       <span className="block text-[9px] text-iconsa-blue font-medium pl-1">
192:                         +{overflow} más
193:                       </span>
194:                     )}
195:                   </div>
196:                 </div>
197:               )
198:             })}
199:           </div>
200:         ))}
201:       </div>
202: 
203:       {/* Mobile: lista vertical */}
204:       <div className="md:hidden divide-y divide-gray-100">
205:         {days.map((day) => {
206:           const key = format(day, 'yyyy-MM-dd')
207:           const dayItems = itemsByDate.get(key) ?? []
208:           const isToday = isSameDay(day, today)
209:           const isSelected = selectedDate === key
210: 
211:           if (dayItems.length === 0 && !isToday) return null
212: 
213:           return (
214:             <div
215:               key={key}
216:               className={`${isSelected ? 'bg-blue-50/40' : ''}`}
217:             >
218:               {/* Cabecera del día */}
219:               <button
220:                 type="button"
221:                 onClick={() => handleDayClick(key)}
222:                 className={`w-full px-3 py-1.5 text-left text-xs font-medium ${
223:                   isToday ? 'text-iconsa-blue' : 'text-gray-600'
