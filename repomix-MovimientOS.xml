 352: export function useTrips(initialFilter?: Partial<TripsFilter>) {
 353:   const supabase = useMemo(() => createClient(), [])
 354: 
 355:   // Estado del backlog de líneas pendientes
 356:   const [backlog, setBacklog] = useState<BacklogLine[]>([])
 357:   const [backlogLoading, setBacklogLoading] = useState(false)
 358: 
 359:   // Estado de la lista de viajes
 360:   const [trips, setTrips] = useState<TripWithRelations[]>([])
 361:   const [listLoading, setListLoading] = useState(false)
 362:   const [listError, setListError] = useState<string | null>(null)
 363:   const [tripsTotalCount, setTripsTotalCount] = useState(0)
 364: 
 365:   // Filtros para la lista de viajes
 366:   const [filters, setFiltersState] = useState<TripsFilter>({
 367:     ...DEFAULT_FILTER,
 368:     ...initialFilter,
 369:   })
 370: 
 371:   // Estado de mutaciones
 372:   const [saving, setSaving] = useState(false)
 373:   const [saveError, setSaveError] = useState<string | null>(null)
 374:   const busyRef = useRef(false)
 375: 
 376:   // --- Actualizar filtros parcialmente ---
 377:   const setFilters = useCallback((updates: Partial<TripsFilter>) => {
 378:     setFiltersState((prev) => ({ ...prev, ...updates }))
 379:   }, [])
 380: 
 381:   // --- Fetch backlog de líneas pendientes ---
 382:   const refetchBacklog = useCallback(async () => {
 383:     setBacklogLoading(true)
 384: 
 385:     try {
 386:       // Traer todas las líneas en estado Pendiente cuyas solicitudes padre
 387:       // no estén Canceladas, Completadas, ni en Borrador (no enviadas aún)
 388:       const { data, error } = await supabase
 389:         .from('sm_request_lines')
 390:         .select(`
 391:           id,
 392:           request_id,
 393:           line_number,
 394:           line_type,
 395:           equipment_id,
 396:           description,
 397:           from_location_id,
 398:           from_text,
 399:           to_location_id,
 400:           to_text,
 401:           quantity,
 402:           unit_id,
 403:           unit_text,
 404:           category,
 405:           notes,
 406:           status,
 407:           qty_scheduled,
 408:           qty_delivered,
 409:           equipment:equipment_id(id, spectrum_code, description),
 410:           from_location:from_location_id(id, name, location_type),
 411:           to_location:to_location_id(id, name, location_type),
 412:           unit:unit_id(id, code),
 413:           request:request_id!inner(
 414:             id,
 415:             request_id,
 416:             priority,
 417:             date_required,
 418:             status,
 419:             notes,
 420:             attachments,
 421:             project:project_id(id, code, name),
 422:             requester:requester_id(id, name)
 423:           )
 424:         `)
 425:         .in('status', ['Pendiente', 'Parcial', 'Programada', 'En Transito'])
 426:         // Excluir solicitudes que no deben aparecer en el backlog
 427:         .not('request.status', 'in', '("Cancelada","Completada","Borrador")')
 428: 
 429:       if (error) {
 430:         // Error silencioso en backlog — la UI mostrará lista vacía
 431:         setBacklog([])
 432:         return
 433:       }
 434: 
 435:       const rows = (data ?? []) as unknown as Record<string, unknown>[]
 436: 
 437:       const mapped: BacklogLine[] = rows.map((row) => {
 438:         const equipment = unwrapRelation(row.equipment as BacklogLine['equipment'] | BacklogLine['equipment'][])
 439:         const fromLoc = unwrapRelation(row.from_location as BacklogLine['from_location'] | BacklogLine['from_location'][])
 440:         const toLoc = unwrapRelation(row.to_location as BacklogLine['to_location'] | BacklogLine['to_location'][])
 441:         const unit = unwrapRelation(row.unit as BacklogLine['unit'] | BacklogLine['unit'][])
 442:         const rawRequest = unwrapRelation(row.request as Record<string, unknown> | Record<string, unknown>[])
 443: 
 444:         const request: BacklogLine['request'] = rawRequest
 445:           ? {
 446:               id: rawRequest.id as string,
 447:               request_id: (rawRequest.request_id as string | null) ?? null,
 448:               priority: (rawRequest.priority as string | null) ?? null,
 449:               date_required: rawRequest.date_required as string,
 450:               status: rawRequest.status as string,
 451:               notes: (rawRequest.notes as string | null) ?? null,
 452:               attachments: (rawRequest.attachments as unknown[] | null) ?? null,
 453:               project: unwrapRelation(rawRequest.project as BacklogLine['request']['project'] | null),
 454:               requester: unwrapRelation(rawRequest.requester as BacklogLine['request']['requester'] | null),
 455:             }
 456:           : { id: '', request_id: null, priority: null, date_required: '', status: '', notes: null, attachments: null, project: null, requester: null }
 457: 
 458:         return {
 459:           id: row.id as string,
 460:           request_id: row.request_id as string,
 461:           line_number: row.line_number as number,
 462:           line_type: row.line_type as string,
 463:           equipment_id: (row.equipment_id as string | null) ?? null,
 464:           description: row.description as string,
 465:           from_location_id: (row.from_location_id as string | null) ?? null,
 466:           from_text: (row.from_text as string | null) ?? null,
 467:           to_location_id: (row.to_location_id as string | null) ?? null,
 468:           to_text: (row.to_text as string | null) ?? null,
 469:           quantity: row.quantity as number,
 470:           unit_id: (row.unit_id as string | null) ?? null,
 471:           unit_text: (row.unit_text as string | null) ?? null,
 472:           category: (row.category as string | null) ?? null,
 473:           notes: (row.notes as string | null) ?? null,
 474:           status: row.status as string,
 475:           qty_scheduled: (row.qty_scheduled as number) ?? 0,
 476:           qty_delivered: (row.qty_delivered as number) ?? 0,
 477:           equipment,
 478:           from_location: fromLoc,
 479:           to_location: toLoc,
 480:           unit,
 481:           request,
 482:         }
 483:       })
 484: 
 485:       // Ordenar por prioridad (Vencida primero) luego por fecha requerida ascendente.
 486:       // El ordenamiento se hace en cliente porque priority es campo calculado en la BD.
 487:       const sorted = [...mapped].sort((a, b) => {
 488:         const pa = PRIORITY_ORDER[a.request.priority ?? 'Normal'] ?? 3
 489:         const pb = PRIORITY_ORDER[b.request.priority ?? 'Normal'] ?? 3
 490:         if (pa !== pb) return pa - pb
 491:         // Desempate por fecha requerida (más próxima primero)
 492:         return a.request.date_required.localeCompare(b.request.date_required)
 493:       })
 494: 
 495:       // Solo líneas con cantidad disponible > 0
 496:       const available = sorted.filter((line) => {
 497:         const avail = line.quantity - (line.qty_scheduled ?? 0) - (line.qty_delivered ?? 0)
 498:         return avail > 0
 499:       })
 500: 
 501:       setBacklog(available)
 502:     } catch {
 503:       setBacklog([])
 504:     } finally {
 505:       setBacklogLoading(false)
 506:     }
 507:   }, [supabase])
