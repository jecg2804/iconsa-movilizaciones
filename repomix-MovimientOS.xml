207:     if (!tripData.rate_id) errors.push('Seleccione una tarifa')
208:     if (tripData.cost == null || tripData.cost <= 0) errors.push('El costo debe ser mayor a cero')
209:     if (assignments.length === 0) errors.push('Seleccione al menos una linea')
210:     setValidationErrors(errors)
211:     return errors.length === 0
212:   }, [tripData, assignments, isCabezal])
213: 
214:   // --- Guardar viaje ---
215:   const handleSave = guard(async () => {
216:     if (!validate()) return
217:     const result = await saveTrip(tripData, assignments, person?.id)
218:     if (result) {
219:       router.push('/programacion')
220:     }
221:   })
222: 
223:   // --- Estado de carga global ---
224:   const isLoading =
225:     authLoading || vehiclesLoading || driversLoading || ratesLoading
226: 
227:   // --- Guard de acceso ---
228:   // PM, campo y almacen no pueden crear viajes
229:   if (!authLoading && (role === 'pm' || role === 'campo' || role === 'almacen')) {
230:     return (
231:       <div className="flex min-h-[50vh] flex-col items-center justify-center gap-4 px-4">
