<file path="src/components/programacion/LineSelector.tsx">
  1: 'use client'
  2: 
  3: import { useCallback } from 'react'
  4: import { useRouter } from 'next/navigation'
  5: import { Wrench, Package, ArrowRight, Plus, X, Loader2 } from 'lucide-react'
  6: import { Button } from '@/components/ui/Button'
  7: import { formatDate } from '@/lib/utils/format'
  8: import type { BacklogLine, AssignmentInput } from '@/hooks/useTrips'
  9: 
 10: /** Unidades que deben usar enteros (min=1, step=1) */
 11: const INTEGER_UNITS = new Set(['und', 'pzas', 'juegos', 'gal', 'ft', 'qq'])
 12: 
 13: function getQtyStep(unitCode: string | undefined): { min: number; step: number } {
 14:   return INTEGER_UNITS.has(unitCode ?? '') ? { min: 1, step: 1 } : { min: 0.01, step: 0.01 }
 15: }
 16: 
 17: interface LineSelectorProps {
 18:   /** Lineas disponibles en el backlog (Pendiente) */
 19:   backlogLines: BacklogLine[]
 20:   /** Asignaciones actuales (lineas ya seleccionadas para este viaje) */
 21:   currentAssignments: AssignmentInput[]
 22:   /** Callback cuando cambian las asignaciones */
 23:   onChange: (assignments: AssignmentInput[]) => void
 24:   loading?: boolean
 25: }
 26: 
 27: /** Calcula la cantidad disponible de una linea (cantidad total - ya programada) */
 28: function getAvailableQty(line: BacklogLine): number {
 29:   return Math.max(0, line.quantity - line.qty_scheduled - (line.qty_delivered ?? 0))
 30: }
 31: 
 32: /** Resuelve el nombre de origen de una linea */
 33: function resolveFrom(line: BacklogLine): string {
 34:   return line.from_location?.name ?? line.from_text ?? '—'
 35: }
 36: 
 37: /** Resuelve el nombre de destino de una linea */
 38: function resolveTo(line: BacklogLine): string {
 39:   return line.to_location?.name ?? line.to_text ?? '—'
 40: }
 41: 
 42: /** Resuelve la unidad de una linea */
 43: function resolveUnit(line: BacklogLine): string {
 44:   return line.unit?.code ?? line.unit_text ?? ''
 45: }
 46: 
 47: /** Color de fecha según urgencia: rojo = vencida, amber = esta semana, gris = normal */
 48: function getDateColor(dateStr: string | null): string {
 49:   if (!dateStr) return 'text-iconsa-gray'
 50:   const today = new Date().toISOString().split('T')[0]
 51:   const nextWeek = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0]
 52:   if (dateStr < today) return 'text-red-600'
 53:   if (dateStr <= nextWeek) return 'text-amber-600'
 54:   return 'text-iconsa-gray'
 55: }
 56: 
 57: /** Info compartida de una línea — usada en disponibles y seleccionadas */
 58: function LineInfo({ line }: { line: BacklogLine }) {
 59:   const router = useRouter()
 60:   const isEquipo = line.line_type === 'Equipo'
 61:   const fromName = resolveFrom(line)
 62:   const toName = resolveTo(line)
 63:   const requestDisplayId = line.request.request_id ?? line.request_id?.slice(0, 8) ?? line.id.slice(0, 8)
 64:   const dateColor = getDateColor(line.request.date_required)
 65: 
 66:   return (
 67:     <div className="min-w-0 flex-1 space-y-1">
 68:       {/* Descripcion + ID + proyecto */}
 69:       <div className="flex items-center gap-2 flex-wrap">
 70:         <span className="sm:hidden shrink-0" title={line.line_type}>
 71:           {isEquipo ? (
 72:             <Wrench className="h-4 w-4 text-iconsa-blue" />
 73:           ) : (
 74:             <Package className="h-4 w-4 text-gold" />
 75:           )}
 76:         </span>
 77:         <span className="text-sm font-medium text-gray-900" title={line.description}>
 78:           {line.description}
 79:         </span>
 80:         <button
 81:           type="button"
 82:           onClick={() => line.request?.id && router.push(`/solicitudes/${line.request.id}`)}
 83:           className="font-mono text-xs text-iconsa-blue hover:underline cursor-pointer shrink-0"
 84:         >
 85:           {requestDisplayId}
 86:         </button>
 87:       </div>
 88: 
 89:       {/* Ruta + fecha requerida + solicitante */}
 90:       <div className="flex items-center gap-1 text-xs text-iconsa-gray flex-wrap">
 91:         <span title={fromName}>{fromName}</span>
 92:         <ArrowRight className="h-3 w-3 shrink-0 text-gray-400" />
 93:         <span title={toName}>{toName}</span>
 94:         <span className="text-gray-300 mx-0.5">·</span>
 95:         <span className={`font-medium ${dateColor}`}>{formatDate(line.request.date_required)}</span>
 96:         {line.request.requester?.name && (
 97:           <>
 98:             <span className="text-gray-300 mx-0.5">·</span>
 99:             <span title={line.request.requester.name}>{line.request.requester.name.split(' ').slice(0, 2).join(' ')}</span>
100:           </>
101:         )}
102:       </div>
103:     </div>
104:   )
105: }
106: 
107: function LineSelector({
108:   backlogLines,
109:   currentAssignments,
110:   onChange,
111:   loading = false,
112: }: LineSelectorProps) {
113:   // IDs de las lineas ya seleccionadas para filtrarlas del backlog disponible
114:   const assignedLineIds = new Set(currentAssignments.map((a) => a.request_line_id))
115: 
116:   // Lineas disponibles = las que aun no estan en las asignaciones actuales
117:   const availableLines = backlogLines.filter((l) => !assignedLineIds.has(l.id))
118: 
119:   // --- Agregar una linea al viaje ---
120:   const handleAdd = useCallback(
121:     (line: BacklogLine) => {
122:       const availableQty = getAvailableQty(line)
123:       if (availableQty <= 0) return // Nada disponible
124:       const newAssignment: AssignmentInput = {
125:         request_line_id: line.id,
126:         quantity_assigned: availableQty,
127:       }
128:       onChange([...currentAssignments, newAssignment])
129:     },
130:     [currentAssignments, onChange],
131:   )
132: 
133:   // --- Quitar una linea del viaje ---
134:   const handleRemove = useCallback(
135:     (lineId: string) => {
136:       onChange(currentAssignments.filter((a) => a.request_line_id !== lineId))
137:     },
138:     [currentAssignments, onChange],
139:   )
140: 
141:   // --- Actualizar cantidad asignada ---
142:   const handleQtyChange = useCallback(
143:     (lineId: string, newQty: number) => {
144:       const line = findLineById(lineId)
145:       const maxQty = line ? getAvailableQty(line) : newQty
146:       const unitCode = line ? resolveUnit(line) : ''
147:       const qtyMin = INTEGER_UNITS.has(unitCode) ? 1 : 0.01
148:       const clamped = Math.min(Math.max(qtyMin, newQty), maxQty > 0 ? maxQty : newQty)
149:       onChange(
150:         currentAssignments.map((a) =>
151:           a.request_line_id === lineId ? { ...a, quantity_assigned: clamped } : a,
152:         ),
153:       )
154:     },
155:     [currentAssignments, onChange],
156:   )
157: 
158:   // --- Obtener datos de una linea por su ID (para mostrar info en la seccion de seleccionadas) ---
159:   function findLineById(lineId: string): BacklogLine | undefined {
160:     return backlogLines.find((l) => l.id === lineId)
161:   }
162: 
163:   return (
164:     <div className="rounded-lg border border-gray-200 bg-gray-50 p-4 space-y-4">
165:       {/* Lineas seleccionadas para este viaje */}
166:       {currentAssignments.length > 0 && (
167:         <div className="space-y-2">
168:           <h4 className="text-sm font-semibold text-gray-900">
169:             Lineas seleccionadas ({currentAssignments.length})
170:           </h4>
171: 
172:           {currentAssignments.map((assignment) => {
173:             const line = findLineById(assignment.request_line_id)
174:             const unitCode = line ? resolveUnit(line) : ''
175:             const availableQty = line ? getAvailableQty(line) : assignment.quantity_assigned
176: 
177:             return (
178:               <div
179:                 key={assignment.request_line_id}
180:                 className="flex flex-col gap-2 rounded-lg border border-navy/20 bg-navy/5 p-3 sm:flex-row sm:items-start sm:gap-3"
181:               >
182:                 {/* Icono de tipo (desktop) */}
183:                 <span className="shrink-0 hidden sm:block pt-0.5" title={line?.line_type}>
184:                   {line?.line_type === 'Equipo' ? (
185:                     <Wrench className="h-4 w-4 text-iconsa-blue" />
186:                   ) : (
187:                     <Package className="h-4 w-4 text-gold" />
188:                   )}
189:                 </span>
190: 
191:                 {/* Info de la linea — compartida */}
192:                 {line ? (
193:                   <LineInfo line={line} />
194:                 ) : (
195:                   <div className="min-w-0 flex-1">
196:                     <span className="text-sm text-gray-500">Cargando...</span>
197:                   </div>
198:                 )}
199: 
200:                 {/* Input de cantidad asignada */}
201:                 {(() => {
202:                   const { min: qtyMin, step: qtyStep } = getQtyStep(unitCode || undefined)
203:                   return (
204:                 <div className="flex items-center gap-2 shrink-0">
205:                   <label className="text-xs text-iconsa-gray whitespace-nowrap">
206:                     Cant. asignada:
207:                   </label>
208:                   <input
209:                     type="number"
210:                     title="Cantidad a asignar"
211:                     value={assignment.quantity_assigned}
212:                     min={qtyMin}
213:                     max={availableQty > 0 ? availableQty : undefined}
214:                     step={qtyStep}
215:                     onChange={(e) => {
216:                       const raw = e.target.value
217:                       if (raw === '' || raw === '-') return
218:                       const parsed = parseFloat(raw)
219:                       if (!Number.isFinite(parsed)) return
220:                       handleQtyChange(assignment.request_line_id, parsed)
221:                     }}
222:                     onFocus={(e) => e.target.select()}
223:                     onBlur={(e) => {
224:                       const parsed = parseFloat(e.target.value)
225:                       if (!Number.isFinite(parsed) || parsed < qtyMin) {
226:                         handleQtyChange(assignment.request_line_id, qtyMin)
227:                       }
228:                     }}
229:                     className="w-20 rounded border border-gray-300 px-2 py-1 text-sm text-right focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
230:                   />
231:                   {unitCode && (
232:                     <span className="text-xs text-gray-500">{unitCode}</span>
233:                   )}
234:                 </div>
235:                   )
236:                 })()}
237: 
238:                 {/* Boton quitar */}
239:                 <button
240:                   type="button"
241:                   onClick={() => handleRemove(assignment.request_line_id)}
242:                   className="shrink-0 self-start rounded p-1.5 text-iconsa-gray hover:bg-red-50 hover:text-iconsa-red transition-colors"
243:                   title="Quitar linea de la movilización"
244:                 >
245:                   <X className="h-4 w-4" />
246:                 </button>
247:               </div>
248:             )
249:           })}
250:         </div>
251:       )}
252: 
253:       {/* Separador si hay seleccionadas y disponibles */}
254:       {currentAssignments.length > 0 && availableLines.length > 0 && (
255:         <div className="border-t border-gray-200" />
256:       )}
257: 
258:       {/* Lineas disponibles del backlog */}
259:       <div className="space-y-2">
260:         <h4 className="text-sm font-semibold text-gray-900">
261:           Lineas disponibles ({availableLines.length})
262:         </h4>
263: 
264:         {loading && (
265:           <div className="flex items-center justify-center py-6 text-iconsa-gray">
266:             <Loader2 className="h-4 w-4 animate-spin mr-2" />
267:             <span className="text-sm">Cargando backlog...</span>
268:           </div>
269:         )}
270: 
271:         {!loading && availableLines.length === 0 && (
272:           <p className="text-center py-6 text-sm text-iconsa-gray">
273:             {backlogLines.length === 0
274:               ? 'No hay lineas pendientes en el backlog'
275:               : 'Todas las lineas del backlog han sido agregadas'}
276:           </p>
277:         )}
278: 
279:         {!loading &&
280:           availableLines.map((line) => {
281:             const isEquipo = line.line_type === 'Equipo'
282:             const unitCode = resolveUnit(line)
283:             const availableQty = getAvailableQty(line)
284: 
285:             return (
286:               <div
287:                 key={line.id}
288:                 className="flex flex-col gap-2 rounded-lg border border-gray-200 bg-white p-3 sm:flex-row sm:items-center sm:gap-3 hover:bg-gray-50/50 transition-colors"
289:               >
290:                 {/* Icono de tipo (desktop) */}
291:                 <span className="shrink-0 hidden sm:block" title={line.line_type}>
292:                   {isEquipo ? (
293:                     <Wrench className="h-4 w-4 text-iconsa-blue" />
294:                   ) : (
295:                     <Package className="h-4 w-4 text-gold" />
296:                   )}
297:                 </span>
298: 
299:                 {/* Info de la linea — compartida */}
300:                 <LineInfo line={line} />
301: 
302:                 {/* Notas de solicitud */}
303:                 {line.request.notes && (
304:                   <p className="text-xs italic text-gray-400 truncate shrink-0 max-w-40" title={line.request.notes}>
305:                     {line.request.notes}
306:                   </p>
307:                 )}
308: 
309:                 {/* Cantidad disponible */}
310:                 <span className="shrink-0 text-xs text-gray-500 whitespace-nowrap">
311:                   Disp: {availableQty} {unitCode}
312:                 </span>
313: 
314:                 {/* Boton agregar (oculto si no hay cantidad disponible) */}
315:                 {availableQty > 0 && (
316:                   <Button
317:                     type="button"
318:                     variant="secondary"
319:                     size="sm"
320:                     onClick={() => handleAdd(line)}
321:                     className="shrink-0 gap-1.5"
322:                   >
323:                     <Plus className="h-3.5 w-3.5" />
324:                     Agregar
325:                   </Button>
326:                 )}
327:               </div>
328:             )
329:           })}
330:       </div>
331:     </div>
332:   )
333: }
334: 
335: export { LineSelector, getDateColor, resolveFrom, resolveTo, resolveUnit }
336: export type { LineSelectorProps }
</file>

<file path="src/components/solicitudes/ActiveTripPanel.tsx">
  1: 'use client'
  2: 
  3: import { useRouter } from 'next/navigation'
  4: import Link from 'next/link'
  5: import { KeyRound, Wrench, Package } from 'lucide-react'
  6: import { Badge } from '@/components/ui/Badge'
  7: import TripLiveMap from '@/components/gps/TripLiveMap'
  8: import { formatDate, formatTimePanama, formatQty } from '@/lib/utils/format'
  9: import type { AssociatedTrip } from '@/components/solicitudes/types'
 10: 
 11: interface ActiveTripPanelProps {
 12:   trip: AssociatedTrip
 13:   role: string | null
 14: }
 15: 
 16: export default function ActiveTripPanel({ trip, role }: ActiveTripPanelProps) {
 17:   const router = useRouter()
 18: 
 19:   const salidaEvent = trip.events.find((e) => e.event_type === 'Salida')
 20:   const activeLines = trip.lines.filter(
 21:     (l) => l.status === 'En Transito' || l.status === 'Parcial',
 22:   )
 23:   const canSeeCode =
 24:     (role === 'pm' || role === 'logistica' || role === 'admin') &&
 25:     !!trip.confirmation_code
 26: 
 27:   return (
 28:     <div className="rounded-lg border border-navy/20 bg-white p-4 shadow-sm sm:p-6 space-y-4">
 29:       {/* 1. Header — código MOV + badge status + hora de salida */}
 30:       <div className="flex items-center justify-between gap-2 flex-wrap">
 31:         <div className="flex items-center gap-2">
 32:           <button
 33:             type="button"
 34:             onClick={() => router.push(`/programacion/viaje/${trip.id}`)}
 35:             className="font-mono text-base font-bold text-navy hover:underline cursor-pointer"
 36:           >
 37:             {trip.trip_id ?? trip.id.slice(0, 8)}
 38:           </button>
 39:           <Badge variant="trip" label={trip.status} />
 40:         </div>
 41:         <div className="flex items-center gap-3 text-sm text-iconsa-gray">
 42:           <span>{formatDate(trip.scheduled_date)}</span>
 43:           {salidaEvent && (
 44:             <span>Salió {formatTimePanama(salidaEvent.event_timestamp)}</span>
 45:           )}
 46:         </div>
 47:       </div>
 48: 
 49:       {/* 2. Metadata — conductor, vehículo, remolque */}
 50:       <div className="flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-700">
 51:         {trip.driver && (
 52:           <span>
 53:             <span className="text-iconsa-gray">Conductor:</span> {trip.driver.name}
 54:           </span>
 55:         )}
 56:         {trip.vehicle && (
 57:           <span>
 58:             <span className="text-iconsa-gray">Vehículo:</span>{' '}
 59:             {trip.vehicle.spectrum_code ? `${trip.vehicle.spectrum_code} — ` : ''}
 60:             {trip.vehicle.description}
 61:           </span>
 62:         )}
 63:         {trip.trailer && (
 64:           <span>
 65:             <span className="text-iconsa-gray">Remolque:</span>{' '}
 66:             {trip.trailer.spectrum_code ? `${trip.trailer.spectrum_code} — ` : ''}
 67:             {trip.trailer.description}
 68:           </span>
 69:         )}
 70:       </div>
 71: 
 72:       {/* 3. Líneas filtradas (En Transito o Parcial) */}
 73:       {activeLines.length > 0 && (
 74:         <ul className="space-y-1">
 75:           {activeLines.map((line, idx) => (
 76:             <li
 77:               key={idx}
 78:               className="flex items-center gap-2 text-sm text-gray-700"
 79:             >
 80:               <span className="shrink-0" title={line.line_type}>
 81:                 {line.line_type === 'Equipo' ? (
 82:                   <Wrench className="h-4 w-4 text-iconsa-blue" />
 83:                 ) : (
 84:                   <Package className="h-4 w-4 text-gold" />
 85:                 )}
 86:               </span>
 87:               <span title={line.description}>{line.description}</span>
 88:               <span className="shrink-0 text-xs text-iconsa-gray">
 89:                 ×{formatQty(line.quantity_assigned)}
 90:               </span>
 91:               <Badge variant="line" label={line.status} />
 92:             </li>
 93:           ))}
 94:         </ul>
 95:       )}
 96: 
 97:       {/* 4. Mapa en vivo — hereda visibility-aware polling, auto-follow, stale banner,
 98:              Reactivar button, Seguir vehículo button, placeholder coords inválidas. */}
 99:       <TripLiveMap tripId={trip.id} variant="compact" />
100: 
101:       {/* 5. Código de verificación — gated por rol (pm/logistica/admin) */}
102:       {canSeeCode && (
103:         <div className="flex items-center gap-2 rounded-lg bg-navy/5 border border-navy/20 px-3 py-2">
104:           <KeyRound className="h-4 w-4 text-navy shrink-0" />
105:           <span className="text-sm text-iconsa-gray">Código:</span>
106:           <span className="font-mono text-lg font-bold text-navy tracking-[0.25em]">
107:             {trip.confirmation_code}
108:           </span>
109:         </div>
110:       )}
111: 
112:       {/* 6. Botón Confirmar Recepción — Link a /mis-viajes con action=deliver */}
