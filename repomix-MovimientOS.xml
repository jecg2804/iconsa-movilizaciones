145:             const toName = ol.line.to_location?.name ?? ol.line.to_text ?? '—'
146:             const unitCode = ol.line.unit?.code ?? ol.line.unit_text ?? ''
147:             const isEquipo = ol.line.line_type === 'Equipo'
