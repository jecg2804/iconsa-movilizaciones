 5: 
 6: interface ModalProps {
 7:   open: boolean
 8:   onClose: () => void
 9:   title: string
10:   children: ReactNode
11:   /** Ancho maximo del modal */
12:   maxWidth?: 'sm' | 'md' | 'lg' | 'xl'
13: }
14: 
15: const maxWidthClasses = {
16:   sm: 'max-w-sm',
17:   md: 'max-w-md',
18:   lg: 'max-w-lg',
19:   xl: 'max-w-xl',
20: }
21: 
22: function Modal({ open, onClose, title, children, maxWidth = 'md' }: ModalProps) {
23:   const dialogRef = useRef<HTMLDialogElement>(null)
24: 
25:   useEffect(() => {
26:     const dialog = dialogRef.current
27:     if (!dialog) return
28: 
29:     if (open) {
30:       if (!dialog.open) dialog.showModal()
31:     } else {
32:       dialog.close()
33:     }
34:   }, [open])
35: 
36:   // Cerrar con click en backdrop
37:   const handleBackdropClick = (e: React.MouseEvent<HTMLDialogElement>) => {
38:     if (e.target === dialogRef.current) {
39:       onClose()
40:     }
41:   }
42: 
43:   if (!open) return null
44: 
45:   return (
46:     <dialog
47:       ref={dialogRef}
48:       onClick={handleBackdropClick}
49:       onCancel={(e) => { e.preventDefault(); onClose() }}
50:       className="fixed inset-0 z-50 m-0 h-full w-full max-h-full max-w-full bg-transparent p-0 backdrop:bg-black/50"
51:     >
52:       <div className="flex min-h-full items-center justify-center p-4">
53:         <div className={`w-full ${maxWidthClasses[maxWidth]} rounded-xl bg-white shadow-xl`}>
