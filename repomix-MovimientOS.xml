  1: // Helpers para templates de email HTML con branding ICONSA
  2: // Todos los estilos inline (email clients no soportan <style> blocks)
  3: 
  4: /**
  5:  * Escapa HTML para prevenir injection en templates. Todo input del usuario
  6:  * (nombres, descripciones, razones, notas) debe pasar por aquí antes de
  7:  * interpolarse en HTML.
  8:  */
  9: export function escapeHtml(input: string | number | null | undefined): string {
 10:   if (input == null) return ''
 11:   return String(input)
 12:     .replace(/&/g, '&amp;')
 13:     .replace(/</g, '&lt;')
 14:     .replace(/>/g, '&gt;')
 15:     .replace(/"/g, '&quot;')
 16:     .replace(/'/g, '&#39;')
 17: }
 18: 
 19: const NAVY = '#1B3A5C'
 20: const GOLD = '#F0A500'
 21: const GRAY_BG = '#F3F4F6'
 22: const GRAY_TEXT = '#6B7280'
 23: 
 24: /**
 25:  * Layout base de email con branding ICONSA.
 26:  * Header navy con logo, body blanco, footer gris.
 27:  */
 28: export function emailLayout(title: string, body: string): string {
 29:   return `<!DOCTYPE html>
 30: <html lang="es">
 31: <head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"></head>
 32: <body style="margin:0;padding:0;background-color:${GRAY_BG};font-family:Arial,Helvetica,sans-serif;">
 33: <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:${GRAY_BG};">
 34: <tr><td align="center" style="padding:24px 16px;">
 35: <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;">
 36: 
 37: <!-- Header -->
 38: <tr><td style="background-color:${NAVY};padding:20px 24px;border-radius:8px 8px 0 0;">
 39: <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
 40: <tr>
 41: <td style="color:${GOLD};font-size:22px;font-weight:bold;letter-spacing:1px;">ICONSA</td>
 42: <td align="right" style="color:#ffffff;font-size:14px;font-weight:500;">MovimientOS</td>
 43: </tr>
 44: </table>
 45: </td></tr>
 46: 
 47: <!-- Title -->
 48: <tr><td style="background-color:#ffffff;padding:24px 24px 8px 24px;">
 49: <h1 style="margin:0;font-size:18px;font-weight:600;color:${NAVY};">${title}</h1>
 50: </td></tr>
 51: 
 52: <!-- Body -->
 53: <tr><td style="background-color:#ffffff;padding:8px 24px 24px 24px;font-size:14px;line-height:1.6;color:#374151;">
 54: ${body}
 55: </td></tr>
 56: 
 57: <!-- Footer -->
 58: <tr><td style="background-color:${GRAY_BG};padding:16px 24px;border-radius:0 0 8px 8px;border-top:1px solid #E5E7EB;">
 59: <p style="margin:0;font-size:11px;color:${GRAY_TEXT};text-align:center;">
 60: Este es un mensaje automático del sistema MovimientOS de ICONSA.<br>No responda a este correo.
 61: </p>
 62: </td></tr>
 63: 
 64: </table>
 65: </td></tr>
 66: </table>
 67: </body>
 68: </html>`
 69: }
