 45:   // Backlog de lineas y mutaciones de viaje
 46:   const {
 47:     backlog,
 48:     backlogLoading,
 49:     saveTrip,
 50:     saving,
 51:     saveError,
 52:   } = useTrips()
 53: 
 54:   // Datos adicionales (fetch inline)
 55:   const [drivers, setDrivers] = useState<PersonRow[]>([])
 56:   const [rates, setRates] = useState<RateRow[]>([])
 57:   const [driversLoading, setDriversLoading] = useState(true)
