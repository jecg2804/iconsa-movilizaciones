 65: // --- Create a solicitud with N lines and return the DB ID ---
 66: export async function createSolicitud(
 67:   page: Page,
 68:   opts: {
 69:     project?: RegExp
 70:     date?: string
 71:     lines: Array<{
 72:       type: 'Equipo' | 'Material'
 73:       equipmentSearch?: string
 74:       description?: string
 75:       from: string | { dropdown: RegExp }
 76:       to: string | { dropdown: RegExp }
 77:       quantity?: number
 78:       unit?: RegExp
 79:     }>
 80:     /**
 81:      * Cost code del header (Cambio 2). La validación bloquea
 82:      * Borrador→Enviada sin cost_code/category. Si se omite, el
 83:      * helper console.warn y los envíos posteriores fallarán
 84:      * salvo que el test lo seteé manualmente.
 85:      */
 86:     costCode?: {
 87:       extra?: RegExp
 88:       fase: RegExp
 89:       categoria: RegExp
 90:     }
 91:     send?: boolean // default true — send the solicitud (Borrador → Enviada)
 92:   },
 93: ): Promise<{ dbId: string; displayId: string }> {
 94:   await page.goto(`${BASE}/solicitudes/nueva`)
 95:   await page.waitForLoadState('networkidle')
 96:   await page.waitForTimeout(1000)
 97: 
 98:   // Select project
 99:   await pick(page, /Proyecto/, opts.project ?? /Muelle 14/)
100: 
101:   // Set date
102:   await page.getByRole('textbox', { name: 'Fecha Requerida' }).fill(opts.date ?? '2026-04-15')
103: 
104:   // Cost code header (Cambio 2 — required para envío)
105:   if (opts.costCode) {
106:     // Esperar render de los Selectors del header (depende del proyecto)
107:     await page.waitForTimeout(800)
108: 
109:     // Extra (solo si el proyecto tiene extras y la opt lo provee)
110:     if (opts.costCode.extra) {
111:       await pick(page, /Extra \/ Sección/, opts.costCode.extra)
112:       await page.waitForTimeout(400)
113:     }
114: 
115:     // Fase
116:     await pick(page, /Fase \/ Código de Costo/, opts.costCode.fase)
117:     await page.waitForTimeout(400)
118: 
119:     // Categoría
120:     await pick(page, /Categoría de Costo/, opts.costCode.categoria)
121:     await page.waitForTimeout(300)
122:   } else {
123:     // eslint-disable-next-line no-console
124:     console.warn('[createSolicitud] No costCode provisto. El envío Borrador→Enviada fallará por validación cost_code requerido.')
125:   }
126: 
127:   // Add each line
128:   for (const line of opts.lines) {
129:     const addBtn = page.getByRole('button', { name: /Agregar Linea/ }).first()
130:     await expect(addBtn).toBeVisible({ timeout: 5000 })
131:     await addBtn.click()
132:     await page.waitForTimeout(800)
133: 
134:     // Type toggle
135:     if (line.type === 'Material') {
136:       await page.getByRole('button', { name: 'Material' }).click()
137:       await page.waitForTimeout(300)
138:     }
139: 
140:     // Equipment (for Equipo type)
141:     if (line.type === 'Equipo' && line.equipmentSearch) {
142:       await page.locator('button', { hasText: 'Buscar equipo...' }).click()
143:       await page.locator('input[placeholder="Buscar..."]').last().fill(line.equipmentSearch)
144:       await page.waitForTimeout(800)
145:       await page.getByRole('option').first().click()
146:       await page.waitForTimeout(300)
147:     }
148: 
149:     // Description (for Material type)
150:     if (line.type === 'Material' && line.description) {
151:       await page.getByRole('textbox', { name: /Descripcion del material/ }).fill(line.description)
152:     }
153: 
154:     // From location
155:     if (typeof line.from === 'string') {
156:       // Fallback text
157:       await page.getByText('No esta en la lista').first().click()
158:       await page.locator('input[placeholder*="Escriba"]').last().fill(line.from)
159:     } else {
160:       await pick(page, 'Desde', line.from.dropdown)
161:     }
162: 
163:     // To location
164:     if (typeof line.to === 'string') {
165:       // Need to find the "No esta en la lista" for the "to" field
166:       const fallbacks = page.getByText('No esta en la lista')
167:       if (await fallbacks.nth(1).isVisible().catch(() => false)) {
168:         await fallbacks.nth(1).click()
169:       } else {
170:         await fallbacks.first().click()
171:       }
172:       await page.locator('input[placeholder*="Escriba"]').last().fill(line.to)
173:     } else {
174:       await pick(page, 'Hasta', line.to.dropdown)
175:     }
176: 
177:     // Quantity
178:     if (line.quantity) {
179:       await page.getByRole('spinbutton', { name: /Cantidad/ }).fill(String(line.quantity))
180:     }
181: 
182:     // Unit
183:     if (line.unit) {
184:       await pick(page, 'Unidad', line.unit)
185:     }
186: 
187:     // Save line
188:     await page.getByRole('button', { name: /Guardar Linea/ }).click()
189:     await page.waitForTimeout(1500)
190: 
191:     // Handle duplicate warning
192:     const continueBtn = page.getByRole('button', { name: /Continuar de todas formas/ })
193:     if (await continueBtn.isVisible({ timeout: 2000 }).catch(() => false)) {
194:       await continueBtn.scrollIntoViewIfNeeded()
195:       await continueBtn.click()
196:       await page.waitForTimeout(1500)
197:     }
198:   }
199: 
200:   // Send or save as draft
201:   const send = opts.send !== false
202:   if (send) {
203:     await page.getByRole('button', { name: /Enviar Solicitud/ }).click()
204:   } else {
205:     await page.getByRole('button', { name: /Guardar Borrador/ }).click()
206:   }
207:   await page.waitForTimeout(2000)
208: 
209:   // Get DB ID — find by unique description tag in lines
210:   const firstLineDesc = opts.lines[0].description ?? opts.lines[0].equipmentSearch ?? ''
211:   let data: { id: string; request_id: string } | null = null
212: 
213:   if (firstLineDesc) {
214:     // Find solicitud via its first line's description (unique per test)
215:     const { data: lines } = await db
216:       .from('sm_request_lines')
217:       .select('request_id')
218:       .ilike('description', `%${firstLineDesc}%`)
219:       .order('created_at', { ascending: false })
220:       .limit(1)
221: 
222:     if (lines && lines.length > 0) {
223:       const { data: req } = await db
224:         .from('sm_requests')
225:         .select('id, request_id')
226:         .eq('id', lines[0].request_id)
227:         .single()
228:       data = req
229:     }
230:   }
231: 
232:   // Fallback to most recent
233:   if (!data) {
234:     const { data: recent } = await db
235:       .from('sm_requests')
236:       .select('id, request_id')
237:       .order('created_at', { ascending: false })
238:       .limit(1)
239:       .single()
240:     data = recent
241:   }
242: 
243:   return { dbId: data?.id ?? '', displayId: data?.request_id ?? '' }
244: }
