1005: // 15. ALERTA DIARIA URGENTES → cron diario 7AM Panamá
1006: // =============================================================================
1007: export async function notifyAlertaDiariaUrgentes(): Promise<void> {
1008:   try {
1009:     // No enviar los domingos (ICONSA no opera) — timezone Panamá explícito
1010:     // para evitar off-by-one si el cron corre en horario no-panamá (cron Vercel en UTC).
1011:     if (dayOfWeekInPanama() === 0) {
1012:       console.log('[Notify] alerta_diaria_urgentes skipped: domingo')
1013:       return
1014:     }
1015: 
1016:     console.log('[Notify] alerta_diaria_urgentes called')
1017:     const supabase = createServiceClient()
1018: 
1019:     // Calcular fecha límite: hoy + 3 días (en Panamá)
1020:     const todayStr = todayStrInPanama() // "YYYY-MM-DD"
1021:     const todayPanama = parseDateStrInPanama(todayStr)
1022:     const limitDate = new Date(todayPanama)
1023:     limitDate.setUTCDate(limitDate.getUTCDate() + 3)
1024:     const limitStr = dateStrInPanama(limitDate)
1025: 
1026:     // Solicitudes activas con fecha requerida ≤ hoy + 3 días
1027:     const { data: requests, error: rErr } = await supabase
1028:       .from('sm_requests')
1029:       .select('id, request_id, project_id, requester_id, date_required')
1030:       .in('status', ['Enviada', 'En Proceso'])
1031:       .lte('date_required', limitStr)
1032:       .order('date_required')
1033: 
1034:     if (rErr) console.error('[Notify] alerta_diaria_urgentes requests error:', rErr.message)
1035:     if (!requests?.length) {
1036:       console.log('[Notify] alerta_diaria_urgentes: no urgent requests found')
1037:       return
1038:     }
1039: 
1040:     // Para cada request: contar líneas pendientes/parciales
1041:     const items: Array<{
1042:       requestId: string
1043:       projectName: string
1044:       requesterName: string
1045:       dateRequired: string
1046:       daysUntil: number
1047:       pendingLines: number
1048:     }> = []
1049: 
1050:     for (const req of requests) {
1051:       const { count } = await supabase
1052:         .from('sm_request_lines')
1053:         .select('id', { count: 'exact', head: true })
1054:         .eq('request_id', req.id)
1055:         .in('status', ['Pendiente', 'Parcial'])
1056: 
1057:       if (!count || count === 0) continue
1058: 
1059:       const { data: project } = await supabase
1060:         .from('projects')
1061:         .select('name')
1062:         .eq('id', req.project_id)
1063:         .single()
1064: 
1065:       const requesterName = await getPersonName(req.requester_id)
1066: 
1067:       const days = daysBetweenInPanama(todayStr, req.date_required)
1068: 
1069:       items.push({
1070:         requestId: req.request_id ?? req.id,
1071:         projectName: project?.name ?? '',
1072:         requesterName,
1073:         dateRequired: req.date_required,
1074:         daysUntil: days,
1075:         pendingLines: count,
1076:       })
1077:     }
1078: 
1079:     if (items.length === 0) {
1080:       console.log('[Notify] alerta_diaria_urgentes: no requests with pending lines')
1081:       return
1082:     }
1083: 
1084:     console.log(`[Notify] alerta_diaria_urgentes: ${items.length} urgent requests with pending lines`)
1085: 
1086:     // Destinatarios: pre-filtrar por alerta_diaria_urgentes o receive_all
1087:     const { data: dailyRecipients } = await supabase
1088:       .from('people')
1089:       .select('id, email, name, notification_preferences')
1090:       .eq('notifications_enabled', true)
1091:       .eq('status', 'Activo')
1092:       .not('email', 'is', null)
1093: 
1094:     const allRecipients = (dailyRecipients ?? []).filter(p => {
1095:       const prefs = p.notification_preferences as Record<string, boolean> | null
1096:       if (!prefs || Object.keys(prefs).length === 0) return true
1097:       if (prefs.receive_all === true) return true
1098:       return prefs.alerta_diaria_urgentes === true
1099:     })
1100: 
1101:     const template = templates.alertaDiariaUrgentes({ items })
1102: 
1103:     await sendNotification({
1104:       eventType: 'alerta_diaria_urgentes',
1105:       referenceType: 'sm_request',
1106:       referenceId: 'daily-alert',
1107:       recipients: allRecipients,
1108:       ...template,
1109:     })
1110:   } catch (err) {
1111:     console.error('[Notify] alerta_diaria_urgentes FAILED:', err)
1112:   }
1113: }
