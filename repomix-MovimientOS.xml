415:           loading={checkingDuplicates}
416:         >
417:           {isEditing ? 'Guardar Cambios' : 'Guardar Linea'}
418:         </Button>
419:       </div>
420:     </div>
421:   )
422: }
423: 
424: export { LineEditor }
425: export type { LineEditorProps }
