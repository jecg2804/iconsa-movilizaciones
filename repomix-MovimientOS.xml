<file path="src/app/api/gps/trip/[tripId]/position/route.ts">
 1: import { NextResponse } from 'next/server'
 2: import { createClient } from '@/lib/supabase/server'
 3: import { getVehiclePosition, isStale } from '@/lib/gps/skydata-client'
 4: import type { GpsTripPosition } from '@/lib/gps/types'
 5: 
 6: interface RouteContext {
 7:   params: Promise<{ tripId: string }>
 8: }
 9: 
10: export async function GET(_request: Request, context: RouteContext) {
11:   const { tripId } = await context.params
12: 
13:   const supabase = await createClient()
14: 
15:   // Auth gate — RLS también bloquea, pero queremos un 401 limpio en vez de 404.
16:   const {
17:     data: { user },
18:   } = await supabase.auth.getUser()
19:   if (!user) {
20:     return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
21:   }
22: 
23:   // Lookup del viaje. RLS aplica; si el usuario no puede verlo, retorna null.
24:   const { data: trip, error: tripError } = await supabase
25:     .from('trips')
26:     .select('id, status, vehicle_id')
27:     .eq('id', tripId)
28:     .maybeSingle()
29: 
30:   if (tripError) {
31:     return NextResponse.json({ error: tripError.message }, { status: 500 })
32:   }
33:   if (!trip) {
34:     return NextResponse.json({ error: 'Not found' }, { status: 404 })
35:   }
36: 
37:   if (trip.status !== 'En Ruta') {
38:     const body: GpsTripPosition = { status: 'not_in_route' }
39:     return NextResponse.json(body)
40:   }
41:   if (!trip.vehicle_id) {
42:     const body: GpsTripPosition = { status: 'no_gps' }
43:     return NextResponse.json(body)
44:   }
45: 
46:   const { data: equipment, error: equipError } = await supabase
47:     .from('equipment')
48:     .select('gps_vehicle_id')
49:     .eq('id', trip.vehicle_id)
50:     .maybeSingle()
51: 
52:   if (equipError) {
53:     return NextResponse.json({ error: equipError.message }, { status: 500 })
54:   }
55:   if (!equipment?.gps_vehicle_id) {
56:     const body: GpsTripPosition = { status: 'no_gps' }
57:     return NextResponse.json(body)
58:   }
59: 
60:   try {
61:     const position = await getVehiclePosition(equipment.gps_vehicle_id)
62:     if (!position) {
63:       const body: GpsTripPosition = { status: 'no_gps' }
64:       return NextResponse.json(body)
65:     }
66:     if (isStale(position)) {
67:       const body: GpsTripPosition = { status: 'stale', lastReport: position }
68:       return NextResponse.json(body)
69:     }
70:     const body: GpsTripPosition = { status: 'live', position }
71:     return NextResponse.json(body)
72:   } catch (err) {
73:     console.error('[gps] upstream failure', err instanceof Error ? err.message : err)
74:     return NextResponse.json({ error: 'GPS provider unavailable' }, { status: 502 })
75:   }
76: }
</file>

