  1: import { format } from 'date-fns'
  2: import { es } from 'date-fns/locale'
  3: import type { Priority } from './constants'
  4: import {
  5:   todayStrInPanama,
  6:   parseDateStrInPanama,
  7:   daysBetweenInPanama,
  8: } from './datetime'
  9: 
 10: /**
 11:  * Parsea un string de fecha en timezone Panamá.
 12:  * Reemplaza el antiguo parseLocalDate que usaba timezone del runtime.
 13:  */
 14: function parseLocalDate(date: string | Date): Date {
 15:   if (date instanceof Date) return date
 16:   return parseDateStrInPanama(date)
 17: }
 18: 
 19: /**
 20:  * Formatea fecha a dd/MM/yyyy (estilo panameño).
 21:  */
 22: export function formatDate(date: string | Date): string {
 23:   const d = parseLocalDate(date)
 24:   return format(d, 'dd/MM/yyyy', { locale: es })
 25: }
 26: 
 27: /**
 28:  * Formatea fecha y hora a dd/MM/yyyy HH:mm.
 29:  */
 30: export function formatDateTime(date: string | Date): string {
 31:   const d = parseLocalDate(date)
 32:   return format(d, 'dd/MM/yyyy HH:mm', { locale: es })
 33: }
 34: 
 35: /**
 36:  * Formatea monto en Balboas panameños: B/. 2,000.00
 37:  */
 38: export function formatCurrency(amount: number): string {
 39:   return `B/. ${amount.toLocaleString('en-US', {
 40:     minimumFractionDigits: 2,
 41:     maximumFractionDigits: 2,
 42:   })}`
 43: }
 44: 
 45: /** Formatea cantidad: entero si es número entero, 2 decimales si tiene fracción */
 46: export function formatQty(n: number | null | undefined): string {
 47:   if (n == null) return '0'
 48:   return Number.isInteger(n) ? String(n) : n.toFixed(2)
 49: }
 50: 
 51: /**
 52:  * Calcula prioridad basada en la fecha requerida vs hoy (en Panamá).
 53:  * Vencida: fecha ya pasó
 54:  * Urgente: 0-3 días
 55:  * Próxima: 4-7 días
 56:  * Normal: 8+ días
 57:  */
 58: export function calculatePriority(dateRequired: string | Date): Priority {
 59:   const daysUntil = daysBetweenInPanama(todayStrInPanama(), dateRequired)
 60: 
 61:   if (daysUntil < 0) return 'Vencida'
 62:   if (daysUntil <= 3) return 'Urgente'
 63:   if (daysUntil <= 7) return 'Próxima'
 64:   return 'Normal'
 65: }
 66: 
 67: /**
 68:  * Días hasta la fecha requerida (en Panamá). Negativo = vencido.
 69:  */
 70: export function daysUntilDue(dateRequired: string | Date): number {
 71:   return daysBetweenInPanama(todayStrInPanama(), dateRequired)
 72: }
 73: 
 74: /**
 75:  * Formato compacto: "Hoy", "1", "2", "-1", "-2"
 76:  */
 77: export function formatDaysUntilDue(dateRequired: string | Date): string {
 78:   const days = daysUntilDue(dateRequired)
 79:   if (days === 0) return 'Hoy'
 80:   return `${days}`
 81: }
 82: 
 83: /**
 84:  * Color Tailwind según días al vencimiento (misma lógica que prioridad).
 85:  */
 86: export function daysUntilDueColor(days: number): string {
 87:   if (days < 0) return 'text-iconsa-red'
 88:   if (days <= 3) return 'text-iconsa-orange'
 89:   if (days <= 7) return 'text-iconsa-blue'
 90:   return 'text-iconsa-green'
 91: }
 92: 
 93: /**
 94:  * Delta entre fecha requerida y fecha completada (ambas en Panamá).
 95:  * Positivo = completado antes de tiempo. Negativo = tarde.
 96:  *
 97:  * dateRequired es date-only ("YYYY-MM-DD"), dateCompleted es TIMESTAMPTZ.
 98:  * daysBetweenInPanama maneja ambos casos correctamente extrayendo la fecha
 99:  * en timezone Panamá antes de comparar.
100:  */
101: export function formatCompletionDelta(
102:   dateRequired: string,
103:   dateCompleted: string
104: ): { text: string; color: string } {
105:   // daysBetweenInPanama: positivo si `to` es después de `from`.
106:   // Aquí queremos: positivo = entregado antes (required - completed > 0).
107:   const days = -daysBetweenInPanama(dateRequired, dateCompleted)
108:   if (days > 0) return { text: `${days}d antes`, color: 'text-iconsa-green' }
109:   if (days < 0) return { text: `${Math.abs(days)}d tarde`, color: 'text-iconsa-red' }
110:   return { text: 'a tiempo', color: 'text-iconsa-green' }
111: }
112: 
113: /**
114:  * Sub-status operativo para solicitudes "En Proceso".
115:  * Muestra resumen de líneas por estado.
116:  */
117: export function getOperationalSummary(lines: { status: string }[]): string {
118:   const inTransit = lines.filter(l => l.status === 'En Transito').length
119:   const delivered = lines.filter(l => l.status === 'Entregada').length
120:   const scheduled = lines.filter(l => l.status === 'Programada').length
121:   const pending = lines.filter(l => l.status === 'Pendiente').length
122:   const partial = lines.filter(l => l.status === 'Parcial').length
123:   const total = lines.length
124: 
125:   if (inTransit > 0) return `🚛 ${inTransit} en tránsito`
126:   if (delivered > 0 && (pending > 0 || scheduled > 0 || partial > 0))
127:     return `📦 ${delivered} de ${total} entregadas`
128:   if (scheduled > 0) return `📅 ${scheduled} programada${scheduled !== 1 ? 's' : ''}`
129:   if (pending > 0) return `⏳ ${pending} sin programar`
130:   return ''
131: }
132: 
133: /**
134:  * Formatea timestamp a hora local Panamá. Retorna '—' si el input es inválido.
135:  */
136: export function formatTimePanama(timestamp: string | null | undefined): string {
137:   if (!timestamp) return '—'
138:   const d = new Date(timestamp)
139:   if (isNaN(d.getTime())) return '—'
140:   return d.toLocaleTimeString('es-PA', {
141:     hour: '2-digit',
142:     minute: '2-digit',
143:     timeZone: 'America/Panama',
144:   })
145: }
146: 
147: /**
148:  * Genera tooltip extendido para badges de status en line cards.
149:  * Incluye contexto per-status (provider para externo, fecha aprobación
150:  * para pickup, scheduled date para programada, etc.).
151:  *
152:  * @param status - Status canónico de la línea
153:  * @param info - Objeto con campos opcionales para contexto extendido
154:  */
155: export function statusContextString(
156:   status: string,
157:   info?: {
158:     pickup_approved_at?: string | null
159:     pickup_received_by_name?: string | null
160:     pickup_completed_at?: string | null
161:     external_provider_name?: string | null
162:     external_invoice_amount?: number | null
163:     external_approved_at?: string | null
164:     external_completed_at?: string | null
165:     external_received_by_name?: string | null
166:     qty_delivered?: number | null
167:     quantity?: number
168:     delivered_at?: string | null
169:   },
170: ): string {
171:   if (!info) return status
172:   switch (status) {
173:     case 'Pickup Aprobado':
174:       return info.pickup_approved_at
175:         ? `Pickup Aprobado el ${formatDate(info.pickup_approved_at)}`
176:         : status
177:     case 'Externo Aprobado':
178:       if (info.external_provider_name && info.external_invoice_amount != null) {
179:         return `Externo: ${info.external_provider_name}, ${formatCurrency(info.external_invoice_amount)}, aprobado ${info.external_approved_at ? formatDate(info.external_approved_at) : '—'}`
180:       }
181:       return status
182:     case 'Entregada':
183:       if (info.external_completed_at) {
184:         const receiver = info.external_received_by_name ?? '(no captado)'
185:         return `Entregada externo: ${info.quantity ?? '—'} el ${formatDate(info.external_completed_at)}, receptor ${receiver}`
186:       }
187:       if (info.pickup_completed_at) {
188:         const receiver = info.pickup_received_by_name ?? '—'
189:         return `Entregada pickup: ${info.quantity ?? '—'} el ${formatDate(info.pickup_completed_at)}, receptor ${receiver}`
190:       }
191:       if (info.delivered_at) {
192:         return `Entregada: ${info.qty_delivered ?? info.quantity ?? '—'} de ${info.quantity ?? '—'} el ${formatDate(info.delivered_at)}`
193:       }
194:       return status
195:     case 'Parcial':
196:       return `Parcial: ${info.qty_delivered ?? 0} de ${info.quantity ?? '—'} entregadas`
197:     default:
198:       return status
199:   }
200: }
