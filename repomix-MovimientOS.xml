 514:     try {
 515:       // J4 — project filter requiere 2-step porque trips.project_id no existe
 516:       // directamente (el proyecto vive en assignments → line → request → project).
 517:       // Paso 1: resolver trip_ids que tienen assignments cuya línea padre pertenece
 518:       // al proyecto filtrado.
 519:       let projectTripIds: string[] | null = null
 520:       if (filters.projectId) {
