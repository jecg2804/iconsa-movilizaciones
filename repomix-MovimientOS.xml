229:                     Hoy
230:                   </span>
231:                 )}
232:                 {dayItems.length > 0 && (
233:                   <span className="ml-1 text-gray-400">({dayItems.length})</span>
234:                 )}
235:               </button>
236: 
237:               {/* Cards del día */}
238:               {dayItems.length > 0 && (
239:                 <div className="px-3 pb-2 space-y-1">
240:                   {dayItems.map((item) => (
241:                     <button
242:                       key={item.id}
243:                       type="button"
244:                       onClick={() => router.push(item.href)}
245:                       className="w-full rounded-lg border border-gray-200 bg-white p-2 text-left hover:bg-gray-50 transition-colors"
246:                     >
