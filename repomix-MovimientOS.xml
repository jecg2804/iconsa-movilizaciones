 15: 
 16: interface LineEditorProps {
 17:   /** Opciones de equipos para el dropdown */
 18:   equipment: SelectOption[]
 19:   /** Opciones de ubicaciones para el dropdown */
 20:   locations: SelectOption[]
 21:   /** Opciones de unidades para el dropdown */
 22:   units: SelectOption[]
