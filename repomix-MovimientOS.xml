210:     // Cleanup: revertir a Programado primero (el trigger solo bloquea mientras
211:     // status sea terminal/en ruta) y luego borrar
212:     await db.from('trips').update({ status: 'Programado' }).eq('id', trip!.id)
213:     await db.from('trips').delete().eq('id', trip!.id)
