186:               onChange={setVehicleId}
187:               searchable
188:               disabled={!canEdit}
189:             />
190: 
191:             {/* Remolque (opcional) */}
192:             <Select
193:               label="Remolque (opcional)"
194:               placeholder="Seleccionar remolque..."
195:               options={trailerOptions}
196:               value={trailerId}
197:               onChange={setTrailerId}
198:               searchable
199:               disabled={!canEdit}
200:             />
201: 
202:             {/* Líneas / Carga */}
203:             <div>
204:               <p className="mb-2 text-sm font-medium text-gray-700">
205:                 Carga ({checkedCount} de {lines.length} ítems)
206:               </p>
207:               <div className="space-y-2">
208:                 {lines.map((line, idx) => (
209:                   <div
210:                     key={line.request_line_id}
211:                     className={`flex items-center gap-2 rounded-lg border p-2 transition-colors ${
212:                       line.checked
213:                         ? 'border-gray-200 bg-gray-50'
214:                         : 'border-gray-100 bg-gray-50/50 opacity-50'
215:                     }`}
216:                   >
217:                     <input
218:                       type="checkbox"
219:                       checked={line.checked}
220:                       onChange={() => handleToggleLine(idx)}
221:                       disabled={!canEdit}
222:                       className="h-4 w-4 rounded border-gray-300 text-navy focus:ring-navy disabled:cursor-not-allowed disabled:opacity-50"
223:                     />
224:                     {line.lineType === 'Equipo' ? (
225:                       <Wrench className="h-3.5 w-3.5 flex-shrink-0 text-iconsa-blue" />
226:                     ) : (
