<file path="src/lib/notifications/send.ts">
  1: 'use server'
  2: 
  3: import { Resend } from 'resend'
  4: import { createServiceClient } from '@/lib/supabase/service'
  5: 
  6: let _resend: Resend | null = null
  7: function getResend() {
  8:   if (!_resend) {
  9:     _resend = new Resend(process.env.RESEND_API_KEY)
 10:   }
 11:   return _resend
 12: }
 13: 
 14: // TEST MODE: cuando está seteado, TODOS los emails van a esta dirección
 15: const TEST_EMAIL = process.env.NOTIFICATION_TEST_EMAIL
 16: 
 17: // FROM address — usa onboarding@resend.dev hasta verificar dominio
 18: const FROM_EMAIL = process.env.RESEND_FROM_EMAIL ?? 'MovimientOS <onboarding@resend.dev>'
 19: 
 20: interface NotificationRecipient {
 21:   id: string
 22:   email: string | null
 23:   name: string
 24: }
 25: 
 26: interface SendResult {
 27:   sent: number
 28:   skipped: number
 29:   failed: number
 30: }
 31: 
 32: export async function sendNotification(params: {
 33:   eventType: string
 34:   referenceType: 'sm_request' | 'trip' | 'suggestion'
 35:   referenceId: string
 36:   recipients: NotificationRecipient[]
 37:   subject: string
 38:   html: string
 39:   data?: Record<string, unknown>
 40: }): Promise<SendResult> {
 41:   const supabase = createServiceClient()
 42:   let sent = 0, skipped = 0, failed = 0
 43: 
 44:   if (params.recipients.length === 0) {
 45:     console.warn(`[Notification] WARNING: 0 recipients for event "${params.eventType}" ref=${params.referenceId}. No emails will be sent.`)
 46:     return { sent, skipped, failed }
 47:   }
 48: 
 49:   console.log(`[Notification] ${params.eventType}: sending to ${params.recipients.length} recipient(s)`)
 50: 
 51:   // Filtrar recipients por notification_preferences
 52:   const recipientIds = params.recipients.map(r => r.id)
 53:   const { data: prefsData } = await supabase
 54:     .from('people')
 55:     .select('id, notification_preferences')
 56:     .in('id', recipientIds)
 57: 
 58:   const prefsMap = new Map(
 59:     (prefsData ?? []).map(p => [p.id, p.notification_preferences as Record<string, boolean> | null])
 60:   )
 61: 
 62:   const eligibleRecipients = params.recipients.filter(r => {
 63:     const prefs = prefsMap.get(r.id)
 64:     if (!prefs || Object.keys(prefs).length === 0) return true // Legacy — no prefs, send
 65:     if (prefs.receive_all === true) return true
 66:     // Si el eventType no tiene key en prefs, enviar por default
 67:     if (!(params.eventType in prefs)) return true
 68:     return prefs[params.eventType] === true
 69:   })
 70: 
 71:   console.log(`[Notification] ${params.eventType}: ${eligibleRecipients.length}/${params.recipients.length} eligible after prefs filter`)
 72: 
 73:   for (const recipient of eligibleRecipients) {
 74:     const targetEmail = TEST_EMAIL ?? recipient.email
 75: 
 76:     if (!targetEmail) {
 77:       const { error: logErr } = await supabase.from('notification_log').insert({
 78:         event_type: params.eventType,
 79:         recipient_id: recipient.id,
 80:         recipient_email: null,
 81:         reference_type: params.referenceType,
 82:         reference_id: params.referenceId,
 83:         channel: 'email',
 84:         status: 'skipped',
 85:         error_message: 'No email address',
 86:         payload: (params.data ?? {}) as { [key: string]: string | number | boolean | null | undefined },
 87:       })
 88:       if (logErr) console.error('[Notification] Failed to log skip to notification_log:', logErr.message)
 89:       skipped++
 90:       continue
 91:     }
 92: 
 93:     // DEDUP: skip si mismo evento+destinatario enviado en últimos 5 minutos.
 94:     // En TEST mode deduplicamos por recipient_email (targetEmail), no por
 95:     // recipient_id original — sin esto, probar un evento que notifica a
 96:     // varios PMs dispara N copias al mismo buzón de test.
 97:     const fiveMinAgo = new Date(Date.now() - 5 * 60 * 1000).toISOString()
 98:     const dedupQuery = supabase
 99:       .from('notification_log')
100:       .select('id')
101:       .eq('event_type', params.eventType)
102:       .eq('reference_id', params.referenceId)
103:       .eq('status', 'sent')
104:       .gte('created_at', fiveMinAgo)
105:       .limit(1)
106: 
107:     const { data: recent, error: dedupErr } = TEST_EMAIL
108:       ? await dedupQuery.eq('recipient_email', targetEmail)
109:       : await dedupQuery.eq('recipient_id', recipient.id)
110: 
111:     // Fail-closed: si la query de dedup falla, asumimos que podría haber
112:     // duplicado y skipeamos. Evita tormenta de emails si Supabase tiene
113:     // problemas y la query retorna error en vez de resultados.
114:     if (dedupErr) {
115:       console.error('[Notification] dedup query failed — skipping to fail closed:', dedupErr.message)
116:       skipped++
117:       continue
118:     }
119: 
120:     if (recent && recent.length > 0) {
121:       skipped++
122:       continue
123:     }
124: 
125:     try {
126:       const subject = TEST_EMAIL
127:         ? `[TEST → ${recipient.name}] ${params.subject}`
128:         : params.subject
129: 
130:       const { data: result, error } = await getResend().emails.send({
131:         from: FROM_EMAIL,
132:         to: targetEmail,
133:         subject,
134:         html: params.html,
135:       })
136: 
137:       if (error) {
138:         console.error(`[Notification] Resend error for ${recipient.name}: ${error.message} (name: ${error.name})`)
139:         throw new Error(error.message)
140:       }
141: 
142:       const { error: logErr } = await supabase.from('notification_log').insert({
143:         event_type: params.eventType,
144:         recipient_id: recipient.id,
145:         recipient_email: targetEmail,
146:         reference_type: params.referenceType,
147:         reference_id: params.referenceId,
148:         channel: 'email',
149:         status: 'sent',
150:         provider_message_id: result?.id ?? null,
151:         payload: (params.data ?? {}) as { [key: string]: string | number | boolean | null | undefined },
152:         sent_at: new Date().toISOString(),
153:       })
154:       if (logErr) console.error('[Notification] Failed to log sent to notification_log:', logErr.message)
155:       sent++
156:     } catch (err) {
157:       const errorMsg = err instanceof Error ? err.message : 'Unknown error'
158:       const { error: logErr } = await supabase.from('notification_log').insert({
159:         event_type: params.eventType,
160:         recipient_id: recipient.id,
161:         recipient_email: targetEmail,
162:         reference_type: params.referenceType,
163:         reference_id: params.referenceId,
164:         channel: 'email',
165:         status: 'failed',
166:         error_message: errorMsg,
167:         payload: (params.data ?? {}) as { [key: string]: string | number | boolean | null | undefined },
168:       })
169:       if (logErr) console.error('[Notification] Failed to log error to notification_log:', logErr.message)
170:       failed++
171:       console.error(`[Notification] failed for ${recipient.name}:`, errorMsg)
172:     }
173:   }
174: 
175:   console.log(`[Notification] ${params.eventType} result: sent=${sent} skipped=${skipped} failed=${failed}`)
176:   return { sent, skipped, failed }
177: }
178: 
179: /** Usuarios con receive_all: true — reciben TODAS las notificaciones */
180: export async function getReceiveAllUsers(): Promise<{ id: string; email: string | null; name: string }[]> {
181:   const supabase = createServiceClient()
182:   const { data, error } = await supabase
183:     .from('people')
184:     .select('id, email, name')
185:     .eq('status', 'Activo')
186:     .eq('notifications_enabled', true)
187:     .not('email', 'is', null)
188:     .contains('notification_preferences', { receive_all: true })
189:   if (error) console.error('[Notification] getReceiveAllUsers error:', error.message)
190:   return data ?? []
191: }
