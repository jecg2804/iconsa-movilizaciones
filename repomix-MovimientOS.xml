 82:     async function fetchDrivers() {
 83:       setDriversLoading(true)
 84:       const { data } = await supabase
 85:         .from('people')
 86:         .select('id, name')
 87:         .eq('status', 'Activo')
 88:         .eq('app_role', 'campo')
 89:         .order('name')
 90:       setDrivers(data ?? [])
 91:       setDriversLoading(false)
 92:     }
 93:     fetchDrivers()
