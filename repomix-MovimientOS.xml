 491:         const maxQty = a.line?.quantity
 492:           ? a.line.quantity - (a.line.qty_delivered ?? 0) - (a.line.qty_scheduled ?? 0) + origQty
 493:           : newQty
 494:         const unitCode = a.line?.unit?.code ?? a.line?.unit_text
 495:         const qtyMin = INTEGER_UNITS.has(unitCode ?? '') ? 1 : 0.01
 496:         const safeMax = Math.max(qtyMin, maxQty)
 497:         const clamped = Math.min(Math.max(qtyMin, newQty), safeMax)
 498:         return { ...a, quantity_assigned: clamped }
 499:       }),
 500:     )
