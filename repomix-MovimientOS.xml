191: 
192:     // Destino requerido
193:     if (!toValue.id && !toValue.text?.trim()) {
194:       newErrors.to = 'Indique el destino'
195:     }
196: 
197:     // Cost code / category ahora se validan a nivel solicitud (SolicitudForm) — Cambio 2.
198: 
199:     setErrors(newErrors)
