414:                 : daysUntilDueColor(daysUntilDue(row.date_required))
415:             }`}>
416:               {row.status === 'Completada' && row.date_completed
417:                 ? formatCompletionDelta(row.date_required, row.date_completed).text
418:                 : formatDaysUntilDue(row.date_required)}
419:             </span>
420:           )}
421:         </div>
422:       </div>
423:     ),
424:     [],
425:   )
426: 
427:   const isLoading = authLoading || listLoading
428: 
429:   return (
430:     <div className="space-y-4">
431:       {/* Header */}
432:       <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
433:         <div className="flex items-center gap-3">
434:           <h1 className="text-2xl font-bold text-navy">Solicitudes de Movilización</h1>
435:           {solicitudes.length > 0 && (
436:             <button
437:               type="button"
438:               onClick={() => setSolExpandedKeys((prev) =>
439:                 prev.size > 0 ? new Set() : new Set(solicitudes.map((s) => s.id))
440:               )}
441:               className="flex items-center gap-1 rounded-md border border-gray-200 px-2 py-1 text-xs text-gray-600 hover:bg-gray-50 transition-colors"
442:             >
443:               {allSolExpanded ? <ChevronsDownUp className="h-3.5 w-3.5" /> : <ChevronsUpDown className="h-3.5 w-3.5" />}
444:               {allSolExpanded ? 'Colapsar' : 'Expandir'}
445:             </button>
446:           )}
447:         </div>
448:         {canCreateSolicitud(role) && (
449:           <Button onClick={() => router.push('/solicitudes/nueva')} className="shrink-0">
450:             <Plus className="h-4 w-4" />
451:             Nueva Solicitud
452:           </Button>
453:         )}
454:       </div>
455: 
456:       {/* FilterBar */}
457:       <FilterBar chips={filterChips} onClearAll={clearAllFilters}>
458:         <div className="w-full sm:w-56">
459:           <Select
460:             placeholder="Proyecto"
461:             options={projectOptions}
462:             value={filters.projectId}
463:             onChange={(val) => setFilters({ projectId: val, page: 0 })}
464:             disabled={projectsLoading}
465:           />
466:         </div>
467:         <div className="relative w-full sm:w-48">
468:           <Search className="absolute left-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400 pointer-events-none" />
469:           <input
470:             type="text"
471:             placeholder="Buscar por ID..."
472:             value={searchInput}
473:             onChange={(e) => setSearchInput(e.target.value)}
474:             className="w-full rounded-lg border border-gray-300 py-2 pl-8 pr-3 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
475:           />
476:         </div>
477:         <div className="flex items-center gap-2">
478:           <span className="text-xs font-medium text-iconsa-gray whitespace-nowrap">Desde</span>
479:           <input
480:             type="date"
481:             title="Fecha desde"
482:             value={filters.dateFrom ?? ''}
483:             onChange={(e) => {
484:               const from = e.target.value || null
485:               setFilters({ dateFrom: from, page: 0 })
486:             }}
487:             className="rounded-lg border border-gray-300 px-2 py-2 text-sm focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
488:           />
489:           <span className="text-xs font-medium text-iconsa-gray whitespace-nowrap">Hasta</span>
490:           <input
491:             type="date"
492:             title="Fecha hasta"
493:             value={filters.dateTo ?? ''}
494:             onChange={(e) => {
495:               const to = e.target.value || null
496:               setFilters({ dateTo: to, page: 0 })
497:             }}
498:             className="rounded-lg border border-gray-300 px-2 py-2 text-sm focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
499:           />
500:         </div>
501:       </FilterBar>
502: 
503:       {/* Badges: Estado */}
504:       <div className="flex flex-wrap items-center gap-2">
505:         <span className="text-xs font-medium text-iconsa-gray">Estado:</span>
506:         {REQUEST_STATUSES.map((status) => {
507:           const isActive = filters.statuses.includes(status)
508:           return (
509:             <button
510:               key={status}
511:               type="button"
512:               aria-label={`Filtrar por estado ${status}`}
513:               onClick={() => toggleStatus(status)}
514:               className={`transition-all ${
515:                 isActive ? 'ring-2 ring-navy ring-offset-1' : 'opacity-50 hover:opacity-80'
516:               }`}
517:             >
518:               <Badge label={status} variant="status" />
519:             </button>
520:           )
521:         })}
522:       </div>
523: 
524:       {/* MiniCalendar */}
525:       <MiniCalendar
526:         items={calendarItems}
527:         selectedDate={calendarDate}
528:         onSelectDate={setCalendarDate}
529:       />
530: 
531:       {/* Error */}
532:       {listError && (
533:         <div className="rounded-lg bg-red-50 p-3 text-sm text-iconsa-red">
534:           Error al cargar solicitudes: {listError}
535:         </div>
536:       )}
537: 
538:       {/* Tabla */}
539:       <DataTable<SolicitudWithRelations>
540:         columns={columns}
541:         data={solicitudes}
542:         keyExtractor={(row) => row.id}
543:         loading={isLoading}
544:         emptyMessage="No hay solicitudes que mostrar"
545:         mobileRender={mobileRender}
546:         pagination="server"
547:         pageSize={filters.pageSize}
548:         totalCount={totalCount}
549:         currentPage={filters.page}
550:         onPageChange={(page) => setFilters({ page })}
551:         onPageSizeChange={(size) => setFilters({ pageSize: size, page: 0 })}
552:         expandedKeys={solExpandedKeys}
553:         onExpandedKeysChange={setSolExpandedKeys}
554:         externalSort={{
555:           column: filters.sortColumn,
556:           direction: filters.sortDirection,
557:           onSortChange: (column, direction) => setFilters({ sortColumn: column, sortDirection: direction, page: 0 }),
558:         }}
559:         expandRender={(row) => {
560:           const lines = row.lines ?? []
561:           if (lines.length === 0) return <p className="text-sm text-iconsa-gray">Sin líneas</p>
562:           return (
563:             <div className="space-y-1.5">
564:               {lines.map((line) => {
565:                 const fromName = line.from_location?.name ?? line.from_text ?? '—'
566:                 const toName = line.to_location?.name ?? line.to_text ?? '—'
567:                 const unitName = line.unit?.code ?? line.unit_text ?? ''
568:                 const isEquipo = line.line_type === 'Equipo'
569:                 return (
570:                   <div key={line.id} className="flex items-center gap-2 text-sm">
571:                     {isEquipo ? (
572:                       <Wrench className="h-3.5 w-3.5 shrink-0 text-iconsa-blue" />
573:                     ) : (
574:                       <Package className="h-3.5 w-3.5 shrink-0 text-gold" />
575:                     )}
576:                     <span className="min-w-0 font-medium text-gray-900" title={line.description}>
577:                       {line.description}
578:                     </span>
579:                     <span className="flex items-center gap-1 text-iconsa-gray">
580:                       <span title={fromName}>{fromName}</span>
581:                       <ArrowRight className="h-3 w-3 shrink-0 text-gray-400" />
582:                       <span title={toName}>{toName}</span>
583:                     </span>
584:                     <span className="shrink-0 text-gray-600">{formatQty(line.quantity)} {unitName}</span>
585:                     <Badge label={line.status} variant="line" />
586:                     {line.notes && (
587:                       <span className="max-w-[150px] truncate text-xs italic text-amber-600" title={line.notes}>
588:                         {line.notes}
589:                       </span>
590:                     )}
591:                   </div>
592:                 )
593:               })}
594:               <a
595:                 href={`/solicitudes/${row.id}`}
596:                 onClick={(e) => { e.stopPropagation(); router.push(`/solicitudes/${row.id}`) }}
597:                 className="mt-1 inline-block text-xs font-medium text-iconsa-blue hover:underline"
598:               >
599:                 Ver detalle completo
600:               </a>
601:             </div>
602:           )
603:         }}
604:       />
605:     </div>
606:   )
607: }
