195:               id="ext-cost"
196:               type="number"
197:               step="0.01"
198:               min="0.01"
199:               value={invoiceAmount}
200:               onChange={(e) => setInvoiceAmount(e.target.value)}
201:               disabled={loading}
202:               placeholder="0.00"
203:               className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
204:             />
205:             {formErrors.invoiceAmount && (
206:               <p className="mt-1 text-xs text-red-600">{formErrors.invoiceAmount}</p>
207:             )}
208:           </div>
209: 
210:           <div>
211:             <FileUploader
212:               attachments={invoiceAttachments}
213:               folder={tempFolderId}
214:               onChange={setInvoiceAttachments}
215:               label="Cotización / Factura"
216:               hint="PDF, JPG, PNG o WEBP (max 10MB) — al menos 1 archivo requerido"
217:               disabled={loading}
218:             />
219:             {formErrors.invoiceAttachments && (
220:               <p className="mt-1 text-xs text-red-600">{formErrors.invoiceAttachments}</p>
221:             )}
222:           </div>
223: 
224:           <div>
225:             <label htmlFor="ext-scheduled-date" className="mb-1 block text-sm font-medium text-gray-700">
226:               Fecha programada <span className="text-red-600">*</span>
227:             </label>
228:             <input
229:               id="ext-scheduled-date"
230:               type="date"
231:               value={scheduledDate}
232:               onChange={(e) => {
233:                 setScheduledDate(e.target.value)
234:                 if (formErrors.scheduledDate) {
235:                   setFormErrors((prev) => {
236:                     const next = { ...prev }
237:                     delete next.scheduledDate
238:                     return next
239:                   })
240:                 }
241:               }}
242:               disabled={loading}
243:               className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
244:             />
245:             {formErrors.scheduledDate && (
246:               <p className="mt-1 text-xs text-red-600">{formErrors.scheduledDate}</p>
247:             )}
248:           </div>
249: 
250:           <div>
251:             <label htmlFor="ext-notes" className="mb-1 block text-sm font-medium text-gray-700">
252:               Notas (opcional)
253:             </label>
254:             <textarea
255:               id="ext-notes"
256:               value={notes}
257:               onChange={(e) => setNotes(e.target.value)}
258:               placeholder="Observaciones del servicio externo..."
259:               rows={2}
260:               maxLength={500}
261:               disabled={loading}
262:               className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
