254: ### Triggers
255: 
256: ```sql
257: -- Trigger de cascada: actualiza status de solicitud padre
258: CREATE OR REPLACE FUNCTION cascade_request_status()
259: RETURNS TRIGGER AS $$
260: DECLARE
261:   total_lines INTEGER; delivered INTEGER;
262:   cancelled INTEGER; in_progress INTEGER; new_status TEXT;
263: BEGIN
264:   SELECT COUNT(*) INTO total_lines FROM sm_request_lines WHERE request_id = NEW.request_id;
265:   SELECT COUNT(*) INTO delivered FROM sm_request_lines WHERE request_id = NEW.request_id AND status = 'Entregada';
266:   SELECT COUNT(*) INTO cancelled FROM sm_request_lines WHERE request_id = NEW.request_id AND status = 'Cancelada';
267:   SELECT COUNT(*) INTO in_progress FROM sm_request_lines WHERE request_id = NEW.request_id AND status IN ('Programada', 'En Tránsito');
268:   
269:   IF delivered = total_lines THEN new_status := 'Completada';
270:   ELSIF cancelled = total_lines THEN new_status := 'Cancelada';
271:   ELSIF delivered > 0 THEN new_status := 'Parcial';
272:   ELSIF in_progress > 0 THEN new_status := 'En Proceso';
273:   ELSE new_status := 'Enviada';
274:   END IF;
275:   
276:   UPDATE sm_requests SET status = new_status, updated_at = now()
277:   WHERE id = NEW.request_id AND status NOT IN ('Borrador', 'Cancelada');
278:   
279:   RETURN NEW;
280: END;
281: $$ LANGUAGE plpgsql;
282: ```
