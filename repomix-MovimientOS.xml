 291: // --- Pagina principal ---
 292: 
 293: export default function Page() {
 294:   const params = useParams()
 295:   const id = params.id as string
 296:   const router = useRouter()
 297:   const supabase = useMemo(() => createClient(), [])
 298: 
 299:   const { person, role, loading: authLoading } = useAuth()
 300:   const { fetchTrip } = useTrips()
 301:   const { registerEvent, registering, registerError } = useTripEvents(id)
 302: 
 303:   // Estado del viaje y eventos
 304:   const [trip, setTrip] = useState<TripWithRelations | null>(null)
 305:   const [events, setEvents] = useState<TripEvent[]>([])
 306:   const [pageLoading, setPageLoading] = useState(true)
 307: 
 308:   // Estado del modal de registro de evento
 309:   const [activeEvent, setActiveEvent] = useState<TripEventType | null>(null)
 310:   const [actionHandled, setActionHandled] = useState(false)
 311:   const [eventBusy, setEventBusy] = useState(false)
 312:   const [eventError, setEventError] = useState<string | null>(null)
 313:   const [revertEvent, setRevertEvent] = useState<TripEvent | null>(null)
 314:   const [reverting, setReverting] = useState(false)
 315:   const [pendingRetornoWarning, setPendingRetornoWarning] = useState(false)
 316: 
 317:   // Opciones de receptor para entrega
 318:   const [receiverOptions, setReceiverOptions] = useState<Array<{ value: string; label: string }>>([])
 319: 
 320:   // --- Fetch receptores del proyecto destino ---
 321:   const loadReceivers = useCallback(async (tripData: TripWithRelations) => {
 322:     // Recopilar to_location_id de las líneas del viaje
 323:     const toLocationIds = new Set<string>()
 324:     for (const a of tripData.assignments) {
 325:       if (a.line?.to_location?.id) {
 326:         toLocationIds.add(a.line.to_location.id)
 327:       }
 328:     }
 329: 
 330:     if (toLocationIds.size === 0) {
 331:       // Sin ubicaciones de destino — mostrar logistica/admin/almacen
 332:       const { data: fallbackPeople } = await supabase
 333:         .from('people')
 334:         .select('id, name')
 335:         .in('app_role', ['almacen', 'logistica', 'admin'])
 336:         .eq('status', 'Activo')
 337:         .order('name')
 338:       setReceiverOptions((fallbackPeople ?? []).map((p) => ({ value: p.id, label: p.name })))
 339:       return
 340:     }
 341: 
 342:     // Buscar project_id de las ubicaciones destino
 343:     const { data: locations } = await supabase
 344:       .from('locations')
 345:       .select('id, project_id')
 346:       .in('id', Array.from(toLocationIds))
 347: 
 348:     const projectIds = new Set<string>()
 349:     let hasNonProjectDest = false
 350:     for (const loc of locations ?? []) {
 351:       if (loc.project_id) {
 352:         projectIds.add(loc.project_id)
 353:       } else {
 354:         hasNonProjectDest = true
 355:       }
 356:     }
 357: 
 358:     const people: Array<{ value: string; label: string }> = []
 359: 
 360:     // Personas asignadas a proyectos destino
 361:     if (projectIds.size > 0) {
 362:       const { data: personProjects } = await supabase
 363:         .from('person_projects')
 364:         .select('person_id, people(id, name)')
 365:         .in('project_id', Array.from(projectIds))
 366:         .eq('is_active', true)
 367: 
 368:       const seen = new Set<string>()
 369:       for (const pp of personProjects ?? []) {
 370:         const person = Array.isArray(pp.people) ? pp.people[0] : pp.people
 371:         if (person && !seen.has(person.id)) {
 372:           seen.add(person.id)
 373:           people.push({ value: person.id, label: person.name })
 374:         }
 375:       }
 376:     }
 377: 
 378:     // Si destino no tiene proyecto (Chilibre, externo) agregar almacen/logistica/admin
 379:     if (hasNonProjectDest || projectIds.size === 0) {
 380:       const { data: fallbackPeople } = await supabase
 381:         .from('people')
 382:         .select('id, name')
 383:         .in('app_role', ['almacen', 'logistica', 'admin'])
 384:         .eq('status', 'Activo')
 385: 
 386:       const seen = new Set(people.map((p) => p.value))
 387:       for (const p of fallbackPeople ?? []) {
 388:         if (!seen.has(p.id)) {
 389:           people.push({ value: p.id, label: p.name })
 390:         }
 391:       }
 392:     }
 393: 
 394:     // Incluir personal operativo (pm, logistica, almacen, admin) que no esté ya en la lista
 395:     const { data: operationalPeople } = await supabase
 396:       .from('people')
 397:       .select('id, name')
 398:       .in('app_role', ['pm', 'logistica', 'almacen', 'admin'])
 399:       .eq('status', 'Activo')
 400:       .order('name')
 401: 
 402:     const seenAll = new Set(people.map((p) => p.value))
 403:     for (const p of operationalPeople ?? []) {
 404:       if (!seenAll.has(p.id)) {
 405:         seenAll.add(p.id)
 406:         people.push({ value: p.id, label: p.name })
 407:       }
 408:     }
 409: 
 410:     people.sort((a, b) => a.label.localeCompare(b.label))
 411:     setReceiverOptions(people)
 412:   }, [supabase])
 413: 
 414:   // --- Carga de eventos ---
 415:   const loadEvents = useCallback(async () => {
 416:     const { data } = await supabase
 417:       .from('trip_events')
 418:       .select(`
 419:         id,
 420:         event_type,
 421:         event_timestamp,
 422:         registered_by:registered_by(id, name),
 423:         received_by_name,
 424:         notes,
 425:         attachments,
 426:         reverts_event_id,
 427:         location
 428:       `)
 429:       .eq('trip_id', id)
 430:       .order('event_timestamp', { ascending: true })
 431: 
 432:     if (data) {
 433:       const mapped: TripEvent[] = (data as unknown as Record<string, unknown>[]).map((row) => {
 434:         const rb = row.registered_by
 435:         const registeredBy = Array.isArray(rb) ? (rb[0] ?? null) : rb as { id: string; name: string } | null
 436:         const rawAtt = row.attachments
 437:         const att: Attachment[] = Array.isArray(rawAtt)
 438:           ? (rawAtt as unknown[]).map(a => a as Attachment)
 439:           : []
 440:         return {
 441:           id: row.id as string,
 442:           event_type: row.event_type as string,
 443:           event_timestamp: row.event_timestamp as string,
 444:           registered_by: registeredBy as { id: string; name: string } | null,
 445:           received_by_name: (row.received_by_name as string | null) ?? null,
 446:           notes: (row.notes as string | null) ?? null,
 447:           attachments: att,
 448:           reverts_event_id: (row.reverts_event_id as string | null) ?? null,
 449:           location: (row.location as string | null) ?? null,
 450:         }
 451:       })
 452:       setEvents(mapped)
 453:     }
 454:   }, [id, supabase])
 455: 
 456:   useEffect(() => {
 457:     async function init() {
 458:       setPageLoading(true)
 459:       const tripData = await fetchTrip(id)
 460:       setTrip(tripData)
 461:       await loadEvents()
 462:       if (tripData) {
 463:         await loadReceivers(tripData)
 464:       }
 465:       setPageLoading(false)
 466:     }
 467:     void init()
 468:   // eslint-disable-next-line react-hooks/exhaustive-deps
 469:   }, [id])
 470: 
 471:   // Seguridad: conductor (campo) solo puede ver SUS viajes asignados.
 472:   // Si intentó entrar por URL directa a uno ajeno, redirigir.
 473:   useEffect(() => {
 474:     if (authLoading || pageLoading) return
 475:     if (!trip || !person) return
 476:     if (role === 'campo' && trip.driver?.id !== person.id) {
 477:       router.replace('/mis-viajes')
 478:     }
 479:   }, [authLoading, pageLoading, trip, person, role, router])
 480: 
 481:   // --- Logica de secuencia de eventos ---
 482:   // Eventos revertidos no cuentan (inmutables pero anulados por Reversion)
 483:   const revertedIds = new Set(
 484:     events.filter((e) => e.event_type === 'Reversion' && e.reverts_event_id).map((e) => e.reverts_event_id!),
 485:   )
 486:   const hasSalida = events.some((e) => e.event_type === 'Salida' && !revertedIds.has(e.id))
 487:   const hasLlegada = events.some((e) => e.event_type === 'Llegada' && !revertedIds.has(e.id))
 488:   const hasEntrega = events.some((e) => e.event_type === 'Entrega' && !revertedIds.has(e.id))
 489:   const hasRetorno = events.some((e) => e.event_type === 'Retorno' && !revertedIds.has(e.id))
 490: 
 491:   const tripDone = trip?.status === 'Completado' || trip?.status === 'Cancelado'
 492: 
 493:   // Siguiente evento principal
 494:   const nextMainEvent: TripEventType | null = tripDone
 495:     ? null
 496:     : (!hasSalida ? 'Salida' : !hasEntrega ? 'Entrega' : !hasRetorno ? 'Retorno' : null)
 497: 
 498:   // Llegada es opcional
 499:   const showLlegadaButton = hasSalida && !hasLlegada && !hasEntrega && !tripDone
 500: 
 501:   // IDs de las líneas asignadas (para transitions de estado)
 502:   const assignedLineIds = useMemo(
 503:     () => trip?.assignments.map((a) => a.request_line_id) ?? [],
 504:     [trip],
 505:   )
 506: 
 507:   // --- Registrar evento ---
 508:   const handleRegisterEvent = useCallback(
 509:     async (input: TripEventInput) => {
 510:       const needsLineUpdate =
 511:         input.event_type === 'Salida' || input.event_type === 'Entrega' || input.event_type === 'Retorno'
 512:       const lineIds = needsLineUpdate ? assignedLineIds : []
 513: 
 514:       const success = await registerEvent(input, lineIds)
 515:       if (success) {
 516:         // Notificaciones por tipo de evento
 517:         if (input.event_type === 'Salida' && trip) {
 518:           notifySalidaRegistrada(trip.id).catch(console.error)
 519:         }
 520:         if (input.event_type === 'Entrega' && trip) {
 521:           // Notificar por cada línea entregada
 522:           for (const lineId of assignedLineIds) {
 523:             notifyEntregaConfirmada(lineId).catch(console.error)
 524:           }
 525:           // Verificar si alguna solicitud padre quedó Completada
 526:           const reqIds = [...new Set(
 527:             trip.assignments.map(a => a.line?.request?.id).filter(Boolean)
 528:           )] as string[]
 529:           for (const reqId of reqIds) {
 530:             notifySolicitudCompletada(reqId).catch(console.error)
 531:           }
 532:         }
 533:         if (input.event_type === 'Incidencia' && trip) {
 534:           notifyIncidenciaRuta(trip.id, input.notes ?? '').catch(console.error)
 535:         }
 536:         if (input.event_type === 'Retorno' && trip) {
 537:           notifyRetornoRegistrado(trip.id).catch(console.error)
 538:         }
 539: 
 540:         setActiveEvent(null)
 541:         // Recargar viaje y eventos
 542:         const tripData = await fetchTrip(id)
 543:         setTrip(tripData)
 544:         await loadEvents()
 545:       }
 546:     },
 547:     [registerEvent, assignedLineIds, fetchTrip, id, loadEvents, trip],
 548:   )
 549: 
 550:   // --- Despacho editable (reemplaza Salida simple) ---
 551:   const handleDispatch = useCallback(
 552:     async (data: DispatchData) => {
 553:       if (!trip) return
 554:       setEventBusy(true)
 555:       setEventError(null)
 556: 
 557:       // Defensiva: conductor (campo) no puede editar — usar lo programado.
 558:       // Protege contra manipulación del cliente (DevTools) cuando el modal viene read-only.
 559:       const isReadOnly = role === 'campo'
 560:       const effectiveData: DispatchData = isReadOnly
 561:         ? {
 562:             event_id: data.event_id,
 563:             driver_id: trip.driver_id ?? null,
 564:             vehicle_id: trip.vehicle_id ?? null,
 565:             trailer_id: trip.trailer_id ?? null,
 566:             lines: trip.assignments.map((a) => ({
 567:               request_line_id: a.request_line_id,
 568:               qty_dispatched: a.quantity_assigned,
 569:             })),
 570:             notes: data.notes,
 571:           }
 572:         : data
 573: 
 574:       try {
 575:         // 1. INSERT evento de Salida PRIMERO — checkpoint de idempotencia.
 576:         // Si el retry encuentra 23505, todo el handler ya corrió → early success.
 577:         // Protege los UPDATE read-modify-write de qty_scheduled contra double-decrement.
 578:         const { error: insertEvtErr } = await supabase
 579:           .from('trip_events')
 580:           .insert({
 581:             id: effectiveData.event_id,
 582:             trip_id: trip.id,
 583:             event_type: 'Salida',
 584:             event_timestamp: new Date().toISOString(),
 585:             registered_by: person?.id ?? null,
 586:             notes: effectiveData.notes || null,
 587:           })
 588: 
 589:         if (insertEvtErr) {
 590:           if (insertEvtErr.code === '23505') {
 591:             console.warn('[Dispatch] Duplicate key — idempotent success, skipping all writes')
 592:             setActiveEvent(null)
 593:             const tripData = await fetchTrip(id)
 594:             setTrip(tripData)
 595:             await loadEvents()
 596:             return
 597:           }
 598:           throw insertEvtErr
 599:         }
 600: 
 601:         // 2. UPDATE trip: conductor, vehículo, remolque, status, salida
 602:         const { error: tripError } = await supabase
 603:           .from('trips')
 604:           .update({
 605:             driver_id: effectiveData.driver_id,
 606:             vehicle_id: effectiveData.vehicle_id,
 607:             trailer_id: effectiveData.trailer_id,
 608:             status: 'En Ruta',
 609:             actual_departure: new Date().toISOString(),
 610:           })
 611:           .eq('id', trip.id)
 612: 
 613:         if (tripError) throw tripError
 614: 
 615:         // 3. UPDATE líneas a 'En Transito' (SIN acento — CRÍTICO para cascade).
 616:         //    Status no es trigger-managed durante dispatch — solo el trigger
 617:         //    recalcula qty_scheduled. La transición a 'En Transito' se hace aquí.
 618:         const lineIds = effectiveData.lines.map((l) => l.request_line_id)
 619:         if (lineIds.length > 0) {
 620:           const { error: linesError } = await supabase
 621:             .from('sm_request_lines')
 622:             .update({ status: 'En Transito' })
 623:             .in('id', lineIds)
 624: 
 625:           if (linesError) throw linesError
 626:         }
 627: 
 628:         // 4. UPDATE trip_line_assignments: qty_dispatched.
 629:         //    Si el conductor despacha menos de lo programado, el trigger BD
 630:         //    recalc_qty_for_line se dispara al UPDATE y reconcilia qty_scheduled
 631:         //    en sm_request_lines (la diferencia vuelve al pool automáticamente).
 632:         for (const line of effectiveData.lines) {
 633:           await supabase
 634:             .from('trip_line_assignments')
 635:             .update({ qty_dispatched: line.qty_dispatched })
 636:             .eq('trip_id', trip.id)
 637:             .eq('request_line_id', line.request_line_id)
 638:         }
 639: 
 640:         // 5. Notificación
 641:         notifySalidaRegistrada(trip.id).catch(console.error)
 642: 
 643:         // 6. Reload
 644:         setActiveEvent(null)
 645:         const tripData = await fetchTrip(id)
 646:         setTrip(tripData)
 647:         await loadEvents()
 648:       } catch (err) {
 649:         setEventError(
 650:           err instanceof Error ? err.message : 'Error al registrar despacho',
 651:         )
 652:       } finally {
 653:         setEventBusy(false)
 654:       }
 655:     },
 656:     [supabase, trip, person, role, fetchTrip, id, loadEvents],
 657:   )
 658: 
 659:   // --- Entrega con per-line status, trip_event_lines, delivery_observations ---
 660:   const [delivering, setDelivering] = useState(false)
 661: 
 662:   const handleDelivery = useCallback(
 663:     async (data: DeliveryData) => {
 664:       if (!trip) return
 665:       setDelivering(true)
 666:       setEventError(null)
 667: 
 668:       try {
 669:         const accepted = data.lines.filter((l) => l.line_status !== 'rejected' && l.quantity > 0)
 670: 
 671:         // 1. INSERT trip_events PRIMERO — sirve de checkpoint de idempotencia.
 672:         // Si el retry encuentra 23505, significa que TODO el handler ya corrió antes → early success.
 673:         // Protege los UPDATE += qty de abajo contra double-count bajo retry de red.
 674:         const { error: eventError } = await supabase
 675:           .from('trip_events')
 676:           .insert({
 677:             id: data.event_id,
 678:             trip_id: trip.id,
 679:             event_type: 'Entrega',
 680:             event_timestamp: new Date().toISOString(),
 681:             registered_by: person?.id ?? null,
 682:             received_by_name: data.received_by_name,
 683:             received_by_id: data.received_by_id,
 684:             notes: data.notes || null,
 685:             attachments: data.attachments.length > 0 ? JSON.parse(JSON.stringify(data.attachments)) : null,
 686:             confirmation_code_used: data.confirmation_code || null,
 687:           })
 688: 
 689:         if (eventError) {
 690:           if (eventError.code === '23505') {
 691:             console.warn('[Delivery] Duplicate key — idempotent success, skipping all writes')
 692:             setActiveEvent(null)
 693:             const tripData = await fetchTrip(id)
 694:             setTrip(tripData)
 695:             await loadEvents()
 696:             return
 697:           }
 698:           throw eventError
 699:         }
 700: 
 701:         // 2. INSERT trip_event_lines (solo en primera pasada — el return de arriba protege retries)
 702:         const eventLines = data.lines.map((l) => ({
 703:           trip_event_id: data.event_id,
 704:           request_line_id: l.request_line_id,
 705:           quantity: l.quantity,
 706:           line_status: l.line_status,
 707:         }))
 708:         await supabase.from('trip_event_lines').insert(eventLines)
 709: 
 710:         // 3. INSERT delivery_observations
 711:         const observations = data.lines
 712:           .filter((l) => l.line_status === 'with_observations' && l.observation_type)
 713:           .map((l) => ({
 714:             trip_event_id: data.event_id,
 715:             request_line_id: l.request_line_id,
 716:             observation_type: l.observation_type!,
 717:             notes: l.observation_notes || null,
 718:             reported_by: person?.id ?? null,
 719:           }))
 720:         if (observations.length > 0) {
 721:           await supabase.from('delivery_observations').insert(observations)
 722:         }
 723: 
 724:         // 4. UPDATE trip_line_assignments: qty_delivered (fresh SELECT para evitar race
 725:         // condition bajo entregas concurrentes desde dos dispositivos. El idempotency
 726:         // checkpoint de step 1 protege contra retries; este fresh SELECT protege contra
 727:         // concurrencia real. El trigger BD recalc_qty_for_line se dispara al UPDATE
 728:         // y reconcilia qty_scheduled, qty_delivered y status en sm_request_lines.
 729:         for (const line of accepted) {
 730:           const { data: freshAssignment } = await supabase
 731:             .from('trip_line_assignments')
 732:             .select('qty_delivered')
 733:             .eq('trip_id', trip.id)
 734:             .eq('request_line_id', line.request_line_id)
 735:             .single()
 736: 
 737:           const currentDelivered = freshAssignment?.qty_delivered ?? 0
 738:           await supabase
 739:             .from('trip_line_assignments')
 740:             .update({ qty_delivered: currentDelivered + line.quantity })
 741:             .eq('trip_id', trip.id)
 742:             .eq('request_line_id', line.request_line_id)
 743:         }
