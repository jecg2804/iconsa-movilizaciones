 381:     const fromAny = supabase.from.bind(supabase) as (t: string) => ReturnType<typeof supabase.from>
 382: 
 383:     if (isNew) {
 384:       await fromAny(table).insert(payload)
 385:     } else {
 386:       await fromAny(table).update(payload).eq('id', formData.id as string)
 387:     }
 388: 
 389:     setSaving(false)
 390:     closeModal()
 391:     fetchData()
 392:   })
