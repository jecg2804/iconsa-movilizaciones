 26:     to_location: { name: string } | null
 27:     from_text: string | null
 28:     to_text: string | null
 29:     request: { request_id: string | null; date_required: string } | null
 30:   } | null
 31: }
 32: 
 33: export interface MyTripSummary {
 34:   id: string
 35:   trip_id: string | null
 36:   scheduled_date: string
 37:   status: string
 38:   confirmation_code: string | null
 39:   att_permit: boolean | null
 40:   escort: boolean | null
 41:   driver: { id: string; name: string } | null
 42:   vehicle: { id: string; description: string; spectrum_code: string | null } | null
 43:   trailer: { id: string; description: string } | null
 44:   assignments: MyTripAssignment[]
 45:   events: MyTripEvent[]
 46: }
 47: 
 48: // --- Helper: extrae objeto de un campo que Supabase puede devolver como array o como objeto ---
 49: function unwrap<T>(value: T | T[] | null | undefined): T | null {
 50:   if (value === null || value === undefined) return null
 51:   if (Array.isArray(value)) return value[0] ?? null
 52:   return value
 53: }
 54: 
 55: // --- Hook ---
 56: 
 57: export function useMyTrips() {
 58:   const supabase = useMemo(() => createClient(), [])
 59:   const { person, role, loading: authLoading } = useAuth()
 60:   const [trips, setTrips] = useState<MyTripSummary[]>([])
 61:   const [loading, setLoading] = useState(true)
 62:   const [error, setError] = useState<string | null>(null)
 63: 
 64:   const fetchTrips = useCallback(async () => {
 65:     setLoading(true)
 66:     setError(null)
 67: 
 68:     try {
 69:       let query = supabase
 70:         .from('trips')
 71:         .select(`
 72:           id,
 73:           trip_id,
 74:           scheduled_date,
 75:           status,
 76:           confirmation_code,
 77:           att_permit,
 78:           escort,
 79:           driver:driver_id(id, name),
 80:           vehicle:vehicle_id(id, description, spectrum_code),
 81:           trailer:trailer_id(id, description),
 82:           assignments:trip_line_assignments(
 83:             id,
 84:             quantity_assigned,
 85:             line:request_line_id(
 86:               id,
 87:               description,
 88:               line_type,
 89:               status,
 90:               from_location:from_location_id(name),
 91:               to_location:to_location_id(name),
 92:               from_text,
 93:               to_text,
 94:               request:request_id(request_id, date_required)
 95:             )
 96:           ),
 97:           events:trip_events(
 98:             id,
 99:             event_type,
100:             event_timestamp,
101:             registered_by:registered_by(name),
102:             notes
103:           )
104:         `)
105:         .order('scheduled_date', { ascending: false })
106: 
107:       // Seguridad: conductores solo ven SUS viajes asignados
108:       if (role === 'campo' && person?.id) {
109:         query = query.eq('driver_id', person.id)
110:       }
111: 
112:       const { data, error: fetchError } = await query
113: 
114:       if (fetchError) {
115:         setError(fetchError.message)
116:         return
117:       }
118: 
119:       const mapped: MyTripSummary[] = (data ?? []).map((row) => {
120:         const r = row as unknown as Record<string, unknown>
121: 
122:         const driver = unwrap(r.driver as { id: string; name: string } | null)
123:         const vehicle = unwrap(
124:           r.vehicle as { id: string; description: string; spectrum_code: string | null } | null,
125:         )
126:         const trailer = unwrap(r.trailer as { id: string; description: string } | null)
127: 
128:         const rawAssignments = Array.isArray(r.assignments) ? r.assignments : []
129:         const assignments: MyTripAssignment[] = (rawAssignments as Record<string, unknown>[]).map((a) => {
130:           const rawLine = a.line as Record<string, unknown> | null
131:           if (!rawLine) return { id: a.id as string, quantity_assigned: a.quantity_assigned as number, line: null }
132: 
133:           const fromLoc = unwrap(rawLine.from_location as { name: string } | null)
134:           const toLoc = unwrap(rawLine.to_location as { name: string } | null)
135:           const rawReq = unwrap(rawLine.request as { request_id: string | null; date_required: string } | null)
136: 
137:           return {
138:             id: a.id as string,
139:             quantity_assigned: a.quantity_assigned as number,
140:             line: {
141:               id: rawLine.id as string,
142:               description: rawLine.description as string,
143:               line_type: rawLine.line_type as string,
144:               status: rawLine.status as string,
145:               from_location: fromLoc,
146:               to_location: toLoc,
147:               from_text: (rawLine.from_text as string | null) ?? null,
148:               to_text: (rawLine.to_text as string | null) ?? null,
149:               request: rawReq ?? null,
150:             },
151:           }
152:         })
153: 
154:         const rawEvents = Array.isArray(r.events) ? r.events : []
155:         const events: MyTripEvent[] = (rawEvents as Record<string, unknown>[]).map((e) => ({
156:           id: e.id as string,
157:           event_type: e.event_type as string,
158:           event_timestamp: e.event_timestamp as string,
159:           registered_by: unwrap(e.registered_by as { name: string } | null),
160:           notes: (e.notes as string | null) ?? null,
161:         }))
162: 
163:         // Ordenar eventos por timestamp ascendente
164:         events.sort((a, b) =>
165:           new Date(a.event_timestamp).getTime() - new Date(b.event_timestamp).getTime(),
166:         )
167: 
168:         return {
169:           id: r.id as string,
170:           trip_id: (r.trip_id as string | null) ?? null,
171:           scheduled_date: r.scheduled_date as string,
172:           status: r.status as string,
173:           confirmation_code: (r.confirmation_code as string | null) ?? null,
174:           att_permit: (r.att_permit as boolean | null) ?? null,
175:           escort: (r.escort as boolean | null) ?? null,
176:           driver,
177:           vehicle,
178:           trailer,
179:           assignments,
180:           events,
181:         }
182:       })
183: 
184:       setTrips(mapped)
185:     } catch (err) {
186:       const message = err instanceof Error ? err.message : 'Error al cargar viajes'
187:       setError(message)
188:     } finally {
189:       setLoading(false)
190:     }
191:   }, [supabase, role, person?.id])
192: 
193:   useEffect(() => {
194:     // Esperar auth load para no disparar fetch sin el filtro de role
195:     if (authLoading) return
196:     void fetchTrips()
197:   }, [fetchTrips, authLoading])
198: 
199:   return { trips, loading, error, refetch: fetchTrips }
200: }
</file>

<file path="src/hooks/useTripEvents.ts">
  1: 'use client'
  2: 
  3: import { useState, useCallback, useMemo } from 'react'
  4: import { createClient } from '@/lib/supabase/client'
  5: import { useAuth } from '@/hooks/useAuth'
  6: 
  7: // --- Tipos exportados ---
  8: 
  9: export type TripEventType = 'Salida' | 'Llegada' | 'Entrega' | 'Retorno' | 'Incidencia' | 'Parada'
 10: 
 11: export interface TripEventInput {
 12:   id?: string // UUID pre-generado para folder de storage
 13:   event_type: TripEventType
 14:   event_timestamp: string
 15:   location?: string | null
 16:   notes?: string | null
 17:   confirmation_code_used?: string | null
 18:   received_by_id?: string | null
 19:   received_by_name?: string | null
 20:   attachments?: unknown[] | null
 21: }
 22: 
 23: // --- Hook ---
 24: 
 25: export function useTripEvents(tripId: string) {
 26:   const supabase = useMemo(() => createClient(), [])
 27:   const { person } = useAuth()
 28: 
 29:   const [registering, setRegistering] = useState(false)
 30:   const [registerError, setRegisterError] = useState<string | null>(null)
 31: 
 32:   /**
 33:    * Registra un evento en el viaje y aplica transiciones de estado.
 34:    * @param input Datos del evento
 35:    * @param assignedLineIds IDs de sm_request_lines asignados al viaje (requerido para Salida y Entrega)
 36:    */
 37:   const registerEvent = useCallback(
 38:     async (input: TripEventInput, assignedLineIds: string[]): Promise<boolean> => {
 39:       setRegistering(true)
 40:       setRegisterError(null)
 41: 
 42:       try {
 43:         // Guard: Salida/Entrega ahora se manejan desde DispatchModal/DeliveryModal
 44:         if (input.event_type === 'Salida') {
 45:           setRegisterError('Salida debe registrarse desde el modal de Despacho')
 46:           return false
 47:         }
 48:         if (input.event_type === 'Entrega') {
 49:           setRegisterError('Entrega debe registrarse desde el modal de Entrega')
 50:           return false
 51:         }
 52: 
 53:         // 1. INSERT trip_events (INMUTABLE — sin UPDATE/DELETE)
 54:         const { error: eventError } = await supabase.from('trip_events').insert({
 55:           ...(input.id ? { id: input.id } : {}),
 56:           trip_id: tripId,
 57:           event_type: input.event_type,
 58:           event_timestamp: input.event_timestamp,
 59:           location: input.location ?? null,
 60:           registered_by: person?.id ?? null,
 61:           confirmation_code_used: input.confirmation_code_used ?? null,
 62:           received_by_id: input.received_by_id ?? null,
 63:           received_by_name: input.received_by_name ?? null,
 64:           notes: input.notes ?? null,
 65:           attachments: JSON.parse(JSON.stringify(input.attachments ?? [])),
 66:         })
 67: 
 68:         if (eventError) {
 69:           // Si el insert ya existía (respuesta perdida en intento anterior), tratar como éxito
 70:           if (eventError.code === '23505') {
 71:             console.warn('[TripEvents] Duplicate key detected — treating as idempotent success')
 72:           } else {
 73:             setRegisterError(eventError.message)
 74:             return false
 75:           }
 76:         }
 77: 
 78:         // 2. Transiciones de estado según tipo de evento
 79:         // NOTA: Salida y Entrega redirigidos a DispatchModal y DeliveryModal respectivamente.
 80:         // Los guards arriba retornan error si se intenta registrarlos por esta vía.
 81: 
 82:         if (input.event_type === 'Llegada') {
 83:           // trips → actual_arrival
 84:           const { error: tripError } = await supabase
 85:             .from('trips')
 86:             .update({ actual_arrival: input.event_timestamp })
 87:             .eq('id', tripId)
 88: 
 89:           if (tripError) {
 90:             setRegisterError(tripError.message)
 91:             return false
 92:           }
 93:         } else if (input.event_type === 'Retorno') {
 94:           // Retorno es NO-OP para cantidades: solo marca el viaje Completado.
 95:           // Si hay líneas En Transito sin entregar, el guard en UI avisa — y quedan visibles
 96:           // en el dashboard "Entregas pendientes en viajes cerrados" para resolver después.
 97:           const { error: tripError } = await supabase
 98:             .from('trips')
 99:             .update({ status: 'Completado' })
100:             .eq('id', tripId)
101: 
102:           if (tripError) {
103:             setRegisterError(tripError.message)
104:             return false
105:           }
106:         }
107:         // 'Incidencia' — sin cambios de estado
108: 
109:         return true
110:       } catch (err) {
111:         const message = err instanceof Error ? err.message : 'Error al registrar evento'
112:         setRegisterError(message)
113:         return false
114:       } finally {
115:         setRegistering(false)
116:       }
117:     },
118:     [supabase, tripId, person],
119:   )
120: 
121:   return { registering, registerError, registerEvent }
122: }
</file>

