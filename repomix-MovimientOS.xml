241:                       }
242:                       className="w-16 rounded border border-gray-300 px-2 py-1 text-sm text-right disabled:bg-gray-100 disabled:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
243:                     />
244:                     <span className="text-xs text-iconsa-gray whitespace-nowrap">
245:                       / {formatQty(line.maxQty)} {line.unitCode}
246:                     </span>
247:                   </div>
248:                 ))}
249:               </div>
