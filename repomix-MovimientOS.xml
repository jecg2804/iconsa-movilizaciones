 3: import { useEffect, useState, useMemo } from 'react'
 4: import { createClient } from '@/lib/supabase/client'
 5: import type { Row } from '@/lib/types/database'
 6: 
 7: /** Códigos de tipo excluidos del dropdown de solicitudes (solo ingeniería — spec: NOT IN ING) */
 8: const EXCLUDED_TYPE_CODES = '("ING")'
 9: 
10: interface UseEquipmentReturn {
11:   /** Equipos activos aptos para líneas de solicitud (excluye solo ING; incluye VHL, VHP, TEC) */
12:   equipment: Row<'equipment'>[]
13:   loading: boolean
14:   error: string | null
15: }
16: 
17: export function useEquipment(): UseEquipmentReturn {
18:   const [equipment, setEquipment] = useState<Row<'equipment'>[]>([])
19:   const [loading, setLoading] = useState(true)
20:   const [error, setError] = useState<string | null>(null)
21: 
22:   const supabase = useMemo(() => createClient(), [])
23: 
24:   useEffect(() => {
25:     async function fetchEquipment() {
26:       try {
27:         setLoading(true)
28:         setError(null)
29: 
30:         const { data, error: fetchError } = await supabase
31:           .from('equipment')
32:           .select('*')
33:           .eq('status', 'Activo')
34:           .not('type_code', 'in', EXCLUDED_TYPE_CODES)
35:           .order('spectrum_code')
36: 
37:         if (fetchError) throw fetchError
38:         setEquipment(data ?? [])
39:       } catch (err) {
40:         const message = err instanceof Error ? err.message : 'Error al cargar equipos'
41:         setError(message)
42:       } finally {
43:         setLoading(false)
44:       }
45:     }
46: 
47:     fetchEquipment()
48:   }, [supabase])
49: 
50:   return { equipment, loading, error }
51: }
</file>

