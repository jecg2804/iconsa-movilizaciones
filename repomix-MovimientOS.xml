120:       ),
121:     )
122:   }, [])
123: 
124:   const handleConfirm = useCallback(async () => {
125:     const checkedLines = lines.filter((l) => l.checked && l.qty > 0)
126:     if (checkedLines.length === 0) return
127: 
128:     try {
129:       await onConfirm({
130:         event_id: eventIdRef.current,
131:         driver_id: driverId,
132:         vehicle_id: vehicleId,
133:         trailer_id: trailerId,
134:         lines: checkedLines.map((l) => ({
135:           request_line_id: l.request_line_id,
136:           qty_dispatched: l.qty,
137:         })),
138:         notes: notes.trim(),
139:       })
140:     } catch (err) {
141:       eventIdRef.current = crypto.randomUUID()
142:       throw err
143:     }
144:   }, [lines, driverId, vehicleId, trailerId, notes, onConfirm])
145: 
146:   const checkedCount = lines.filter((l) => l.checked && l.qty > 0).length
147:   const isLoading = driversLoading || vehiclesLoading
148: 
