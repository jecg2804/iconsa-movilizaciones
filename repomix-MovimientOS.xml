170: 
171:           <div>
172:             <label htmlFor="ext-provider" className="mb-1 block text-sm font-medium text-gray-700">
173:               Proveedor / Empresa transportista <span className="text-red-600">*</span>
174:             </label>
175:             <input
176:               id="ext-provider"
177:               type="text"
178:               maxLength={100}
179:               value={providerName}
180:               onChange={(e) => setProviderName(e.target.value)}
181:               disabled={loading}
182:               placeholder="Nombre del proveedor"
183:               className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
184:             />
185:             {formErrors.providerName && (
186:               <p className="mt-1 text-xs text-red-600">{formErrors.providerName}</p>
187:             )}
188:           </div>
189: 
190:           <div>
191:             <label htmlFor="ext-cost" className="mb-1 block text-sm font-medium text-gray-700">
192:               Costo del servicio (B/.) <span className="text-red-600">*</span>
193:             </label>
