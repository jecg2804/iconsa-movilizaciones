449: export function alertaDiariaUrgentes(data: {
450:   items: Array<{
451:     requestId: string
452:     projectName: string
453:     requesterName: string
454:     dateRequired: string
455:     daysUntil: number
456:     pendingLines: number
457:   }>
458: }): TemplateResult {
459:   const count = data.items.length
460: 
461:   const tableRows = data.items.map(item => {
462:     const rowColor = item.daysUntil < 0 ? '#fef2f2' : item.daysUntil <= 3 ? '#fffbeb' : '#ffffff'
463:     const daysText = item.daysUntil < 0
464:       ? `<span style="color:#C0392B;font-weight:bold;">Venció hace ${Math.abs(item.daysUntil)}d</span>`
465:       : `<span style="color:#B45309;font-weight:bold;">${item.daysUntil}d</span>`
466: 
467:     return `<tr style="background:${rowColor};">
468:       <td style="padding:6px 10px;border-bottom:1px solid #eee;font-family:monospace;font-size:13px;">${escapeHtml(item.requestId)}</td>
469:       <td style="padding:6px 10px;border-bottom:1px solid #eee;">${escapeHtml(item.projectName)}</td>
470:       <td style="padding:6px 10px;border-bottom:1px solid #eee;">${escapeHtml(item.requesterName)}</td>
471:       <td style="padding:6px 10px;border-bottom:1px solid #eee;">${formatDate(item.dateRequired)}</td>
472:       <td style="padding:6px 10px;border-bottom:1px solid #eee;text-align:center;">${daysText}</td>
473:       <td style="padding:6px 10px;border-bottom:1px solid #eee;text-align:center;">${item.pendingLines}</td>
474:     </tr>`
475:   }).join('')
476: 
477:   const body = `
478: ${alertBanner(`📋 ${count} solicitud${count !== 1 ? 'es' : ''} urgente${count !== 1 ? 's' : ''} sin programar completamente`, 'warning')}
479: <table style="width:100%;border-collapse:collapse;margin:16px 0;font-size:14px;">
480:   <thead>
481:     <tr style="background:#1B3A5C;color:white;">
482:       <th style="padding:8px 10px;text-align:left;">Solicitud</th>
483:       <th style="padding:8px 10px;text-align:left;">Proyecto</th>
484:       <th style="padding:8px 10px;text-align:left;">Solicitante</th>
485:       <th style="padding:8px 10px;text-align:left;">Fecha Req.</th>
486:       <th style="padding:8px 10px;text-align:center;">Días</th>
487:       <th style="padding:8px 10px;text-align:center;">Pend.</th>
488:     </tr>
489:   </thead>
490:   <tbody>${tableRows}</tbody>
491: </table>
492: ${ctaButton('Ver Backlog →', `${APP_URL}/programacion`)}`
493: 
494:   return {
495:     subject: `📋 Alerta diaria: ${count} solicitud${count !== 1 ? 'es' : ''} urgente${count !== 1 ? 's' : ''} sin programar`,
496:     html: emailLayout('Alerta Diaria — Solicitudes Urgentes', body),
497:   }
498: }
