132:             )}
133:             {order.status === 'Cancelado' && order.cancelled_at && (
134:               <span>Cancelado {formatDate(order.cancelled_at)}</span>
135:             )}
136:           </div>
137:         )}
138:       </div>
139: 
140:       {expanded && (
