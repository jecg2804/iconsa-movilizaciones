<file path="src/components/ui/FileUploader.tsx">
  1: 'use client'
  2: 
  3: import { useState, useRef, useCallback, useEffect } from 'react'
  4: import {
  5:   type Attachment,
  6:   uploadFile,
  7:   deleteFile,
  8:   formatFileSize,
  9:   isImageType,
 10:   isAllowedType,
 11:   isWithinSizeLimit,
 12:   inferMimeType,
 13: } from '@/lib/supabase/storage'
 14: import { useAuth } from '@/hooks/useAuth'
 15: import FileDisplay from './FileDisplay'
 16: 
 17: interface FileUploaderProps {
 18:   attachments: Attachment[]
 19:   folder: string
 20:   onChange: (files: Attachment[]) => void
 21:   maxFiles?: number
 22:   disabled?: boolean
 23:   label?: string
 24:   hint?: string
 25: }
 26: 
 27: export default function FileUploader({
 28:   attachments,
 29:   folder,
 30:   onChange,
 31:   maxFiles = 10,
 32:   disabled = false,
 33:   label = 'Documentos Adjuntos',
 34:   hint = 'Formatos: PDF, JPG, PNG, WEBP. Máx 10MB',
 35: }: FileUploaderProps) {
 36:   const { person } = useAuth()
 37:   const fileInputRef = useRef<HTMLInputElement>(null)
 38:   const cameraInputRef = useRef<HTMLInputElement>(null)
 39:   const [uploading, setUploading] = useState(false)
 40:   const [errors, setErrors] = useState<string[]>([])
 41:   const [dragOver, setDragOver] = useState(false)
 42:   const [deleting, setDeleting] = useState<Set<number>>(new Set())
 43:   const attachmentsRef = useRef(attachments)
 44:   const timerRef = useRef<NodeJS.Timeout>(null)
 45: 
 46:   useEffect(() => { attachmentsRef.current = attachments }, [attachments])
 47: 
 48:   const atLimit = attachments.length >= maxFiles
 49: 
 50:   const addError = useCallback((msg: string) => {
 51:     setErrors((prev) => [...prev, msg])
 52:     if (timerRef.current) clearTimeout(timerRef.current)
 53:     timerRef.current = setTimeout(() => setErrors([]), 5000)
 54:   }, [])
 55: 
 56:   const handleFiles = useCallback(
 57:     async (files: FileList | File[]) => {
 58:       if (!person?.id) return
 59:       const fileArray = Array.from(files)
 60: 
 61:       const remaining = maxFiles - attachmentsRef.current.length
 62:       if (remaining <= 0) {
 63:         addError(`Máximo ${maxFiles} archivos`)
 64:         return
 65:       }
 66:       const toUpload = fileArray.slice(0, remaining)
 67: 
 68:       setUploading(true)
 69:       setErrors([])
 70: 
 71:       const newAttachments = [...attachmentsRef.current]
 72:       const newErrors: string[] = []
 73: 
 74:       for (const file of toUpload) {
 75:         const inferredType = inferMimeType(file)
 76:         if (!isAllowedType(inferredType)) {
 77:           newErrors.push(`Tipo no permitido: ${file.name}. Use PDF, JPG, PNG o WEBP`)
 78:           continue
 79:         }
 80:         if (!isWithinSizeLimit(file.size)) {
 81:           newErrors.push(`"${file.name}" excede 10MB`)
 82:           continue
 83:         }
 84: 
 85:         const result = await uploadFile(file, folder, person.id)
 86:         if (result.error) {
 87:           newErrors.push(result.error)
 88:         } else if (result.attachment) {
 89:           newAttachments.push(result.attachment)
 90:         }
 91:       }
 92: 
 93:       onChange(newAttachments)
 94:       setUploading(false)
 95:       if (newErrors.length > 0) {
 96:         setErrors(newErrors)
 97:         if (timerRef.current) clearTimeout(timerRef.current)
 98:         timerRef.current = setTimeout(() => setErrors([]), 5000)
 99:       }
100:     },
101:     [folder, maxFiles, onChange, person?.id, addError],
102:   )
103: 
104:   const handleDelete = useCallback(
105:     async (index: number) => {
106:       const current = attachmentsRef.current
107:       const file = current[index]
108:       if (!file) return
109: 
110:       setDeleting((prev) => new Set(prev).add(index))
111: 
112:       const ok = await deleteFile(file.path)
113:       if (ok) {
114:         const updated = attachmentsRef.current.filter((_, i) => i !== index)
115:         onChange(updated)
116:       } else {
117:         addError('Error al eliminar archivo')
118:       }
119: 
120:       setDeleting((prev) => {
121:         const next = new Set(prev)
122:         next.delete(index)
123:         return next
124:       })
125:     },
126:     [onChange, addError],
127:   )
128: 
129:   const handleDrop = useCallback(
130:     (e: React.DragEvent) => {
131:       e.preventDefault()
132:       setDragOver(false)
133:       if (disabled || atLimit || uploading) return
134:       void handleFiles(e.dataTransfer.files)
135:     },
136:     [disabled, atLimit, uploading, handleFiles],
137:   )
138: 
139:   const handleDragOver = useCallback(
140:     (e: React.DragEvent) => {
141:       e.preventDefault()
142:       if (!disabled && !atLimit) setDragOver(true)
143:     },
144:     [disabled, atLimit],
145:   )
146: 
147:   const handleDragLeave = useCallback(() => setDragOver(false), [])
148: 
149:   return (
150:     <div className="space-y-2">
151:       <label className="block text-sm font-medium text-gray-700">{label}</label>
152: 
153:       {/* Lista de archivos subidos */}
154:       {attachments.length > 0 && (
155:         <div className="flex flex-wrap gap-2">
156:           {attachments.map((file, idx) => (
157:             <div
158:               key={file.path}
159:               className="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-3 py-1.5"
160:             >
161:               {isImageType(file.type) ? (
162:                 <span className="text-sm">🖼️</span>
163:               ) : (
164:                 <span className="text-sm">📄</span>
165:               )}
166:               <span className="max-w-40 truncate text-sm text-gray-700" title={file.name}>
167:                 {file.name}
168:               </span>
169:               <span className="text-xs text-gray-400">({formatFileSize(file.size)})</span>
170:               {!disabled && (
171:                 <button
172:                   type="button"
173:                   onClick={() => void handleDelete(idx)}
174:                   className="ml-1 text-red-400 hover:text-red-600 disabled:opacity-40"
175:                   title="Eliminar archivo"
176:                   disabled={deleting.has(idx)}
177:                 >
178:                   {deleting.has(idx) ? '⏳' : '🗑'}
179:                 </button>
180:               )}
181:             </div>
182:           ))}
183:         </div>
184:       )}
185: 
186:       {/* Zona de drop / botón de subida */}
187:       {!disabled && (
188:         <>
189:           {atLimit ? (
190:             <p className="text-xs text-orange-600">Máximo {maxFiles} archivos alcanzado</p>
191:           ) : (
192:             <div
193:               onDrop={handleDrop}
194:               onDragOver={handleDragOver}
195:               onDragLeave={handleDragLeave}
196:               onClick={() => fileInputRef.current?.click()}
197:               className={`cursor-pointer rounded-lg border-2 border-dashed p-4 text-center transition-colors ${
198:                 dragOver
199:                   ? 'border-blue-400 bg-blue-50'
200:                   : 'border-gray-300 bg-white hover:border-gray-400 hover:bg-gray-50'
201:               } ${uploading ? 'pointer-events-none opacity-60' : ''}`}
202:             >
203:               {uploading ? (
204:                 <div className="flex items-center justify-center gap-2">
205:                   <div className="h-4 w-4 animate-spin rounded-full border-2 border-gray-300 border-t-blue-500" />
206:                   <span className="text-sm text-gray-500">Subiendo...</span>
207:                 </div>
208:               ) : (
209:                 <p className="text-sm text-gray-500">
210:                   Arrastre archivos aquí o haga click para seleccionar
211:                 </p>
212:               )}
213:             </div>
214:           )}
215: 
216:           {/* Inputs ocultos */}
217:           <input
218:             ref={fileInputRef}
219:             type="file"
220:             className="hidden"
221:             multiple
222:             accept=".pdf,.jpg,.jpeg,.png,.webp"
223:             title="Seleccionar archivos"
224:             onChange={(e) => {
225:               if (e.target.files) void handleFiles(e.target.files)
226:               e.target.value = ''
227:             }}
228:           />
229: 
230:           {/* Botón cámara mobile */}
231:           <button
232:             type="button"
233:             onClick={() => cameraInputRef.current?.click()}
234:             className="flex w-full items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 sm:hidden"
235:             disabled={atLimit || uploading}
236:           >
237:             📷 Tomar foto
238:           </button>
239:           <input
240:             ref={cameraInputRef}
241:             type="file"
242:             className="hidden"
243:             accept="image/*"
244:             capture="environment"
245:             title="Tomar foto"
246:             onChange={(e) => {
247:               if (e.target.files) void handleFiles(e.target.files)
248:               e.target.value = ''
249:             }}
250:           />
251:         </>
252:       )}
253: 
254:       {/* Hint */}
255:       {hint && !disabled && (
256:         <p className="text-xs text-gray-400">{hint}</p>
257:       )}
258: 
259:       {/* Error inline */}
260:       {errors.length > 0 && (
261:         <div className="rounded-md bg-red-50 border border-red-200 px-3 py-2 space-y-1">
262:           {errors.map((err, i) => (
263:             <p key={i} className="text-sm text-red-700">{err}</p>
264:           ))}
265:         </div>
266:       )}
267: 
268:       {/* Preview inline de archivos existentes */}
269:       {attachments.length > 0 && (
270:         <FileDisplay attachments={attachments} label="Vista previa" />
271:       )}
272:     </div>
273:   )
274: }
