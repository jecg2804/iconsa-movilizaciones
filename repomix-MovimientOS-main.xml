1001: function PersonProjectsPanel({
1002:   personId,
1003:   personName,
1004:   assignments,
1005:   loading,
1006:   projectOptions,
1007:   onAdd,
1008:   onRemove,
1009:   onClose,
1010: }: {
1011:   personId: string
1012:   personName: string
1013:   assignments: PersonProject[]
1014:   loading: boolean
1015:   projectOptions: SelectOption[]
1016:   onAdd: (personId: string, projectId: string) => void
1017:   onRemove: (assignmentId: string, personId: string) => void
1018:   onClose: () => void
1019: }) {
1020:   const [newProjectId, setNewProjectId] = useState<string | null>(null)
