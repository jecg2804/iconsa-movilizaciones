 191: /**
 192:  * Extrae un objeto de relación Supabase que puede llegar como array o como objeto.
 193:  * Supabase devuelve joins como objetos para to-one y arrays para to-many.
 194:  */
 195: function unwrapRelation<T>(value: T | T[] | null | undefined): T | null {
 196:   if (value === null || value === undefined) return null
 197:   if (Array.isArray(value)) return value[0] ?? null
 198:   return value
 199: }
