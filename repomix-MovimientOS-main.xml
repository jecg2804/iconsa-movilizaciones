<file path="src/components/layout/MobileNav.tsx">
 1: 'use client'
 2: 
 3: import { useEffect } from 'react'
 4: import Link from 'next/link'
 5: import { usePathname } from 'next/navigation'
 6: import { X } from 'lucide-react'
 7: import { ROLE_ROUTES, type AppRole } from '@/lib/utils/constants'
 8: import { ALL_NAV_ITEMS } from './Sidebar'
 9: 
10: interface MobileNavProps {
11:   role: AppRole
12:   open: boolean
13:   onClose: () => void
14: }
15: 
16: export function MobileNav({ role, open, onClose }: MobileNavProps) {
17:   const pathname = usePathname()
18: 
19:   // Cerrar al navegar
20:   useEffect(() => {
21:     onClose()
22:   }, [pathname, onClose])
23: 
24:   // Prevenir scroll del body cuando está abierto
25:   useEffect(() => {
26:     if (open) {
27:       document.body.style.overflow = 'hidden'
28:     } else {
29:       document.body.style.overflow = ''
30:     }
31:     return () => {
32:       document.body.style.overflow = ''
33:     }
34:   }, [open])
35: 
36:   if (!open) return null
37: 
38:   const allowedRoutes = ROLE_ROUTES[role] ?? []
39:   const navItems = ALL_NAV_ITEMS.filter((item) =>
40:     allowedRoutes.some((route) => item.href.startsWith(route)),
41:   )
42: 
43:   return (
44:     <div className="fixed inset-0 z-40 md:hidden">
45:       {/* Overlay */}
46:       <div
47:         className="fixed inset-0 bg-black/50"
48:         onClick={onClose}
49:         aria-hidden="true"
50:       />
51: 
52:       {/* Panel */}
53:       <div className="fixed inset-y-0 left-0 w-64 bg-navy shadow-xl">
54:         {/* Header */}
55:         <div className="flex h-14 items-center justify-between px-5">
56:           <span className="text-xl font-bold text-white">
57:             Movimient<span className="text-gold">OS</span>
58:           </span>
59:           <button
60:             onClick={onClose}
61:             className="rounded-lg p-1.5 text-white/70 hover:text-white"
62:             aria-label="Cerrar menú"
63:           >
64:             <X className="h-5 w-5" />
65:           </button>
66:         </div>
67: 
68:         {/* Nav */}
69:         <nav className="mt-4 space-y-1 px-3">
70:           {navItems.map((item) => {
71:             const isActive =
72:               pathname === item.href || pathname.startsWith(item.href + '/')
73:             const Icon = item.icon
74: 
75:             return (
76:               <Link
77:                 key={item.href}
78:                 href={item.href}
79:                 className={`
80:                   flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium
81:                   transition-colors duration-150
82:                   ${
83:                     isActive
84:                       ? 'bg-white/15 text-white'
85:                       : 'text-white/70 hover:bg-white/10 hover:text-white'
86:                   }
87:                 `}
88:               >
89:                 <Icon className="h-5 w-5 shrink-0" />
90:                 {item.label}
91:               </Link>
92:             )
93:           })}
94:         </nav>
95:       </div>
96:     </div>
97:   )
98: }
</file>

