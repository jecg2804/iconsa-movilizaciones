 27: /** Calcula la cantidad disponible de una linea (cantidad total - ya programada) */
 28: function getAvailableQty(line: BacklogLine): number {
 29:   return Math.max(0, line.quantity - line.qty_scheduled - (line.qty_delivered ?? 0))
 30: }
