113: function LineSelector({
114:   backlogLines,
115:   currentAssignments,
116:   onChange,
117:   loading = false,
118: }: LineSelectorProps) {
119:   // IDs de las lineas ya seleccionadas para filtrarlas del backlog disponible
120:   const assignedLineIds = new Set(currentAssignments.map((a) => a.request_line_id))
121: 
122:   // Lineas disponibles = las que aun no estan en las asignaciones actuales
123:   const availableLines = backlogLines.filter((l) => !assignedLineIds.has(l.id))
124: 
125:   // --- Agregar una linea al viaje ---
126:   const handleAdd = useCallback(
127:     (line: BacklogLine) => {
128:       const availableQty = getAvailableQty(line)
129:       if (availableQty <= 0) return // Nada disponible
130:       const newAssignment: AssignmentInput = {
131:         request_line_id: line.id,
132:         quantity_assigned: availableQty,
133:       }
134:       onChange([...currentAssignments, newAssignment])
135:     },
136:     [currentAssignments, onChange],
137:   )
138: 
139:   // --- Quitar una linea del viaje ---
140:   const handleRemove = useCallback(
141:     (lineId: string) => {
142:       onChange(currentAssignments.filter((a) => a.request_line_id !== lineId))
143:     },
144:     [currentAssignments, onChange],
145:   )
146: 
147:   // --- Actualizar cantidad asignada ---
148:   const handleQtyChange = useCallback(
149:     (lineId: string, newQty: number) => {
150:       const line = findLineById(lineId)
151:       const maxQty = line ? getAvailableQty(line) : newQty
152:       const unitCode = line ? resolveUnit(line) : ''
153:       const qtyMin = INTEGER_UNITS.has(unitCode) ? 1 : 0.01
154:       const clamped = Math.min(Math.max(qtyMin, newQty), maxQty > 0 ? maxQty : newQty)
155:       onChange(
156:         currentAssignments.map((a) =>
157:           a.request_line_id === lineId ? { ...a, quantity_assigned: clamped } : a,
158:         ),
159:       )
160:     },
161:     [currentAssignments, onChange],
162:   )
163: 
