 897:       modifiedAssignments?: ModifiedAssignment[],
 898:     ): Promise<boolean> => {
 899:       if (busyRef.current) return false
 900:       busyRef.current = true
 901:       setSaving(true)
 902:       setSaveError(null)
 903: 
 904:       try {
 905:         // 1. Actualizar los campos del viaje
 906:         const { error: updateError } = await supabase
 907:           .from('trips')
 908:           .update({
 909:             scheduled_date: input.scheduled_date,
 910:             scheduled_time: input.scheduled_time ?? null,
 911:             driver_id: input.driver_id,
 912:             vehicle_id: input.vehicle_id,
 913:             trailer_id: input.trailer_id,
 914:             rate_id: input.rate_id,
 915:             cost: input.cost,
 916:             att_permit: input.att_permit,
 917:             escort: input.escort,
 918:             notes: input.notes,
