 26:   const showDriverFilter = role !== 'campo'
 27: 
 28:   useEffect(() => {
 29:     if (!showDriverFilter) return
 30:     supabase
 31:       .from('people')
 32:       .select('id, name')
 33:       .eq('status', 'Activo')
 34:       .eq('app_role', 'campo')
 35:       .order('name')
 36:       .then(({ data }) => setDrivers(data ?? []))
 37:   }, [supabase, showDriverFilter])
 38: 
 39:   const statusOptions: SelectOption[] = [
 40:     { value: 'Programado', label: 'Programado' },
