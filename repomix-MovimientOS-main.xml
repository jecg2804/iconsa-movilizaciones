 878:         busyRef.current = false
 879:         const message = err instanceof Error ? err.message : 'Error inesperado al guardar viaje'
 880:         setSaveError(message)
 881:         return null
 882:       } finally {
 883:         setSaving(false)
 884:       }
 885:     },
 886:     [supabase],
