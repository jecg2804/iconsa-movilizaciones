370:   // --- Fetch tarifas ---
371:   useEffect(() => {
372:     async function fetchRates() {
373:       setRatesLoading(true)
374:       const { data } = await supabase
375:         .from('mobilization_rates')
376:         .select('id, code, description, rate')
377:         .eq('is_active', true)
378:         .order('code')
379:       setRates(data ?? [])
380:       setRatesLoading(false)
381:     }
