<file path="src/components/ui/MiniCalendar.tsx">
  1: 'use client'
  2: 
  3: import { useState, useMemo } from 'react'
  4: import { useRouter } from 'next/navigation'
  5: import { startOfWeek, addDays, format, isSameDay } from 'date-fns'
  6: import { es } from 'date-fns/locale'
  7: import { ChevronLeft, ChevronRight } from 'lucide-react'
  8: import { Badge } from '@/components/ui/Badge'
  9: 
 10: interface CalendarItem {
 11:   id: string
 12:   date: string
 13:   label: string
 14:   status: string
 15:   badgeVariant: 'trip' | 'status' | 'priority'
 16:   subtitle: string
 17:   route?: string
 18:   href: string
 19: }
 20: 
 21: interface MiniCalendarProps {
 22:   items: CalendarItem[]
 23:   selectedDate: string | null
 24:   onSelectDate: (date: string | null) => void
 25:   weeksToShow?: number
 26: }
 27: 
 28: const DAY_HEADERS = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom']
 29: const MAX_CARDS = 3
 30: 
 31: function MiniCalendar({
 32:   items,
 33:   selectedDate,
 34:   onSelectDate,
 35:   weeksToShow = 2,
 36: }: MiniCalendarProps) {
 37:   const router = useRouter()
 38:   const [weekStart, setWeekStart] = useState(() =>
 39:     startOfWeek(new Date(), { weekStartsOn: 1 }),
 40:   )
 41: 
 42:   const today = useMemo(() => new Date(), [])
 43:   const totalDays = weeksToShow * 7
 44: 
 45:   const days = useMemo(() => {
 46:     const result: Date[] = []
 47:     for (let i = 0; i < totalDays; i++) {
 48:       result.push(addDays(weekStart, i))
 49:     }
 50:     return result
 51:   }, [weekStart, totalDays])
 52: 
 53:   // Agrupar items por fecha
 54:   const itemsByDate = useMemo(() => {
 55:     const map = new Map<string, CalendarItem[]>()
 56:     for (const item of items) {
 57:       if (!map.has(item.date)) map.set(item.date, [])
 58:       map.get(item.date)!.push(item)
 59:     }
 60:     return map
 61:   }, [items])
 62: 
 63:   const rangeLabel = `${format(weekStart, "d MMM", { locale: es })} — ${format(addDays(weekStart, totalDays - 1), "d MMM yyyy", { locale: es })}`
 64: 
 65:   const handleDayClick = (dateStr: string) => {
 66:     onSelectDate(selectedDate === dateStr ? null : dateStr)
 67:   }
 68: 
 69:   return (
 70:     <div className="rounded-lg border border-gray-200 bg-white">
 71:       {/* Nav */}
 72:       <div className="flex items-center justify-between px-3 py-2 border-b border-gray-100">
 73:         <button
 74:           type="button"
 75:           title="Semana anterior"
 76:           onClick={() => setWeekStart((p) => addDays(p, -7))}
 77:           className="rounded p-1 text-gray-500 hover:bg-gray-100"
 78:         >
 79:           <ChevronLeft className="h-4 w-4" />
 80:         </button>
 81:         <div className="flex items-center gap-2">
 82:           <span className="text-xs font-medium text-gray-600 capitalize">
 83:             {rangeLabel}
 84:           </span>
 85:           <button
 86:             type="button"
 87:             onClick={() =>
 88:               setWeekStart(startOfWeek(new Date(), { weekStartsOn: 1 }))
 89:             }
 90:             className="rounded px-1.5 py-0.5 text-[10px] font-medium text-iconsa-blue hover:bg-blue-50"
 91:           >
 92:             Hoy
 93:           </button>
 94:         </div>
 95:         <button
 96:           type="button"
 97:           title="Semana siguiente"
 98:           onClick={() => setWeekStart((p) => addDays(p, 7))}
 99:           className="rounded p-1 text-gray-500 hover:bg-gray-100"
100:         >
101:           <ChevronRight className="h-4 w-4" />
102:         </button>
103:       </div>
104: 
105:       {/* Desktop grid */}
106:       <div className="hidden md:block">
107:         {/* Cabecera días */}
108:         <div className="grid grid-cols-7 gap-px bg-gray-100">
109:           {DAY_HEADERS.map((d) => (
110:             <div
111:               key={d}
112:               className="bg-gray-50 px-2 py-1 text-center text-[10px] font-semibold text-gray-500"
113:             >
114:               {d}
115:             </div>
116:           ))}
117:         </div>
118: 
119:         {/* Filas de días */}
120:         {Array.from({ length: weeksToShow }, (_, row) => (
121:           <div key={row} className="grid grid-cols-7 gap-px bg-gray-100">
122:             {days.slice(row * 7, row * 7 + 7).map((day) => {
123:               const key = format(day, 'yyyy-MM-dd')
124:               const dayItems = itemsByDate.get(key) ?? []
125:               const isToday = isSameDay(day, today)
126:               const isSelected = selectedDate === key
127:               const visibleItems = dayItems.slice(0, MAX_CARDS)
128:               const overflow = dayItems.length - MAX_CARDS
129: 
130:               return (
131:                 <div
132:                   key={key}
133:                   onClick={() => handleDayClick(key)}
134:                   className={`min-h-[140px] bg-white p-1.5 cursor-pointer transition-colors hover:bg-gray-50 ${
135:                     isSelected ? 'ring-2 ring-inset ring-iconsa-blue bg-blue-50/30' : ''
136:                   } ${isToday && !isSelected ? 'ring-1 ring-inset ring-iconsa-blue/40' : ''}`}
137:                 >
138:                   {/* Número del día */}
139:                   <div className="mb-1 flex items-center gap-1">
140:                     <span
141:                       className={`text-[11px] font-medium leading-none ${
142:                         isToday
143:                           ? 'flex h-5 w-5 items-center justify-center rounded-full bg-iconsa-blue text-white'
144:                           : isSelected
145:                             ? 'text-iconsa-blue'
146:                             : 'text-gray-500'
147:                       }`}
148:                     >
149:                       {format(day, 'd')}
150:                     </span>
151:                     {dayItems.length > 0 && !isToday && (
152:                       <span className="text-[9px] font-medium text-gray-400">
153:                         ({dayItems.length})
154:                       </span>
155:                     )}
156:                   </div>
157: 
158:                   {/* Mini-cards */}
159:                   <div className="space-y-0.5">
160:                     {visibleItems.map((item) => (
161:                       <button
162:                         key={item.id}
163:                         type="button"
164:                         onClick={(e) => {
165:                           e.stopPropagation()
166:                           router.push(item.href)
167:                         }}
168:                         className="w-full rounded border border-gray-150 bg-white p-1 text-left hover:bg-gray-50 transition-colors"
169:                       >
170:                         <div className="flex items-center justify-between gap-0.5">
171:                           <span className="font-mono text-[10px] font-medium text-iconsa-navy truncate">
172:                             {item.label}
173:                           </span>
174:                           <Badge
175:                             label={item.status}
176:                             variant={item.badgeVariant}
177:                             className="text-[8px] px-1 py-0 leading-tight"
178:                           />
179:                         </div>
180:                         <p className="text-[10px] text-gray-500 truncate leading-tight">
181:                           {item.subtitle}
182:                         </p>
183:                         {item.route && (
184:                           <p className="text-[9px] text-gray-400 truncate leading-tight">
185:                             {item.route}
186:                           </p>
187:                         )}
188:                       </button>
189:                     ))}
190:                     {overflow > 0 && (
191:                       <span className="block text-[9px] text-iconsa-blue font-medium pl-1">
192:                         +{overflow} más
193:                       </span>
194:                     )}
195:                   </div>
196:                 </div>
197:               )
198:             })}
199:           </div>
200:         ))}
201:       </div>
202: 
203:       {/* Mobile: lista vertical */}
204:       <div className="md:hidden divide-y divide-gray-100">
205:         {days.map((day) => {
206:           const key = format(day, 'yyyy-MM-dd')
207:           const dayItems = itemsByDate.get(key) ?? []
208:           const isToday = isSameDay(day, today)
209:           const isSelected = selectedDate === key
210: 
211:           if (dayItems.length === 0 && !isToday) return null
212: 
213:           return (
214:             <div
215:               key={key}
216:               className={`${isSelected ? 'bg-blue-50/40' : ''}`}
217:             >
218:               {/* Cabecera del día */}
219:               <button
220:                 type="button"
221:                 onClick={() => handleDayClick(key)}
222:                 className={`w-full px-3 py-1.5 text-left text-xs font-medium ${
223:                   isToday ? 'text-iconsa-blue' : 'text-gray-600'
224:                 } hover:bg-gray-50`}
225:               >
226:                 {format(day, "EEE d 'de' MMM", { locale: es })}
227:                 {isToday && (
228:                   <span className="ml-1.5 rounded-full bg-iconsa-blue px-1.5 py-0.5 text-[9px] font-semibold text-white">
229:                     Hoy
230:                   </span>
231:                 )}
232:                 {dayItems.length > 0 && (
233:                   <span className="ml-1 text-gray-400">({dayItems.length})</span>
234:                 )}
235:               </button>
236: 
237:               {/* Cards del día */}
238:               {dayItems.length > 0 && (
239:                 <div className="px-3 pb-2 space-y-1">
240:                   {dayItems.map((item) => (
241:                     <button
242:                       key={item.id}
243:                       type="button"
244:                       onClick={() => router.push(item.href)}
245:                       className="w-full rounded-lg border border-gray-200 bg-white p-2 text-left hover:bg-gray-50 transition-colors"
246:                     >
247:                       <div className="flex items-center justify-between gap-1 mb-0.5">
248:                         <span className="font-mono text-xs font-medium text-iconsa-navy truncate">
249:                           {item.label}
250:                         </span>
251:                         <Badge label={item.status} variant={item.badgeVariant} />
252:                       </div>
253:                       <p className="text-xs text-gray-600 truncate">{item.subtitle}</p>
254:                       {item.route && (
255:                         <p className="text-[11px] text-gray-400 truncate">{item.route}</p>
256:                       )}
257:                     </button>
258:                   ))}
259:                 </div>
260:               )}
261: 
262:               {/* Día vacío (solo hoy) */}
263:               {dayItems.length === 0 && (
264:                 <p className="px-3 pb-2 text-xs text-gray-400 italic">Sin actividad</p>
265:               )}
266:             </div>
267:           )
268:         })}
269: 
270:         {/* Sin items en ningún día */}
271:         {items.length === 0 && (
272:           <div className="px-3 py-6 text-center text-xs text-gray-400">
273:             Sin actividad en este período
274:           </div>
275:         )}
276:       </div>
277:     </div>
278:   )
279: }
280: 
281: export { MiniCalendar }
282: export type { MiniCalendarProps, CalendarItem }
</file>

<file path="src/components/ui/Select.tsx">
  1: 'use client'
  2: 
  3: import { useState, useRef, useEffect, useCallback, useMemo } from 'react'
  4: import { ChevronDown, X } from 'lucide-react'
  5: 
  6: export interface SelectOption {
  7:   value: string
  8:   label: string
  9:   sublabel?: string
 10:   /** Valor numérico opcional — usado para auto-fill (ej: monto de tarifa de movilización) */
 11:   amount?: number
 12: }
 13: 
 14: interface SelectProps {
 15:   label?: string
 16:   placeholder?: string
 17:   options: SelectOption[]
 18:   value: string | null
 19:   onChange: (value: string | null) => void
 20:   error?: string
 21:   disabled?: boolean
 22:   searchable?: boolean
 23:   emptyMessage?: string
 24:   className?: string
 25:   id?: string
 26: }
 27: 
 28: function Select({
 29:   label,
 30:   placeholder = 'Seleccionar...',
 31:   options,
 32:   value,
 33:   onChange,
 34:   error,
 35:   disabled = false,
 36:   searchable = true,
 37:   emptyMessage = 'No se encontraron resultados',
 38:   className = '',
 39:   id,
 40: }: SelectProps) {
 41:   const [isOpen, setIsOpen] = useState(false)
 42:   const [search, setSearch] = useState('')
 43:   const [highlightedIndex, setHighlightedIndex] = useState(-1)
 44:   const containerRef = useRef<HTMLDivElement>(null)
 45:   const searchInputRef = useRef<HTMLInputElement>(null)
 46:   const listRef = useRef<HTMLUListElement>(null)
 47: 
 48:   const inputId = id ?? label?.toLowerCase().replace(/\s+/g, '-')
 49: 
 50:   const selectedOption = useMemo(
 51:     () => options.find((opt) => opt.value === value) ?? null,
 52:     [options, value],
 53:   )
 54: 
 55:   const filteredOptions = useMemo(() => {
 56:     if (!search) return options
 57:     const term = search.toLowerCase()
 58:     return options.filter((opt) => opt.label.toLowerCase().includes(term))
 59:   }, [options, search])
 60: 
 61:   // Cerrar al hacer click afuera
 62:   useEffect(() => {
 63:     function handleMouseDown(e: MouseEvent) {
 64:       if (containerRef.current && !containerRef.current.contains(e.target as Node)) {
 65:         setIsOpen(false)
 66:         setSearch('')
 67:       }
 68:     }
 69:     document.addEventListener('mousedown', handleMouseDown)
 70:     return () => document.removeEventListener('mousedown', handleMouseDown)
 71:   }, [])
 72: 
 73:   // Auto-focus en el input de busqueda al abrir
 74:   useEffect(() => {
 75:     if (isOpen && searchable && searchInputRef.current) {
 76:       searchInputRef.current.focus()
 77:     }
 78:   }, [isOpen, searchable])
 79: 
 80:   const handleToggle = useCallback(() => {
 81:     if (disabled) return
 82:     setIsOpen((prev) => {
 83:       if (prev) setSearch('')
 84:       return !prev
 85:     })
 86:   }, [disabled])
 87: 
 88:   const handleSelect = useCallback(
 89:     (optionValue: string) => {
 90:       onChange(optionValue)
 91:       setIsOpen(false)
 92:       setSearch('')
 93:     },
 94:     [onChange],
 95:   )
 96: 
 97:   const handleClear = useCallback(
 98:     (e: React.MouseEvent) => {
 99:       e.stopPropagation()
100:       onChange(null)
101:       setIsOpen(false)
102:       setSearch('')
103:     },
104:     [onChange],
105:   )
106: 
107:   // Reset highlight cuando cambian las opciones filtradas
108:   useEffect(() => {
109:     setHighlightedIndex(-1)
110:   }, [filteredOptions.length])
111: 
112:   const handleKeyDown = useCallback(
113:     (e: React.KeyboardEvent) => {
114:       if (e.key === 'Escape') {
115:         setIsOpen(false)
116:         setSearch('')
117:         return
118:       }
119: 
120:       if (!isOpen) {
121:         if (e.key === 'ArrowDown' || e.key === 'Enter') {
122:           e.preventDefault()
123:           setIsOpen(true)
124:         }
125:         return
126:       }
127: 
128:       if (e.key === 'ArrowDown') {
129:         e.preventDefault()
130:         setHighlightedIndex((prev) => {
131:           const next = prev < filteredOptions.length - 1 ? prev + 1 : 0
132:           listRef.current?.children[next]?.scrollIntoView({ block: 'nearest' })
133:           return next
134:         })
135:       } else if (e.key === 'ArrowUp') {
136:         e.preventDefault()
137:         setHighlightedIndex((prev) => {
138:           const next = prev > 0 ? prev - 1 : filteredOptions.length - 1
139:           listRef.current?.children[next]?.scrollIntoView({ block: 'nearest' })
140:           return next
141:         })
142:       } else if (e.key === 'Enter') {
143:         e.preventDefault()
144:         if (highlightedIndex >= 0 && highlightedIndex < filteredOptions.length) {
145:           handleSelect(filteredOptions[highlightedIndex].value)
146:         }
147:       }
148:     },
149:     [isOpen, filteredOptions, highlightedIndex, handleSelect],
150:   )
151: 
152:   return (
153:     <div ref={containerRef} className={`relative w-full ${className}`}>
154:       {label && (
155:         <label
156:           htmlFor={inputId}
157:           className="mb-1 block text-sm font-medium text-gray-700"
158:         >
159:           {label}
160:         </label>
161:       )}
162: 
163:       {/* Trigger */}
164:       <button
165:         type="button"
166:         id={inputId}
167:         onClick={handleToggle}
168:         onKeyDown={handleKeyDown}
169:         disabled={disabled}
170:         className={`
171:           flex w-full items-center justify-between rounded-lg border px-3 py-2 text-sm text-left
172:           focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue
173:           disabled:bg-gray-50 disabled:text-gray-500 disabled:cursor-not-allowed
174:           ${error ? 'border-iconsa-red' : 'border-gray-300'}
175:         `}
176:       >
177:         <span className={selectedOption ? 'text-gray-900' : 'text-gray-400'}>
178:           {selectedOption?.label ?? placeholder}
179:         </span>
180:         <span className="flex items-center gap-1">
181:           {value !== null && !disabled && (
182:             <span
183:               role="button"
184:               title="Limpiar selección"
185:               tabIndex={-1}
186:               onClick={handleClear}
187:               onKeyDown={(e) => {
188:                 if (e.key === 'Enter') handleClear(e as unknown as React.MouseEvent)
189:               }}
190:               className="rounded p-0.5 hover:bg-gray-100"
191:             >
192:               <X className="h-3.5 w-3.5 text-gray-400" />
193:             </span>
194:           )}
195:           <ChevronDown
196:             className={`h-4 w-4 text-gray-400 transition-transform ${isOpen ? 'rotate-180' : ''}`}
197:           />
198:         </span>
199:       </button>
200: 
201:       {/* Dropdown */}
202:       {isOpen && (
203:         <div
204:           className="absolute z-50 mt-1 w-full max-h-60 overflow-auto rounded-lg border border-gray-300 bg-white shadow-lg"
205:         >
206:           {searchable && (
207:             <div className="sticky top-0 border-b border-gray-200 bg-white p-2">
208:               <input
209:                 ref={searchInputRef}
210:                 type="text"
211:                 value={search}
212:                 onChange={(e) => setSearch(e.target.value)}
213:                 onKeyDown={handleKeyDown}
214:                 placeholder="Buscar..."
215:                 className="w-full rounded border border-gray-300 px-2.5 py-1.5 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
216:               />
217:             </div>
218:           )}
219: 
220:           {filteredOptions.length === 0 ? (
221:             <div className="px-3 py-4 text-center text-sm text-gray-500">
222:               {emptyMessage}
223:             </div>
224:           ) : (
225:             <ul role="listbox" aria-label={label ?? placeholder} ref={listRef}>
226:               {filteredOptions.map((option, idx) => (
227:                 <li
228:                   key={option.value}
229:                   role="option"
230:                   aria-selected={option.value === value ? true : undefined}
231:                   onClick={() => handleSelect(option.value)}
232:                   onMouseEnter={() => setHighlightedIndex(idx)}
233:                   className={`
234:                     cursor-pointer px-3 py-2 text-sm
235:                     ${idx === highlightedIndex ? 'bg-gray-100' : 'hover:bg-gray-50'}
236:                     ${option.value === value ? 'bg-iconsa-blue/5 font-medium text-iconsa-blue' : 'text-gray-900'}
237:                   `}
238:                 >
239:                   <span className="block">{option.label}</span>
240:                   {option.sublabel && (
241:                     <span className="block text-xs text-gray-500">{option.sublabel}</span>
242:                   )}
243:                 </li>
244:               ))}
245:             </ul>
246:           )}
247:         </div>
248:       )}
249: 
250:       {error && (
251:         <p className="mt-1 text-sm text-iconsa-red">{error}</p>
252:       )}
253:     </div>
254:   )
255: }
256: 
257: export { Select }
258: export type { SelectProps }
</file>

<file path="src/components/viajes/CodeConfirmation.tsx">
  1: 'use client'
  2: 
  3: import { useState, useMemo } from 'react'
  4: import { Input } from '@/components/ui/Input'
  5: import { Button } from '@/components/ui/Button'
  6: import { SelectWithFallback, type SelectWithFallbackValue } from '@/components/ui/SelectWithFallback'
  7: import type { SelectOption } from '@/components/ui/Select'
  8: 
  9: interface CodeConfirmationProps {
 10:   /** Código esperado — usado SOLO para validación interna. NUNCA mostrar en UI. */
 11:   expectedCode: string | null
 12:   /** Opciones para el dropdown de receptor */
 13:   receiverOptions: SelectOption[]
 14:   onConfirm: (codeUsed: string, receivedById: string | null, receivedByName: string) => void
 15:   onCancel: () => void
 16:   loading?: boolean
 17: }
 18: 
 19: export function CodeConfirmation({
 20:   expectedCode,
 21:   receiverOptions,
 22:   onConfirm,
 23:   onCancel,
 24:   loading,
 25: }: CodeConfirmationProps) {
 26:   const [code, setCode] = useState('')
 27:   const [receiver, setReceiver] = useState<SelectWithFallbackValue>({ id: null, text: null })
 28:   const [showHelp, setShowHelp] = useState(false)
 29: 
 30:   // Validación del código
 31:   const codeComplete = code.trim().length === 4
 32:   const codeCorrect = codeComplete && expectedCode !== null && code.trim() === expectedCode
 33:   const codeIncorrect = codeComplete && expectedCode !== null && code.trim() !== expectedCode
 34: 
 35:   // Receptor lleno: seleccionó del dropdown (id) o escribió texto (text)
 36:   const receiverFilled = (receiver.id !== null) || (receiver.text !== null && receiver.text.trim().length > 0)
 37: 
 38:   // Nombre del receptor para denormalización
 39:   const receiverName = useMemo(() => {
 40:     if (receiver.id) {
 41:       const opt = receiverOptions.find((o) => o.value === receiver.id)
 42:       return opt?.label ?? ''
 43:     }
 44:     return receiver.text?.trim() ?? ''
 45:   }, [receiver, receiverOptions])
 46: 
 47:   const canConfirm = codeCorrect && receiverFilled
 48: 
 49:   const handleConfirm = () => {
 50:     if (!canConfirm) return
 51:     onConfirm(code.trim(), receiver.id, receiverName)
 52:   }
 53: 
 54:   return (
 55:     <div className="space-y-4">
 56:       <p className="text-sm text-gray-700">
 57:         Solicite el código de confirmación al receptor en campo e ingréselo aquí.
 58:       </p>
 59: 
 60:       <div className="space-y-3">
 61:         {/* Código de confirmación */}
 62:         <Input
 63:           label="Código de confirmación (4 dígitos)"
 64:           type="text"
 65:           inputMode="numeric"
 66:           maxLength={4}
 67:           placeholder="0000"
 68:           value={code}
 69:           onChange={(e) => setCode(e.target.value.replace(/\D/g, ''))}
 70:           error={codeIncorrect ? 'Código incorrecto. Verifique con el solicitante.' : undefined}
 71:         />
 72: 
 73:         {/* Mensaje de código correcto */}
 74:         {codeCorrect && (
 75:           <p className="text-sm font-medium text-iconsa-green">Código verificado ✓</p>
 76:         )}
 77: 
 78:         {/* Recibido por — SelectWithFallback */}
 79:         <SelectWithFallback
 80:           label="Recibido por"
 81:           placeholder="Seleccionar receptor..."
 82:           options={receiverOptions}
 83:           value={receiver}
 84:           onChange={setReceiver}
 85:           fallbackLabel="No está en la lista"
 86:           fallbackPlaceholder="Nombre del receptor"
 87:         />
 88:       </div>
 89: 
 90:       {/* Link de ayuda */}
 91:       <button
 92:         type="button"
 93:         onClick={() => setShowHelp(!showHelp)}
 94:         className="text-xs font-medium text-iconsa-blue hover:underline"
 95:       >
 96:         ¿No tiene el código?
 97:       </button>
 98: 
 99:       {showHelp && (
100:         <div className="rounded-lg border border-blue-200 bg-blue-50 px-4 py-3">
101:           <p className="text-sm text-blue-800">
102:             Contacte al solicitante o al coordinador de logística para obtener el código de confirmación.
103:             La entrega no puede registrarse sin el código correcto.
104:           </p>
105:         </div>
106:       )}
107: 
108:       {/* Acciones */}
109:       <div className="flex gap-2">
110:         <Button variant="primary" onClick={handleConfirm} disabled={!canConfirm} loading={loading}>
111:           Confirmar Entrega
112:         </Button>
113:         <Button variant="ghost" onClick={onCancel} disabled={loading}>
114:           Cancelar
115:         </Button>
116:       </div>
117:     </div>
118:   )
119: }
</file>

