141: const SEQUENCE_CONFLICT_ERROR =
142:   'there is no unique or exclusion constraint matching the ON CONFLICT specification'
143: 
144: function isSequenceConflictError(message: string | undefined): boolean {
145:   if (!message) return false
146:   return message.toLowerCase().includes(SEQUENCE_CONFLICT_ERROR)
147: }
148: 
149: /**
150:  * Fallback para generar request_id desde cliente si el trigger falla por ON CONFLICT.
151:  * Mantiene formato {project_code}-SM-{###} por proyecto.
152:  */
153: async function generateRequestIdFallback(
154:   supabase: SupabaseClient<Database>,
155:   projectId: string,
156: ): Promise<string | null> {
157:   const { data: project, error: projectError } = await supabase
158:     .from('projects')
159:     .select('code')
160:     .eq('id', projectId)
161:     .single()
162: 
163:   if (projectError || !project?.code) {
164:     return null
165:   }
166: 
167:   const { data: existingRows } = await supabase
168:     .from('sm_requests')
169:     .select('request_id')
170:     .eq('project_id', projectId)
171:     .not('request_id', 'is', null)
172: 
173:   let maxSequence = 0
174:   for (const row of existingRows ?? []) {
175:     const requestId = row.request_id
176:     if (!requestId) continue
177: 
178:     const match = requestId.match(/-SM-(\d+)$/)
179:     if (!match) continue
180: 
181:     const parsed = Number(match[1])
182:     if (!Number.isNaN(parsed)) {
183:       maxSequence = Math.max(maxSequence, parsed)
184:     }
185:   }
186: 
187:   const nextSequence = maxSequence + 1
188:   const suffix = String(nextSequence).padStart(3, '0')
189:   return `${project.code}-SM-${suffix}`
190: }
191: 
192: /**
193:  * Crea registros en la tabla suggestions para valores de fallback (texto libre).
194:  * Se ignoran errores silenciosamente — las sugerencias son best-effort.
195:  */
196: async function createSuggestions(
197:   supabase: SupabaseClient<Database>,
198:   lines: LineInput[],
199:   personId: string,
200: ): Promise<void> {
201:   const suggestions: Array<{
202:     table_name: string
203:     suggested_value: string
204:     suggested_by: string
205:   }> = []
206: 
207:   for (const line of lines) {
208:     if (line.equipment_text) {
209:       suggestions.push({
210:         table_name: 'equipment',
211:         suggested_value: line.equipment_text,
212:         suggested_by: personId,
213:       })
214:     }
215:     if (line.from_text) {
216:       suggestions.push({
217:         table_name: 'locations',
218:         suggested_value: line.from_text,
219:         suggested_by: personId,
220:       })
221:     }
222:     if (line.to_text) {
223:       suggestions.push({
224:         table_name: 'locations',
225:         suggested_value: line.to_text,
226:         suggested_by: personId,
227:       })
228:     }
229:     if (line.unit_text) {
230:       suggestions.push({
231:         table_name: 'units',
232:         suggested_value: line.unit_text,
233:         suggested_by: personId,
234:       })
235:     }
236:   }
237: 
238:   if (suggestions.length > 0) {
239:     await supabase.from('suggestions').insert(suggestions)
240:   }
241: }
