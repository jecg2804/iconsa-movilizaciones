256:     // eslint-disable-next-line @typescript-eslint/no-explicit-any
257:     ;(supabase.from.bind(supabase) as (table: string) => ReturnType<typeof supabase.from>)('cost_code_categories')
258:       .select('cost_category_id, cost_categories(id, code, description)')
259:       .eq('cost_code_id', costCodeId)
260:       .then(({ data }: { data: Array<{ cost_category_id: string; cost_categories: { id: string; code: string; description: string | null } | null }> | null }) => {
261:         if (cancelled) return
262:         const options: SelectOption[] = (data ?? [])
263:           .map((row) => {
264:             const cat = row.cost_categories
265:             if (!cat) return null
266:             return { value: cat.id, label: `${cat.code} — ${cat.description ?? cat.code}` }
267:           })
268:           .filter((opt): opt is SelectOption => opt !== null)
269:           .sort((a, b) => a.label.localeCompare(b.label))
270:         setCategoryOptions(options)
271: 
272:         // Si la categoria actual no esta en las opciones validas, resetear
273:         if (costCategoryId && !options.some((o) => o.value === costCategoryId)) {
274:           setCostCategoryId(null)
275:         }
276:         setLoadingCategories(false)
277:       })
278: 
279:     return () => { cancelled = true }
280:     // Solo re-fetch cuando cambia costCodeId, no cuando cambia costCategoryId
281:     // eslint-disable-next-line react-hooks/exhaustive-deps
282:   }, [costCodeId, supabase])
283: 
284:   // --- Auto-rellenar descripcion al seleccionar equipo del dropdown ---
285:   useEffect(() => {
286:     if (lineType === 'Equipo' && equipmentValue.id) {
287:       const selected = equipment.find((opt) => opt.value === equipmentValue.id)
288:       if (selected) {
289:         setDescription(selected.label)
290:       }
291:     }
292:   }, [equipmentValue.id, lineType, equipment])
293: 
294:   // --- Cambiar tipo de linea ---
295:   const handleTypeChange = useCallback(
296:     (newType: 'Equipo' | 'Material') => {
297:       if (newType === lineType) return
298:       setLineType(newType)
299:       // Resetear campos especificos del tipo
300:       if (newType === 'Material') {
301:         setEquipmentValue(emptyFallbackValue())
302:         setDescription('')
303:       } else {
304:         setDescription('')
305:       }
306:       setMaterialCategory(null)
307:       setErrors({})
308:     },
309:     [lineType],
310:   )
311: 
312:   // --- Manejar cambio de extra (resetea fase + categoria) ---
313:   const handleExtraChange = useCallback((newExtraId: string | null) => {
314:     setSelectedExtraId(newExtraId)
315:     setCostCodeId(null)
316:     setCostCategoryId(null)
317:   }, [])
318: 
319:   // --- Manejar cambio de fase (resetea categoria) ---
320:   const handleCostCodeChange = useCallback((newCostCodeId: string | null) => {
321:     setCostCodeId(newCostCodeId)
322:     setCostCategoryId(null)
323:   }, [])
324: 
325:   // --- Construir LineInput desde el estado actual ---
326:   const buildLineInput = useCallback((): LineInput => {
327:     return {
328:       id: initialData?.id,
329:       line_type: lineType,
330:       equipment_id: lineType === 'Equipo' ? equipmentValue.id : null,
331:       equipment_text: lineType === 'Equipo' ? equipmentValue.text : null,
332:       description: description.trim(),
333:       from_location_id: fromValue.id,
334:       from_text: fromValue.text,
335:       to_location_id: toValue.id,
336:       to_text: toValue.text,
337:       quantity: Math.round(parseFloat(quantity)) || 0,
338:       unit_id: unitValue.id,
339:       unit_text: unitValue.text,
340:       cost_code_id: costCodeId,
341:       cost_category_id: costCategoryId,
342:       category: null, // LEGACY — no usar
343:       material_category: lineType === 'Material' ? materialCategory : null,
344:       po_reference: poReference.trim() || null,
345:       notes: lineNotes.trim() || null,
346:     }
347:   }, [
348:     initialData?.id,
349:     lineType,
350:     equipmentValue,
351:     description,
352:     fromValue,
353:     toValue,
354:     quantity,
355:     unitValue,
356:     costCodeId,
357:     costCategoryId,
358:     materialCategory,
359:     poReference,
360:     lineNotes,
361:   ])
362: 
363:   // --- Validacion ---
364:   const validate = useCallback((): boolean => {
365:     const newErrors: Record<string, string> = {}
366: 
367:     // Descripcion requerida
368:     if (!description.trim()) {
369:       newErrors.description = 'La descripcion es requerida'
370:     }
371: 
372:     // Cantidad > 0
373:     const qty = parseFloat(quantity)
374:     if (isNaN(qty) || qty <= 0) {
375:       newErrors.quantity = 'La cantidad debe ser mayor a cero'
376:     }
377: 
378:     // Origen requerido
379:     if (!fromValue.id && !fromValue.text?.trim()) {
380:       newErrors.from = 'Indique el origen'
381:     }
382: 
383:     // Destino requerido
384:     if (!toValue.id && !toValue.text?.trim()) {
385:       newErrors.to = 'Indique el destino'
386:     }
387: 
388:     // J7-ext — Código de costo completo requerido (3 campos):
389:     // Extra/Sección (solo si hasExtras), Fase, y Categoría.
390:     if (hasExtras && !selectedExtraId) {
391:       newErrors.extra = 'Seleccione un extra/sección'
392:     }
393:     if (!costCodeId) {
394:       newErrors.cost_code = 'La fase / código de costo es requerida'
395:     }
396:     if (!costCategoryId) {
397:       newErrors.cost_category = 'La categoría de costo es requerida'
398:     }
399: 
400:     setErrors(newErrors)
401:     return Object.keys(newErrors).length === 0
402:   }, [description, quantity, fromValue, toValue, hasExtras, selectedExtraId, costCodeId, costCategoryId])
403: 
404:   // --- Guardar ---
405:   const handleSave = useCallback(async () => {
406:     if (!validate()) return
407: 
408:     const lineInput = buildLineInput()
409: 
410:     // Verificar duplicados si la funcion esta disponible
411:     if (onCheckDuplicates && !showDuplicateWarning) {
412:       setCheckingDuplicates(true)
413:       try {
414:         const found = await onCheckDuplicates(lineInput)
415:         if (found.length > 0) {
416:           setDuplicates(found)
417:           setShowDuplicateWarning(true)
418:           return
419:         }
420:       } finally {
421:         setCheckingDuplicates(false)
422:       }
423:     }
424: 
425:     onSave(lineInput)
426:   }, [validate, buildLineInput, onCheckDuplicates, showDuplicateWarning, onSave])
427: 
428:   // --- Continuar despues de warning de duplicados ---
429:   const handleDuplicateContinue = useCallback(() => {
430:     setShowDuplicateWarning(false)
431:     setDuplicates(null)
432:     const lineInput = buildLineInput()
433:     onSave(lineInput)
434:   }, [buildLineInput, onSave])
435: 
436:   const handleDuplicateCancel = useCallback(() => {
437:     setShowDuplicateWarning(false)
438:     setDuplicates(null)
439:   }, [])
440: 
441:   return (
442:     <div className="rounded-lg border border-gray-200 bg-gray-50 p-4 space-y-4">
443:       {/* Titulo */}
444:       <h3 className="text-sm font-semibold text-gray-900">
445:         {isEditing ? 'Editar Linea' : 'Agregar Linea'}
446:       </h3>
447: 
448:       {/* Toggle de tipo de linea */}
449:       <div className="flex gap-2">
450:         <button
451:           type="button"
452:           onClick={() => handleTypeChange('Equipo')}
453:           className={`
454:             flex flex-1 items-center justify-center gap-2 rounded-lg border-2 px-4 py-2.5 text-sm font-medium transition-colors
455:             ${
456:               lineType === 'Equipo'
457:                 ? 'border-navy bg-navy text-white'
458:                 : 'border-gray-300 bg-white text-gray-700 hover:bg-gray-50'
459:             }
460:           `}
461:         >
462:           <Wrench className="h-4 w-4" />
463:           Equipo
464:         </button>
465:         <button
466:           type="button"
467:           onClick={() => handleTypeChange('Material')}
468:           className={`
469:             flex flex-1 items-center justify-center gap-2 rounded-lg border-2 px-4 py-2.5 text-sm font-medium transition-colors
470:             ${
471:               lineType === 'Material'
472:                 ? 'border-gold bg-gold text-white'
473:                 : 'border-gray-300 bg-white text-gray-700 hover:bg-gray-50'
474:             }
475:           `}
476:         >
477:           <Package className="h-4 w-4" />
478:           Material
479:         </button>
480:       </div>
481: 
482:       {/* Campos del formulario */}
483:       <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
484:         {/* Campos especificos segun tipo */}
485:         {lineType === 'Equipo' ? (
486:           <>
487:             <SelectWithFallback
488:               label="Equipo"
489:               placeholder="Buscar equipo..."
490:               options={equipment}
491:               value={equipmentValue}
492:               onChange={setEquipmentValue}
493:               fallbackLabel="No esta en la lista"
494:               fallbackPlaceholder="Escriba el nombre del equipo..."
495:             />
496:             <Input
497:               label="Descripcion"
498:               value={description}
499:               onChange={(e) => setDescription(e.target.value)}
500:               placeholder="Se rellena al seleccionar equipo"
501:               error={errors.description}
502:             />
503:           </>
504:         ) : (
505:           <>
506:             <div className="md:col-span-2">
507:               <Input
508:                 label="Descripcion del material"
509:                 value={description}
510:                 onChange={(e) => setDescription(e.target.value)}
511:                 placeholder="Describa el material a movilizar..."
512:                 error={errors.description}
513:               />
514:             </div>
515:             <div className="md:col-span-2">
516:               <Input
517:                 label="Categoria de Material"
518:                 value={materialCategory ?? ''}
519:                 onChange={(e) => setMaterialCategory(e.target.value || null)}
520:                 placeholder="Ej: Agregados, Acero, Electrico, Plomeria..."
521:               />
522:             </div>
523:           </>
524:         )}
525: 
526:         {/* Campos comunes */}
527:         <SelectWithFallback
528:           label="Desde"
529:           placeholder="Seleccionar origen..."
530:           options={locations}
531:           value={fromValue}
532:           onChange={setFromValue}
533:           error={errors.from}
534:           fallbackLabel="No esta en la lista"
535:           fallbackPlaceholder="Escriba la ubicacion de origen..."
536:         />
537: 
538:         <SelectWithFallback
539:           label="Hasta"
540:           placeholder="Seleccionar destino..."
541:           options={locations}
542:           value={toValue}
543:           onChange={setToValue}
544:           error={errors.to}
545:           fallbackLabel="No esta en la lista"
546:           fallbackPlaceholder="Escriba la ubicacion de destino..."
547:         />
548: 
549:         <Input
550:           label="Cantidad"
551:           type="number"
552:           min="1"
553:           step="1"
554:           value={quantity}
555:           onChange={(e) => setQuantity(e.target.value)}
556:           error={errors.quantity}
557:         />
558: 
559:         <SelectWithFallback
560:           label="Unidad"
561:           placeholder="Seleccionar unidad..."
562:           options={units}
563:           value={unitValue}
564:           onChange={setUnitValue}
565:           fallbackLabel="No esta en la lista"
566:           fallbackPlaceholder="Escriba la unidad..."
567:         />
568: 
569:         {/* Dropdown Extra — solo visible si el proyecto tiene extras */}
570:         {hasExtras && (
571:           <Select
572:             label="Extra / Sección *"
573:             placeholder={loadingExtras ? 'Cargando...' : 'Seleccionar extra...'}
574:             options={[
575:               { value: '__base__', label: '(Proyecto Base)' },
576:               ...extraOptions,
577:             ]}
578:             value={selectedExtraId}
579:             onChange={handleExtraChange}
580:             disabled={loadingExtras}
581:             error={errors.extra}
582:           />
583:         )}
584: 
585:         <Select
586:           label="Fase / Código de Costo *"
587:           placeholder={loadingCostCodes ? 'Cargando...' : (hasExtras && !selectedExtraId) ? 'Seleccione un extra primero' : 'Seleccionar fase...'}
588:           options={projectId ? filteredCostCodes : costCodes}
589:           value={costCodeId}
590:           onChange={handleCostCodeChange}
591:           searchable
592:           disabled={loadingCostCodes || (hasExtras && !selectedExtraId)}
593:           error={errors.cost_code}
594:         />
595: 
596:         <Select
597:           label="Categoría de Costo *"
598:           placeholder={loadingCategories ? 'Cargando...' : costCodeId ? 'Seleccionar categoría...' : 'Seleccione una fase primero'}
599:           options={categoryOptions}
600:           value={costCategoryId}
601:           onChange={setCostCategoryId}
602:           disabled={!costCodeId || loadingCategories}
603:           error={errors.cost_category}
604:         />
605: 
606:         <Input
607:           label="Referencia OC"
608:           value={poReference}
609:           onChange={(e) => setPoReference(e.target.value)}
610:           placeholder="Orden de compra (opcional)"
611:         />
612: 
613:         <div className="md:col-span-2">
614:           <label
615:             htmlFor="line-notes"
616:             className="mb-1 block text-sm font-medium text-gray-700"
617:           >
618:             Notas de linea
619:           </label>
620:           <textarea
621:             id="line-notes"
622:             value={lineNotes}
623:             onChange={(e) => setLineNotes(e.target.value)}
624:             placeholder="Observaciones sobre esta linea (opcional)"
625:             rows={2}
626:             className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue disabled:bg-gray-50 disabled:text-gray-500"
627:           />
628:         </div>
629:       </div>
630: 
631:       {/* Warning de duplicados */}
632:       {showDuplicateWarning && duplicates && duplicates.length > 0 && (
633:         <DuplicateWarning
634:           matches={duplicates}
635:           onContinue={handleDuplicateContinue}
636:           onCancel={handleDuplicateCancel}
637:         />
638:       )}
639: 
640:       {/* Botones de accion */}
641:       <div className="flex items-center justify-end gap-3 border-t border-gray-200 pt-4">
642:         <Button variant="ghost" size="sm" onClick={onCancel}>
643:           Cancelar
644:         </Button>
645:         <Button
646:           variant="primary"
647:           size="sm"
648:           onClick={handleSave}
649:           loading={checkingDuplicates}
650:         >
651:           {isEditing ? 'Guardar Cambios' : 'Guardar Linea'}
652:         </Button>
653:       </div>
654:     </div>
655:   )
656: }
657: 
658: export { LineEditor }
659: export type { LineEditorProps }
