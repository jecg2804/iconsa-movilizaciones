 544:                   <div style={{display:"flex",justifyContent:"space-between",alignItems:"flex-start"}}>
 545:                     <div>
 546:                       <div style={{display:"flex",gap:"6px",alignItems:"center"}}>
 547:                         <span style={{fontFamily:"monospace",fontWeight:700,fontSize:"13px",color:C.navy}}>{v.id}</span>
 548:                         <Badge color={v.st==="Completado"?C.ok:C.purple}>{v.st}</Badge>
