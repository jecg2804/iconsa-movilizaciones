491:             notifyEntregaConfirmada(lineId).catch(console.error)
492:           }
493:           // Verificar si alguna solicitud padre quedó Completada
494:           const reqIds = [...new Set(
495:             trip.assignments.map(a => a.line?.request?.id).filter(Boolean)
496:           )] as string[]
497:           for (const reqId of reqIds) {
498:             notifySolicitudCompletada(reqId).catch(console.error)
499:           }
500:         }
501:         if (input.event_type === 'Incidencia' && trip) {
502:           notifyIncidenciaRuta(trip.id, input.notes ?? '').catch(console.error)
503:         }
504:         if (input.event_type === 'Retorno' && trip) {
505:           notifyRetornoRegistrado(trip.id).catch(console.error)
506:         }
507: 
508:         setActiveEvent(null)
509:         // Recargar viaje y eventos
510:         const tripData = await fetchTrip(id)
511:         setTrip(tripData)
512:         await loadEvents()
513:       }
514:     },
515:     [registerEvent, assignedLineIds, fetchTrip, id, loadEvents, trip],
516:   )
517: 
518:   // --- Guards ---
519:   if (authLoading || pageLoading) {
520:     return (
521:       <div className="flex min-h-[50vh] items-center justify-center">
522:         <Loader2 className="h-8 w-8 animate-spin text-navy" />
523:       </div>
524:     )
525:   }
526: 
527:   if (!trip) {
528:     return (
529:       <div className="mx-auto max-w-2xl px-4 py-8">
530:         <button
531:           onClick={() => router.push('/mis-viajes')}
532:           className="mb-4 inline-flex items-center gap-1.5 text-sm text-iconsa-gray hover:text-navy transition-colors"
533:         >
534:           <ArrowLeft className="h-4 w-4" />
535:           Mis Movilizaciones
536:         </button>
537:         <p className="text-sm text-iconsa-gray">Movilización no encontrada.</p>
538:       </div>
539:     )
540:   }
541: 
542:   // Código de confirmación solo visible para logistica y admin y pm
543:   const canSeeConfirmationCode = role === 'logistica' || role === 'admin' || role === 'pm'
544:   // Todos los roles con acceso a mis-viajes pueden registrar eventos (incluye PM para entregas)
545:   const canRegisterEvents = canRegisterEvent(role)
546:   // PM solo ve Entrega + Incidencia (no puede UPDATE trips → no Salida/Retorno)
547:   const isPM = role === 'pm'
