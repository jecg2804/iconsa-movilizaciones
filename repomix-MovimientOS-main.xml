 199: /** Combina dos listas de recipients sin duplicados */
 200: function dedup(...lists: Recipient[][]): Recipient[] {
 201:   const seen = new Set<string>()
 202:   const result: Recipient[] = []
 203:   for (const list of lists) {
 204:     for (const r of list) {
 205:       if (!seen.has(r.id)) {
 206:         seen.add(r.id)
 207:         result.push(r)
 208:       }
 209:     }
 210:   }
 211:   return result
 212: }
