<file path="src/hooks/useVehicles.ts">
 1: 'use client'
 2: 
 3: import { useEffect, useState, useMemo } from 'react'
 4: import { createClient } from '@/lib/supabase/client'
 5: import type { Row } from '@/lib/types/database'
 6: 
 7: interface UseVehiclesReturn {
 8:   /** Vehículos activos aptos para cabezal de viaje (VHL y VHP) */
 9:   vehicles: Row<'equipment'>[]
10:   /** Remolques activos filtrados por spectrum_code LIKE 'REM%' */
11:   trailers: Row<'equipment'>[]
12:   loading: boolean
13:   error: string | null
14: }
15: 
16: export function useVehicles(): UseVehiclesReturn {
17:   const [vehicles, setVehicles] = useState<Row<'equipment'>[]>([])
18:   const [trailers, setTrailers] = useState<Row<'equipment'>[]>([])
19:   const [loading, setLoading] = useState(true)
20:   const [error, setError] = useState<string | null>(null)
21: 
22:   const supabase = useMemo(() => createClient(), [])
23: 
24:   useEffect(() => {
25:     async function fetchVehicles() {
26:       try {
27:         setLoading(true)
28:         setError(null)
29: 
30:         const [vehiclesResult, trailersResult] = await Promise.all([
31:           // Vehículos de transporte: cabezales y plataformas propulsadas
32:           supabase
33:             .from('equipment')
34:             .select('*')
35:             .eq('status', 'Activo')
36:             .in('type_code', ['VHL', 'VHP'])
37:             .order('spectrum_code'),
38: 
39:           // Remolques: solo equipos con spectrum_code REM### (excluye camiones plataforma y equipo marino)
40:           supabase
41:             .from('equipment')
42:             .select('*')
43:             .eq('status', 'Activo')
44:             .like('spectrum_code', 'REM%')
45:             .order('spectrum_code'),
46:         ])
47: 
48:         if (vehiclesResult.error) throw vehiclesResult.error
49:         if (trailersResult.error) throw trailersResult.error
50: 
51:         setVehicles(vehiclesResult.data ?? [])
52:         setTrailers(trailersResult.data ?? [])
53:       } catch (err) {
54:         const message = err instanceof Error ? err.message : 'Error al cargar vehículos'
55:         setError(message)
56:       } finally {
57:         setLoading(false)
58:       }
59:     }
60: 
61:     fetchVehicles()
62:   }, [supabase])
63: 
64:   return { vehicles, trailers, loading, error }
65: }
