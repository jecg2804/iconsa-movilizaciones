425:   // --- Quitar asignacion existente ---
426:   const handleRemoveExisting = useCallback((assignmentId: string) => {
427:     const removed = existingAssignments.find((a) => a.id === assignmentId)
428:     setExistingAssignments((prev) => prev.filter((a) => a.id !== assignmentId))
429:     setRemovedAssignmentIds((prev) => [...prev, assignmentId])
430: 
431:     // Reconstruir como BacklogLine para que aparezca inmediatamente en disponibles
432:     if (removed?.line) {
433:       const l = removed.line
434:       // qty_scheduled real MENOS lo que este viaje tenía asignado
435:       const adjustedQtyScheduled = Math.max(0, (l.qty_scheduled ?? 0) - removed.quantity_assigned)
436:       const bl: BacklogLine = {
437:         id: removed.request_line_id,
438:         request_id: l.request?.id ?? '',
439:         line_number: l.line_number,
440:         line_type: l.line_type,
441:         equipment_id: l.equipment?.id ?? null,
442:         description: l.description,
443:         from_location_id: l.from_location?.id ?? null,
444:         from_text: l.from_text ?? null,
445:         to_location_id: l.to_location?.id ?? null,
446:         to_text: l.to_text ?? null,
447:         quantity: l.quantity,
448:         unit_id: l.unit?.id ?? null,
449:         unit_text: l.unit_text ?? null,
450:         cost_code_id: null,
451:         category: null,
452:         status: adjustedQtyScheduled > 0 ? 'Programada' : 'Pendiente',
453:         notes: l.notes ?? null,
454:         qty_scheduled: adjustedQtyScheduled,
455:         qty_delivered: l.qty_delivered ?? 0,
456:         equipment: l.equipment ?? null,
457:         from_location: l.from_location ?? null,
458:         to_location: l.to_location ?? null,
459:         unit: l.unit ?? null,
460:         request: {
461:           id: l.request?.id ?? '',
462:           request_id: l.request?.request_id ?? '',
463:           project: l.request?.project ?? { id: '', code: '', name: '' },
464:           requester: l.request?.requester ?? { id: '', name: '' },
465:           priority: null,
466:           date_required: l.request?.date_required ?? '',
467:           status: 'Enviada',
468:           notes: null,
469:           attachments: null,
470:         },
471:       }
472:       setRemovedLines((prev) => {
473:         // Si ya existe en removedLines, reemplazar (evitar duplicados)
474:         const idx = prev.findIndex((rl) => rl.id === bl.id)
475:         if (idx >= 0) {
476:           const copy = [...prev]
477:           copy[idx] = bl
478:           return copy
479:         }
480:         return [...prev, bl]
481:       })
482:     }
483: 
484:     setIsDirty(true)
485:   }, [existingAssignments])
486: 
487:   // --- Cambiar cantidad de asignacion existente ---
488:   const handleExistingQtyChange = useCallback((assignmentId: string, newQty: number) => {
489:     setExistingAssignments((prev) =>
490:       prev.map((a) => {
491:         if (a.id !== assignmentId) return a
492:         // originalQty congelado al cargar — no se mueve mientras el usuario teclea
493:         const origQty = originalAssignments.get(a.id) ?? a.quantity_assigned
494:         const maxQty = a.line?.quantity
495:           ? a.line.quantity - (a.line.qty_delivered ?? 0) - (a.line.qty_scheduled ?? 0) + origQty
496:           : newQty
497:         const unitCode = a.line?.unit?.code ?? a.line?.unit_text
498:         const qtyMin = INTEGER_UNITS.has(unitCode ?? '') ? 1 : 0.01
499:         const safeMax = Math.max(qtyMin, maxQty)
500:         const clamped = Math.min(Math.max(qtyMin, newQty), safeMax)
501:         return { ...a, quantity_assigned: clamped }
502:       }),
503:     )
504:     setIsDirty(true)
505:   }, [originalAssignments])
506: 
507:   // --- Cambiar nuevas asignaciones (desde LineSelector) ---
508:   const handleNewAssignmentsChange = useCallback((updated: AssignmentInput[]) => {
509:     setNewAssignments(updated)
510:     setIsDirty(true)
511:   }, [])
512: 
513:   // --- Transformar datos a SelectOption ---
514: 
515:   const driverOptions: SelectOption[] = useMemo(
516:     () => drivers.map((d) => ({ value: d.id, label: d.name })),
517:     [drivers],
518:   )
519: 
520:   const vehicleOptions: SelectOption[] = useMemo(
521:     () =>
522:       vehicles.map((v) => ({
523:         value: v.id,
524:         label: `${v.spectrum_code ?? ''} – ${v.description}`.trim(),
525:       })),
526:     [vehicles],
527:   )
528: 
529:   const trailerOptions: SelectOption[] = useMemo(
530:     () =>
531:       trailers.map((t) => ({
532:         value: t.id,
533:         label: `${t.spectrum_code ?? ''} – ${t.description}`.trim(),
534:       })),
535:     [trailers],
536:   )
537: 
538:   const rateOptions: SelectOption[] = useMemo(
539:     () =>
540:       rates.map((r) => ({
541:         value: r.id,
542:         label: `${r.code} — ${r.description}`,
543:         sublabel: formatCurrency(r.rate),
544:         amount: r.rate,
545:       })),
546:     [rates],
547:   )
548: 
549:   // IDs de las lineas ya asignadas (para filtrar del LineSelector)
550:   const existingLineIds = useMemo(
551:     () => new Set(existingAssignments.map((a) => a.request_line_id)),
552:     [existingAssignments],
553:   )
554: 
555:   // Backlog disponible = lineas no asignadas al viaje + lineas recién removidas del viaje
556:   const availableBacklog = useMemo(() => {
557:     const fromBacklog = backlog.filter((l) => !existingLineIds.has(l.id))
558:     // removedLines tiene prioridad (qty_scheduled ajustada por la cantidad liberada)
559:     const removedIds = new Set(removedLines.map((l) => l.id))
560:     const deduped = fromBacklog.filter((l) => !removedIds.has(l.id))
561:     return [...deduped, ...removedLines.filter((l) => !existingLineIds.has(l.id))]
562:   }, [backlog, existingLineIds, removedLines])
563: 
564:   // --- Guardar cambios ---
565:   const handleSave = guard(async () => {
566:     if (!trip) return
567:     // Validar remolque para cabezal
568:     if (isCabezal && !tripData.trailer_id) {
569:       return // El TripForm ya muestra el warning visual; no avanzar
570:     }
571:     // Validar que ninguna cantidad exceda su max (safety net)
572:     for (const a of existingAssignments) {
573:       if (!a.line?.quantity) continue
574:       const origQty = originalAssignments.get(a.id) ?? a.quantity_assigned
575:       const maxQty = a.line.quantity - (a.line.qty_delivered ?? 0) - (a.line.qty_scheduled ?? 0) + origQty
576:       const unitCode = a.line?.unit?.code ?? a.line?.unit_text
577:       const qtyMin = INTEGER_UNITS.has(unitCode ?? '') ? 1 : 0.01
578:       if (a.quantity_assigned > maxQty || a.quantity_assigned < qtyMin) return
579:     }
580:     // Calcular asignaciones existentes con cantidad modificada
581:     const modified: ModifiedAssignment[] = existingAssignments
582:       .filter((a) => {
583:         const orig = originalAssignments.get(a.id)
584:         return orig !== undefined && orig !== a.quantity_assigned
585:       })
586:       .map((a) => ({
587:         id: a.id,
588:         request_line_id: a.request_line_id,
589:         quantity_assigned: a.quantity_assigned,
590:         original_quantity: originalAssignments.get(a.id) ?? a.quantity_assigned,
591:       }))
592: 
593:     const originalDate = trip.scheduled_date
594:     const success = await updateTrip(trip.id, tripData, newAssignments, removedAssignmentIds, person?.id, modified)
595:     if (success) {
596:       // Detectar cambios significativos para notificación
597:       const changes: string[] = []
598:       if (originalDate !== tripData.scheduled_date)
599:         changes.push(`Fecha: ${originalDate} → ${tripData.scheduled_date}`)
600:       if (removedAssignmentIds.length > 0)
601:         changes.push(`${removedAssignmentIds.length} línea(s) removida(s)`)
602:       if (newAssignments.length > 0)
603:         changes.push(`${newAssignments.length} línea(s) agregada(s)`)
604:       if (modified.length > 0)
605:         changes.push('Cantidades ajustadas')
606:       if (trip.vehicle_id !== tripData.vehicle_id)
607:         changes.push('Vehículo cambiado')
608:       if (trip.trailer_id !== tripData.trailer_id)
609:         changes.push('Remolque cambiado')
610:       if (changes.length > 0) {
611:         notifyViajeEditado(trip.id, changes).catch(console.error)
612:       }
613:       // Refrescar backlog y datos del viaje
614:       refetchBacklog()
615:       const updated = await fetchTrip(id)
616:       if (updated) {
617:         setTrip(updated)
618:         setTripData(tripToInput(updated))
619:         setExistingAssignments(updated.assignments)
620:         setOriginalAssignments(new Map(updated.assignments.map((a: TripAssignment) => [a.id, a.quantity_assigned])))
621:         setNewAssignments([])
622:         setRemovedAssignmentIds([])
623:         setRemovedLines([])
624:         setIsDirty(false)
625:       }
626:     }
627:   })
