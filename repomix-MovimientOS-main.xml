277: export function useSolicitudes(initialFilter?: Partial<SolicitudesFilter>) {
278:   const supabase = useMemo(() => createClient(), [])
279: 
280:   // Estado de lista
281:   const [solicitudes, setSolicitudes] = useState<SolicitudWithRelations[]>([])
282:   const [filters, setFiltersState] = useState<SolicitudesFilter>({
283:     ...DEFAULT_FILTER,
284:     ...initialFilter,
285:   })
286:   const [listLoading, setListLoading] = useState(false)
287:   const [listError, setListError] = useState<string | null>(null)
288:   const [totalCount, setTotalCount] = useState(0)
289: 
290:   // Estado de mutaciones
291:   const [saving, setSaving] = useState(false)
292:   const [saveError, setSaveError] = useState<string | null>(null)
293:   const busyRef = useRef(false)
294: 
295:   // --- Actualizar filtros parcialmente ---
296:   const setFilters = useCallback((updates: Partial<SolicitudesFilter>) => {
297:     setFiltersState((prev) => ({ ...prev, ...updates }))
298:   }, [])
299: 
300:   // --- Fetch lista ---
301:   const refetchList = useCallback(async () => {
302:     setListLoading(true)
303:     setListError(null)
304: 
305:     try {
306:       // J4-B: sort server-side. Default: date_required asc si no hay explícito.
307:       const sortCol = filters.sortColumn ?? 'date_required'
308:       const sortAsc = filters.sortDirection !== 'desc'
309:       let query = supabase
310:         .from('sm_requests')
311:         .select(`
312:           *,
313:           project:projects!sm_requests_project_id_fkey(id, code, name),
314:           requester:people!sm_requests_requester_id_fkey(id, name),
315:           lines:sm_request_lines(id, status, line_type, description, quantity, notes, from_text, to_text, unit_text, from_location:locations!sm_request_lines_from_location_id_fkey(name), to_location:locations!sm_request_lines_to_location_id_fkey(name), unit:units(code))
316:         `, { count: 'exact' })
317:         .order(sortCol, { ascending: sortAsc })
318: 
319:       // Aplicar filtros dinamicamente
320:       if (filters.projectId) {
321:         query = query.eq('project_id', filters.projectId)
322:       }
323:       if (filters.statuses.length > 0) {
324:         query = query.in('status', filters.statuses)
325:       }
326:       // Prioridad se filtra client-side (calculatePriority viva vs BD stale)
327:       if (filters.dateFrom) {
328:         query = query.gte('date_required', filters.dateFrom)
329:       }
330:       if (filters.dateTo) {
331:         query = query.lte('date_required', filters.dateTo)
332:       }
333:       // J4-A: día único del click calendario. Solo aplica a la tabla.
334:       if (filters.singleDay) {
335:         query = query.eq('date_required', filters.singleDay)
336:       }
337:       if (filters.search) {
338:         query = query.ilike('request_id', `%${filters.search}%`)
339:       }
340:       if (filters.requesterId) {
341:         query = query.eq('requester_id', filters.requesterId)
342:       }
343: 
344:       // Paginación server-side
345:       const from = filters.page * filters.pageSize
346:       const to = from + filters.pageSize - 1
347:       query = query.range(from, to)
348: 
349:       const { data, error, count } = await query
350: 
351:       if (error) {
352:         setListError(error.message)
353:         return
354:       }
355: 
356:       // Mapear la respuesta al tipo esperado
357:       const mapped: SolicitudWithRelations[] = (data ?? []).map((row) => {
358:         // Supabase devuelve el join como objeto o array segun cardinalidad
359:         const project = Array.isArray(row.project) ? row.project[0] : row.project
360:         const requester = Array.isArray(row.requester) ? row.requester[0] : row.requester
361:         const lines = Array.isArray(row.lines) ? row.lines : []
362: 
363:         return {
364:           id: row.id,
365:           request_id: row.request_id,
366:           project_id: row.project_id,
367:           requester_id: row.requester_id,
368:           approved_by: row.approved_by,
369:           date_required: row.date_required,
370:           date_created: row.date_created,
371:           date_submitted: row.date_submitted ?? null,
372:           date_completed: row.date_completed ?? null,
373:           date_cancelled: row.date_cancelled ?? null,
374:           status: row.status,
375:           priority: row.priority,
376:           notes: row.notes,
377:           attachments: row.attachments,
378:           created_at: row.created_at,
379:           updated_at: row.updated_at,
380:           project: project as SolicitudWithRelations['project'],
381:           requester: requester as SolicitudWithRelations['requester'],
382:           // Para la lista, las lineas solo traen id y status (sin relaciones completas)
383:           lines: lines as unknown as LineWithRelations[],
384:         }
385:       })
386: 
387:       setTotalCount(count ?? 0)
388:       setSolicitudes(mapped)
389:     } catch (err) {
390:       const message = err instanceof Error ? err.message : 'Error al cargar solicitudes'
391:       setListError(message)
392:     } finally {
393:       setListLoading(false)
394:     }
395:   }, [supabase, filters])
396: 
397:   // Auto-fetch cuando cambian los filtros
398:   useEffect(() => {
399:     void refetchList()
400:   }, [refetchList])
401: 
402:   // --- Fetch detalle de una solicitud ---
403:   const fetchSolicitud = useCallback(
404:     async (id: string): Promise<SolicitudWithRelations | null> => {
405:       const { data, error } = await supabase
406:         .from('sm_requests')
407:         .select(`
408:           *,
409:           project:projects!sm_requests_project_id_fkey(id, code, name),
410:           requester:people!sm_requests_requester_id_fkey(id, name),
411:           lines:sm_request_lines(
412:             *,
413:             equipment:equipment!sm_request_lines_equipment_id_fkey(id, spectrum_code, description),
414:             from_location:locations!sm_request_lines_from_location_id_fkey(id, name),
415:             to_location:locations!sm_request_lines_to_location_id_fkey(id, name),
416:             unit:units!sm_request_lines_unit_id_fkey(id, code, description),
417:             cost_code:cost_codes!sm_request_lines_cost_code_id_fkey(id, phase_code, phase_description, full_code),
418:             cost_category:cost_categories!sm_request_lines_cost_category_id_fkey(id, code, description)
419:           )
420:         `)
421:         .eq('id', id)
422:         .single()
423: 
424:       if (error || !data) {
425:         return null
426:       }
427: 
428:       const project = Array.isArray(data.project) ? data.project[0] : data.project
429:       const requester = Array.isArray(data.requester) ? data.requester[0] : data.requester
430:       const rawLines = Array.isArray(data.lines) ? data.lines : []
431: 
432:       // Ordenar lineas por line_number
433:       const sortedLines = [...rawLines].sort(
434:         (a, b) => (a as { line_number: number }).line_number - (b as { line_number: number }).line_number,
435:       )
436: 
437:       // Mapear lineas con sus relaciones
438:       const lines: LineWithRelations[] = sortedLines.map((rawLine) => {
439:         const line = rawLine as Record<string, unknown>
440:         const eq = line.equipment as LineWithRelations['equipment']
441:         const fromLoc = line.from_location as LineWithRelations['from_location']
442:         const toLoc = line.to_location as LineWithRelations['to_location']
443:         const unit = line.unit as LineWithRelations['unit']
444:         const costCode = line.cost_code as LineWithRelations['cost_code']
445:         const costCategory = line.cost_category as LineWithRelations['cost_category']
446: 
447:         return {
448:           id: line.id as string,
449:           request_id: line.request_id as string,
450:           line_number: line.line_number as number,
451:           line_type: line.line_type as string,
452:           equipment_id: (line.equipment_id as string | null) ?? null,
453:           description: line.description as string,
454:           equipment_text: (line.equipment_text as string | null) ?? null,
455:           from_location_id: (line.from_location_id as string | null) ?? null,
456:           from_text: (line.from_text as string | null) ?? null,
457:           to_location_id: (line.to_location_id as string | null) ?? null,
458:           to_text: (line.to_text as string | null) ?? null,
459:           quantity: line.quantity as number,
460:           unit_id: (line.unit_id as string | null) ?? null,
461:           unit_text: (line.unit_text as string | null) ?? null,
462:           cost_code_id: (line.cost_code_id as string | null) ?? null,
463:           cost_category_id: (line.cost_category_id as string | null) ?? null,
464:           category: (line.category as string | null) ?? null,
465:           material_category: (line.material_category as string | null) ?? null,
466:           po_reference: (line.po_reference as string | null) ?? null,
467:           notes: (line.notes as string | null) ?? null,
468:           status: line.status as string,
469:           qty_scheduled: (line.qty_scheduled as number | null) ?? null,
470:           qty_delivered: (line.qty_delivered as number | null) ?? null,
471:           created_at: line.created_at as string,
472:           updated_at: line.updated_at as string,
473:           equipment: eq ? (Array.isArray(eq) ? eq[0] : eq) : null,
474:           from_location: fromLoc ? (Array.isArray(fromLoc) ? fromLoc[0] : fromLoc) : null,
475:           to_location: toLoc ? (Array.isArray(toLoc) ? toLoc[0] : toLoc) : null,
476:           unit: unit ? (Array.isArray(unit) ? unit[0] : unit) : null,
477:           cost_code: costCode ? (Array.isArray(costCode) ? costCode[0] : costCode) : null,
478:           cost_category: costCategory ? (Array.isArray(costCategory) ? costCategory[0] : costCategory) : null,
479:         }
480:       })
481: 
482:       return {
483:         id: data.id,
484:         request_id: data.request_id,
485:         project_id: data.project_id,
486:         requester_id: data.requester_id,
487:         approved_by: data.approved_by,
488:         date_required: data.date_required,
489:         date_created: data.date_created,
490:         date_submitted: data.date_submitted,
491:         date_completed: data.date_completed,
492:         date_cancelled: data.date_cancelled,
493:         status: data.status,
494:         priority: data.priority,
495:         notes: data.notes,
496:         attachments: data.attachments,
497:         created_at: data.created_at,
498:         updated_at: data.updated_at,
499:         project: project as SolicitudWithRelations['project'],
500:         requester: requester as SolicitudWithRelations['requester'],
501:         lines,
502:       }
503:     },
504:     [supabase],
505:   )
506: 
507:   // --- Crear solicitud nueva ---
508:   const saveSolicitud = useCallback(
509:     async (
510:       header: SolicitudInput,
511:       lines: LineInput[],
512:       _deletedLineIds: string[],
513:       status: 'Borrador' | 'Enviada',
514:       personId?: string,
515:     ): Promise<{ id: string; requestId: string } | null> => {
516:       if (busyRef.current) return null
517:       busyRef.current = true
518:       setSaving(true)
519:       setSaveError(null)
520: 
521:       try {
522:         const headerPayload = {
523:           project_id: header.project_id,
524:           requester_id: header.requester_id,
525:           approved_by: header.approved_by ?? null,
526:           date_required: header.date_required,
527:           notes: header.notes ?? null,
528:           attachments: JSON.parse(JSON.stringify(header.attachments ?? [])),
529:           status,
530:           created_by: personId ?? null,
531:         }
532: 
533:         // 1. Insertar el header
534:         let { data: insertedRequest, error: headerError } = await supabase
535:           .from('sm_requests')
536:           .insert(headerPayload)
537:           .select('id, request_id')
538:           .single()
539: 
540:         // Fallback: si falla trigger por ON CONFLICT, reintentar enviando request_id manual.
541:         if ((headerError || !insertedRequest) && isSequenceConflictError(headerError?.message)) {
542:           const fallbackRequestId = await generateRequestIdFallback(supabase, header.project_id)
543: 
544:           if (fallbackRequestId) {
545:             const retry = await supabase
546:               .from('sm_requests')
547:               .insert({
548:                 ...headerPayload,
549:                 request_id: fallbackRequestId,
550:               })
551:               .select('id, request_id')
552:               .single()
553: 
554:             insertedRequest = retry.data
555:             headerError = retry.error
556:           }
557:         }
558: 
559:         if (headerError || !insertedRequest) {
560:           setSaveError(headerError?.message ?? 'Error al crear la solicitud')
561:           return null
562:         }
563: 
564:         const newId = insertedRequest.id
565: 
566:         // 2. Insertar lineas
567:         if (lines.length > 0) {
568:           const lineRows = lines.map((line, index) =>
569:             lineInputToRow(line, newId, index + 1),
570:           )
571: 
572:           const { error: linesError } = await supabase
573:             .from('sm_request_lines')
574:             .insert(lineRows)
575: 
576:           if (linesError) {
577:             setSaveError(`Solicitud creada pero error al guardar líneas: ${linesError.message}`)
578:             return null
579:           }
580:         }
581: 
582:         // 3. Crear sugerencias para valores de fallback
583:         await createSuggestions(supabase, lines, header.requester_id)
584: 
585:         // 4. Re-fetch para obtener el request_id auto-generado por trigger
586:         const { data: refreshed } = await supabase
587:           .from('sm_requests')
588:           .select('request_id')
589:           .eq('id', newId)
590:           .single()
591: 
592:         // Notificar si se envió directamente (status = Enviada)
593:         if (status === 'Enviada') {
594:           notifySolicitudEnviada(newId).catch(console.error)
595:           notifySolicitudUrgenteNueva(newId).catch(console.error)
596:         }
597: 
598:         return {
599:           id: newId,
600:           requestId: refreshed?.request_id ?? '',
601:         }
602:       } catch (err) {
603:         busyRef.current = false
604:         const message = err instanceof Error ? err.message : 'Error inesperado al guardar'
605:         setSaveError(message)
606:         return null
607:       } finally {
608:         setSaving(false)
609:       }
610:     },
611:     [supabase],
612:   )
613: 
614:   // --- Actualizar solicitud existente ---
615:   const updateSolicitud = useCallback(
616:     async (
617:       id: string,
618:       header: Partial<SolicitudInput>,
619:       lines: LineInput[],
620:       deletedLineIds: string[],
621:       personId?: string,
622:     ): Promise<boolean> => {
623:       if (busyRef.current) return false
624:       busyRef.current = true
625:       setSaving(true)
626:       setSaveError(null)
627: 
628:       try {
629:         // 1. Actualizar header
630:         const headerUpdate: Record<string, unknown> = {}
631:         if (header.project_id !== undefined) headerUpdate.project_id = header.project_id
632:         if (header.requester_id !== undefined) headerUpdate.requester_id = header.requester_id
633:         if (header.approved_by !== undefined) headerUpdate.approved_by = header.approved_by
634:         if (header.date_required !== undefined) headerUpdate.date_required = header.date_required
635:         if (header.notes !== undefined) headerUpdate.notes = header.notes
636:         if (header.attachments !== undefined) headerUpdate.attachments = header.attachments
637:         if (personId) headerUpdate.updated_by = personId
638: 
639:         if (Object.keys(headerUpdate).length > 0) {
640:           const { error: headerError } = await supabase
641:             .from('sm_requests')
642:             .update(headerUpdate)
643:             .eq('id', id)
644: 
645:           if (headerError) {
646:             setSaveError(headerError.message)
647:             return false
648:           }
649:         }
650: 
651:         // 2. Eliminar lineas marcadas para eliminacion
652:         for (const lineId of deletedLineIds) {
653:           // Primero eliminar asignaciones de viaje (si existen)
654:           await supabase
655:             .from('trip_line_assignments')
656:             .delete()
657:             .eq('request_line_id', lineId)
658: 
659:           // Luego eliminar la linea
660:           const { error: deleteError } = await supabase
661:             .from('sm_request_lines')
662:             .delete()
663:             .eq('id', lineId)
664: 
665:           if (deleteError) {
666:             setSaveError(`Error al eliminar línea: ${deleteError.message}`)
667:             return false
668:           }
669:         }
670: 
671:         // 3. Calcular el proximo line_number para lineas nuevas
672:         const { data: existingLines } = await supabase
673:           .from('sm_request_lines')
674:           .select('line_number')
675:           .eq('request_id', id)
676:           .order('line_number', { ascending: false })
677:           .limit(1)
678: 
679:         let nextLineNumber = (existingLines?.[0]?.line_number ?? 0) + 1
680: 
681:         // 4. Actualizar lineas existentes e insertar nuevas
682:         for (const line of lines) {
683:           if (line.id) {
684:             // Linea existente: actualizar
685:             const lineUpdate: Record<string, unknown> = {
686:                 line_type: line.line_type,
687:                 equipment_id: line.equipment_id,
688:                 equipment_text: line.equipment_text,
689:                 description: line.description,
690:                 from_location_id: line.from_location_id,
691:                 from_text: line.from_text,
692:                 to_location_id: line.to_location_id,
693:                 to_text: line.to_text,
694:                 quantity: line.quantity,
695:                 unit_id: line.unit_id,
696:                 unit_text: line.unit_text,
697:                 cost_code_id: line.cost_code_id,
698:                 cost_category_id: line.cost_category_id,
699:                 category: line.category,
700:                 material_category: line.material_category,
701:                 po_reference: line.po_reference,
702:                 notes: line.notes,
703:               }
704:             if (personId) lineUpdate.updated_by = personId
705: 
706:             const { error: updateError } = await supabase
707:               .from('sm_request_lines')
708:               .update(lineUpdate)
709:               .eq('id', line.id)
710: 
711:             if (updateError) {
712:               setSaveError(`Error al actualizar línea: ${updateError.message}`)
713:               return false
714:             }
715:           } else {
716:             // Linea nueva: insertar (solo permitido en Borrador)
717:             const { error: insertError } = await supabase
718:               .from('sm_request_lines')
719:               .insert(lineInputToRow(line, id, nextLineNumber))
720: 
721:             if (insertError) {
722:               setSaveError(`Error al agregar línea: ${insertError.message}`)
723:               return false
724:             }
725:             nextLineNumber++
726:           }
727:         }
728: 
729:         // 5. Crear sugerencias para valores de fallback de lineas nuevas
730:         const newLines = lines.filter((l) => !l.id)
731:         if (newLines.length > 0) {
732:           const requesterId = header.requester_id
733:           if (requesterId) {
734:             await createSuggestions(supabase, newLines, requesterId)
735:           }
736:         }
737: 
738:         // Notificar edición (action verifica que status sea Enviada/En Proceso)
739:         if (personId) {
740:           notifySolicitudEditada(id, personId).catch(console.error)
741:         }
742: 
743:         return true
744:       } catch (err) {
745:         const message = err instanceof Error ? err.message : 'Error inesperado al actualizar'
746:         setSaveError(message)
747:         return false
748:       } finally {
749:         busyRef.current = false
750:         setSaving(false)
751:       }
752:     },
753:     [supabase],
754:   )
755: 
756:   // --- Cancelar solicitud ---
757:   const cancelSolicitud = useCallback(
758:     async (id: string, personId?: string): Promise<boolean> => {
759:       if (busyRef.current) return false
760:       busyRef.current = true
761:       setSaving(true)
762:       setSaveError(null)
763: 
764:       try {
765:         // 1. Obtener las lineas de la solicitud
766:         const { data: lines, error: fetchError } = await supabase
767:           .from('sm_request_lines')
768:           .select('id, status')
769:           .eq('request_id', id)
770: 
771:         if (fetchError) {
772:           setSaveError(fetchError.message)
773:           return false
774:         }
775: 
776:         // 2. Para lineas Programadas: eliminar asignaciones de viaje
777:         const programmedLines = (lines ?? []).filter((l) => l.status === 'Programada')
778:         for (const line of programmedLines) {
779:           await supabase
780:             .from('trip_line_assignments')
781:             .delete()
782:             .eq('request_line_id', line.id)
783:         }
784: 
785:         // 3. Actualizar todas las lineas Pendiente y Programada a Cancelada
786:         const lineIdsToCancel = (lines ?? [])
787:           .filter((l) => l.status === 'Pendiente' || l.status === 'Programada')
788:           .map((l) => l.id)
789: 
790:         if (lineIdsToCancel.length > 0) {
791:           const { error: cancelLinesError } = await supabase
792:             .from('sm_request_lines')
793:             .update({ status: 'Cancelada' })
794:             .in('id', lineIdsToCancel)
795: 
796:           if (cancelLinesError) {
797:             setSaveError(cancelLinesError.message)
798:             return false
799:           }
800:         }
801: 
802:         // 4. Actualizar el status del header a Cancelada
803:         const { error: cancelError } = await supabase
804:           .from('sm_requests')
805:           .update({ status: 'Cancelada' })
806:           .eq('id', id)
807: 
808:         if (cancelError) {
809:           setSaveError(cancelError.message)
810:           return false
811:         }
812: 
813:         // Notificar cancelación
814:         notifySolicitudCancelada(id, personId).catch(console.error)
815: 
816:         return true
817:       } catch (err) {
818:         const message = err instanceof Error ? err.message : 'Error inesperado al cancelar'
819:         setSaveError(message)
820:         return false
821:       } finally {
822:         busyRef.current = false
823:         setSaving(false)
824:       }
825:     },
826:     [supabase],
827:   )
828: 
829:   return {
830:     // Lista
831:     solicitudes,
832:     totalCount,
833:     filters,
834:     setFilters,
835:     listLoading,
836:     listError,
837:     refetchList,
838: 
839:     // Detalle
840:     fetchSolicitud,
841: 
842:     // Mutaciones
843:     saveSolicitud,
844:     updateSolicitud,
845:     cancelSolicitud,
846: 
847:     saving,
848:     saveError,
849:   }
850: }
