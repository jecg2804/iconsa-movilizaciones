<file path="src/lib/utils/duplicates.ts">
  1: import type { SupabaseClient } from '@supabase/supabase-js'
  2: import type { Database } from '@/lib/types/database'
  3: 
  4: interface DuplicateCheckParams {
  5:   lineType: 'Equipo' | 'Material'
  6:   equipmentId: string | null
  7:   description: string
  8:   fromLocationId: string | null
  9:   toLocationId: string | null
 10:   excludeRequestId?: string
 11: }
 12: 
 13: export interface DuplicateResult {
 14:   requestId: string
 15:   lineNumber: number
 16:   description: string
 17:   status: string
 18:   fromName: string
 19:   toName: string
 20: }
 21: 
 22: /**
 23:  * Busca lineas activas similares en otras solicitudes.
 24:  * Para tipo Equipo: coincidencia exacta por equipment_id.
 25:  * Para tipo Material: coincidencia parcial por descripcion (ILIKE).
 26:  * Opcionalmente filtra por ruta (from/to location).
 27:  * Excluye solicitudes canceladas/completadas y lineas canceladas/entregadas.
 28:  */
 29: export async function checkDuplicateLines(
 30:   supabase: SupabaseClient<Database>,
 31:   params: DuplicateCheckParams,
 32: ): Promise<DuplicateResult[]> {
 33:   const {
 34:     lineType,
 35:     equipmentId,
 36:     description,
 37:     fromLocationId,
 38:     toLocationId,
 39:     excludeRequestId,
 40:   } = params
 41: 
 42:   // Para Equipo necesitamos un equipment_id real para buscar duplicados
 43:   if (lineType === 'Equipo' && !equipmentId) {
 44:     return []
 45:   }
 46: 
 47:   // Para Material necesitamos al menos una descripcion con contenido
 48:   if (lineType === 'Material' && description.trim().length < 3) {
 49:     return []
 50:   }
 51: 
 52:   // Construir query base: lineas con su solicitud padre
 53:   let query = supabase
 54:     .from('sm_request_lines')
 55:     .select(`
 56:       line_number,
 57:       description,
 58:       status,
 59:       equipment_id,
 60:       from_location_id,
 61:       to_location_id,
 62:       request:sm_requests!sm_request_lines_request_id_fkey (
 63:         id,
 64:         request_id,
 65:         status
 66:       )
 67:     `)
 68:     .not('status', 'in', '("Cancelada","Entregada")')
 69: 
 70:   // Filtrar por tipo de coincidencia
 71:   if (lineType === 'Equipo') {
 72:     query = query.eq('equipment_id', equipmentId!)
 73:   } else {
 74:     // Busqueda parcial por descripcion para materiales
 75:     query = query.ilike('description', `%${description.trim()}%`)
 76:   }
 77: 
 78:   // Filtrar por ruta si se proporcionan ubicaciones
 79:   if (fromLocationId) {
 80:     query = query.eq('from_location_id', fromLocationId)
 81:   }
 82:   if (toLocationId) {
 83:     query = query.eq('to_location_id', toLocationId)
 84:   }
 85: 
 86:   const { data: lines, error: linesError } = await query
 87: 
 88:   if (linesError || !lines) {
 89:     return []
 90:   }
 91: 
 92:   // Filtrar: solicitud no cancelada/completada, y excluir solicitud actual
 93:   const activeLine = lines.filter((line) => {
 94:     // El join con sm_requests puede devolver un objeto o un array
 95:     const request = Array.isArray(line.request) ? line.request[0] : line.request
 96:     if (!request) return false
 97:     const reqStatus = (request as { id: string; request_id: string; status: string }).status
 98:     if (reqStatus === 'Cancelada' || reqStatus === 'Completada') return false
 99:     if (excludeRequestId && (request as { id: string }).id === excludeRequestId) return false
100:     return true
101:   })
102: 
103:   if (activeLine.length === 0) {
104:     return []
105:   }
106: 
107:   // Recopilar IDs de ubicaciones unicos para obtener nombres
108:   const locationIds = new Set<string>()
109:   for (const line of activeLine) {
110:     if (line.from_location_id) locationIds.add(line.from_location_id)
111:     if (line.to_location_id) locationIds.add(line.to_location_id)
112:   }
113: 
114:   // Obtener nombres de ubicaciones
115:   const locationMap = new Map<string, string>()
116:   if (locationIds.size > 0) {
117:     const { data: locations } = await supabase
118:       .from('locations')
119:       .select('id, name')
120:       .in('id', Array.from(locationIds))
121: 
122:     if (locations) {
123:       for (const loc of locations) {
124:         locationMap.set(loc.id, loc.name)
125:       }
126:     }
127:   }
128: 
129:   // Construir resultados
130:   const results: DuplicateResult[] = activeLine.map((line) => {
131:     const request = Array.isArray(line.request) ? line.request[0] : line.request
132:     const reqData = request as { id: string; request_id: string; status: string }
133: 
134:     const fromName = line.from_location_id
135:       ? (locationMap.get(line.from_location_id) ?? 'Desconocido')
136:       : 'Sin origen'
137:     const toName = line.to_location_id
138:       ? (locationMap.get(line.to_location_id) ?? 'Desconocido')
139:       : 'Sin destino'
140: 
141:     return {
142:       requestId: reqData.request_id ?? 'Sin ID',
143:       lineNumber: line.line_number,
144:       description: line.description ?? '',
145:       status: line.status,
146:       fromName,
147:       toName,
148:     }
149:   })
150: 
151:   return results
152: }
</file>

<file path="src/lib/utils/format.ts">
  1: import { format, differenceInCalendarDays } from 'date-fns'
  2: import { es } from 'date-fns/locale'
  3: import type { Priority } from './constants'
  4: 
  5: /**
  6:  * Parsea un string de fecha como fecha LOCAL (no UTC).
  7:  * "2026-03-10" → 10 de marzo local (no 9 de marzo por timezone).
  8:  */
  9: function parseLocalDate(date: string | Date): Date {
 10:   if (date instanceof Date) return date
 11:   // Fechas tipo "YYYY-MM-DD" se parsean como UTC por JS.
 12:   // Agregar T00:00:00 fuerza interpretación como hora local.
 13:   if (/^\d{4}-\d{2}-\d{2}$/.test(date)) {
 14:     return new Date(date + 'T00:00:00')
 15:   }
 16:   return new Date(date)
 17: }
 18: 
 19: /**
 20:  * Formatea fecha a dd/MM/yyyy (estilo panameño).
 21:  */
 22: export function formatDate(date: string | Date): string {
 23:   const d = parseLocalDate(date)
 24:   return format(d, 'dd/MM/yyyy', { locale: es })
 25: }
 26: 
 27: /**
 28:  * Formatea fecha y hora a dd/MM/yyyy HH:mm.
 29:  */
 30: export function formatDateTime(date: string | Date): string {
 31:   const d = parseLocalDate(date)
 32:   return format(d, 'dd/MM/yyyy HH:mm', { locale: es })
 33: }
 34: 
 35: /**
 36:  * Formatea monto en Balboas panameños: B/. 2,000.00
 37:  */
 38: export function formatCurrency(amount: number): string {
 39:   return `B/. ${amount.toLocaleString('en-US', {
 40:     minimumFractionDigits: 2,
 41:     maximumFractionDigits: 2,
 42:   })}`
 43: }
 44: 
 45: /** Formatea cantidad: entero si es número entero, 2 decimales si tiene fracción */
 46: export function formatQty(n: number | null | undefined): string {
 47:   if (n == null) return '0'
 48:   return Number.isInteger(n) ? String(n) : n.toFixed(2)
 49: }
 50: 
 51: /**
 52:  * Calcula prioridad basada en la fecha requerida vs hoy.
 53:  * Vencida: fecha ya pasó
 54:  * Urgente: 0-3 días
 55:  * Próxima: 4-7 días
 56:  * Normal: 8+ días
 57:  */
 58: export function calculatePriority(dateRequired: string | Date): Priority {
 59:   const required = parseLocalDate(dateRequired)
 60:   const today = new Date()
 61:   today.setHours(0, 0, 0, 0)
 62: 
 63:   const daysUntil = differenceInCalendarDays(required, today)
 64: 
 65:   if (daysUntil < 0) return 'Vencida'
 66:   if (daysUntil <= 3) return 'Urgente'
 67:   if (daysUntil <= 7) return 'Próxima'
 68:   return 'Normal'
 69: }
 70: 
 71: /**
 72:  * Días hasta la fecha requerida. Negativo = vencido.
 73:  */
 74: export function daysUntilDue(dateRequired: string | Date): number {
 75:   const required = parseLocalDate(dateRequired)
 76:   const today = new Date()
 77:   today.setHours(0, 0, 0, 0)
 78:   return differenceInCalendarDays(required, today)
 79: }
 80: 
 81: /**
 82:  * Formato compacto: "Hoy", "1", "2", "-1", "-2"
 83:  */
 84: export function formatDaysUntilDue(dateRequired: string | Date): string {
 85:   const days = daysUntilDue(dateRequired)
 86:   if (days === 0) return 'Hoy'
 87:   return `${days}`
 88: }
 89: 
 90: /**
 91:  * Color Tailwind según días al vencimiento (misma lógica que prioridad).
 92:  */
 93: export function daysUntilDueColor(days: number): string {
 94:   if (days < 0) return 'text-iconsa-red'
 95:   if (days <= 3) return 'text-iconsa-orange'
 96:   if (days <= 7) return 'text-iconsa-blue'
 97:   return 'text-iconsa-green'
 98: }
 99: 
100: /**
101:  * Delta entre fecha requerida y fecha completada.
102:  * Positivo = completado antes de tiempo. Negativo = tarde.
103:  */
104: export function formatCompletionDelta(
105:   dateRequired: string,
106:   dateCompleted: string
107: ): { text: string; color: string } {
108:   const required = parseLocalDate(dateRequired)
109:   // dateCompleted es TIMESTAMPTZ — convertir a fecha local (no usar parseLocalDate que extrae YYYY-MM-DD del string)
110:   const completedFull = new Date(dateCompleted)
111:   const completed = new Date(completedFull.getFullYear(), completedFull.getMonth(), completedFull.getDate())
112:   const days = differenceInCalendarDays(required, completed)
113:   if (days > 0) return { text: `${days}d antes`, color: 'text-iconsa-green' }
114:   if (days < 0) return { text: `${Math.abs(days)}d tarde`, color: 'text-iconsa-red' }
115:   return { text: 'a tiempo', color: 'text-iconsa-green' }
116: }
</file>

