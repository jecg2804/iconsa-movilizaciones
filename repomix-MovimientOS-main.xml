 91:             )}
 92:           </span>
 93: 
 94:           {/* Codigo de costo */}
 95:           <span className="shrink-0 font-mono text-xs text-iconsa-gray" title={costCode}>
 96:             {costCode}
 97:           </span>
 98: 
 99:           {/* Campos opcionales */}
100:           {line.po_reference && (
101:             <span className="shrink-0 text-xs text-iconsa-gray" title={`OC: ${line.po_reference}`}>
102:               OC: {line.po_reference}
103:             </span>
104:           )}
105:           {!isEquipo && line.material_category && (
106:             <span className="shrink-0 text-xs text-gray-500 bg-gray-100 px-1.5 py-0.5 rounded">
107:               {line.material_category}
108:             </span>
109:           )}
110: 
111:           {/* Badge de estado */}
112:           <div className="ml-auto shrink-0">
113:             <Badge variant="line" label={status} />
114:           </div>
115: 
116:           {/* Acciones */}
117:           {(editable || canDelete || onDuplicate) && (
118:             <div className="flex shrink-0 items-center gap-1">
119:               {editable && (
120:                 <button
121:                   type="button"
122:                   onClick={onEdit}
123:                   className="rounded p-1.5 text-iconsa-gray hover:bg-gray-100 hover:text-iconsa-blue transition-colors"
124:                   title="Editar linea"
125:                 >
126:                   <Pencil className="h-4 w-4" />
127:                 </button>
128:               )}
129:               {onDuplicate && (
130:                 <button
131:                   type="button"
132:                   onClick={onDuplicate}
133:                   className="rounded p-1.5 text-iconsa-gray hover:bg-gray-100 hover:text-iconsa-blue transition-colors"
134:                   title="Duplicar linea"
135:                 >
136:                   <Copy className="h-4 w-4" />
137:                 </button>
138:               )}
139:               {canDelete && (
140:                 <button
141:                   type="button"
142:                   onClick={onDelete}
143:                   className="rounded p-1.5 text-iconsa-gray hover:bg-red-50 hover:text-iconsa-red transition-colors"
144:                   title={isScheduled ? 'Eliminar linea programada' : 'Eliminar linea'}
145:                 >
146:                   <Trash2 className="h-4 w-4" />
147:                 </button>
148:               )}
149:             </div>
150:           )}
151:         </div>
152:         {/* Notas de linea — texto completo, sin truncar */}
153:         {line.notes && (
154:           <div className="mt-1.5 ml-6 text-xs italic text-amber-600">
155:             {line.notes}
156:           </div>
157:         )}
158:       </div>
159: 
160:       {/* Mobile: visible hasta md */}
161:       <div className="flex flex-col gap-2 rounded-lg border border-gray-200 bg-white p-3 md:hidden">
162:         {/* Primera linea: tipo + descripcion + estado */}
163:         <div className="flex items-start justify-between gap-2">
164:           <div className="flex items-center gap-2 min-w-0">
165:             <span className="text-xs font-medium text-iconsa-gray">#{lineNumber}</span>
166:             {isEquipo ? (
167:               <Wrench className="h-4 w-4 shrink-0 text-iconsa-blue" />
168:             ) : (
169:               <Package className="h-4 w-4 shrink-0 text-gold" />
170:             )}
171:             <span className="min-w-0 truncate text-sm font-medium text-gray-900">
172:               {line.description}
173:             </span>
174:           </div>
175:           <Badge variant="line" label={status} />
176:         </div>
177: 
178:         {/* Segunda linea: ruta */}
179:         <div className="flex items-center gap-1.5 text-xs text-iconsa-gray">
180:           <span className="max-w-[130px] truncate">{fromName}</span>
181:           <ArrowRight className="h-3 w-3 shrink-0 text-gray-400" />
182:           <span className="max-w-[130px] truncate">{toName}</span>
183:         </div>
184: 
185:         {/* Campos opcionales */}
186:         {(line.po_reference || (!isEquipo && line.material_category) || line.notes) && (
187:           <div className="flex flex-wrap items-center gap-2 text-xs">
188:             {line.po_reference && (
189:               <span className="text-iconsa-gray">OC: {line.po_reference}</span>
190:             )}
191:             {!isEquipo && line.material_category && (
192:               <span className="text-gray-500 bg-gray-100 px-1.5 py-0.5 rounded">{line.material_category}</span>
193:             )}
194:             {line.notes && (
195:               <span className="text-xs italic text-amber-600">{line.notes}</span>
196:             )}
197:           </div>
198:         )}
199: 
200:         {/* Tercera linea: cantidad, codigo costo, acciones */}
201:         <div className="flex items-center justify-between">
202:           <div className="flex items-center gap-3 text-xs">
203:             <span className="text-gray-700">
204:               {line.quantity} {unitName}
205:               {(line.qty_delivered ?? 0) > 0 && (
206:                 <span className={`ml-1 text-xs ${(line.qty_delivered ?? 0) >= line.quantity ? 'text-iconsa-green' : 'text-orange-600'}`}>
207:                   ({line.qty_delivered}/{line.quantity} entregadas)
208:                 </span>
209:               )}
210:             </span>
211:             {costCode !== '—' && (
212:               <span className="font-mono text-iconsa-gray">{costCode}</span>
213:             )}
214:           </div>
215: 
216:           {(editable || canDelete || onDuplicate) && (
217:             <div className="flex items-center gap-1">
218:               {editable && (
219:                 <button
220:                   type="button"
221:                   onClick={onEdit}
222:                   className="rounded p-1.5 text-iconsa-gray hover:bg-gray-100 hover:text-iconsa-blue transition-colors"
223:                   title="Editar linea"
224:                 >
225:                   <Pencil className="h-3.5 w-3.5" />
226:                 </button>
227:               )}
228:               {onDuplicate && (
229:                 <button
230:                   type="button"
231:                   onClick={onDuplicate}
232:                   className="rounded p-1.5 text-iconsa-gray hover:bg-gray-100 hover:text-iconsa-blue transition-colors"
233:                   title="Duplicar linea"
234:                 >
235:                   <Copy className="h-3.5 w-3.5" />
236:                 </button>
237:               )}
238:               {canDelete && (
239:                 <button
240:                   type="button"
241:                   onClick={onDelete}
242:                   className="rounded p-1.5 text-iconsa-gray hover:bg-red-50 hover:text-iconsa-red transition-colors"
243:                   title={isScheduled ? 'Eliminar linea programada' : 'Eliminar linea'}
244:                 >
245:                   <Trash2 className="h-3.5 w-3.5" />
246:                 </button>
247:               )}
248:             </div>
249:           )}
250:         </div>
251:       </div>
252:     </>
253:   )
254: }
