144:       if (rate) {
145:         setTripData((prev) => ({ ...prev, cost: rate.rate }))
146:       }
147:     },
148:     [rates],
149:   )
150: 
151:   // --- Transformar datos a SelectOption ---
152: 
153:   const driverOptions: SelectOption[] = useMemo(
154:     () => drivers.map((d) => ({ value: d.id, label: d.name })),
155:     [drivers],
156:   )
157: 
158:   const vehicleOptions: SelectOption[] = useMemo(
159:     () =>
160:       vehicles.map((v) => ({
161:         value: v.id,
162:         label: `${v.spectrum_code ?? ''} – ${v.description}`.trim(),
163:       })),
164:     [vehicles],
165:   )
166: 
167:   const trailerOptions: SelectOption[] = useMemo(
168:     () =>
169:       trailers.map((t) => ({
170:         value: t.id,
171:         label: `${t.spectrum_code ?? ''} – ${t.description}`.trim(),
172:       })),
173:     [trailers],
174:   )
175: 
176:   const rateOptions: SelectOption[] = useMemo(
177:     () =>
178:       rates.map((r) => ({
179:         value: r.id,
180:         label: `${r.code} — ${r.description}`,
181:         sublabel: formatCurrency(r.rate),
182:         amount: r.rate,
183:       })),
184:     [rates],
185:   )
186: 
187:   // --- Detectar si el vehículo es cabezal ---
188:   const isCabezal = useMemo(() => {
189:     const v = vehicles.find((v) => v.id === tripData.vehicle_id)
190:     if (!v) return false
191:     return (
192:       (v.spectrum_code?.toUpperCase().startsWith('CAB') ?? false) ||
193:       v.description.toUpperCase().includes('CABEZAL')
194:     )
195:   }, [vehicles, tripData.vehicle_id])
196: 
197:   // --- Validacion ---
198:   const validate = useCallback((): boolean => {
199:     const errors: string[] = []
200:     if (!tripData.scheduled_date) errors.push('Seleccione la fecha programada')
201:     if (!tripData.driver_id) errors.push('Seleccione un conductor')
202:     if (!tripData.vehicle_id) errors.push('Seleccione un vehiculo')
203:     // Remolque requerido para cabezal
204:     if (isCabezal && !tripData.trailer_id) {
205:       errors.push('Remolque requerido para vehículo cabezal')
206:     }
207:     // Tarifa es opcional — no toda movilización tiene tarifa formal
208:     if (assignments.length === 0) errors.push('Seleccione al menos una linea')
209:     setValidationErrors(errors)
210:     return errors.length === 0
211:   }, [tripData, assignments, isCabezal])
212: 
213:   // --- Guardar viaje ---
214:   const handleSave = guard(async () => {
215:     if (!validate()) return
216:     const result = await saveTrip(tripData, assignments, person?.id)
217:     if (result) {
218:       router.push('/programacion')
219:     }
220:   })
221: 
222:   // --- Estado de carga global ---
223:   const isLoading =
224:     authLoading || vehiclesLoading || driversLoading || ratesLoading
225: 
226:   // --- Guard de acceso ---
227:   // PM, campo y almacen no pueden crear viajes
228:   if (!authLoading && (role === 'pm' || role === 'campo' || role === 'almacen')) {
229:     return (
230:       <div className="flex min-h-[50vh] flex-col items-center justify-center gap-4 px-4">
231:         <h1 className="text-xl font-bold text-gray-900">Acceso denegado</h1>
232:         <p className="text-sm text-iconsa-gray">
233:           No tiene permisos para crear movilizaciones.
234:         </p>
235:         <Button variant="secondary" onClick={() => router.push('/programacion')}>
236:           Volver a Programacion
237:         </Button>
238:       </div>
239:     )
240:   }
241: 
242:   // --- Loading ---
243:   if (isLoading) {
244:     return (
245:       <div className="flex min-h-[50vh] items-center justify-center">
246:         <div className="flex flex-col items-center gap-3">
247:           <Loader2 className="h-8 w-8 animate-spin text-navy" />
248:           <p className="text-sm text-iconsa-gray">Cargando formulario...</p>
249:         </div>
250:       </div>
251:     )
252:   }
253: 
254:   return (
255:     <div className="mx-auto max-w-4xl space-y-6 px-4 pb-32 pt-4 sm:px-6 sm:pb-8 sm:pt-6">
256:       {/* Navegacion superior */}
257:       <div className="flex items-center gap-3">
258:         <button
259:           type="button"
260:           onClick={() => router.push('/programacion')}
261:           className="flex items-center gap-1.5 text-sm text-iconsa-gray hover:text-navy transition-colors"
262:         >
263:           <ArrowLeft className="h-4 w-4" />
264:           Programacion
265:         </button>
266:       </div>
267: 
268:       {/* Titulo */}
269:       <h1 className="text-2xl font-bold text-gray-900">Nueva Movilización</h1>
270: 
271:       {/* Error global de guardado */}
272:       {saveError && (
273:         <div className="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800">
274:           {saveError}
275:         </div>
276:       )}
277: 
278:       {/* Errores de validacion */}
279:       {validationErrors.length > 0 && (
280:         <div className="rounded-lg border border-red-300 bg-red-50 px-4 py-3">
281:           <ul className="space-y-1 text-sm text-red-800">
282:             {validationErrors.map((err) => (
283:               <li key={err}>{err}</li>
284:             ))}
285:           </ul>
286:         </div>
287:       )}
288: 
289:       {/* Formulario de cabecera del viaje */}
290:       <div className="rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
291:         <TripForm
292:           mode="create"
293:           drivers={driverOptions}
294:           vehicles={vehicleOptions}
295:           trailers={trailerOptions}
296:           rates={rateOptions}
297:           onChange={setTripData}
298:           onRateChange={handleRateChange}
299:           isTrailerRequired={isCabezal}
300:         />
301:       </div>
302: 
303:       {/* Seccion de lineas del viaje */}
304:       <div className="rounded-lg border border-gray-200 bg-white p-4 shadow-sm sm:p-6">
305:         <div className="mb-4 flex items-center gap-2">
306:           <h2 className="text-lg font-semibold text-gray-900">
307:             Lineas de la Movilización
308:           </h2>
309:           {assignments.length > 0 && (
310:             <span className="rounded-full bg-navy/10 px-2.5 py-0.5 text-xs font-medium text-navy">
311:               {assignments.length}
312:             </span>
313:           )}
314:         </div>
315: 
316:         <LineSelector
317:           backlogLines={backlog}
318:           currentAssignments={assignments}
319:           onChange={setAssignments}
320:           loading={backlogLoading}
321:         />
322:       </div>
323: 
324:       {/* Barra de acciones — sticky en mobile */}
325:       <div className="fixed inset-x-0 bottom-0 z-20 border-t border-gray-200 bg-white px-4 py-3 shadow-lg sm:static sm:inset-auto sm:z-auto sm:mt-6 sm:rounded-lg sm:border sm:shadow-sm sm:px-6 sm:py-4">
326:         <div className="mx-auto flex max-w-4xl items-center justify-between gap-3 sm:justify-end">
327:           <Button
328:             variant="ghost"
329:             onClick={() => router.push('/programacion')}
330:             disabled={saving}
331:           >
332:             Cancelar
333:           </Button>
334:           <Button
335:             variant="primary"
336:             onClick={handleSave}
337:             loading={saving}
338:             disabled={saving || assignments.length === 0}
339:           >
340:             Guardar Movilización
341:           </Button>
342:         </div>
343:       </div>
344:     </div>
345:   )
346: }
