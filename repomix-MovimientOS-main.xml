629:   // --- Cancelar viaje ---
630:   const handleCancelTrip = guard(async () => {
631:     if (!trip) return
632:     const success = await cancelTrip(trip.id)
633:     if (success) {
634:       router.push('/programacion')
635:     }
636:   })
