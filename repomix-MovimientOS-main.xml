 521:                     <span style={{fontSize:"12px",fontWeight:600}}>{l.desc}</span>
 522:                     <Badge sm color={C.purple}>Programada</Badge>
 523:                   </div>
 524:                   <div style={{fontSize:"10px",color:C.sub,marginTop:"2px"}}>
 525:                     <span style={{fontFamily:"monospace",fontWeight:600}}>{l.smId}</span> · {l.smProyNom} · {l.cant} {l.und} · {l.desde} → {l.hasta}
