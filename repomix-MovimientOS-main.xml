192: );
193: 
194: CREATE TABLE cost_code_categories (
195:   id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
196:   cost_code_id uuid NOT NULL REFERENCES cost_codes(id) ON DELETE CASCADE,
197:   cost_category_id uuid NOT NULL REFERENCES cost_categories(id) ON DELETE CASCADE,
198:   created_at timestamptz DEFAULT now(),
199:   UNIQUE(cost_code_id, cost_category_id)
200: );
201: 
202: CREATE TABLE sequences (
203:   id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
204:   seq_type text NOT NULL, project_id uuid REFERENCES projects(id),
205:   next_number integer NOT NULL DEFAULT 1
206: );
207: CREATE UNIQUE INDEX idx_sequences_unique ON sequences (seq_type, COALESCE(project_id, '00000000-0000-0000-0000-000000000000'::uuid));
208: 
209: CREATE TABLE suggestions (
210:   id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
211:   table_name text NOT NULL, suggested_value text NOT NULL,
212:   suggested_by uuid REFERENCES people(id),
213:   status text DEFAULT 'pendiente', reviewed_by uuid REFERENCES people(id),
214:   created_at timestamptz DEFAULT now()
215: );
216: 
217: CREATE TABLE user_app_roles (
218:   id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
219:   person_id uuid NOT NULL REFERENCES people(id),
220:   app_code text NOT NULL, role_code text NOT NULL,
221:   is_active boolean DEFAULT true, granted_by uuid REFERENCES people(id),
222:   granted_at timestamptz DEFAULT now(), notes text,
223:   created_at timestamptz DEFAULT now(), updated_at timestamptz DEFAULT now(),
224:   UNIQUE(person_id, app_code, role_code)
225: );
226: 
227: -- ============================================================
228: -- TABLAS TRANSACCIONALES (5)
229: -- ============================================================
230: 
231: CREATE TABLE sm_requests (
232:   id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
233:   request_id text UNIQUE, project_id uuid NOT NULL REFERENCES projects(id),
234:   requester_id uuid NOT NULL REFERENCES people(id),
235:   date_required date NOT NULL, date_created timestamptz DEFAULT now(),
236:   status text NOT NULL DEFAULT 'Borrador', priority text,
237:   approved_by uuid REFERENCES people(id), notes text,
238:   attachments jsonb DEFAULT '[]'::jsonb,
239:   created_at timestamptz DEFAULT now(), updated_at timestamptz DEFAULT now()
240: );
241: 
242: CREATE TABLE sm_request_lines (
243:   id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
244:   request_id uuid NOT NULL REFERENCES sm_requests(id) ON DELETE CASCADE,
245:   line_number integer NOT NULL,
246:   line_type text NOT NULL CHECK (line_type IN ('Equipo', 'Material')),
247:   equipment_id uuid REFERENCES equipment(id),
248:   description text NOT NULL,
249:   from_location_id uuid REFERENCES locations(id),
250:   to_location_id uuid REFERENCES locations(id),
251:   quantity numeric NOT NULL DEFAULT 1,
252:   unit_id uuid REFERENCES units(id),
253:   cost_code_id uuid REFERENCES cost_codes(id),
254:   cost_category_id uuid REFERENCES cost_categories(id),
255:   category text, -- LEGACY
256:   material_category text, -- texto libre, solo Material
257:   po_reference text, notes text,
258:   status text NOT NULL DEFAULT 'Pendiente',
259:   qty_scheduled numeric DEFAULT 0, qty_delivered numeric DEFAULT 0,
260:   from_text text, to_text text, equipment_text text, unit_text text,
261:   created_at timestamptz DEFAULT now(), updated_at timestamptz DEFAULT now()
262: );
263: 
264: CREATE TABLE trips (
265:   id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
266:   trip_id text UNIQUE, scheduled_date date NOT NULL,
267:   driver_id uuid REFERENCES people(id),
268:   vehicle_id uuid REFERENCES equipment(id),
269:   trailer_id uuid REFERENCES equipment(id),
270:   rate_id uuid REFERENCES mobilization_rates(id),
271:   cost numeric, att_permit boolean DEFAULT false, escort boolean DEFAULT false,
272:   confirmation_code text, -- auto by trigger if NULL
273:   notes text, status text NOT NULL DEFAULT 'Programado',
274:   actual_departure timestamptz, actual_arrival timestamptz,
275:   route_summary text, is_external boolean DEFAULT false,
276:   created_at timestamptz DEFAULT now(), updated_at timestamptz DEFAULT now()
277: );
278: 
279: CREATE TABLE trip_line_assignments (
280:   id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
281:   trip_id uuid NOT NULL REFERENCES trips(id) ON DELETE CASCADE,
282:   request_line_id uuid NOT NULL REFERENCES sm_request_lines(id),
283:   quantity_assigned numeric NOT NULL,
284:   created_at timestamptz DEFAULT now(), updated_at timestamptz DEFAULT now(),
285:   UNIQUE(trip_id, request_line_id)
286: );
287: 
288: CREATE TABLE trip_events (
289:   id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
290:   trip_id uuid NOT NULL REFERENCES trips(id),
291:   event_type text NOT NULL, event_timestamp timestamptz DEFAULT now(),
292:   location text, registered_by uuid REFERENCES people(id),
293:   confirmation_code_used text,
294:   received_by_id uuid REFERENCES people(id), -- receptor vinculado a people
295:   received_by_name text, -- denormalizacion + fallback
296:   notes text,
297:   created_at timestamptz DEFAULT now()
298:   -- NO updated_at — eventos INMUTABLES
299: );
300: CREATE INDEX idx_trip_events_received_by ON trip_events(received_by_id);
301: 
