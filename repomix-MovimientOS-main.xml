 21: function formatDate(dateStr: string): string {
 22:   const d = new Date(dateStr + 'T12:00:00')
 23:   return d.toLocaleDateString('es-PA', { day: '2-digit', month: 'short', year: 'numeric' })
 24: }
 25: 
 26: function daysUntil(dateStr: string): number {
 27:   const today = new Date()
 28:   today.setHours(0, 0, 0, 0)
 29:   const target = new Date(dateStr + 'T12:00:00')
 30:   target.setHours(0, 0, 0, 0)
 31:   return Math.ceil((target.getTime() - today.getTime()) / (1000 * 60 * 60 * 24))
 32: }
