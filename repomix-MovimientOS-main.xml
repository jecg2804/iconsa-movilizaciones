 786:         //    confirmation_code se genera aquí (4 dígitos random).
 787:         const confirmationCode = Math.floor(Math.random() * 10000).toString().padStart(4, '0')
 788:         const { data: insertedTrip, error: tripError } = await supabase
 789:           .from('trips')
