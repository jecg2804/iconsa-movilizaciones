 626:   // --- NOTIFICACIONES ---
 627:   function NotificacionesTab() {
 628:     const filtered = notifPeople.filter((p) =>
 629:       !search || p.name.toLowerCase().includes(search.toLowerCase()) || (p.email ?? '').toLowerCase().includes(search.toLowerCase()),
 630:     )
 631: 
 632:     const toggleEnabled = async (personId: string, currentValue: boolean) => {
 633:       const newValue = !currentValue
 634:       setNotifPeople(prev => prev.map(p => p.id === personId ? { ...p, notifications_enabled: newValue } : p))
 635:       await supabase.from('people').update({ notifications_enabled: newValue }).eq('id', personId)
 636:     }
 637: 
 638:     const togglePref = async (personId: string, key: string, currentPrefs: Record<string, boolean> | null) => {
 639:       const prefs = { ...(currentPrefs ?? {}) }
 640:       prefs[key] = !prefs[key]
 641:       setNotifPeople(prev => prev.map(p => p.id === personId ? { ...p, notification_preferences: prefs } : p))
 642:       await supabase.from('people').update({ notification_preferences: prefs }).eq('id', personId)
 643:     }
 644: 
 645:     if (loadingData) {
 646:       return <div className="py-8 text-center text-gray-500">Cargando...</div>
 647:     }
 648: 
 649:     return (
 650:       <div className="overflow-x-auto rounded-lg border border-gray-200">
 651:         <table className="min-w-full text-sm">
 652:           <thead>
 653:             <tr className="border-b bg-gray-50 text-left text-xs font-medium uppercase tracking-wider text-gray-500">
 654:               <th className="sticky left-0 z-10 bg-gray-50 px-3 py-2">Persona</th>
 655:               <th className="px-2 py-2 text-center" title="Master toggle">Activo</th>
 656:               <th className="px-2 py-2 text-center" title="Recibe todas las notificaciones">Todo</th>
 657:               {NOTIF_EVENT_KEYS.map(e => (
 658:                 <th key={e.key} className="px-1.5 py-2 text-center whitespace-nowrap" title={e.key}>{e.label}</th>
 659:               ))}
 660:             </tr>
 661:           </thead>
 662:           <tbody className="divide-y divide-gray-100">
 663:             {filtered.map(person => {
 664:               const prefs = person.notification_preferences ?? {}
 665:               const isDisabled = !person.notifications_enabled
 666:               const isReceiveAll = !!prefs.receive_all
 667: 
 668:               return (
 669:                 <tr key={person.id} className={isDisabled ? 'bg-gray-50 opacity-60' : ''}>
 670:                   <td className="sticky left-0 z-10 bg-white px-3 py-2">
 671:                     <div className="flex flex-col">
 672:                       <span className="font-medium text-gray-900">{person.name}</span>
 673:                       <span className="text-xs text-gray-500">
 674:                         {person.email}
 675:                         {person.app_role && (
 676:                           <span className="ml-1.5 inline-block rounded bg-purple-100 px-1.5 py-0.5 text-[10px] font-medium text-purple-700">
 677:                             {person.app_role}
 678:                           </span>
 679:                         )}
 680:                       </span>
 681:                     </div>
 682:                   </td>
 683:                   <td className="px-2 py-2 text-center">
 684:                     <input
 685:                       type="checkbox"
 686:                       checked={person.notifications_enabled}
 687:                       onChange={() => toggleEnabled(person.id, person.notifications_enabled)}
 688:                       title={`Notificaciones ${person.notifications_enabled ? 'activas' : 'desactivadas'} para ${person.name}`}
 689:                       className="h-4 w-4 rounded border-gray-300 text-iconsa-blue focus:ring-iconsa-blue"
 690:                     />
 691:                   </td>
 692:                   <td className="px-2 py-2 text-center">
 693:                     <input
 694:                       type="checkbox"
 695:                       checked={isReceiveAll}
 696:                       disabled={isDisabled}
 697:                       onChange={() => togglePref(person.id, 'receive_all', prefs)}
 698:                       title={`Recibir todas las notificaciones — ${person.name}`}
 699:                       className="h-4 w-4 rounded border-gray-300 text-iconsa-blue focus:ring-iconsa-blue disabled:opacity-40"
 700:                     />
 701:                   </td>
 702:                   {NOTIF_EVENT_KEYS.map(e => (
 703:                     <td key={e.key} className="px-1.5 py-2 text-center">
 704:                       <input
 705:                         type="checkbox"
 706:                         checked={!!prefs[e.key]}
 707:                         disabled={isDisabled || isReceiveAll}
 708:                         onChange={() => togglePref(person.id, e.key, prefs)}
 709:                         title={`${e.label} — ${person.name}`}
 710:                         className="h-4 w-4 rounded border-gray-300 text-iconsa-blue focus:ring-iconsa-blue disabled:opacity-40"
 711:                       />
 712:                     </td>
 713:                   ))}
 714:                 </tr>
 715:               )
 716:             })}
 717:           </tbody>
 718:         </table>
 719:         {filtered.length === 0 && (
 720:           <div className="py-8 text-center text-gray-500">No hay personas con email activo</div>
 721:         )}
 722:       </div>
 723:     )
 724:   }
