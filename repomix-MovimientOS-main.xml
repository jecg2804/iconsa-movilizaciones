 2: import { type NextRequest } from 'next/server'
 3: import { redirect } from 'next/navigation'
 4: import { createClient } from '@/lib/supabase/server'
 5: 
 6: export async function GET(request: NextRequest) {
 7:   const { searchParams } = new URL(request.url)
 8:   const token_hash = searchParams.get('token_hash')
 9:   const type = searchParams.get('type') as EmailOtpType | null
10:   const next = searchParams.get('next')?.startsWith('/') ? searchParams.get('next')! : '/dashboard'
11: 
12:   if (token_hash && type) {
13:     const supabase = await createClient()
14:     const { error } = await supabase.auth.verifyOtp({ type, token_hash })
15:     if (!error) redirect(next)
16:   }
17: 
18:   redirect('/login?error=invalid_token')
19: }
</file>

