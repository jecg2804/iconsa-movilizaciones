286:   const [trip, setTrip] = useState<TripWithRelations | null>(null)
287:   const [pageLoading, setPageLoading] = useState(true)
288: 
289:   // Estado editable
290:   const [tripData, setTripData] = useState<TripInput>({
291:     scheduled_date: '',
292:     scheduled_time: null,
293:     driver_id: null,
294:     vehicle_id: null,
295:     trailer_id: null,
296:     rate_id: null,
297:     cost: null,
298:     att_permit: false,
299:     escort: false,
300:     notes: null,
301:     is_external: false,
302:   })
303: 
304:   // Asignaciones: las originales del viaje + las nuevas seleccionadas
305:   const [existingAssignments, setExistingAssignments] = useState<TripAssignment[]>([])
306:   const [originalAssignments, setOriginalAssignments] = useState<Map<string, number>>(new Map())
307:   const [newAssignments, setNewAssignments] = useState<AssignmentInput[]>([])
308:   const [removedAssignmentIds, setRemovedAssignmentIds] = useState<string[]>([])
309:   const [removedLines, setRemovedLines] = useState<BacklogLine[]>([])
310: 
311:   // Eventos de ejecución
312:   const [tripEvents, setTripEvents] = useState<TripEventRow[]>([])
313: 
314:   // Estado de UI
315:   const [isDirty, setIsDirty] = useState(false)
316:   const [showCancelConfirm, setShowCancelConfirm] = useState(false)
317: 
318:   // Datos adicionales (fetch inline)
319:   const [drivers, setDrivers] = useState<PersonRow[]>([])
320:   const [rates, setRates] = useState<RateRow[]>([])
321:   const [driversLoading, setDriversLoading] = useState(true)
322:   const [ratesLoading, setRatesLoading] = useState(true)
323: 
324:   // --- Cargar viaje ---
325:   useEffect(() => {
326:     async function load() {
327:       setPageLoading(true)
328:       const data = await fetchTrip(id)
329:       if (data) {
330:         setTrip(data)
331:         setTripData(tripToInput(data))
332:         setExistingAssignments(data.assignments)
333:         setOriginalAssignments(new Map(data.assignments.map((a: TripAssignment) => [a.id, a.quantity_assigned])))
334:         setNewAssignments([])
335:         setRemovedAssignmentIds([])
336:         setRemovedLines([])
337:         setIsDirty(false)
338: 
339:         // Fetch eventos de ejecución
340:         const { data: events } = await supabase
341:           .from('trip_events')
342:           .select('event_type, event_timestamp, registered_by:registered_by(name), received_by_name, notes, attachments')
343:           .eq('trip_id', id)
344:           .order('event_timestamp', { ascending: true })
345:         setTripEvents((events as unknown as TripEventRow[]) ?? [])
346:       }
347:       setPageLoading(false)
348:     }
349:     load()
350:     // Solo al montar o cuando cambia el ID
351:     // eslint-disable-next-line react-hooks/exhaustive-deps
352:   }, [id])
353: 
354:   // --- Fetch conductores ---
355:   useEffect(() => {
356:     async function fetchDrivers() {
357:       setDriversLoading(true)
358:       const { data } = await supabase
359:         .from('people')
360:         .select('id, name')
361:         .eq('status', 'Activo')
362:         .eq('app_role', 'campo')
363:         .order('name')
364:       setDrivers(data ?? [])
365:       setDriversLoading(false)
366:     }
367:     fetchDrivers()
