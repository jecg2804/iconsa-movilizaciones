 45:   // Rango: 2 semanas (14 días)
 46:   const dateFrom = format(weekStart, 'yyyy-MM-dd')
 47:   const dateTo = format(addDays(weekStart, 13), 'yyyy-MM-dd')
 48: 
 49:   const fetchTrips = useCallback(async () => {
 50:     setLoading(true)
 51:     const { data } = await supabase
 52:       .from('trips')
 53:       .select(`
 54:         id, trip_id, scheduled_date, status, att_permit, escort,
 55:         driver:driver_id(id, name),
 56:         vehicle:vehicle_id(id, spectrum_code, description),
 57:         assignments:trip_line_assignments(
 58:           line:request_line_id(
 59:             from_location:from_location_id(name),
 60:             to_location:to_location_id(name),
 61:             from_text, to_text
 62:           )
 63:         )
 64:       `)
 65:       .gte('scheduled_date', dateFrom)
 66:       .lte('scheduled_date', dateTo)
 67:       .order('scheduled_date')
 68: 
 69:     setTrips((data as unknown as CalendarTrip[] | null) ?? [])
 70:     setLoading(false)
 71:   }, [supabase, dateFrom, dateTo])
 72: 
 73:   useEffect(() => {
 74:     void fetchTrips()
 75:   }, [fetchTrips])
 76: 
 77:   // Agrupar viajes por fecha
 78:   const tripsByDate = useMemo(() => {
 79:     const map = new Map<string, CalendarTrip[]>()
 80:     for (const trip of trips) {
 81:       const key = trip.scheduled_date
 82:       if (!map.has(key)) map.set(key, [])
 83:       map.get(key)!.push(trip)
 84:     }
 85:     return map
 86:   }, [trips])
 87: 
 88:   // Generar los 14 días
 89:   const days = useMemo(() => {
 90:     const result: Date[] = []
