 561:                   <div style={{marginTop:"6px",borderTop:`1px solid ${C.bdr}`,paddingTop:"6px"}}>
 562:                     <div style={{fontSize:"9px",fontWeight:700,color:C.sub,textTransform:"uppercase",marginBottom:"3px"}}>
 563:                       Carga ({v.asignaciones.length} líneas de {[...new Set(v.asignaciones.map(a=>a.smId))].length} solicitud{[...new Set(v.asignaciones.map(a=>a.smId))].length>1?"es":""}):
 564:                     </div>
 565:                     {v.asignaciones.map((a,j)=>(
 566:                       <div key={j} style={{fontSize:"10px",color:C.sub,display:"flex",gap:"4px",alignItems:"center",padding:"1px 0"}}>
 567:                         <span style={{fontFamily:"monospace",fontSize:"9px",color:C.purple,fontWeight:600}}>{a.smId}·L{a.linea}</span>
 568:                         <span>{a.desc}</span>
 569:                         <span style={{color:C.muted}}>×{a.cant} {a.und}</span>
