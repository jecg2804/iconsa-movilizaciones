 83:               checked={allSelected}
 84:               ref={(el) => {
 85:                 if (el) el.indeterminate = someSelected
 86:               }}
 87:               onChange={(e) => onSelectAll?.(e.target.checked)}
 88:               className="rounded border-gray-300 text-navy focus:ring-navy"
 89:             />
 90:             <span>Seleccionar todo</span>
 91:           </label>
 92:         </div>
