164: /** Usuarios con receive_all: true — reciben TODAS las notificaciones */
165: export async function getReceiveAllUsers(): Promise<{ id: string; email: string | null; name: string }[]> {
166:   const supabase = createServiceClient()
167:   const { data, error } = await supabase
168:     .from('people')
169:     .select('id, email, name')
170:     .eq('status', 'Activo')
171:     .eq('notifications_enabled', true)
172:     .not('email', 'is', null)
173:     .contains('notification_preferences', { receive_all: true })
174:   if (error) console.error('[Notification] getReceiveAllUsers error:', error.message)
175:   return data ?? []
176: }
