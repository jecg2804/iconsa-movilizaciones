269: export default function MisViajesDetailPage() {
270:   const params = useParams()
271:   const id = params.id as string
272:   const router = useRouter()
273:   const supabase = useMemo(() => createClient(), [])
274: 
275:   const { person, role, loading: authLoading } = useAuth()
276:   const { fetchTrip } = useTrips()
277:   const { registerEvent, registering, registerError } = useTripEvents(id)
278: 
279:   // Estado del viaje y eventos
280:   const [trip, setTrip] = useState<TripWithRelations | null>(null)
281:   const [events, setEvents] = useState<TripEvent[]>([])
282:   const [pageLoading, setPageLoading] = useState(true)
283: 
284:   // Estado del modal de registro de evento
285:   const [activeEvent, setActiveEvent] = useState<TripEventType | null>(null)
286: 
287:   // Opciones de receptor para entrega
288:   const [receiverOptions, setReceiverOptions] = useState<Array<{ value: string; label: string }>>([])
289: 
290:   // --- Fetch receptores del proyecto destino ---
291:   const loadReceivers = useCallback(async (tripData: TripWithRelations) => {
292:     // Recopilar to_location_id de las líneas del viaje
293:     const toLocationIds = new Set<string>()
294:     for (const a of tripData.assignments) {
295:       if (a.line?.to_location?.id) {
296:         toLocationIds.add(a.line.to_location.id)
297:       }
298:     }
299: 
300:     if (toLocationIds.size === 0) {
301:       // Sin ubicaciones de destino — mostrar logistica/admin/almacen
302:       const { data: fallbackPeople } = await supabase
303:         .from('people')
304:         .select('id, name')
305:         .in('app_role', ['almacen', 'logistica', 'admin'])
306:         .eq('status', 'Activo')
307:         .order('name')
308:       setReceiverOptions((fallbackPeople ?? []).map((p) => ({ value: p.id, label: p.name })))
309:       return
310:     }
311: 
312:     // Buscar project_id de las ubicaciones destino
313:     const { data: locations } = await supabase
314:       .from('locations')
315:       .select('id, project_id')
316:       .in('id', Array.from(toLocationIds))
317: 
318:     const projectIds = new Set<string>()
319:     let hasNonProjectDest = false
320:     for (const loc of locations ?? []) {
321:       if (loc.project_id) {
322:         projectIds.add(loc.project_id)
323:       } else {
324:         hasNonProjectDest = true
325:       }
326:     }
327: 
328:     const people: Array<{ value: string; label: string }> = []
329: 
330:     // Personas asignadas a proyectos destino
331:     if (projectIds.size > 0) {
332:       const { data: personProjects } = await supabase
333:         .from('person_projects')
334:         .select('person_id, people(id, name)')
335:         .in('project_id', Array.from(projectIds))
336:         .eq('is_active', true)
337: 
338:       const seen = new Set<string>()
339:       for (const pp of personProjects ?? []) {
340:         const person = Array.isArray(pp.people) ? pp.people[0] : pp.people
341:         if (person && !seen.has(person.id)) {
342:           seen.add(person.id)
343:           people.push({ value: person.id, label: person.name })
344:         }
345:       }
346:     }
347: 
348:     // Si destino no tiene proyecto (Chilibre, externo) agregar almacen/logistica/admin
349:     if (hasNonProjectDest || projectIds.size === 0) {
350:       const { data: fallbackPeople } = await supabase
351:         .from('people')
352:         .select('id, name')
353:         .in('app_role', ['almacen', 'logistica', 'admin'])
354:         .eq('status', 'Activo')
355: 
356:       const seen = new Set(people.map((p) => p.value))
357:       for (const p of fallbackPeople ?? []) {
358:         if (!seen.has(p.id)) {
359:           people.push({ value: p.id, label: p.name })
360:         }
361:       }
362:     }
363: 
364:     // Incluir personal operativo (pm, logistica, almacen, admin) que no esté ya en la lista
365:     const { data: operationalPeople } = await supabase
366:       .from('people')
367:       .select('id, name')
368:       .in('app_role', ['pm', 'logistica', 'almacen', 'admin'])
369:       .eq('status', 'Activo')
370:       .order('name')
371: 
372:     const seenAll = new Set(people.map((p) => p.value))
373:     for (const p of operationalPeople ?? []) {
374:       if (!seenAll.has(p.id)) {
375:         seenAll.add(p.id)
376:         people.push({ value: p.id, label: p.name })
377:       }
378:     }
379: 
380:     people.sort((a, b) => a.label.localeCompare(b.label))
381:     setReceiverOptions(people)
382:   }, [supabase])
383: 
384:   // --- Carga de eventos ---
385:   const loadEvents = useCallback(async () => {
386:     const { data } = await supabase
387:       .from('trip_events')
388:       .select(`
389:         id,
390:         event_type,
391:         event_timestamp,
392:         registered_by:registered_by(name),
393:         received_by_name,
394:         notes,
395:         attachments
396:       `)
397:       .eq('trip_id', id)
398:       .order('event_timestamp', { ascending: true })
399: 
400:     if (data) {
401:       const mapped: TripEvent[] = (data as unknown as Record<string, unknown>[]).map((row) => {
402:         const rb = row.registered_by
403:         const registeredBy = Array.isArray(rb) ? (rb[0] ?? null) : rb
404:         const rawAtt = row.attachments
405:         const att: Attachment[] = Array.isArray(rawAtt)
406:           ? (rawAtt as unknown[]).map(a => a as Attachment)
407:           : []
408:         return {
409:           id: row.id as string,
410:           event_type: row.event_type as string,
411:           event_timestamp: row.event_timestamp as string,
412:           registered_by: registeredBy as { name: string } | null,
413:           received_by_name: (row.received_by_name as string | null) ?? null,
414:           notes: (row.notes as string | null) ?? null,
415:           attachments: att,
416:         }
417:       })
418:       setEvents(mapped)
419:     }
420:   }, [id, supabase])
421: 
422:   useEffect(() => {
423:     async function init() {
424:       setPageLoading(true)
425:       const tripData = await fetchTrip(id)
426:       setTrip(tripData)
427:       await loadEvents()
428:       if (tripData) {
429:         await loadReceivers(tripData)
430:       }
431:       setPageLoading(false)
432:     }
433:     void init()
434:   // eslint-disable-next-line react-hooks/exhaustive-deps
435:   }, [id])
436: 
437:   // Seguridad: conductor (campo) solo puede ver SUS viajes asignados.
438:   // Si intentó entrar por URL directa a uno ajeno, redirigir.
439:   useEffect(() => {
440:     if (authLoading || pageLoading) return
441:     if (!trip || !person) return
442:     if (role === 'campo' && trip.driver?.id !== person.id) {
443:       router.replace('/mis-viajes')
444:     }
445:   }, [authLoading, pageLoading, trip, person, role, router])
446: 
447:   // --- Logica de secuencia de eventos ---
448:   const hasSalida = events.some((e) => e.event_type === 'Salida')
449:   const hasLlegada = events.some((e) => e.event_type === 'Llegada')
450:   const hasEntrega = events.some((e) => e.event_type === 'Entrega')
451:   const hasRetorno = events.some((e) => e.event_type === 'Retorno')
452: 
453:   const tripDone = trip?.status === 'Completado' || trip?.status === 'Cancelado'
454: 
455:   // Siguiente evento principal
456:   const nextMainEvent: TripEventType | null = tripDone
457:     ? null
458:     : !hasSalida
459:     ? 'Salida'
460:     : !hasEntrega
461:     ? 'Entrega'
462:     : !hasRetorno
463:     ? 'Retorno'
464:     : null
465: 
466:   // Llegada es opcional pero mostrar si salida hecha, llegada no hecha y entrega no hecha
467:   const showLlegadaButton = hasSalida && !hasLlegada && !hasEntrega && !tripDone
468: 
469:   // IDs de las líneas asignadas (para transitions de estado)
470:   const assignedLineIds = useMemo(
471:     () => trip?.assignments.map((a) => a.request_line_id) ?? [],
472:     [trip],
473:   )
474: 
475:   // --- Registrar evento ---
476:   const handleRegisterEvent = useCallback(
477:     async (input: TripEventInput) => {
478:       const needsLineUpdate =
479:         input.event_type === 'Salida' || input.event_type === 'Entrega'
480:       const lineIds = needsLineUpdate ? assignedLineIds : []
481: 
482:       const success = await registerEvent(input, lineIds)
483:       if (success) {
484:         // Notificaciones por tipo de evento
485:         if (input.event_type === 'Salida' && trip) {
486:           notifySalidaRegistrada(trip.id).catch(console.error)
