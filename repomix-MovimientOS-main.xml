 383: export function useTrips(initialFilter?: Partial<TripsFilter>) {
 384:   const supabase = useMemo(() => createClient(), [])
 385: 
 386:   // Estado del backlog de líneas pendientes
 387:   const [backlog, setBacklog] = useState<BacklogLine[]>([])
 388:   const [backlogLoading, setBacklogLoading] = useState(false)
 389: 
 390:   // Estado de la lista de viajes
 391:   const [trips, setTrips] = useState<TripWithRelations[]>([])
 392:   const [listLoading, setListLoading] = useState(false)
 393:   const [listError, setListError] = useState<string | null>(null)
 394:   const [tripsTotalCount, setTripsTotalCount] = useState(0)
 395: 
 396:   // Filtros para la lista de viajes
 397:   const [filters, setFiltersState] = useState<TripsFilter>({
 398:     ...DEFAULT_FILTER,
 399:     ...initialFilter,
 400:   })
 401: 
 402:   // Estado de mutaciones
 403:   const [saving, setSaving] = useState(false)
 404:   const [saveError, setSaveError] = useState<string | null>(null)
 405:   const busyRef = useRef(false)
 406: 
 407:   // --- Actualizar filtros parcialmente ---
 408:   const setFilters = useCallback((updates: Partial<TripsFilter>) => {
 409:     setFiltersState((prev) => ({ ...prev, ...updates }))
 410:   }, [])
 411: 
 412:   // --- Fetch backlog de líneas pendientes ---
 413:   const refetchBacklog = useCallback(async () => {
 414:     setBacklogLoading(true)
 415: 
 416:     try {
 417:       // Traer todas las líneas en estado Pendiente cuyas solicitudes padre
 418:       // no estén Canceladas, Completadas, ni en Borrador (no enviadas aún)
 419:       const { data, error } = await supabase
 420:         .from('sm_request_lines')
 421:         .select(`
 422:           id,
 423:           request_id,
 424:           line_number,
 425:           line_type,
 426:           equipment_id,
 427:           description,
 428:           from_location_id,
 429:           from_text,
 430:           to_location_id,
 431:           to_text,
 432:           quantity,
 433:           unit_id,
 434:           unit_text,
 435:           cost_code_id,
 436:           category,
 437:           notes,
 438:           status,
 439:           qty_scheduled,
 440:           qty_delivered,
 441:           equipment:equipment_id(id, spectrum_code, description),
 442:           from_location:from_location_id(id, name),
 443:           to_location:to_location_id(id, name),
 444:           unit:unit_id(id, code),
 445:           request:request_id!inner(
 446:             id,
 447:             request_id,
 448:             priority,
 449:             date_required,
 450:             status,
 451:             notes,
 452:             attachments,
 453:             project:project_id(id, code, name),
 454:             requester:requester_id(id, name)
 455:           )
 456:         `)
 457:         .in('status', ['Pendiente', 'Parcial', 'Programada', 'En Transito'])
 458:         // Excluir solicitudes que no deben aparecer en el backlog
 459:         .not('request.status', 'in', '("Cancelada","Completada","Borrador")')
 460: 
 461:       if (error) {
 462:         // Error silencioso en backlog — la UI mostrará lista vacía
 463:         setBacklog([])
 464:         return
 465:       }
 466: 
 467:       const rows = (data ?? []) as unknown as Record<string, unknown>[]
 468: 
 469:       const mapped: BacklogLine[] = rows.map((row) => {
 470:         const equipment = unwrapRelation(row.equipment as BacklogLine['equipment'] | BacklogLine['equipment'][])
 471:         const fromLoc = unwrapRelation(row.from_location as BacklogLine['from_location'] | BacklogLine['from_location'][])
 472:         const toLoc = unwrapRelation(row.to_location as BacklogLine['to_location'] | BacklogLine['to_location'][])
 473:         const unit = unwrapRelation(row.unit as BacklogLine['unit'] | BacklogLine['unit'][])
 474:         const rawRequest = unwrapRelation(row.request as Record<string, unknown> | Record<string, unknown>[])
 475: 
 476:         const request: BacklogLine['request'] = rawRequest
 477:           ? {
 478:               id: rawRequest.id as string,
 479:               request_id: (rawRequest.request_id as string | null) ?? null,
 480:               priority: (rawRequest.priority as string | null) ?? null,
 481:               date_required: rawRequest.date_required as string,
 482:               status: rawRequest.status as string,
 483:               notes: (rawRequest.notes as string | null) ?? null,
 484:               attachments: (rawRequest.attachments as unknown[] | null) ?? null,
 485:               project: unwrapRelation(rawRequest.project as BacklogLine['request']['project'] | null),
 486:               requester: unwrapRelation(rawRequest.requester as BacklogLine['request']['requester'] | null),
 487:             }
 488:           : { id: '', request_id: null, priority: null, date_required: '', status: '', notes: null, attachments: null, project: null, requester: null }
 489: 
 490:         return {
 491:           id: row.id as string,
 492:           request_id: row.request_id as string,
 493:           line_number: row.line_number as number,
 494:           line_type: row.line_type as string,
 495:           equipment_id: (row.equipment_id as string | null) ?? null,
 496:           description: row.description as string,
 497:           from_location_id: (row.from_location_id as string | null) ?? null,
 498:           from_text: (row.from_text as string | null) ?? null,
 499:           to_location_id: (row.to_location_id as string | null) ?? null,
 500:           to_text: (row.to_text as string | null) ?? null,
 501:           quantity: row.quantity as number,
 502:           unit_id: (row.unit_id as string | null) ?? null,
 503:           unit_text: (row.unit_text as string | null) ?? null,
 504:           cost_code_id: (row.cost_code_id as string | null) ?? null,
 505:           category: (row.category as string | null) ?? null,
 506:           notes: (row.notes as string | null) ?? null,
 507:           status: row.status as string,
 508:           qty_scheduled: (row.qty_scheduled as number) ?? 0,
 509:           qty_delivered: (row.qty_delivered as number) ?? 0,
 510:           equipment,
 511:           from_location: fromLoc,
 512:           to_location: toLoc,
 513:           unit,
 514:           request,
 515:         }
 516:       })
 517: 
 518:       // Ordenar por prioridad (Vencida primero) luego por fecha requerida ascendente.
 519:       // El ordenamiento se hace en cliente porque priority es campo calculado en la BD.
 520:       const sorted = [...mapped].sort((a, b) => {
 521:         const pa = PRIORITY_ORDER[a.request.priority ?? 'Normal'] ?? 3
 522:         const pb = PRIORITY_ORDER[b.request.priority ?? 'Normal'] ?? 3
 523:         if (pa !== pb) return pa - pb
 524:         // Desempate por fecha requerida (más próxima primero)
 525:         return a.request.date_required.localeCompare(b.request.date_required)
 526:       })
 527: 
 528:       // Solo líneas con cantidad disponible > 0
 529:       const available = sorted.filter((line) => {
 530:         const avail = line.quantity - (line.qty_scheduled ?? 0) - (line.qty_delivered ?? 0)
 531:         return avail > 0
 532:       })
 533: 
 534:       setBacklog(available)
 535:     } catch {
 536:       setBacklog([])
 537:     } finally {
 538:       setBacklogLoading(false)
 539:     }
 540:   }, [supabase])
