 730:   const renderModalForm = () => {
 731:     if (!editingItem) return null
 732:     const isNew = !editingItem.id
 733: 
 734:     switch (activeTab) {
 735:       case 'proyectos': return (
 736:         <ProjectForm data={editingItem as Partial<Project>} isNew={isNew} onSave={handleSave} onCancel={closeModal} saving={saving} />
 737:       )
 738:       case 'personas': return (
 739:         <PersonForm data={editingItem as Partial<Person>} isNew={isNew} onSave={handleSave} onCancel={closeModal} saving={saving} />
 740:       )
 741:       case 'equipos': return (
 742:         <EquipmentForm data={editingItem as Partial<Equipment>} isNew={isNew} onSave={handleSave} onCancel={closeModal} saving={saving} />
 743:       )
 744:       case 'ubicaciones': return (
 745:         <LocationForm data={editingItem as Partial<Location>} isNew={isNew} onSave={handleSave} onCancel={closeModal} saving={saving} projectOptions={allProjects} />
 746:       )
 747:       case 'tarifas': return (
 748:         <RateForm data={editingItem as Partial<Rate>} isNew={isNew} onSave={handleSave} onCancel={closeModal} saving={saving} />
 749:       )
 750:       case 'extras': return (
 751:         <ExtraForm data={editingItem as Partial<Extra>} isNew={isNew} onSave={handleSave} onCancel={closeModal} saving={saving} projectOptions={allProjects} />
 752:       )
 753:       case 'notificaciones': return null
 754:     }
 755:   }
 756: 
 757:   if (authLoading) return null
 758:   if (role !== 'admin') return null
 759: 
 760:   const tabLabel = TABS.find((t) => t.key === activeTab)?.label ?? ''
 761: 
 762:   return (
 763:     <div className="space-y-6">
 764:       <div className="flex items-center justify-between">
 765:         <h1 className="text-2xl font-bold text-navy">Administración</h1>
 766:       </div>
 767: 
 768:       {/* Tabs */}
 769:       <div className="flex gap-1 overflow-x-auto rounded-lg bg-gray-100 p-1">
 770:         {TABS.map((tab) => {
 771:           const Icon = tab.icon
 772:           const isActive = activeTab === tab.key
 773:           return (
 774:             <button
 775:               key={tab.key}
 776:               onClick={() => setActiveTab(tab.key)}
 777:               className={`flex items-center gap-1.5 whitespace-nowrap rounded-md px-3 py-2 text-sm font-medium transition-colors ${
 778:                 isActive
 779:                   ? 'bg-white text-navy shadow-sm'
 780:                   : 'text-gray-600 hover:text-gray-900'
 781:               }`}
 782:             >
 783:               <Icon className="h-4 w-4" />
 784:               <span className="hidden sm:inline">{tab.label}</span>
 785:             </button>
 786:           )
 787:         })}
 788:       </div>
 789: 
 790:       {/* Barra de busqueda + boton crear (no en notificaciones) */}
 791:       {activeTab !== 'notificaciones' && (
 792:         <div className="flex items-center gap-3">
 793:           <div className="flex-1">
 794:             <Input
 795:               placeholder={`Buscar ${tabLabel.toLowerCase()}...`}
 796:               value={search}
 797:               onChange={(e) => setSearch(e.target.value)}
 798:             />
 799:           </div>
 800:           <Button onClick={openCreate} size="sm">
 801:             <Plus className="h-4 w-4" />
 802:             <span className="hidden sm:inline">Agregar</span>
 803:           </Button>
 804:         </div>
 805:       )}
 806: 
 807:       {/* Contenido del tab */}
 808:       {renderContent()}
 809: 
 810:       {/* Modal crear/editar */}
 811:       <Modal
 812:         open={modalOpen}
 813:         onClose={closeModal}
 814:         title={editingItem?.id ? `Editar ${tabLabel.slice(0, -1)}` : `Nuevo ${tabLabel.slice(0, -1)}`}
 815:         maxWidth="lg"
 816:       >
 817:         {renderModalForm()}
 818:       </Modal>
 819:     </div>
 820:   )
 821: }
