 269:     att_permit: (row.att_permit as boolean | null) ?? null,
 270:     escort: (row.escort as boolean | null) ?? null,
 271:     confirmation_code: (row.confirmation_code as string | null) ?? null,
 272:     status: row.status as string,
 273:     notes: (row.notes as string | null) ?? null,
