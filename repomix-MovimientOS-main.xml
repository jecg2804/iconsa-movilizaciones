  7: import { useAuth } from '@/hooks/useAuth'
  8: import { useVehicles } from '@/hooks/useVehicles'
  9: import { useTrips, type TripInput, type AssignmentInput } from '@/hooks/useTrips'
 10: import { useSubmitGuard } from '@/hooks/useSubmitGuard'
 11: import { formatCurrency } from '@/lib/utils/format'
 12: import type { SelectOption } from '@/components/ui/Select'
 13: import { Button } from '@/components/ui/Button'
 14: import { TripForm } from '@/components/programacion/TripForm'
 15: import { LineSelector } from '@/components/programacion/LineSelector'
 16: 
 17: // --- Tipos internos ---
 18: 
 19: interface PersonRow {
 20:   id: string
 21:   name: string
 22: }
 23: 
 24: interface RateRow {
 25:   id: string
 26:   code: string
 27:   description: string
 28:   rate: number
 29: }
 30: 
 31: // --- Pagina ---
 32: 
 33: export default function NuevoViajePage() {
 34:   const router = useRouter()
 35:   const guard = useSubmitGuard()
 36:   const searchParams = useSearchParams()
 37:   const supabase = useMemo(() => createClient(), [])
 38: 
 39:   // Auth y permisos
 40:   const { person, role, loading: authLoading } = useAuth()
 41: 
 42:   // Vehiculos y remolques
 43:   const { vehicles, trailers, loading: vehiclesLoading } = useVehicles()
 44: 
 45:   // Backlog de lineas y mutaciones de viaje
 46:   const {
 47:     backlog,
 48:     backlogLoading,
 49:     saveTrip,
 50:     saving,
 51:     saveError,
 52:   } = useTrips()
 53: 
 54:   // Datos adicionales (fetch inline)
 55:   const [drivers, setDrivers] = useState<PersonRow[]>([])
 56:   const [rates, setRates] = useState<RateRow[]>([])
 57:   const [driversLoading, setDriversLoading] = useState(true)
 58:   const [ratesLoading, setRatesLoading] = useState(true)
 59: 
 60:   // Estado del formulario
 61:   const [tripData, setTripData] = useState<TripInput>({
 62:     scheduled_date: '',
 63:     scheduled_time: null,
 64:     driver_id: null,
 65:     vehicle_id: null,
 66:     trailer_id: null,
 67:     rate_id: null,
 68:     cost: null,
 69:     att_permit: false,
 70:     escort: false,
 71:     notes: null,
 72:     is_external: false,
 73:   })
 74: 
 75:   // Asignaciones de lineas seleccionadas
 76:   const [assignments, setAssignments] = useState<AssignmentInput[]>([])
 77: 
 78:   // Errores de validacion
 79:   const [validationErrors, setValidationErrors] = useState<string[]>([])
 80: 
 81:   // --- Fetch conductores ---
 82:   useEffect(() => {
 83:     async function fetchDrivers() {
 84:       setDriversLoading(true)
 85:       const { data } = await supabase
 86:         .from('people')
 87:         .select('id, name')
 88:         .eq('status', 'Activo')
 89:         .eq('app_role', 'campo')
 90:         .order('name')
 91:       setDrivers(data ?? [])
 92:       setDriversLoading(false)
 93:     }
 94:     fetchDrivers()
 95:   }, [supabase])
 96: 
 97:   // --- Fetch tarifas ---
 98:   useEffect(() => {
 99:     async function fetchRates() {
100:       setRatesLoading(true)
101:       const { data } = await supabase
102:         .from('mobilization_rates')
103:         .select('id, code, description, rate')
104:         .eq('is_active', true)
105:         .order('code')
106:       setRates(data ?? [])
107:       setRatesLoading(false)
108:     }
109:     fetchRates()
110:   }, [supabase])
111: 
112:   // --- Pre-poblar asignaciones desde URL params (?lines=id1,id2) ---
113:   useEffect(() => {
114:     const linesParam = searchParams.get('lines')
115:     if (!linesParam || backlog.length === 0) return
116: 
117:     const lineIds = linesParam.split(',').filter(Boolean)
118:     if (lineIds.length === 0) return
119: 
120:     const preselected: AssignmentInput[] = lineIds
121:       .map((id) => {
122:         const line = backlog.find((l) => l.id === id)
123:         if (!line) return null
124:         const availableQty = Math.max(0, line.quantity - line.qty_scheduled - (line.qty_delivered ?? 0))
125:         return {
126:           request_line_id: line.id,
127:           quantity_assigned: availableQty > 0 ? availableQty : line.quantity,
128:         }
129:       })
130:       .filter((a): a is AssignmentInput => a !== null)
131: 
132:     if (preselected.length > 0) {
133:       setAssignments(preselected)
134:     }
135:     // Solo cuando backlog se carga por primera vez
136:     // eslint-disable-next-line react-hooks/exhaustive-deps
137:   }, [backlog.length, searchParams])
138: 
139:   // --- Auto-rellenar costo cuando cambia la tarifa ---
140:   const handleRateChange = useCallback(
141:     (rateId: string | null) => {
142:       if (!rateId) return
