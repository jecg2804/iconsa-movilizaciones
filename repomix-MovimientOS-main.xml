 59:         <span className="text-sm">Cargando backlog...</span>
 60:       </div>
 61:     )
 62:   }
 63: 
 64:   // --- Estado vacio ---
 65:   if (lines.length === 0) {
 66:     return (
 67:       <div className="flex flex-col items-center justify-center py-12 text-center text-iconsa-gray">
 68:         <Package className="h-8 w-8 mb-2 text-gray-300" />
 69:         <p className="text-sm font-medium">No hay lineas pendientes</p>
 70:         <p className="text-xs mt-1">El backlog esta al dia</p>
 71:       </div>
 72:     )
 73:   }
 74: 
 75:   return (
 76:     <div className="space-y-2">
 77:       {/* Header de seleccion (solo desktop, solo si selectable) */}
