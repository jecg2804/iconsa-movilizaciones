113:   matcher: [
114:     /*
115:      * Aplica a todas las rutas excepto:
116:      * - _next/static (archivos estáticos)
117:      * - _next/image (optimización de imágenes)
118:      * - favicon.ico, sitemap.xml, robots.txt
119:      * - Archivos con extensión (imágenes, etc.)
120:      * - api/cron (cron jobs autenticados por Bearer token, no por session)
121:      */
122:     '/((?!_next/static|_next/image|favicon.ico|sitemap.xml|robots.txt|api/cron|.*\\.(?:svg|png|jpg|jpeg|gif|webp)$).*)',
123:   ],
124: }
