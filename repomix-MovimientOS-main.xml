<file path="src/components/solicitudes/SolicitudForm.tsx">
  1: 'use client'
  2: 
  3: import { useState, useEffect, useCallback, useRef } from 'react'
  4: import { Select, type SelectOption } from '@/components/ui/Select'
  5: import { Input } from '@/components/ui/Input'
  6: import { Badge } from '@/components/ui/Badge'
  7: import FileUploader from '@/components/ui/FileUploader'
  8: import FileDisplay from '@/components/ui/FileDisplay'
  9: import { formatDate, formatDateTime, formatDaysUntilDue, daysUntilDue, daysUntilDueColor, formatCompletionDelta } from '@/lib/utils/format'
 10: import type { SolicitudInput } from '@/hooks/useSolicitudes'
 11: import type { Attachment } from '@/lib/supabase/storage'
 12: 
 13: type FormMode = 'create' | 'edit' | 'readonly'
 14: 
 15: interface SolicitudFormProps {
 16:   mode: FormMode
 17:   initialData?: {
 18:     requestId?: string | null
 19:     projectId: string
 20:     requesterId: string
 21:     approvedBy: string | null
 22:     dateRequired: string
 23:     dateCreated?: string
 24:     notes: string | null
 25:     status: string
 26:     priority: string | null
 27:     dateSubmitted?: string | null
 28:     dateCompleted?: string | null
 29:     dateCancelled?: string | null
 30:   }
 31:   /** Proyectos disponibles para el dropdown (para PM, solo sus proyectos asignados) */
 32:   projects: SelectOption[]
 33:   /** Personas disponibles para el dropdown de solicitante */
 34:   people: SelectOption[]
 35:   /** Personas disponibles para el dropdown "Aprobado por". Si no se provee, usa people. */
 36:   approvers?: SelectOption[]
 37:   /** Callback cada vez que cambian los datos del header */
 38:   onChange: (data: SolicitudInput) => void
 39:   /** ID de la persona actualmente logueada (auto-rellena solicitante en modo creacion) */
 40:   currentPersonId: string
 41:   /** Rol del usuario logueado — admin puede editar solicitante */
 42:   role?: string | null
 43:   /** UUID de la solicitud (para folder de storage). En modo crear se genera uno temporal. */
 44:   solicitudId?: string
 45:   /** Adjuntos iniciales de la solicitud */
 46:   initialAttachments?: Attachment[]
 47: }
 48: 
 49: function SolicitudForm({
 50:   mode,
 51:   initialData,
 52:   projects,
 53:   people,
 54:   approvers,
 55:   onChange,
 56:   currentPersonId,
 57:   role,
 58:   solicitudId,
 59:   initialAttachments,
 60: }: SolicitudFormProps) {
 61:   const approverOptions = approvers ?? people
 62:   const isReadonly = mode === 'readonly'
 63: 
 64:   // --- Estado interno del formulario ---
 65:   const [projectId, setProjectId] = useState<string>(
 66:     initialData?.projectId ?? '',
 67:   )
 68:   const [requesterId, setRequesterId] = useState<string>(
 69:     initialData?.requesterId ?? currentPersonId,
 70:   )
 71:   const [approvedBy, setApprovedBy] = useState<string | null>(
 72:     initialData?.approvedBy ?? null,
 73:   )
 74:   const [dateRequired, setDateRequired] = useState<string>(
 75:     initialData?.dateRequired ?? '',
 76:   )
 77:   const [notes, setNotes] = useState<string>(initialData?.notes ?? '')
 78:   const [attachments, setAttachments] = useState<Attachment[]>(initialAttachments ?? [])
 79:   // UUID estable para folder de storage (en modo crear, genera uno temporal)
 80:   const folderIdRef = useRef(solicitudId ?? crypto.randomUUID())
 81: 
 82:   // --- Propagar cambios al padre ---
 83:   const propagate = useCallback(
 84:     (overrides?: Partial<SolicitudInput>) => {
 85:       const data: SolicitudInput = {
 86:         project_id: overrides?.project_id ?? projectId,
 87:         requester_id: overrides?.requester_id ?? requesterId,
 88:         approved_by: overrides?.approved_by !== undefined ? overrides.approved_by : approvedBy,
 89:         date_required: overrides?.date_required ?? dateRequired,
 90:         notes: overrides?.notes !== undefined ? overrides.notes : notes || null,
 91:         attachments: overrides?.attachments !== undefined ? overrides.attachments : attachments,
 92:       }
 93:       onChange(data)
 94:     },
 95:     [projectId, requesterId, approvedBy, dateRequired, notes, attachments, onChange],
 96:   )
 97: 
 98:   // Propagar el estado inicial al montar
 99:   useEffect(() => {
100:     propagate()
101:     // Solo en el montaje inicial
102:     // eslint-disable-next-line react-hooks/exhaustive-deps
103:   }, [])
104: 
105:   // --- Handlers de cambio ---
106:   const handleProjectChange = useCallback(
107:     (value: string | null) => {
108:       const newVal = value ?? ''
109:       setProjectId(newVal)
110:       propagate({ project_id: newVal })
111:     },
112:     [propagate],
113:   )
114: 
115:   const handleApprovedByChange = useCallback(
116:     (value: string | null) => {
117:       setApprovedBy(value)
118:       propagate({ approved_by: value })
119:     },
120:     [propagate],
121:   )
122: 
123:   const handleDateChange = useCallback(
124:     (e: React.ChangeEvent<HTMLInputElement>) => {
125:       const newVal = e.target.value
126:       setDateRequired(newVal)
127:       propagate({ date_required: newVal })
128:     },
129:     [propagate],
130:   )
131: 
132:   const handleNotesChange = useCallback(
133:     (e: React.ChangeEvent<HTMLTextAreaElement>) => {
134:       const newVal = e.target.value
135:       setNotes(newVal)
136:       propagate({ notes: newVal || null })
137:     },
138:     [propagate],
139:   )
140: 
141:   // Datos de visualizacion
142:   const requestId = initialData?.requestId
143:   const status = initialData?.status
144:   const isCancelled = status === 'Cancelada'
145:   const isCompleted = status === 'Completada'
146:   const isTerminal = isCancelled || isCompleted
147: 
148:   // Delta de completación (solo para Completada)
149:   const completionDelta = isCompleted && dateRequired && initialData?.dateCompleted
150:     ? formatCompletionDelta(dateRequired, initialData.dateCompleted)
151:     : null
152: 
153:   return (
154:     <div className="space-y-4">
155:       {/* Barra de identificacion */}
156:       <div className="flex flex-col gap-2 rounded-lg bg-gray-100 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
157:         <div>
158:           {requestId ? (
159:             <span className="text-lg font-bold font-mono text-navy">
160:               {requestId}
161:             </span>
162:           ) : (
163:             <span className="text-sm italic text-iconsa-gray">
164:               Se generara al guardar
165:             </span>
166:           )}
167:         </div>
168:         {(status || dateRequired) && (
169:           <div className="flex items-center gap-2">
170:             {status && <Badge variant="status" label={status} />}
171:             {completionDelta ? (
172:               <span className={`text-xs font-medium ${completionDelta.color}`}>
173:                 {completionDelta.text}
174:               </span>
175:             ) : !isTerminal && dateRequired ? (
176:               <span className={`text-xs font-medium ${daysUntilDueColor(daysUntilDue(dateRequired))}`}>
177:                 {formatDaysUntilDue(dateRequired)}
178:               </span>
179:             ) : null}
180:           </div>
181:         )}
182:       </div>
183: 
184:       {/* Campos del header */}
185:       <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
186:         <Select
187:           label="Proyecto"
188:           placeholder="Seleccionar proyecto..."
189:           options={projects}
190:           value={projectId || null}
191:           onChange={handleProjectChange}
192:           disabled={isReadonly}
193:           searchable
194:         />
195: 
196:         {/* Solicitante — editable solo para admin */}
197:         {role === 'admin' ? (
198:           <Select
199:             label="Solicitante"
200:             placeholder="Seleccionar solicitante..."
201:             options={people}
202:             value={requesterId}
203:             onChange={(val) => {
204:               setRequesterId(val ?? '')
205:               propagate({ requester_id: val ?? '' })
206:             }}
207:             disabled={isReadonly}
208:             searchable
209:           />
210:         ) : (
211:           <div>
212:             <label className="mb-1 block text-sm font-medium text-gray-700">
213:               Solicitante
214:             </label>
215:             <div className="rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-700">
216:               {people.find((p) => p.value === requesterId)?.label ?? '—'}
217:             </div>
218:           </div>
