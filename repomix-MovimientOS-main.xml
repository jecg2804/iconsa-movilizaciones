1041: 
1042:       try {
1043:         // 1. Obtener todas las asignaciones del viaje para liberar las líneas
1044:         const { data: assignments, error: fetchError } = await supabase
1045:           .from('trip_line_assignments')
1046:           .select('id, request_line_id, quantity_assigned')
1047:           .eq('trip_id', id)
1048: 
1049:         if (fetchError) {
1050:           setSaveError(fetchError.message)
1051:           return false
1052:         }
1053: 
1054:         // 2. Liberar cada línea asignada de vuelta al backlog.
1055:         //    El trigger cascade_request_status() actualizará automáticamente
1056:         //    el estado de las solicitudes padre cuando las líneas vuelvan a Pendiente.
1057:         for (const assignment of assignments ?? []) {
1058:           await releaseLineFromAssignment(
1059:             supabase,
1060:             assignment.request_line_id,
1061:             assignment.quantity_assigned,
1062:           )
1063:         }
1064: 
1065:         // 3. Eliminar todas las asignaciones del viaje
1066:         const { error: deleteAssignError } = await supabase
1067:           .from('trip_line_assignments')
1068:           .delete()
1069:           .eq('trip_id', id)
1070: 
1071:         if (deleteAssignError) {
1072:           setSaveError(deleteAssignError.message)
1073:           return false
1074:         }
1075: 
1076:         // 4. Marcar el viaje como Cancelado
1077:         const { error: cancelError } = await supabase
1078:           .from('trips')
1079:           .update({ status: 'Cancelado' })
1080:           .eq('id', id)
1081: 
1082:         if (cancelError) {
1083:           setSaveError(cancelError.message)
1084:           return false
1085:         }
1086: 
1087:         // Notificar cancelación de viaje a PMs afectados
1088:         notifyViajeCancelado(id).catch(console.error)
1089: 
1090:         return true
1091:       } catch (err) {
1092:         const message = err instanceof Error ? err.message : 'Error inesperado al cancelar viaje'
1093:         setSaveError(message)
1094:         return false
1095:       } finally {
1096:         busyRef.current = false
1097:         setSaving(false)
1098:       }
1099:     },
1100:     [supabase],
1101:   )
1102: 
1103:   return {
1104:     // Backlog de líneas pendientes (vista de Charris)
1105:     backlog,
1106:     backlogLoading,
1107:     refetchBacklog,
1108: 
1109:     // Lista de viajes
1110:     trips,
1111:     tripsTotalCount,
1112:     listLoading,
1113:     listError,
1114:     refetchTrips,
1115: 
1116:     // Filtros de la lista
1117:     filters,
1118:     setFilters,
1119: 
1120:     // Detalle de un viaje individual
1121:     fetchTrip,
1122: 
1123:     // Mutaciones
1124:     saveTrip,
1125:     updateTrip,
1126:     cancelTrip,
1127: 
1128:     // Estado de mutaciones
1129:     saving,
1130:     saveError,
1131:   }
1132: }
