814:           {tripEvents.length === 0 ? (
815:             <p className="text-sm text-iconsa-gray">Sin eventos registrados.</p>
816:           ) : (
817:             <div className="space-y-3">
818:               {tripEvents.map((ev, idx) => {
819:                 const icon = ev.event_type === 'Salida' ? '🚛'
820:                   : ev.event_type === 'Llegada' ? '📍'
821:                   : ev.event_type === 'Entrega' ? '✅'
822:                   : ev.event_type === 'Retorno' ? '🏠'
823:                   : '⚠️'
824:                 return (
825:                   <div key={idx} className="flex items-start gap-3 rounded-lg border border-gray-100 bg-gray-50 px-4 py-3">
826:                     <span className="text-lg shrink-0">{icon}</span>
827:                     <div className="min-w-0 flex-1 space-y-0.5">
828:                       <div className="flex items-center gap-2 flex-wrap">
829:                         <span className="text-sm font-semibold text-gray-900">{ev.event_type}</span>
830:                         <span className="text-xs text-iconsa-gray">{formatDateTime(ev.event_timestamp)}</span>
