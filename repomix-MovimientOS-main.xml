 889:   // --- Actualizar viaje existente ---
 890:   const updateTrip = useCallback(
 891:     async (
 892:       id: string,
 893:       input: TripInput,
 894:       addAssignments: AssignmentInput[],
 895:       removeAssignmentIds: string[],
