 916: export async function notifyAlertaDiariaUrgentes(): Promise<void> {
 917:   try {
 918:     // No enviar los domingos (ICONSA no opera)
 919:     const now = new Date()
 920:     if (now.getUTCDay() === 0) {
 921:       console.log('[Notify] alerta_diaria_urgentes skipped: domingo')
 922:       return
 923:     }
 924: 
 925:     console.log('[Notify] alerta_diaria_urgentes called')
 926:     const supabase = createServiceClient()
 927: 
 928:     // Calcular fecha límite: hoy + 3 días
 929:     const today = new Date()
 930:     today.setHours(0, 0, 0, 0)
 931:     const limitDate = new Date(today)
 932:     limitDate.setDate(limitDate.getDate() + 3)
 933:     const limitStr = limitDate.toISOString().split('T')[0]
 934: 
 935:     // Solicitudes activas con fecha requerida ≤ hoy + 3 días
 936:     const { data: requests, error: rErr } = await supabase
 937:       .from('sm_requests')
 938:       .select('id, request_id, project_id, requester_id, date_required')
 939:       .in('status', ['Enviada', 'En Proceso'])
 940:       .lte('date_required', limitStr)
 941:       .order('date_required')
 942: 
 943:     if (rErr) console.error('[Notify] alerta_diaria_urgentes requests error:', rErr.message)
 944:     if (!requests?.length) {
 945:       console.log('[Notify] alerta_diaria_urgentes: no urgent requests found')
 946:       return
 947:     }
 948: 
 949:     // Para cada request: contar líneas pendientes/parciales
 950:     const items: Array<{
 951:       requestId: string
 952:       projectName: string
 953:       requesterName: string
 954:       dateRequired: string
 955:       daysUntil: number
 956:       pendingLines: number
 957:     }> = []
 958: 
 959:     for (const req of requests) {
 960:       const { count } = await supabase
 961:         .from('sm_request_lines')
 962:         .select('id', { count: 'exact', head: true })
 963:         .eq('request_id', req.id)
 964:         .in('status', ['Pendiente', 'Parcial'])
 965: 
 966:       if (!count || count === 0) continue
 967: 
 968:       const { data: project } = await supabase
 969:         .from('projects')
 970:         .select('name')
 971:         .eq('id', req.project_id)
 972:         .single()
 973: 
 974:       const requesterName = await getPersonName(req.requester_id)
 975: 
 976:       const target = new Date(req.date_required + 'T12:00:00')
 977:       target.setHours(0, 0, 0, 0)
 978:       const days = Math.ceil((target.getTime() - today.getTime()) / (1000 * 60 * 60 * 24))
 979: 
 980:       items.push({
 981:         requestId: req.request_id ?? req.id,
 982:         projectName: project?.name ?? '',
 983:         requesterName,
 984:         dateRequired: req.date_required,
 985:         daysUntil: days,
 986:         pendingLines: count,
 987:       })
 988:     }
 989: 
 990:     if (items.length === 0) {
 991:       console.log('[Notify] alerta_diaria_urgentes: no requests with pending lines')
 992:       return
 993:     }
 994: 
 995:     console.log(`[Notify] alerta_diaria_urgentes: ${items.length} urgent requests with pending lines`)
 996: 
 997:     // Destinatarios: pre-filtrar por alerta_diaria_urgentes o receive_all
 998:     const { data: dailyRecipients } = await supabase
 999:       .from('people')
1000:       .select('id, email, name, notification_preferences')
1001:       .eq('notifications_enabled', true)
1002:       .eq('status', 'Activo')
1003:       .not('email', 'is', null)
1004: 
1005:     const allRecipients = (dailyRecipients ?? []).filter(p => {
1006:       const prefs = p.notification_preferences as Record<string, boolean> | null
1007:       if (!prefs || Object.keys(prefs).length === 0) return true
1008:       if (prefs.receive_all === true) return true
1009:       return prefs.alerta_diaria_urgentes === true
1010:     })
1011: 
1012:     const template = templates.alertaDiariaUrgentes({ items })
1013: 
1014:     await sendNotification({
1015:       eventType: 'alerta_diaria_urgentes',
