 455: // ═══ SCREEN: PROGRAMACIÓN (Charris's view — LINE LEVEL) ═══
 456: const ScrProgramacion = ({goTo,setSelectedViaje}) => {
 457:   const [tab,setTab]=useState("backlog");
 458:   const [filtPr,setFiltPr]=useState("Todos");
 459:   
 460:   // Flatten all pending lines across all solicitudes
 461:   const allLines = SOLICITUDES.filter(s=>s.st!=="Completada"&&s.st!=="Cancelada").flatMap(s=>
 462:     s.lineas.filter(l=>l.stLinea==="Pendiente"||l.stLinea==="Programada").map(l=>({...l,smId:s.id,smProy:s.proy,smProyNom:s.proyNom,smSol:s.sol,smFReq:s.fReq}))
 463:   ).filter(l=>filtPr==="Todos"||l.smProy===filtPr);
 464:   
 465:   const pendLines = allLines.filter(l=>l.stLinea==="Pendiente");
 466:   const progLines = allLines.filter(l=>l.stLinea==="Programada");
 467: 
 468:   return (
 469:     <div style={{display:"flex",flexDirection:"column",height:"100%"}}>
 470:       {/* Tabs */}
 471:       <div style={{display:"flex",background:"#fff",borderBottom:`1px solid ${C.bdr}`}}>
 472:         {[["backlog","📋 Backlog de Líneas"],["viajes","🚛 Viajes Programados"],["calendario","📅 Look-Ahead"]].map(([k,l])=>(
 473:           <button key={k} onClick={()=>setTab(k)} style={{flex:1,padding:"8px",fontSize:"11px",fontWeight:600,background:tab===k?C.card:`${C.bg}`,color:tab===k?C.navy:C.sub,border:"none",borderBottom:tab===k?`2px solid ${C.navy}`:"2px solid transparent",cursor:"pointer"}}>{l}</button>
 474:         ))}
 475:       </div>
 476:       <div style={{padding:"6px 10px",display:"flex",gap:"6px",alignItems:"center",background:"#fff",borderBottom:`1px solid ${C.bdr}`}}>
 477:         <select value={filtPr} onChange={e=>setFiltPr(e.target.value)} style={{padding:"5px",borderRadius:"4px",border:`1px solid ${C.bdr}`,fontSize:"10px",fontWeight:600}}>
 478:           <option value="Todos">Todos los proyectos</option>
 479:           {PROYECTOS.map(p=><option key={p.id} value={p.codigo}>{p.codigo}</option>)}
 480:         </select>
 481:         <span style={{fontSize:"10px",color:C.sub}}>{pendLines.length} pendientes · {progLines.length} programadas</span>
 482:       </div>
 483: 
 484:       <div style={{flex:1,overflow:"auto",padding:"8px"}}>
 485:         {tab==="backlog"&&(
 486:           <div>
 487:             {/* PENDIENTES — lines Charris needs to assign */}
 488:             <div style={{fontSize:"11px",fontWeight:700,color:C.err,textTransform:"uppercase",marginBottom:"6px"}}>⚠️ Sin Programar ({pendLines.length})</div>
 489:             <div style={{display:"flex",flexDirection:"column",gap:"4px",marginBottom:"14px"}}>
 490:               {pendLines.map((l,i)=>{
 491:                 const daysDiff = Math.floor(Math.random()*8)-2;
 492:                 const prioridad = daysDiff<0?"Vencida":daysDiff<=3?"Urgente":daysDiff<=7?"Próxima":"Normal";
 493:                 const pColor = {Vencida:C.err,Urgente:C.warn,Próxima:C.blue,Normal:C.ok}[prioridad];
 494:                 return (
 495:                   <Card key={i} s={{padding:"8px 10px",borderLeft:`3px solid ${pColor}`}}>
 496:                     <div style={{display:"flex",justifyContent:"space-between",alignItems:"flex-start"}}>
 497:                       <div style={{flex:1}}>
 498:                         <div style={{display:"flex",gap:"4px",alignItems:"center",flexWrap:"wrap"}}>
 499:                           <span style={{fontSize:"11px"}}>{l.tipo==="Equipo"?"🔧":"📦"}</span>
 500:                           <span style={{fontSize:"12px",fontWeight:600}}>{l.desc}</span>
 501:                           <Badge sm color={pColor}>{prioridad}</Badge>
 502:                         </div>
 503:                         <div style={{fontSize:"10px",color:C.sub,marginTop:"2px"}}>
 504:                           <span style={{fontFamily:"monospace",fontWeight:600}}>{l.smId}</span> · {l.smProyNom} · {l.cant} {l.und}
 505:                         </div>
 506:                         <div style={{fontSize:"10px",color:C.sub}}>{l.desde} → {l.hasta} · Req: {l.smFReq} · Sol: {l.smSol}</div>
 507:                       </div>
 508:                       <Btn sm color={C.purple} onClick={()=>{}}>📅 Asignar</Btn>
 509:                     </div>
 510:                   </Card>
 511:                 );
 512:               })}
 513:             </div>
 514:             {/* PROGRAMADAS */}
 515:             <div style={{fontSize:"11px",fontWeight:700,color:C.purple,textTransform:"uppercase",marginBottom:"6px"}}>📅 Programadas ({progLines.length})</div>
 516:             <div style={{display:"flex",flexDirection:"column",gap:"4px"}}>
 517:               {progLines.map((l,i)=>(
