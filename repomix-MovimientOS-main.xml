1043:                   <span>{a.projects ? `${a.projects.code} — ${a.projects.name}` : a.project_id}</span>
1044:                   <button
1045:                     onClick={() => onRemove(a.id, personId)}
1046:                     className="text-xs text-red-500 hover:text-red-700"
1047:                   >
1048:                     Quitar
1049:                   </button>
1050:                 </div>
1051:               ))}
1052:             </div>
1053:           )}
1054: 
1055:           {/* Agregar proyecto */}
