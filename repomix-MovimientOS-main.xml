 201: /**
 202:  * Mapea una fila cruda de la lista de viajes al tipo TripWithRelations.
 203:  * Las asignaciones en la lista no incluyen detalles de línea.
 204:  */
 205: function mapTripRow(row: Record<string, unknown>): TripWithRelations {
 206:   const driver = unwrapRelation(row.driver as TripWithRelations['driver'] | TripWithRelations['driver'][])
 207:   const vehicle = unwrapRelation(row.vehicle as TripWithRelations['vehicle'] | TripWithRelations['vehicle'][])
 208:   const trailer = unwrapRelation(row.trailer as TripWithRelations['trailer'] | TripWithRelations['trailer'][])
 209:   const rate = unwrapRelation(row.rate as TripWithRelations['rate'] | TripWithRelations['rate'][])
 210:   const rawAssignments = Array.isArray(row.assignments) ? row.assignments : []
 211: 
 212:   // Las asignaciones de la lista incluyen datos mínimos de línea (solo from/to para ruta)
 213:   const assignments: TripAssignment[] = (rawAssignments as Record<string, unknown>[]).map((a) => {
 214:     const rawLine = a.line as Record<string, unknown> | null
 215:     let line: TripAssignment['line'] = null
 216:     if (rawLine) {
 217:       const fromLoc = unwrapRelation(rawLine.from_location as { id: string; name: string } | null)
 218:       const toLoc = unwrapRelation(rawLine.to_location as { id: string; name: string } | null)
 219:       const rawRequest = unwrapRelation(rawLine.request as Record<string, unknown> | null) as Record<string, unknown> | null
 220:       const unitRel = unwrapRelation(rawLine.unit as { id: string; code: string } | null)
 221:       const equipRel = unwrapRelation(rawLine.equipment as { id: string; spectrum_code: string | null; description: string } | null)
 222:       line = {
 223:         id: rawLine.id as string,
 224:         line_number: (rawLine.line_number as number) ?? 0,
 225:         line_type: (rawLine.line_type as string) ?? '',
 226:         description: (rawLine.description as string) ?? '',
 227:         quantity: (rawLine.quantity as number) ?? 0,
 228:         status: (rawLine.status as string) ?? '',
 229:         notes: (rawLine.notes as string | null) ?? null,
 230:         qty_scheduled: (rawLine.qty_scheduled as number) ?? 0,
 231:         qty_delivered: (rawLine.qty_delivered as number) ?? 0,
 232:         from_location: fromLoc,
 233:         to_location: toLoc,
 234:         unit: unitRel,
 235:         from_text: (rawLine.from_text as string | null) ?? null,
 236:         to_text: (rawLine.to_text as string | null) ?? null,
 237:         unit_text: (rawLine.unit_text as string | null) ?? null,
 238:         equipment: equipRel,
 239:         request: rawRequest
 240:           ? {
 241:               id: rawRequest['id'] as string,
 242:               request_id: (rawRequest['request_id'] as string | null) ?? null,
 243:               date_required: (rawRequest['date_required'] as string | null) ?? null,
 244:               project: unwrapRelation(rawRequest['project'] as { id: string; code: string; name: string } | null),
 245:               requester: unwrapRelation(rawRequest['requester'] as { id: string; name: string } | null),
 246:             }
 247:           : { id: '', request_id: null, date_required: null, project: null, requester: null },
 248:       }
 249:     }
 250:     return {
 251:       id: a.id as string,
 252:       trip_id: a.trip_id as string,
 253:       request_line_id: a.request_line_id as string,
 254:       quantity_assigned: a.quantity_assigned as number,
 255:       qty_delivered: (a.qty_delivered as number) ?? 0,
 256:       line,
 257:     }
 258:   })
 259: 
 260:   return {
 261:     id: row.id as string,
 262:     trip_id: (row.trip_id as string | null) ?? null,
 263:     scheduled_date: row.scheduled_date as string,
 264:     driver_id: (row.driver_id as string | null) ?? null,
 265:     vehicle_id: (row.vehicle_id as string | null) ?? null,
 266:     trailer_id: (row.trailer_id as string | null) ?? null,
 267:     rate_id: (row.rate_id as string | null) ?? null,
