 12: /** Genera opciones de hora de 4:00 AM a 8:00 PM cada 5 min */
 13: function generateTimeOptions(): SelectOption[] {
 14:   const options: SelectOption[] = []
 15:   for (let h = 4; h <= 20; h++) {
 16:     for (let m = 0; m < 60; m += 5) {
 17:       if (h === 20 && m > 0) break
 18:       const value = `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`
 19:       const h12 = h === 0 ? 12 : h > 12 ? h - 12 : h
 20:       const ampm = h >= 12 ? 'PM' : 'AM'
 21:       const label = `${h12}:${String(m).padStart(2, '0')} ${ampm}`
 22:       options.push({ value, label })
 23:     }
 24:   }
 25:   return options
 26: }
 27: 
