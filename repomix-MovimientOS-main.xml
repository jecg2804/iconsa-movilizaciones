<file path="src/hooks/useTripEvents.ts">
  1: 'use client'
  2: 
  3: import { useState, useCallback, useMemo } from 'react'
  4: import { createClient } from '@/lib/supabase/client'
  5: import { useAuth } from '@/hooks/useAuth'
  6: 
  7: // --- Tipos exportados ---
  8: 
  9: export type TripEventType = 'Salida' | 'Llegada' | 'Entrega' | 'Retorno' | 'Incidencia'
 10: 
 11: export interface TripEventInput {
 12:   id?: string // UUID pre-generado para folder de storage
 13:   event_type: TripEventType
 14:   event_timestamp: string
 15:   location?: string | null
 16:   notes?: string | null
 17:   confirmation_code_used?: string | null
 18:   received_by_id?: string | null
 19:   received_by_name?: string | null
 20:   deliveredQuantities?: Record<string, number> // lineId → qty entregada en ESTE viaje
 21:   attachments?: unknown[] | null
 22: }
 23: 
 24: // --- Hook ---
 25: 
 26: export function useTripEvents(tripId: string) {
 27:   const supabase = useMemo(() => createClient(), [])
 28:   const { person } = useAuth()
 29: 
 30:   const [registering, setRegistering] = useState(false)
 31:   const [registerError, setRegisterError] = useState<string | null>(null)
 32: 
 33:   /**
 34:    * Registra un evento en el viaje y aplica transiciones de estado.
 35:    * @param input Datos del evento
 36:    * @param assignedLineIds IDs de sm_request_lines asignados al viaje (requerido para Salida y Entrega)
 37:    */
 38:   const registerEvent = useCallback(
 39:     async (input: TripEventInput, assignedLineIds: string[]): Promise<boolean> => {
 40:       setRegistering(true)
 41:       setRegisterError(null)
 42: 
 43:       try {
 44:         // 1. INSERT trip_events (INMUTABLE — sin UPDATE/DELETE)
 45:         const { error: eventError } = await supabase.from('trip_events').insert({
 46:           ...(input.id ? { id: input.id } : {}),
 47:           trip_id: tripId,
 48:           event_type: input.event_type,
 49:           event_timestamp: input.event_timestamp,
 50:           location: input.location ?? null,
 51:           registered_by: person?.id ?? null,
 52:           confirmation_code_used: input.confirmation_code_used ?? null,
 53:           received_by_id: input.received_by_id ?? null,
 54:           received_by_name: input.received_by_name ?? null,
 55:           notes: input.notes ?? null,
 56:           attachments: JSON.parse(JSON.stringify(input.attachments ?? [])),
 57:         })
 58: 
 59:         if (eventError) {
 60:           // Si el insert ya existía (respuesta perdida en intento anterior), tratar como éxito
 61:           if (eventError.code === '23505') {
 62:             console.warn('[TripEvents] Duplicate key detected — treating as idempotent success')
 63:           } else {
 64:             setRegisterError(eventError.message)
 65:             return false
 66:           }
 67:         }
 68: 
 69:         // 2. Transiciones de estado según tipo de evento
 70: 
 71:         if (input.event_type === 'Salida') {
 72:           // trips → En Ruta + actual_departure
 73:           const { error: tripError } = await supabase
 74:             .from('trips')
 75:             .update({
 76:               status: 'En Ruta',
 77:               actual_departure: input.event_timestamp,
 78:             })
 79:             .eq('id', tripId)
 80: 
 81:           if (tripError) {
 82:             setRegisterError(tripError.message)
 83:             return false
 84:           }
 85: 
 86:           // líneas → En Transito
 87:           if (assignedLineIds.length > 0) {
 88:             const { error: linesError } = await supabase
 89:               .from('sm_request_lines')
 90:               .update({ status: 'En Transito', updated_by: person?.id ?? null })
 91:               .in('id', assignedLineIds)
 92:               .eq('status', 'Programada')
 93: 
 94:             if (linesError) {
 95:               setRegisterError(linesError.message)
 96:               return false
 97:             }
 98:           }
 99:         } else if (input.event_type === 'Llegada') {
100:           // trips → actual_arrival
101:           const { error: tripError } = await supabase
102:             .from('trips')
103:             .update({ actual_arrival: input.event_timestamp })
104:             .eq('id', tripId)
105: 
106:           if (tripError) {
107:             setRegisterError(tripError.message)
108:             return false
109:           }
110:         } else if (input.event_type === 'Entrega') {
111:           // Entregas parciales: acumula qty_delivered, decrementa qty_scheduled
112:           if (assignedLineIds.length > 0) {
113:             const { data: assignments } = await supabase
114:               .from('trip_line_assignments')
115:               .select('request_line_id, quantity_assigned')
116:               .eq('trip_id', tripId)
117:               .in('request_line_id', assignedLineIds)
118: 
119:             const now = new Date().toISOString()
120: 
121:             for (const lineId of assignedLineIds) {
122:               const assignment = assignments?.find((a) => a.request_line_id === lineId)
123:               const qtyAssigned = assignment?.quantity_assigned ?? 0
124:               // qty real entregada (default = lo asignado al viaje)
125:               const qtyThisTrip = input.deliveredQuantities?.[lineId] ?? qtyAssigned
126: 
127:               // Leer estado actual de la línea
128:               const { data: currentLine } = await supabase
129:                 .from('sm_request_lines')
130:                 .select('quantity, qty_scheduled, qty_delivered')
131:                 .eq('id', lineId)
132:                 .single()
133: 
134:               if (!currentLine) continue
135: 
136:               const newQtyDelivered = (currentLine.qty_delivered ?? 0) + qtyThisTrip
137:               // Decrementar por lo realmente entregado, no por lo programado —
138:               // entregas parciales dejaban qty_scheduled inflada al restar qtyAssigned
139:               const newQtyScheduled = Math.max(0, (currentLine.qty_scheduled ?? 0) - qtyThisTrip)
140:               const newStatus = newQtyDelivered >= currentLine.quantity ? 'Entregada' : 'Parcial'
141: 
142:               const { error: lineError } = await supabase
143:                 .from('sm_request_lines')
144:                 .update({
145:                   status: newStatus,
146:                   qty_delivered: newQtyDelivered,
147:                   qty_scheduled: newQtyScheduled,
148:                   delivered_at: now,
149:                   updated_by: person?.id ?? null,
150:                 })
151:                 .eq('id', lineId)
152: 
153:               if (lineError) {
154:                 setRegisterError(lineError.message)
155:                 return false
156:               }
157: 
158:               // Auditoría: guardar qty_delivered en la asignación
159:               await supabase
160:                 .from('trip_line_assignments')
161:                 .update({ qty_delivered: qtyThisTrip })
162:                 .eq('trip_id', tripId)
163:                 .eq('request_line_id', lineId)
164:             }
165:           }
166:         } else if (input.event_type === 'Retorno') {
167:           // trips → Completado
168:           const { error: tripError } = await supabase
169:             .from('trips')
170:             .update({ status: 'Completado' })
171:             .eq('id', tripId)
172: 
173:           if (tripError) {
174:             setRegisterError(tripError.message)
175:             return false
176:           }
177:         }
178:         // 'Incidencia' — sin cambios de estado
179: 
180:         return true
181:       } catch (err) {
182:         const message = err instanceof Error ? err.message : 'Error al registrar evento'
183:         setRegisterError(message)
184:         return false
185:       } finally {
186:         setRegistering(false)
187:       }
188:     },
189:     [supabase, tripId, person],
190:   )
191: 
192:   return { registering, registerError, registerEvent }
193: }
</file>

<file path="src/lib/supabase/storage.ts">
