<file path="src/components/solicitudes/LineRow.tsx">
  1: 'use client'
  2: 
  3: import { Wrench, Package, Pencil, Trash2, Copy, ArrowRight } from 'lucide-react'
  4: import { Badge } from '@/components/ui/Badge'
  5: import { formatQty } from '@/lib/utils/format'
  6: import type { LineInput } from '@/hooks/useSolicitudes'
  7: 
  8: interface LineRowProps {
  9:   line: LineInput & { status?: string; po_reference?: string | null; material_category?: string | null; qty_delivered?: number | null; qty_scheduled?: number | null }
 10:   lineNumber: number
 11:   editable: boolean
 12:   canDelete: boolean
 13:   isScheduled: boolean
 14:   onEdit: () => void
 15:   onDelete: () => void
 16:   /** Opcional — si se provee, muestra botón Duplicar (J8b). Solo tiene sentido cuando se pueden agregar líneas (ej. Borrador). */
 17:   onDuplicate?: () => void
 18:   // Nombres resueltos por el componente padre
 19:   fromDisplay?: string
 20:   toDisplay?: string
 21:   unitDisplay?: string
 22:   costCodeDisplay?: string
 23: }
 24: 
 25: /**
 26:  * Fila de una linea de solicitud.
 27:  * Desktop: layout horizontal con todos los datos.
 28:  * Mobile: tarjeta compacta apilada.
 29:  */
 30: function LineRow({
 31:   line,
 32:   lineNumber,
 33:   editable,
 34:   canDelete,
 35:   isScheduled,
 36:   onEdit,
 37:   onDelete,
 38:   onDuplicate,
 39:   fromDisplay,
 40:   toDisplay,
 41:   unitDisplay,
 42:   costCodeDisplay,
 43: }: LineRowProps) {
 44:   const isEquipo = line.line_type === 'Equipo'
 45:   const status = line.status ?? 'Pendiente'
 46: 
 47:   // Resolver nombres para mostrar
 48:   const fromName = fromDisplay ?? line.from_text ?? '—'
 49:   const toName = toDisplay ?? line.to_text ?? '—'
 50:   const unitName = unitDisplay ?? line.unit_text ?? '—'
 51:   const costCode = costCodeDisplay ?? '—'
 52: 
 53:   return (
 54:     <>
 55:       {/* Desktop: visible a partir de md */}
 56:       <div className="hidden md:block rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm hover:bg-gray-50/50 transition-colors">
 57:         <div className="flex items-center gap-3">
 58:           {/* Numero de linea */}
 59:           <span className="w-6 shrink-0 text-center text-xs font-medium text-iconsa-gray">
 60:             {lineNumber}
 61:           </span>
 62: 
 63:           {/* Icono de tipo */}
 64:           <span className="shrink-0" title={line.line_type}>
 65:             {isEquipo ? (
 66:               <Wrench className="h-4 w-4 text-iconsa-blue" />
 67:             ) : (
 68:               <Package className="h-4 w-4 text-gold" />
 69:             )}
 70:           </span>
 71: 
 72:           {/* Descripcion */}
 73:           <span className="min-w-0 max-w-[200px] truncate font-medium text-gray-900" title={line.description}>
 74:             {line.description}
 75:           </span>
 76: 
 77:           {/* Ruta: desde → hasta */}
 78:           <span className="flex min-w-0 items-center gap-1.5 text-iconsa-gray">
 79:             <span className="max-w-[120px] truncate" title={fromName}>{fromName}</span>
 80:             <ArrowRight className="h-3.5 w-3.5 shrink-0 text-gray-400" />
 81:             <span className="max-w-[120px] truncate" title={toName}>{toName}</span>
 82:           </span>
 83: 
 84:           {/* Cantidad + unidad + progreso entrega */}
 85:           <span className="shrink-0 whitespace-nowrap text-gray-700">
