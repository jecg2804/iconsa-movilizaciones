401:   // Si el viaje esta En Ruta, solo se pueden editar notas (TripForm lo maneja internamente)
402:   const canEditFullTrip = mode === 'edit' && trip?.status === 'Programado'
403:   const canEditNotes = mode === 'edit' && trip?.status === 'En Ruta'
404:   const canRemoveAssignments = canEditFullTrip
405: 
406:   // --- Auto-rellenar costo cuando cambia la tarifa ---
407:   const handleRateChange = useCallback(
408:     (rateId: string | null) => {
409:       if (!rateId) return
410:       const rate = rates.find((r) => r.id === rateId)
411:       if (rate) {
412:         setTripData((prev) => ({ ...prev, cost: rate.rate }))
413:         setIsDirty(true)
414:       }
