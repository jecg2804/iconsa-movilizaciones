 923:           .eq('id', id)
 924: 
 925:         if (updateError) {
 926:           setSaveError(updateError.message)
 927:           return false
 928:         }
 929: 
 930:         // 2. Eliminar asignaciones removidas y liberar las líneas de vuelta al backlog
 931:         for (const assignmentId of removeAssignmentIds) {
 932:           // Obtener la asignación para saber cuánto restar de qty_scheduled
 933:           const { data: assignment, error: fetchAssignError } = await supabase
 934:             .from('trip_line_assignments')
 935:             .select('request_line_id, quantity_assigned')
 936:             .eq('id', assignmentId)
 937:             .single()
 938: 
 939:           if (fetchAssignError || !assignment) continue
 940: 
 941:           // Eliminar la asignación del viaje
 942:           await supabase
 943:             .from('trip_line_assignments')
 944:             .delete()
 945:             .eq('id', assignmentId)
 946: 
 947:           // Liberar la línea: restar qty_scheduled, volver a Pendiente si llega a 0
 948:           await releaseLineFromAssignment(
 949:             supabase,
 950:             assignment.request_line_id,
 951:             assignment.quantity_assigned,
 952:           )
 953:         }
 954: 
 955:         // 2.5. Actualizar cantidades de asignaciones existentes modificadas
 956:         if (modifiedAssignments && modifiedAssignments.length > 0) {
 957:           for (const mod of modifiedAssignments) {
 958:             const delta = mod.quantity_assigned - mod.original_quantity
 959: 
 960:             // Actualizar la asignación
 961:             await supabase
 962:               .from('trip_line_assignments')
 963:               .update({ quantity_assigned: mod.quantity_assigned })
 964:               .eq('id', mod.id)
 965: 
 966:             // Ajustar qty_scheduled de la línea
 967:             if (delta !== 0) {
 968:               const { data: currentLine } = await supabase
 969:                 .from('sm_request_lines')
 970:                 .select('qty_scheduled')
 971:                 .eq('id', mod.request_line_id)
 972:                 .single()
 973: 
 974:               const newQtyScheduled = Math.max(0, (currentLine?.qty_scheduled ?? 0) + delta)
 975: 
 976:               await supabase
 977:                 .from('sm_request_lines')
 978:                 .update({ qty_scheduled: newQtyScheduled })
 979:                 .eq('id', mod.request_line_id)
 980:             }
 981:           }
 982:         }
 983: 
 984:         // 3. Agregar nuevas asignaciones y marcar las líneas como Programadas
 985:         if (addAssignments.length > 0) {
 986:           const newRows = addAssignments.map((a) => ({
 987:             trip_id: id,
 988:             request_line_id: a.request_line_id,
 989:             quantity_assigned: a.quantity_assigned,
 990:           }))
 991: 
 992:           const { error: insertError } = await supabase
 993:             .from('trip_line_assignments')
 994:             .insert(newRows)
 995: 
 996:           if (insertError) {
 997:             setSaveError(`Error al agregar asignaciones: ${insertError.message}`)
 998:             return false
 999:           }
1000: 
1001:           // Actualizar estado y cantidad programada de las líneas recién asignadas
1002:           for (const a of addAssignments) {
1003:             const { data: currentLine } = await supabase
1004:               .from('sm_request_lines')
1005:               .select('qty_scheduled')
1006:               .eq('id', a.request_line_id)
1007:               .single()
1008: 
1009:             const newQtyScheduled = (currentLine?.qty_scheduled ?? 0) + a.quantity_assigned
1010: 
1011:             await supabase
1012:               .from('sm_request_lines')
1013:               .update({
1014:                 status: 'Programada',
1015:                 qty_scheduled: newQtyScheduled,
1016:               })
1017:               .eq('id', a.request_line_id)
1018:           }
1019:         }
1020: 
1021:         return true
1022:       } catch (err) {
1023:         const message = err instanceof Error ? err.message : 'Error inesperado al actualizar viaje'
1024:         setSaveError(message)
1025:         return false
1026:       } finally {
1027:         busyRef.current = false
1028:         setSaving(false)
1029:       }
1030:     },
1031:     [supabase],
1032:   )
