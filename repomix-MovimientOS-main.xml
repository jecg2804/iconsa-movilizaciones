 56: 
 57:   const buildSinProgramarQuery = () =>
 58:     supabase
 59:       .from('sm_request_lines')
 60:       .select('id, sm_requests!inner(status)', { count: 'exact', head: true })
 61:       .in('status', ['Pendiente', 'Parcial'])
 62:       .not('sm_requests.status', 'in', '("Borrador","Cancelada","Completada")')
 63: 
 64:   const buildCompletadasQuery = () =>
 65:     supabase
 66:       .from('sm_requests')
 67:       .select('id', { count: 'exact', head: true })
 68:       .eq('status', 'Completada')
 69:       .gte('updated_at', firstOfMonth)
 70: 
 71:   const buildRecentSolicitudesQuery = () =>
 72:     supabase
 73:       .from('sm_requests')
 74:       .select(
 75:         'id, request_id, status, priority, date_required, project:projects(code, name), requester:people!requester_id(name)',
 76:       )
