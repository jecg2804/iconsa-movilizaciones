116:                   <input
117:                     type="checkbox"
118:                     checked={isSelected}
119:                     onChange={() => onToggleSelect?.(line.id)}
120:                     aria-label={`Seleccionar linea ${line.description}`}
121:                     className="rounded border-gray-300 text-navy focus:ring-navy"
