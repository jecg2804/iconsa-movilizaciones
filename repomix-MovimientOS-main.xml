 23: 
 24: /**
 25:  * J4-B: contrato para sort controlado externamente (server-side).
 26:  */
 27: export interface ExternalSort {
 28:   column: string | null
 29:   direction: SortDirection
 30:   onSortChange: (column: string | null, direction: SortDirection) => void
 31: }
 32: 
 33: interface DataTableProps<T> {
 34:   columns: Column<T>[]
 35:   data: T[]
 36:   keyExtractor: (row: T) => string
 37:   emptyMessage?: string
 38:   onRowClick?: (row: T) => void
 39:   loading?: boolean
 40:   className?: string
 41:   mobileRender?: (row: T) => React.ReactNode
 42:   /** Función opcional para aplicar clases CSS condicionales a cada fila */
 43:   rowClassName?: (row: T) => string
 44:   /** Contenido expandible debajo de cada fila. Si se provee, click en fila togglea expansión. */
 45:   expandRender?: (row: T) => React.ReactNode
 46:   /** Controlled: keys expandidas (si se pasa, DataTable no maneja su propio state) */
 47:   expandedKeys?: Set<string>
 48:   /** Controlled: callback cuando cambian las keys expandidas */
 49:   onExpandedKeysChange?: (keys: Set<string>) => void
 50: 
 51:   /** Modo de paginación. Default: 'none'.
 52:    *  'client' = DataTable pagina internamente
 53:    *  'server' = parent controla la data por página */
 54:   pagination?: 'none' | 'client' | 'server'
 55:   /** Filas por página. Default: 20 */
 56:   pageSize?: number
 57:   /** Opciones de page size para el selector. Default: [10, 20, 50] */
 58:   pageSizeOptions?: number[]
 59:   /** Total de registros (para calcular páginas). Solo server mode. */
 60:   totalCount?: number
 61:   /** Página actual (0-indexed). Solo server mode. */
 62:   currentPage?: number
 63:   /** Callback cuando cambia la página. Solo server mode. */
 64:   onPageChange?: (page: number) => void
 65:   /** Callback cuando cambia el page size. Solo server mode. */
 66:   onPageSizeChange?: (size: number) => void
 67:   /**
 68:    * J4-B: sort controlado externamente. Si se provee, DataTable delega el
 69:    * sort al parent (server-side). Client-side sort se desactiva. Requiere
 70:    * `serverSortKey` en los columns que se quieran sortear.
 71:    */
 72:   externalSort?: ExternalSort
 73: }
 74: 
 75: function DataTable<T>({
 76:   columns,
 77:   data,
 78:   keyExtractor,
 79:   emptyMessage = 'No hay datos para mostrar',
 80:   onRowClick,
 81:   loading = false,
 82:   className = '',
 83:   mobileRender,
 84:   rowClassName,
 85:   expandRender,
 86:   expandedKeys: controlledExpandedKeys,
 87:   onExpandedKeysChange,
 88:   pagination = 'none',
 89:   pageSize = 20,
 90:   pageSizeOptions = [10, 20, 50],
 91:   totalCount,
 92:   currentPage,
 93:   onPageChange,
 94:   onPageSizeChange,
 95:   externalSort,
 96: }: DataTableProps<T>) {
 97:   const [sortKey, setSortKey] = useState<string | null>(null)
 98:   const [sortDirection, setSortDirection] = useState<SortDirection>('asc')
 99:   const [internalExpandedKeys, setInternalExpandedKeys] = useState<Set<string>>(new Set())
100: 
101:   // --- Pagination internal state (client mode) ---
102:   const [clientPage, setClientPage] = useState(0)
103:   const [internalPageSize, setInternalPageSize] = useState(pageSize)
104: 
105:   // Resetear página client cuando data cambia (filtros aplicados)
106:   useEffect(() => {
107:     setClientPage(0)
108:   }, [data.length])
109: 
110:   // Controlled vs uncontrolled expand state
111:   const isControlled = controlledExpandedKeys !== undefined
112:   const expandedKeys = isControlled ? controlledExpandedKeys : internalExpandedKeys
113:   const setExpandedKeys = isControlled ? (onExpandedKeysChange ?? setInternalExpandedKeys) : setInternalExpandedKeys
114: 
115:   const handleSort = useCallback(
116:     (columnKey: string) => {
117:       // J4-B: modo externalSort
118:       if (externalSort) {
119:         const column = columns.find((c) => c.key === columnKey)
120:         if (!column?.serverSortKey) return
121:         const target = column.serverSortKey
122:         if (externalSort.column === target) {
123:           if (externalSort.direction === 'asc') {
124:             externalSort.onSortChange(target, 'desc')
125:           } else {
126:             externalSort.onSortChange(null, 'asc')
127:           }
128:         } else {
129:           externalSort.onSortChange(target, 'asc')
130:         }
131:         return
132:       }
133: 
134:       // Modo interno client-side
135:       if (sortKey === columnKey) {
136:         if (sortDirection === 'asc') {
137:           setSortDirection('desc')
138:         } else {
139:           // Tercer click: quitar sort
140:           setSortKey(null)
141:           setSortDirection('asc')
142:         }
143:       } else {
144:         setSortKey(columnKey)
145:         setSortDirection('asc')
146:       }
147:     },
148:     [sortKey, sortDirection, externalSort, columns],
149:   )
150: 
151:   const toggleExpand = useCallback(
152:     (key: string) => {
153:       const next = new Set(expandedKeys)
154:       if (next.has(key)) next.delete(key)
155:       else next.add(key)
156:       setExpandedKeys(next)
157:     },
158:     [expandedKeys, setExpandedKeys],
159:   )
160: 
161:   const sortedData = useMemo(() => {
162:     // J4-B: en modo externalSort, data ya viene ordenada del server
163:     if (externalSort) return data
164: 
165:     if (!sortKey) return data
166: 
167:     const column = columns.find((col) => col.key === sortKey)
168:     if (!column) return data
169: 
170:     const sorted = [...data].sort((a, b) => {
171:       let aVal: string | number | Date
172:       let bVal: string | number | Date
173: 
174:       if (column.sortValue) {
175:         aVal = column.sortValue(a)
176:         bVal = column.sortValue(b)
177:       } else {
178:         // Intentar extraer texto del resultado de render
179:         const aRender = column.render(a)
180:         const bRender = column.render(b)
181:         aVal = typeof aRender === 'string' || typeof aRender === 'number' ? aRender : String(aRender ?? '')
182:         bVal = typeof bRender === 'string' || typeof bRender === 'number' ? bRender : String(bRender ?? '')
183:       }
184: 
185:       // Comparacion
186:       if (aVal instanceof Date && bVal instanceof Date) {
187:         return aVal.getTime() - bVal.getTime()
188:       }
189:       if (typeof aVal === 'number' && typeof bVal === 'number') {
190:         return aVal - bVal
191:       }
192:       return String(aVal).localeCompare(String(bVal), 'es')
193:     })
194: 
195:     return sortDirection === 'desc' ? sorted.reverse() : sorted
196:   }, [data, sortKey, sortDirection, columns, externalSort])
197: 
198:   // --- Paginación ---
199:   const paginatedData = useMemo(() => {
200:     if (pagination === 'none') return sortedData
201:     if (pagination === 'client') {
202:       const start = clientPage * internalPageSize
203:       return sortedData.slice(start, start + internalPageSize)
204:     }
205:     // server: data ya viene paginada del parent
206:     return sortedData
207:   }, [sortedData, pagination, clientPage, internalPageSize])
208: 
209:   const total = pagination === 'server' ? (totalCount ?? data.length) : data.length
210:   const activePage = pagination === 'server' ? (currentPage ?? 0) : clientPage
211:   const activePageSize = pagination === 'server' ? pageSize : internalPageSize
212:   const totalPages = Math.ceil(total / activePageSize)
213: 
214:   const handlePageChange = useCallback(
215:     (newPage: number) => {
216:       if (pagination === 'server') {
217:         onPageChange?.(newPage)
218:       } else {
219:         setClientPage(newPage)
220:       }
221:     },
222:     [pagination, onPageChange],
223:   )
224: 
225:   const handlePageSizeChange = useCallback(
226:     (newSize: number) => {
227:       if (pagination === 'server') {
228:         onPageSizeChange?.(newSize)
229:         onPageChange?.(0)
230:       } else {
231:         setInternalPageSize(newSize)
232:         setClientPage(0)
233:       }
234:     },
235:     [pagination, onPageSizeChange, onPageChange],
236:   )
237: 
238:   // Estado de carga
239:   if (loading) {
240:     return (
241:       <div className={`flex items-center justify-center py-16 ${className}`}>
242:         <Loader2 className="h-8 w-8 animate-spin text-iconsa-gray" />
243:       </div>
244:     )
245:   }
246: 
247:   // Sin datos
248:   if (data.length === 0) {
249:     return (
250:       <div className={`flex items-center justify-center py-16 ${className}`}>
251:         <p className="text-sm text-iconsa-gray">{emptyMessage}</p>
252:       </div>
253:     )
254:   }
255: 
256:   const renderSortIcon = (column: Column<T>) => {
257:     if (!column.sortable) return null
258: 
259:     // J4-B: externalSort mode
260:     if (externalSort) {
261:       if (!column.serverSortKey) return null
262:       if (externalSort.column !== column.serverSortKey) {
263:         return <ArrowUpDown className="ml-1 inline h-3.5 w-3.5 text-gray-400" />
264:       }
265:       return externalSort.direction === 'asc' ? (
266:         <ArrowUp className="ml-1 inline h-3.5 w-3.5 text-iconsa-blue" />
267:       ) : (
268:         <ArrowDown className="ml-1 inline h-3.5 w-3.5 text-iconsa-blue" />
269:       )
270:     }
271: 
272:     // Modo interno
273:     if (sortKey !== column.key) {
274:       return <ArrowUpDown className="ml-1 inline h-3.5 w-3.5 text-gray-400" />
275:     }
276: 
277:     return sortDirection === 'asc' ? (
278:       <ArrowUp className="ml-1 inline h-3.5 w-3.5 text-iconsa-blue" />
279:     ) : (
280:       <ArrowDown className="ml-1 inline h-3.5 w-3.5 text-iconsa-blue" />
281:     )
282:   }
283: 
284:   // --- Pagination UI component ---
285:   const paginationUI = pagination !== 'none' && totalPages > 1 && (
286:     <div className="flex items-center justify-between border-t border-gray-200 px-4 py-3 text-sm">
287:       <span className="text-gray-500">
288:         {activePage * activePageSize + 1}–{Math.min((activePage + 1) * activePageSize, total)} de {total}
289:       </span>
290: 
291:       <div className="flex items-center gap-2">
292:         <span className="text-gray-500 text-xs hidden sm:inline">Filas:</span>
293:         <select
294:           title="Filas por página"
295:           value={activePageSize}
296:           onChange={(e) => handlePageSizeChange(Number(e.target.value))}
297:           className="rounded border border-gray-200 px-2 py-1 text-xs"
298:         >
299:           {pageSizeOptions.map((n) => (
300:             <option key={n} value={n}>{n}</option>
301:           ))}
302:         </select>
303:       </div>
304: 
305:       <div className="flex items-center gap-1">
306:         <button
307:           type="button"
308:           title="Página anterior"
309:           onClick={() => handlePageChange(activePage - 1)}
310:           disabled={activePage === 0}
311:           className="rounded px-2 py-1 text-gray-600 hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed"
312:         >
313:           <ChevronLeft className="h-4 w-4" />
314:         </button>
315:         <span className="text-gray-700 px-2">
316:           {activePage + 1} / {totalPages}
317:         </span>
318:         <button
319:           type="button"
320:           title="Página siguiente"
321:           onClick={() => handlePageChange(activePage + 1)}
322:           disabled={activePage >= totalPages - 1}
323:           className="rounded px-2 py-1 text-gray-600 hover:bg-gray-100 disabled:opacity-30 disabled:cursor-not-allowed"
324:         >
325:           <ChevronRight className="h-4 w-4" />
326:         </button>
327:       </div>
328:     </div>
329:   )
330: 
331:   return (
332:     <div className={className}>
333:       {/* Vista desktop */}
334:       <div className="hidden md:block">
335:         <div className="overflow-hidden rounded-xl ring-1 ring-gray-200">
336:           <table className="w-full text-left text-sm">
337:             <thead>
338:               <tr className="border-b border-gray-200 bg-gray-50">
339:                 {expandRender && <th className="w-8 px-2 py-3"><span className="sr-only">Expandir</span></th>}
340:                 {columns.map((column) => {
341:                   // J4-B: en externalSort, solo clickeable si tiene serverSortKey
342:                   const effectivelySortable = column.sortable && (!externalSort || !!column.serverSortKey)
343:                   return (
344:                   <th
345:                     key={column.key}
346:                     className={`px-4 py-3 text-xs font-semibold uppercase tracking-wider text-iconsa-gray ${
347:                       effectivelySortable ? 'cursor-pointer select-none hover:text-navy' : ''
348:                     } ${column.className ?? ''}`}
349:                     onClick={effectivelySortable ? () => handleSort(column.key) : undefined}
350:                   >
351:                     <span className="inline-flex items-center">
352:                       {column.header}
353:                       {renderSortIcon(column)}
354:                     </span>
355:                   </th>
356:                   )
357:                 })}
358:               </tr>
359:             </thead>
360:             <tbody className="divide-y divide-gray-100">
361:               {paginatedData.map((row) => {
362:                 const rowKey = keyExtractor(row)
363:                 const isExpanded = expandedKeys.has(rowKey)
364:                 const handleRowClick = expandRender
365:                   ? () => toggleExpand(rowKey)
366:                   : onRowClick
367:                     ? () => onRowClick(row)
368:                     : undefined
369:                 const colCount = columns.length + (expandRender ? 1 : 0)
370: 
371:                 return (
372:                   <React.Fragment key={rowKey}>
373:                     <tr
374:                       onClick={handleRowClick}
375:                       className={`bg-white transition-colors ${
376:                         handleRowClick ? 'cursor-pointer hover:bg-gray-50' : ''
377:                       } ${rowClassName ? rowClassName(row) : ''}`}
378:                     >
379:                       {expandRender && (
380:                         <td className="w-8 px-2 py-3">
381:                           <ChevronRight
382:                             className={`h-4 w-4 text-gray-400 transition-transform ${isExpanded ? 'rotate-90' : ''}`}
383:                           />
384:                         </td>
385:                       )}
386:                       {columns.map((column) => (
387:                         <td
388:                           key={column.key}
389:                           className={`px-4 py-3 ${column.className ?? ''}`}
390:                         >
391:                           {column.render(row)}
392:                         </td>
393:                       ))}
394:                     </tr>
395:                     {isExpanded && expandRender && (
396:                       <tr>
397:                         <td colSpan={colCount} className="border-t-0 bg-gray-50 px-6 py-3">
398:                           {expandRender(row)}
399:                         </td>
400:                       </tr>
401:                     )}
402:                   </React.Fragment>
403:                 )
404:               })}
405:             </tbody>
406:           </table>
407:           {paginationUI}
408:         </div>
409:       </div>
410: 
411:       {/* Vista mobile */}
412:       <div className="flex flex-col gap-3 md:hidden">
413:         {paginatedData.map((row) => {
414:           const key = keyExtractor(row)
415:           const isExpanded = expandedKeys.has(key)
416:           const handleMobileClick = expandRender
417:             ? () => toggleExpand(key)
418:             : onRowClick
419:               ? () => onRowClick(row)
420:               : undefined
421: 
422:           if (mobileRender) {
423:             return (
424:               <div key={key}>
425:                 <div
426:                   onClick={handleMobileClick}
427:                   className={`${handleMobileClick ? 'cursor-pointer' : ''} ${rowClassName ? rowClassName(row) : ''}`}
428:                 >
429:                   {mobileRender(row)}
430:                 </div>
431:                 {isExpanded && expandRender && (
432:                   <div className="rounded-b-xl border border-t-0 border-gray-200 bg-gray-50 px-4 py-3">
433:                     {expandRender(row)}
434:                   </div>
435:                 )}
436:               </div>
437:             )
438:           }
439: 
440:           // Vista mobile por defecto: tarjeta con columnas apiladas
441:           return (
442:             <div key={key}>
443:               <div
444:                 onClick={handleMobileClick}
445:                 className={`rounded-xl border border-gray-200 bg-white p-4 ${
446:                   handleMobileClick ? 'cursor-pointer hover:bg-gray-50' : ''
447:                 } ${rowClassName ? rowClassName(row) : ''} ${isExpanded ? 'rounded-b-none' : ''}`}
448:               >
449:                 <div className="space-y-2">
450:                   {columns.map((column) => (
451:                     <div key={column.key} className="flex items-start justify-between gap-2">
452:                       <span className="shrink-0 text-xs font-medium text-iconsa-gray">
453:                         {column.header}
454:                       </span>
455:                       <span className="text-right text-sm text-gray-900">
456:                         {column.render(row)}
457:                       </span>
458:                     </div>
459:                   ))}
460:                 </div>
461:               </div>
462:               {isExpanded && expandRender && (
463:                 <div className="rounded-b-xl border border-t-0 border-gray-200 bg-gray-50 px-4 py-3">
464:                   {expandRender(row)}
465:                 </div>
466:               )}
467:             </div>
468:           )
469:         })}
470:         {/* Paginación mobile — debajo de las cards */}
471:         {paginationUI}
472:       </div>
473:     </div>
474:   )
475: }
476: 
477: export { DataTable }
</file>

<file path="src/lib/notifications/send.ts">
  1: 'use server'
  2: 
  3: import { Resend } from 'resend'
  4: import { createServiceClient } from '@/lib/supabase/service'
  5: 
  6: let _resend: Resend | null = null
  7: function getResend() {
  8:   if (!_resend) {
  9:     _resend = new Resend(process.env.RESEND_API_KEY)
 10:   }
 11:   return _resend
 12: }
 13: 
 14: // TEST MODE: cuando está seteado, TODOS los emails van a esta dirección
 15: const TEST_EMAIL = process.env.NOTIFICATION_TEST_EMAIL
 16: 
 17: // FROM address — usa onboarding@resend.dev hasta verificar dominio
 18: const FROM_EMAIL = process.env.RESEND_FROM_EMAIL ?? 'MovimientOS <onboarding@resend.dev>'
 19: 
 20: interface NotificationRecipient {
 21:   id: string
 22:   email: string | null
 23:   name: string
 24: }
 25: 
 26: interface SendResult {
 27:   sent: number
 28:   skipped: number
 29:   failed: number
 30: }
 31: 
 32: export async function sendNotification(params: {
 33:   eventType: string
 34:   referenceType: 'sm_request' | 'trip' | 'suggestion'
 35:   referenceId: string
 36:   recipients: NotificationRecipient[]
 37:   subject: string
 38:   html: string
 39:   data?: Record<string, unknown>
 40: }): Promise<SendResult> {
 41:   const supabase = createServiceClient()
 42:   let sent = 0, skipped = 0, failed = 0
 43: 
 44:   if (params.recipients.length === 0) {
 45:     console.warn(`[Notification] WARNING: 0 recipients for event "${params.eventType}" ref=${params.referenceId}. No emails will be sent.`)
 46:     return { sent, skipped, failed }
 47:   }
 48: 
 49:   console.log(`[Notification] ${params.eventType}: sending to ${params.recipients.length} recipient(s)`)
 50: 
 51:   // Filtrar recipients por notification_preferences
 52:   const recipientIds = params.recipients.map(r => r.id)
 53:   const { data: prefsData } = await supabase
 54:     .from('people')
 55:     .select('id, notification_preferences')
 56:     .in('id', recipientIds)
 57: 
 58:   const prefsMap = new Map(
 59:     (prefsData ?? []).map(p => [p.id, p.notification_preferences as Record<string, boolean> | null])
 60:   )
 61: 
 62:   const eligibleRecipients = params.recipients.filter(r => {
 63:     const prefs = prefsMap.get(r.id)
 64:     if (!prefs || Object.keys(prefs).length === 0) return true // Legacy — no prefs, send
 65:     if (prefs.receive_all === true) return true
 66:     // Si el eventType no tiene key en prefs, enviar por default
 67:     if (!(params.eventType in prefs)) return true
 68:     return prefs[params.eventType] === true
 69:   })
 70: 
 71:   console.log(`[Notification] ${params.eventType}: ${eligibleRecipients.length}/${params.recipients.length} eligible after prefs filter`)
 72: 
 73:   for (const recipient of eligibleRecipients) {
 74:     const targetEmail = TEST_EMAIL ?? recipient.email
 75: 
 76:     if (!targetEmail) {
 77:       const { error: logErr } = await supabase.from('notification_log').insert({
 78:         event_type: params.eventType,
 79:         recipient_id: recipient.id,
 80:         recipient_email: null,
 81:         reference_type: params.referenceType,
 82:         reference_id: params.referenceId,
 83:         channel: 'email',
 84:         status: 'skipped',
 85:         error_message: 'No email address',
 86:         payload: (params.data ?? {}) as { [key: string]: string | number | boolean | null | undefined },
 87:       })
 88:       if (logErr) console.error('[Notification] Failed to log skip to notification_log:', logErr.message)
 89:       skipped++
 90:       continue
 91:     }
 92: 
 93:     // DEDUP: skip si mismo evento+recipient enviado en últimos 5 minutos
 94:     const fiveMinAgo = new Date(Date.now() - 5 * 60 * 1000).toISOString()
 95:     const { data: recent } = await supabase
 96:       .from('notification_log')
 97:       .select('id')
 98:       .eq('event_type', params.eventType)
 99:       .eq('reference_id', params.referenceId)
100:       .eq('recipient_id', recipient.id)
101:       .eq('status', 'sent')
102:       .gte('created_at', fiveMinAgo)
103:       .limit(1)
104: 
105:     if (recent && recent.length > 0) {
106:       skipped++
107:       continue
108:     }
109: 
110:     try {
111:       const subject = TEST_EMAIL
112:         ? `[TEST → ${recipient.name}] ${params.subject}`
113:         : params.subject
114: 
115:       const { data: result, error } = await getResend().emails.send({
116:         from: FROM_EMAIL,
117:         to: targetEmail,
118:         subject,
119:         html: params.html,
120:       })
121: 
122:       if (error) {
123:         console.error(`[Notification] Resend error for ${recipient.name}: ${error.message} (name: ${error.name})`)
124:         throw new Error(error.message)
125:       }
126: 
127:       const { error: logErr } = await supabase.from('notification_log').insert({
128:         event_type: params.eventType,
129:         recipient_id: recipient.id,
130:         recipient_email: targetEmail,
131:         reference_type: params.referenceType,
132:         reference_id: params.referenceId,
133:         channel: 'email',
134:         status: 'sent',
135:         provider_message_id: result?.id ?? null,
136:         payload: (params.data ?? {}) as { [key: string]: string | number | boolean | null | undefined },
137:         sent_at: new Date().toISOString(),
138:       })
139:       if (logErr) console.error('[Notification] Failed to log sent to notification_log:', logErr.message)
140:       sent++
141:     } catch (err) {
142:       const errorMsg = err instanceof Error ? err.message : 'Unknown error'
143:       const { error: logErr } = await supabase.from('notification_log').insert({
144:         event_type: params.eventType,
145:         recipient_id: recipient.id,
146:         recipient_email: targetEmail,
147:         reference_type: params.referenceType,
148:         reference_id: params.referenceId,
149:         channel: 'email',
150:         status: 'failed',
151:         error_message: errorMsg,
152:         payload: (params.data ?? {}) as { [key: string]: string | number | boolean | null | undefined },
153:       })
154:       if (logErr) console.error('[Notification] Failed to log error to notification_log:', logErr.message)
155:       failed++
156:       console.error(`[Notification] failed for ${recipient.name}:`, errorMsg)
157:     }
158:   }
159: 
160:   console.log(`[Notification] ${params.eventType} result: sent=${sent} skipped=${skipped} failed=${failed}`)
161:   return { sent, skipped, failed }
162: }
