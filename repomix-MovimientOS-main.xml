  2: 
  3: const BUCKET = 'attachments'
  4: const MAX_SIZE = 10 * 1024 * 1024 // 10MB
  5: const ALLOWED_TYPES = [
  6:   'application/pdf',
  7:   'image/jpeg',
  8:   'image/png',
  9:   'image/webp',
 10:   'image/heic',
 11:   'image/heif',
 12: ]
 13: 
 14: export interface Attachment {
 15:   name: string        // "OC-24950.pdf"
 16:   path: string        // "requests/uuid/1710000000-OC-24950.pdf"
 17:   size: number        // bytes
 18:   type: string        // MIME type
 19:   uploaded_at: string // ISO timestamp
 20:   uploaded_by: string // person UUID
 21: }
 22: 
 23: export function isAllowedType(type: string): boolean {
 24:   return ALLOWED_TYPES.includes(type)
 25: }
 26: 
 27: export function isWithinSizeLimit(size: number): boolean {
 28:   return size <= MAX_SIZE
 29: }
 30: 
 31: export function formatFileSize(bytes: number): string {
 32:   if (bytes < 1024) return `${bytes} B`
 33:   if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`
 34:   return `${(bytes / (1024 * 1024)).toFixed(1)} MB`
 35: }
 36: 
 37: export function isImageType(type: string): boolean {
 38:   return type.startsWith('image/')
 39: }
 40: 
 41: const EXT_TO_MIME: Record<string, string> = {
 42:   '.pdf': 'application/pdf',
 43:   '.jpg': 'image/jpeg',
 44:   '.jpeg': 'image/jpeg',
 45:   '.png': 'image/png',
 46:   '.webp': 'image/webp',
 47:   '.heic': 'image/heic',
 48:   '.heif': 'image/heif',
 49: }
 50: 
 51: /**
 52:  * Infiere el MIME type de un archivo.
 53:  * Necesario porque Android WebView a veces retorna file.type vacío en capturas de cámara.
 54:  */
 55: export function inferMimeType(file: File): string {
 56:   if (file.type && ALLOWED_TYPES.includes(file.type)) {
 57:     return file.type
 58:   }
 59:   const ext = file.name.toLowerCase().match(/\.[^.]+$/)?.[0] ?? ''
 60:   return EXT_TO_MIME[ext] ?? file.type
 61: }
 62: 
 63: /**
 64:  * Sube un archivo a Supabase Storage.
 65:  * Retorna metadata del attachment o null si falla.
 66:  */
 67: export async function uploadFile(
 68:   file: File,
 69:   folder: string,
 70:   userId: string,
 71: ): Promise<{ attachment: Attachment | null; error: string | null }> {
 72:   const inferredType = inferMimeType(file)
 73:   if (!isAllowedType(inferredType)) {
 74:     return { attachment: null, error: `Tipo de archivo no permitido. Use PDF, JPG, PNG o WEBP` }
 75:   }
 76:   if (!isWithinSizeLimit(file.size)) {
 77:     return { attachment: null, error: `El archivo "${file.name}" excede el límite de 10MB` }
 78:   }
 79: 
 80:   const supabase = createClient()
 81:   // Timestamp para evitar colisiones de nombre
 82:   const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, '_')
 83:   const path = `${folder}/${Date.now()}-${safeName}`
 84: 
 85:   const { data: uploadData, error } = await supabase.storage
 86:     .from(BUCKET)
 87:     .upload(path, file, { upsert: false, contentType: inferredType })
 88: 
 89:   console.log('[Storage] upload response:', { path, uploadData, error })
 90: 
 91:   if (error) {
 92:     console.error('[Storage] upload error:', error)
 93:     return { attachment: null, error: 'Error al subir archivo. Intente de nuevo' }
 94:   }
 95: 
 96:   // Verificar que el archivo realmente existe en storage
 97:   const { data: check } = await supabase.storage
 98:     .from(BUCKET)
 99:     .createSignedUrl(path, 60)
100: 
101:   if (!check?.signedUrl) {
102:     console.error('[Storage] upload reported success but file not found:', path)
103:     return { attachment: null, error: 'Error al subir archivo. Verifique permisos.' }
104:   }
105: 
106:   return {
107:     attachment: {
108:       name: file.name,
109:       path,
110:       size: file.size,
111:       type: inferredType,
112:       uploaded_at: new Date().toISOString(),
113:       uploaded_by: userId,
114:     },
115:     error: null,
116:   }
117: }
118: 
119: /**
120:  * Obtiene URL firmada para ver un archivo (1 hora de expiración).
121:  */
122: export async function getFileUrl(path: string): Promise<string | null> {
123:   const supabase = createClient()
124:   const { data, error } = await supabase.storage
125:     .from(BUCKET)
126:     .createSignedUrl(path, 3600)
127: 
128:   if (error) {
129:     console.error('Signed URL error:', error)
130:     return null
131:   }
132:   return data.signedUrl
133: }
134: 
135: /**
136:  * Elimina un archivo de Supabase Storage.
137:  */
138: export async function deleteFile(path: string): Promise<boolean> {
139:   const supabase = createClient()
140:   const { error } = await supabase.storage.from(BUCKET).remove([path])
141:   if (error) {
142:     console.error('Delete error:', error)
143:     return false
144:   }
145:   return true
146: }
