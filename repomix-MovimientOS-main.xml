 1: import { notifyAlertaDiariaUrgentes } from '@/lib/notifications/actions'
 2: import { NextResponse } from 'next/server'
 3: 
 4: export async function GET(request: Request) {
 5:   const cronSecret = process.env.CRON_SECRET
 6:   if (!cronSecret) {
 7:     console.error('[Cron] CRON_SECRET not configured')
 8:     return NextResponse.json({ error: 'Server misconfigured' }, { status: 500 })
 9:   }
10: 
11:   // Check Bearer token (Vercel cron sends this automatically)
12:   const authHeader = request.headers.get('authorization') || ''
13:   const headerMatch = authHeader === `Bearer ${cronSecret}`
14: 
15:   // Fallback: check query param for manual testing
16:   const url = new URL(request.url)
17:   const querySecret = url.searchParams.get('secret') || ''
18:   const queryMatch = querySecret === cronSecret
19: 
20:   if (!headerMatch && !queryMatch) {
21:     console.error('[Cron] Auth failed. Header present:', !!authHeader, 'Query present:', !!querySecret)
22:     return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
23:   }
24: 
25:   await notifyAlertaDiariaUrgentes()
26:   return NextResponse.json({ ok: true })
27: }
