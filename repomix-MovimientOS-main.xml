 47: /** Color de fecha según urgencia: rojo = vencida, amber = esta semana, gris = normal */
 48: function getDateColor(dateStr: string | null): string {
 49:   if (!dateStr) return 'text-iconsa-gray'
 50:   const today = new Date().toISOString().split('T')[0]
 51:   const nextWeek = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString().split('T')[0]
 52:   if (dateStr < today) return 'text-red-600'
 53:   if (dateStr <= nextWeek) return 'text-amber-600'
 54:   return 'text-iconsa-gray'
 55: }
