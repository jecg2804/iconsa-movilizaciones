  1: import { createServerClient } from '@supabase/ssr'
  2: import { NextResponse, type NextRequest } from 'next/server'
  3: 
  4: export async function proxy(request: NextRequest) {
  5:   const { pathname } = request.nextUrl
  6:   const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL
  7:   const supabaseAnonKey = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY
  8: 
  9:   // Evita caídas del middleware cuando faltan variables en Vercel.
 10:   if (!supabaseUrl || !supabaseAnonKey) {
 11:     if (pathname !== '/login') {
 12:       const url = request.nextUrl.clone()
 13:       url.pathname = '/login'
 14:       url.searchParams.set('error', 'config')
 15:       return NextResponse.redirect(url)
 16:     }
 17:     return NextResponse.next({ request })
 18:   }
 19: 
 20:   let supabaseResponse = NextResponse.next({
 21:     request,
 22:   })
 23: 
 24:   try {
 25:     const supabase = createServerClient(supabaseUrl, supabaseAnonKey, {
 26:       cookies: {
 27:         getAll() {
 28:           return request.cookies.getAll()
 29:         },
 30:         setAll(cookiesToSet) {
 31:           cookiesToSet.forEach(({ name, value }) =>
 32:             request.cookies.set(name, value),
 33:           )
 34:           supabaseResponse = NextResponse.next({
 35:             request,
 36:           })
 37:           cookiesToSet.forEach(({ name, value, options }) =>
 38:             supabaseResponse.cookies.set(name, value, options),
 39:           )
 40:         },
 41:       },
 42:     })
 43: 
 44:     // Rutas públicas (no requieren auth)
 45:     const publicRoutes = ['/login', '/forgot-password', '/auth/confirm', '/api/cron']
 46:     if (publicRoutes.some((route) => pathname.startsWith(route))) {
 47:       return supabaseResponse
 48:     }
 49: 
 50:     // IMPORTANTE: No usar getSession() — getUser() valida contra el servidor de Auth
 51:     const {
 52:       data: { user },
 53:     } = await supabase.auth.getUser()
 54: 
 55:     // Sin sesión → login
 56:     if (!user) {
 57:       const url = request.nextUrl.clone()
 58:       url.pathname = '/login'
 59:       return NextResponse.redirect(url)
 60:     }
 61: 
 62:     // Con sesión pero must_change_password → forzar cambio
 63:     if (user.user_metadata?.must_change_password === true && pathname !== '/change-password') {
 64:       const url = request.nextUrl.clone()
 65:       url.pathname = '/change-password'
 66:       return NextResponse.redirect(url)
 67:     }
 68: 
 69:     // Consultar rol del usuario para enforcement de RBAC
 70:     // (Seguridad: conductores solo pueden acceder a /mis-viajes)
 71:     const { data: personData } = await supabase
 72:       .from('people')
 73:       .select('app_role')
 74:       .eq('auth_id', user.id)
 75:       .single()
 76: 
 77:     const role = personData?.app_role as string | null
 78: 
 79:     // Rol campo: solo puede acceder a /mis-viajes y /change-password
 80:     if (role === 'campo') {
 81:       const isAllowedForCampo =
 82:         pathname.startsWith('/mis-viajes') ||
 83:         pathname === '/change-password'
 84: 
 85:       if (!isAllowedForCampo) {
 86:         const url = request.nextUrl.clone()
 87:         url.pathname = '/mis-viajes'
 88:         return NextResponse.redirect(url)
 89:       }
 90:     }
 91: 
 92:     // Si hay sesión y está en /login o raíz, redirigir al home del rol
 93:     if (pathname === '/login' || pathname === '/') {
 94:       const url = request.nextUrl.clone()
 95:       url.pathname = role === 'campo' ? '/mis-viajes' : '/dashboard'
 96:       return NextResponse.redirect(url)
 97:     }
 98: 
 99:     return supabaseResponse
100:   } catch {
101:     // Evita MIDDLEWARE_INVOCATION_FAILED por errores runtime en Edge.
102:     if (pathname === '/login') {
103:       return NextResponse.next({ request })
104:     }
105:     const url = request.nextUrl.clone()
106:     url.pathname = '/login'
107:     url.searchParams.set('error', 'auth')
108:     return NextResponse.redirect(url)
109:   }
110: }
