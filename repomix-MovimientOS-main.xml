 342: // --- Función auxiliar para actualizar líneas al cancelar asignaciones ---
 343: 
 344: /**
 345:  * Libera una línea de una asignación de viaje:
 346:  * - Resta la cantidad asignada de qty_scheduled
 347:  * - Si qty_scheduled llega a 0, revierte el estado a 'Pendiente'
 348:  */
 349: async function releaseLineFromAssignment(
 350:   supabase: SupabaseClient<Database>,
 351:   requestLineId: string,
 352:   quantityAssigned: number,
 353: ): Promise<boolean> {
 354:   // Obtener el estado actual y qty_scheduled de la línea
 355:   const { data: line, error: fetchError } = await supabase
 356:     .from('sm_request_lines')
 357:     .select('id, status, qty_scheduled, qty_delivered')
 358:     .eq('id', requestLineId)
 359:     .single()
 360: 
 361:   if (fetchError || !line) return false
 362: 
 363:   const newQtyScheduled = Math.max(0, (line.qty_scheduled ?? 0) - quantityAssigned)
 364:   // Si no queda cantidad programada, determinar estado según entregas previas
 365:   let newStatus = line.status
 366:   if (newQtyScheduled <= 0) {
 367:     newStatus = (line.qty_delivered ?? 0) > 0 ? 'Parcial' : 'Pendiente'
 368:   }
 369: 
 370:   const { error: updateError } = await supabase
 371:     .from('sm_request_lines')
 372:     .update({
 373:       qty_scheduled: newQtyScheduled,
 374:       status: newStatus,
 375:     })
 376:     .eq('id', requestLineId)
 377: 
 378:   return !updateError
 379: }
