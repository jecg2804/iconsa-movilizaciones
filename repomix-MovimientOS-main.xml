  56: /** Todos los PMs de TODOS los proyectos afectados por un viaje (deduped) */
  57: async function getTripProjectPMs(tripId: string): Promise<Recipient[]> {
  58:   const supabase = createServiceClient()
  59: 
  60:   // Trip → assignments → lines → requests → project_ids
  61:   const { data: assignments, error: aErr } = await supabase
  62:     .from('trip_line_assignments')
  63:     .select('request_line_id')
  64:     .eq('trip_id', tripId)
  65: 
  66:   if (aErr) console.error('[Notify] getTripProjectPMs assignments error:', aErr.message)
  67:   if (!assignments?.length) return []
  68: 
  69:   const lineIds = assignments.map(a => a.request_line_id)
  70:   const { data: lines, error: lErr } = await supabase
  71:     .from('sm_request_lines')
  72:     .select('request_id')
  73:     .in('id', lineIds)
  74: 
  75:   if (lErr) console.error('[Notify] getTripProjectPMs lines error:', lErr.message)
  76:   if (!lines?.length) return []
  77: 
  78:   const uniqueRequestIds = [...new Set(lines.map(l => l.request_id))]
  79:   const { data: requests, error: rErr } = await supabase
  80:     .from('sm_requests')
  81:     .select('project_id')
  82:     .in('id', uniqueRequestIds)
  83: 
  84:   if (rErr) console.error('[Notify] getTripProjectPMs requests error:', rErr.message)
  85:   if (!requests?.length) return []
  86: 
  87:   const projectIds = [...new Set(requests.map(r => r.project_id))]
  88:   console.log(`[Notify] getTripProjectPMs: trip affects ${projectIds.length} project(s)`)
  89: 
  90:   // Obtener PMs de todos los proyectos, deduped
  91:   const allRecipients: Recipient[] = []
  92:   const seen = new Set<string>()
  93:   for (const projId of projectIds) {
  94:     const pms = await getProjectPMs(projId)
  95:     for (const pm of pms) {
  96:       if (!seen.has(pm.id)) {
  97:         seen.add(pm.id)
  98:         allRecipients.push(pm)
  99:       }
 100:     }
 101:   }
 102: 
 103:   console.log(`[Notify] getTripProjectPMs: ${allRecipients.length} unique PMs total`)
 104:   return allRecipients
 105: }
