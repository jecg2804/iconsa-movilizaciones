107: interface EventModalProps {
108:   eventType: TripEventType
109:   confirmationCode: string | null
110:   receiverOptions: Array<{ value: string; label: string }>
111:   assignments?: Array<{
112:     request_line_id: string
113:     quantity_assigned: number
114:     line: { description: string; quantity: number; unit?: { code: string } | null } | null
115:   }>
116:   onConfirm: (input: TripEventInput) => void
117:   onClose: () => void
118:   loading: boolean
119: }
120: 
121: function EventModal({ eventType, confirmationCode, receiverOptions, assignments, onConfirm, onClose, loading }: EventModalProps) {
122:   const [notes, setNotes] = useState('')
123:   const [location, setLocation] = useState('')
124:   const [attachments, setAttachments] = useState<Attachment[]>([])
125:   const eventIdRef = useRef(crypto.randomUUID())
126:   const deliveredQtys = useRef<Record<string, number>>({})
127: 
128:   useEffect(() => {
129:     if (assignments) {
130:       const defaults: Record<string, number> = {}
131:       for (const a of assignments) {
132:         defaults[a.request_line_id] = a.quantity_assigned
133:       }
134:       deliveredQtys.current = defaults
135:     }
136:   }, [assignments])
137: 
138:   const handleConfirmCode = useCallback(
139:     (codeUsed: string, receivedById: string | null, receivedByName: string) => {
140:       onConfirm({
141:         id: eventIdRef.current,
142:         event_type: eventType,
143:         event_timestamp: new Date().toISOString(),
144:         location: location.trim() || null,
145:         notes: notes.trim() || null,
146:         confirmation_code_used: codeUsed || null,
147:         received_by_id: receivedById ?? null,
148:         received_by_name: receivedByName || null,
149:         deliveredQuantities: { ...deliveredQtys.current },
150:         attachments,
151:       })
152:       eventIdRef.current = crypto.randomUUID()
153:     },
154:     [eventType, location, notes, attachments, onConfirm],
155:   )
156: 
157:   const handleDirectConfirm = useCallback(() => {
158:     onConfirm({
159:       id: eventIdRef.current,
160:       event_type: eventType,
161:       event_timestamp: new Date().toISOString(),
162:       location: location.trim() || null,
163:       notes: notes.trim() || null,
164:       attachments,
165:     })
166:     eventIdRef.current = crypto.randomUUID()
167:   }, [eventType, location, notes, attachments, onConfirm])
168: 
169:   return (
170:     <div className="fixed inset-0 z-50 flex items-end justify-center bg-black/50 p-4 sm:items-center">
171:       <div className="w-full max-w-md max-h-[90vh] overflow-y-auto rounded-t-2xl bg-white p-4 shadow-xl sm:rounded-2xl sm:p-6">
172:         <h3 className="mb-4 text-lg font-semibold text-gray-900">
173:           Registrar {eventType}
174:         </h3>
175: 
176:         <div className="space-y-3">
177:           {/* Ubicacion */}
178:           <Input
179:             label="Ubicación (opcional)"
180:             type="text"
181:             placeholder="Ej: Muelle 14, Taller Chilibre"
182:             value={location}
183:             onChange={(e) => setLocation(e.target.value)}
184:           />
185: 
186:           {/* Notas */}
187:           <div>
188:             <label className="mb-1 block text-sm font-medium text-gray-700">
189:               Notas (opcional)
190:             </label>
191:             <textarea
192:               value={notes}
193:               onChange={(e) => setNotes(e.target.value)}
194:               placeholder="Observaciones del evento"
195:               rows={2}
196:               className="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm placeholder:text-gray-400 focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
197:             />
198:           </div>
199: 
200:           {/* Fotos / Adjuntos */}
201:           <FileUploader
202:             attachments={attachments}
203:             folder={`events/${eventIdRef.current}`}
204:             onChange={setAttachments}
205:             label="Fotos"
206:             hint="PDF, JPG, PNG o WEBP (max 10MB)"
207:           />
208:         </div>
209: 
210:         {/* Cantidades a entregar (solo Entrega) */}
211:         {eventType === 'Entrega' && assignments && assignments.length > 0 && (
212:           <div className="mt-4 space-y-2">
213:             <p className="text-sm font-medium text-gray-700">Cantidades a entregar</p>
214:             {assignments.map((a) => {
215:               const desc = a.line?.description ?? 'Línea'
216:               const unitCode = a.line?.unit?.code ?? ''
217:               return (
218:                 <div key={a.request_line_id} className="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 p-2">
219:                   <span className="flex-1 text-sm text-gray-700 truncate">{desc}</span>
220:                   <input
221:                     type="number"
222:                     min={0}
223:                     max={Math.round(a.quantity_assigned)}
224:                     step="1"
225:                     defaultValue={Math.round(a.quantity_assigned)}
226:                     title={`Cantidad a entregar de ${desc}`}
227:                     onChange={(e) => {
228:                       deliveredQtys.current[a.request_line_id] = parseFloat(e.target.value) || 0
229:                     }}
230:                     className="w-20 rounded border border-gray-300 px-2 py-1 text-sm text-right focus:border-iconsa-blue focus:outline-none focus:ring-1 focus:ring-iconsa-blue"
231:                   />
232:                   <span className="text-xs text-iconsa-gray whitespace-nowrap">/ {formatQty(a.quantity_assigned)} {unitCode}</span>
233:                 </div>
234:               )
235:             })}
236:           </div>
237:         )}
238: 
239:         {/* Confirmacion de entrega con codigo */}
240:         {eventType === 'Entrega' ? (
241:           <div className="mt-4">
242:             <hr className="mb-4 border-gray-200" />
243:             <p className="mb-3 text-sm font-medium text-gray-900">Verificar entrega</p>
244:             <CodeConfirmation
245:               expectedCode={confirmationCode}
246:               receiverOptions={receiverOptions}
247:               onConfirm={handleConfirmCode}
248:               onCancel={onClose}
249:               loading={loading}
250:             />
251:           </div>
252:         ) : (
253:           <div className="mt-4 flex gap-2">
254:             <Button variant="primary" onClick={handleDirectConfirm} loading={loading}>
255:               Confirmar
256:             </Button>
257:             <Button variant="ghost" onClick={onClose} disabled={loading}>
258:               Cancelar
259:             </Button>
260:           </div>
261:         )}
262:       </div>
263:     </div>
264:   )
265: }
