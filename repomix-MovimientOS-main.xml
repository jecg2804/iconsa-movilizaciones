<file path="src/components/ui/FileDisplay.tsx">
  1: 'use client'
  2: 
  3: import { useState, useCallback, useEffect } from 'react'
  4: import { type Attachment, getFileUrl, formatFileSize, isImageType } from '@/lib/supabase/storage'
  5: 
  6: interface FileDisplayProps {
  7:   attachments: Attachment[]
  8:   collapsible?: boolean
  9:   label?: string
 10: }
 11: 
 12: export default function FileDisplay({
 13:   attachments,
 14:   collapsible = true,
 15:   label = 'Documentos Adjuntos',
 16: }: FileDisplayProps) {
 17:   const [expanded, setExpanded] = useState(!collapsible)
 18:   const [signedUrls, setSignedUrls] = useState<Record<string, string>>({})
 19:   const [lightboxSrc, setLightboxSrc] = useState<string | null>(null)
 20:   const [loadingUrls, setLoadingUrls] = useState(false)
 21: 
 22:   // Cargar signed URLs cuando se expande la sección
 23:   const loadUrls = useCallback(async () => {
 24:     if (loadingUrls || attachments.length === 0) return
 25:     setLoadingUrls(true)
 26: 
 27:     const urls: Record<string, string> = {}
 28:     for (const file of attachments) {
 29:       const url = await getFileUrl(file.path)
 30:       if (url) urls[file.path] = url
 31:     }
 32:     setSignedUrls(urls)
 33:     setLoadingUrls(false)
 34:   }, [attachments, loadingUrls])
 35: 
 36:   useEffect(() => {
 37:     if (expanded && Object.keys(signedUrls).length === 0 && attachments.length > 0) {
 38:       void loadUrls()
 39:     }
 40:   }, [expanded, signedUrls, attachments.length, loadUrls])
 41: 
 42:   if (attachments.length === 0) return null
 43: 
 44:   const images = attachments.filter((f) => isImageType(f.type))
 45:   const documents = attachments.filter((f) => !isImageType(f.type))
 46: 
 47:   return (
 48:     <div className="space-y-2">
 49:       {/* Header colapsable */}
 50:       <button
 51:         type="button"
 52:         onClick={() => setExpanded(!expanded)}
 53:         className="flex items-center gap-2 text-sm font-medium text-gray-700 hover:text-gray-900"
 54:       >
 55:         <span className={`transition-transform ${expanded ? 'rotate-90' : ''}`}>▶</span>
 56:         📎 {label} ({attachments.length})
 57:       </button>
 58: 
 59:       {expanded && (
 60:         <div className="space-y-3 pl-5">
 61:           {loadingUrls && (
 62:             <div className="flex items-center gap-2 text-sm text-gray-400">
 63:               <div className="h-3 w-3 animate-spin rounded-full border-2 border-gray-300 border-t-blue-500" />
 64:               Cargando archivos...
 65:             </div>
 66:           )}
 67: 
 68:           {/* Imágenes — grid de thumbnails */}
 69:           {images.length > 0 && (
 70:             <div className="flex flex-wrap gap-2">
 71:               {images.map((file) => {
 72:                 const url = signedUrls[file.path]
 73:                 return (
 74:                   <div key={file.path} className="group relative">
 75:                     {url ? (
 76:                       <button
 77:                         type="button"
 78:                         onClick={() => setLightboxSrc(url)}
 79:                         className="block overflow-hidden rounded-lg border border-gray-200 hover:border-blue-400"
 80:                       >
 81:                         {/* eslint-disable-next-line @next/next/no-img-element */}
 82:                         <img
 83:                           src={url}
 84:                           alt={file.name}
 85:                           className="h-20 w-20 object-cover"
 86:                         />
 87:                       </button>
 88:                     ) : (
 89:                       <div className="flex h-20 w-20 items-center justify-center rounded-lg border border-gray-200 bg-gray-50">
 90:                         <span className="text-2xl">🖼️</span>
 91:                       </div>
 92:                     )}
 93:                     <p className="mt-1 max-w-20 truncate text-xs text-gray-500" title={file.name}>
 94:                       {file.name}
 95:                     </p>
 96:                   </div>
 97:                 )
 98:               })}
 99:             </div>
100:           )}
101: 
102:           {/* Documentos (PDFs) */}
103:           {documents.map((file) => {
104:             const url = signedUrls[file.path]
105:             return (
106:               <div key={file.path} className="space-y-1">
107:                 <div className="flex items-center gap-2">
108:                   <span>📄</span>
109:                   <span className="text-sm font-medium text-gray-700">{file.name}</span>
110:                   <span className="text-xs text-gray-400">({formatFileSize(file.size)})</span>
111:                   {url && (
112:                     <a
113:                       href={url}
114:                       target="_blank"
115:                       rel="noopener noreferrer"
116:                       className="ml-2 text-xs text-blue-600 hover:underline"
117:                       title="Descargar"
118:                     >
119:                       ↓ Descargar
120:                     </a>
121:                   )}
122:                 </div>
123:                 {/* Render PDF inline */}
124:                 {url && file.type === 'application/pdf' && (
125:                   <iframe
126:                     src={url}
127:                     className="h-100 w-full rounded-lg border border-gray-200"
128:                     title={file.name}
129:                   />
130:                 )}
131:               </div>
132:             )
133:           })}
134:         </div>
135:       )}
136: 
137:       {/* Lightbox para imágenes */}
138:       {lightboxSrc && (
139:         <div
140:           className="fixed inset-0 z-50 flex items-center justify-center bg-black/80"
141:           onClick={() => setLightboxSrc(null)}
142:         >
143:           <button
144:             type="button"
145:             onClick={() => setLightboxSrc(null)}
146:             className="absolute right-4 top-4 text-2xl text-white hover:text-gray-300"
147:           >
148:             ✕
149:           </button>
150:           {/* eslint-disable-next-line @next/next/no-img-element */}
151:           <img
152:             src={lightboxSrc}
153:             alt="Vista completa"
154:             className="max-h-[90vh] max-w-[90vw] rounded-lg object-contain"
155:             onClick={(e) => e.stopPropagation()}
156:           />
157:         </div>
158:       )}
159:     </div>
160:   )
161: }
</file>

<file path="src/hooks/useMyTrips.ts">
  1: 'use client'
  2: 
  3: import { useState, useEffect, useCallback, useMemo } from 'react'
  4: import { createClient } from '@/lib/supabase/client'
  5: import { useAuth } from '@/hooks/useAuth'
  6: 
  7: // --- Tipos exportados ---
  8: 
  9: export interface MyTripEvent {
 10:   id: string
 11:   event_type: string
 12:   event_timestamp: string
 13:   registered_by: { name: string } | null
 14:   notes: string | null
 15: }
 16: 
 17: export interface MyTripAssignment {
 18:   id: string
 19:   quantity_assigned: number
 20:   line: {
 21:     id: string
 22:     description: string
 23:     line_type: string
 24:     status: string
 25:     from_location: { name: string } | null
 26:     to_location: { name: string } | null
 27:     from_text: string | null
 28:     to_text: string | null
 29:     request: { request_id: string | null; date_required: string } | null
 30:   } | null
 31: }
 32: 
 33: export interface MyTripSummary {
 34:   id: string
 35:   trip_id: string | null
 36:   scheduled_date: string
 37:   status: string
 38:   confirmation_code: string | null
 39:   att_permit: boolean | null
 40:   escort: boolean | null
 41:   driver: { id: string; name: string } | null
 42:   vehicle: { id: string; description: string; spectrum_code: string | null } | null
 43:   trailer: { id: string; description: string } | null
 44:   assignments: MyTripAssignment[]
 45:   events: MyTripEvent[]
 46: }
 47: 
 48: // --- Helper: extrae objeto de un campo que Supabase puede devolver como array o como objeto ---
 49: function unwrap<T>(value: T | T[] | null | undefined): T | null {
 50:   if (value === null || value === undefined) return null
 51:   if (Array.isArray(value)) return value[0] ?? null
 52:   return value
 53: }
 54: 
 55: // --- Hook ---
 56: 
 57: export function useMyTrips() {
 58:   const supabase = useMemo(() => createClient(), [])
 59:   const { person, role, loading: authLoading } = useAuth()
 60:   const [trips, setTrips] = useState<MyTripSummary[]>([])
 61:   const [loading, setLoading] = useState(true)
 62:   const [error, setError] = useState<string | null>(null)
 63: 
 64:   const fetchTrips = useCallback(async () => {
 65:     setLoading(true)
 66:     setError(null)
 67: 
 68:     try {
 69:       let query = supabase
 70:         .from('trips')
 71:         .select(`
 72:           id,
 73:           trip_id,
 74:           scheduled_date,
 75:           status,
 76:           confirmation_code,
 77:           att_permit,
 78:           escort,
 79:           driver:driver_id(id, name),
 80:           vehicle:vehicle_id(id, description, spectrum_code),
 81:           trailer:trailer_id(id, description),
 82:           assignments:trip_line_assignments(
 83:             id,
 84:             quantity_assigned,
 85:             line:request_line_id(
 86:               id,
 87:               description,
 88:               line_type,
 89:               status,
 90:               from_location:from_location_id(name),
 91:               to_location:to_location_id(name),
 92:               from_text,
 93:               to_text,
 94:               request:request_id(request_id, date_required)
 95:             )
 96:           ),
 97:           events:trip_events(
 98:             id,
 99:             event_type,
100:             event_timestamp,
101:             registered_by:registered_by(name),
102:             notes
103:           )
104:         `)
105:         .order('scheduled_date', { ascending: false })
106: 
107:       // Seguridad: conductores solo ven SUS viajes asignados
108:       if (role === 'campo' && person?.id) {
109:         query = query.eq('driver_id', person.id)
110:       }
111: 
112:       const { data, error: fetchError } = await query
113: 
114:       if (fetchError) {
115:         setError(fetchError.message)
116:         return
117:       }
118: 
119:       const mapped: MyTripSummary[] = (data ?? []).map((row) => {
120:         const r = row as unknown as Record<string, unknown>
121: 
122:         const driver = unwrap(r.driver as { id: string; name: string } | null)
123:         const vehicle = unwrap(
124:           r.vehicle as { id: string; description: string; spectrum_code: string | null } | null,
125:         )
126:         const trailer = unwrap(r.trailer as { id: string; description: string } | null)
127: 
128:         const rawAssignments = Array.isArray(r.assignments) ? r.assignments : []
129:         const assignments: MyTripAssignment[] = (rawAssignments as Record<string, unknown>[]).map((a) => {
130:           const rawLine = a.line as Record<string, unknown> | null
131:           if (!rawLine) return { id: a.id as string, quantity_assigned: a.quantity_assigned as number, line: null }
132: 
133:           const fromLoc = unwrap(rawLine.from_location as { name: string } | null)
134:           const toLoc = unwrap(rawLine.to_location as { name: string } | null)
135:           const rawReq = unwrap(rawLine.request as { request_id: string | null; date_required: string } | null)
136: 
137:           return {
138:             id: a.id as string,
139:             quantity_assigned: a.quantity_assigned as number,
140:             line: {
141:               id: rawLine.id as string,
142:               description: rawLine.description as string,
143:               line_type: rawLine.line_type as string,
144:               status: rawLine.status as string,
145:               from_location: fromLoc,
146:               to_location: toLoc,
147:               from_text: (rawLine.from_text as string | null) ?? null,
148:               to_text: (rawLine.to_text as string | null) ?? null,
149:               request: rawReq ?? null,
150:             },
151:           }
152:         })
153: 
154:         const rawEvents = Array.isArray(r.events) ? r.events : []
155:         const events: MyTripEvent[] = (rawEvents as Record<string, unknown>[]).map((e) => ({
156:           id: e.id as string,
157:           event_type: e.event_type as string,
158:           event_timestamp: e.event_timestamp as string,
159:           registered_by: unwrap(e.registered_by as { name: string } | null),
160:           notes: (e.notes as string | null) ?? null,
161:         }))
162: 
163:         // Ordenar eventos por timestamp ascendente
164:         events.sort((a, b) =>
165:           new Date(a.event_timestamp).getTime() - new Date(b.event_timestamp).getTime(),
166:         )
167: 
168:         return {
169:           id: r.id as string,
170:           trip_id: (r.trip_id as string | null) ?? null,
171:           scheduled_date: r.scheduled_date as string,
172:           status: r.status as string,
173:           confirmation_code: (r.confirmation_code as string | null) ?? null,
174:           att_permit: (r.att_permit as boolean | null) ?? null,
175:           escort: (r.escort as boolean | null) ?? null,
176:           driver,
177:           vehicle,
178:           trailer,
179:           assignments,
180:           events,
181:         }
182:       })
183: 
184:       setTrips(mapped)
185:     } catch (err) {
186:       const message = err instanceof Error ? err.message : 'Error al cargar viajes'
187:       setError(message)
188:     } finally {
189:       setLoading(false)
190:     }
191:   }, [supabase, role, person?.id])
192: 
193:   useEffect(() => {
194:     // Esperar auth load para no disparar fetch sin el filtro de role
195:     if (authLoading) return
196:     void fetchTrips()
197:   }, [fetchTrips, authLoading])
198: 
199:   return { trips, loading, error, refetch: fetchTrips }
200: }
