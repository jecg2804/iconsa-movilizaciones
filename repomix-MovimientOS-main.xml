1035:       ) : (
1036:         <>
1037:           {assignments.length === 0 ? (
1038:             <p className="text-sm text-gray-500 mb-3">Sin proyectos asignados</p>
1039:           ) : (
1040:             <div className="space-y-2 mb-3">
