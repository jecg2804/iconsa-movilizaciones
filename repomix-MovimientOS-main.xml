163:   created_at timestamptz DEFAULT now(), updated_at timestamptz DEFAULT now()
164: );
165: 
166: CREATE TABLE mobilization_rates (
167:   id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
168:   code text UNIQUE NOT NULL, description text NOT NULL, rate numeric NOT NULL,
169:   is_active boolean DEFAULT true,
170:   created_at timestamptz DEFAULT now(), updated_at timestamptz DEFAULT now()
171: );
172: 
173: CREATE TABLE units (
174:   id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
175:   code text UNIQUE NOT NULL, description text,
176:   created_at timestamptz DEFAULT now(), updated_at timestamptz DEFAULT now()
177: );
178: 
179: CREATE TABLE cost_codes (
180:   id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
181:   project_id uuid REFERENCES projects(id),
182:   phase_code text NOT NULL, phase_description text,
183:   full_code text, -- auto: trigger generate_full_code() → {proyecto}-{fase} all dashes
184:   created_at timestamptz DEFAULT now(), updated_at timestamptz DEFAULT now()
185: );
186: 
187: CREATE TABLE cost_categories (
188:   id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
