 808: 
 809:         if (tripError || !insertedTrip) {
 810:           setSaveError(tripError?.message ?? 'Error al crear el viaje')
 811:           return null
 812:         }
 813: 
 814:         const newTripId = insertedTrip.id
 815: 
 816:         // 2. Insertar asignaciones de líneas al viaje
 817:         if (assignments.length > 0) {
 818:           const assignmentRows = assignments.map((a) => ({
 819:             trip_id: newTripId,
 820:             request_line_id: a.request_line_id,
 821:             quantity_assigned: a.quantity_assigned,
 822:           }))
 823: 
 824:           const { error: assignError } = await supabase
 825:             .from('trip_line_assignments')
 826:             .insert(assignmentRows)
 827: 
 828:           if (assignError) {
 829:             setSaveError(`Viaje creado pero error al asignar líneas: ${assignError.message}`)
 830:             return null
 831:           }
 832: 
 833:           // 3. Actualizar el estado de cada línea asignada a 'Programada'
 834:           //    y sumar la cantidad programada acumulada
 835:           for (const a of assignments) {
 836:             const { data: currentLine } = await supabase
 837:               .from('sm_request_lines')
 838:               .select('qty_scheduled')
 839:               .eq('id', a.request_line_id)
 840:               .single()
 841: 
 842:             const newQtyScheduled = (currentLine?.qty_scheduled ?? 0) + a.quantity_assigned
 843: 
 844:             await supabase
 845:               .from('sm_request_lines')
 846:               .update({
 847:                 status: 'Programada',
 848:                 qty_scheduled: newQtyScheduled,
 849:               })
 850:               .eq('id', a.request_line_id)
 851:           }
 852:         }
 853: 
 854:         // 4. Re-fetch para obtener el trip_id auto-generado por el trigger
 855:         const { data: refreshed } = await supabase
 856:           .from('trips')
 857:           .select('trip_id')
 858:           .eq('id', newTripId)
 859:           .single()
 860: 
 861:         // 5. Notificaciones: líneas programadas a PMs + viaje asignado a conductor
 862:         const { data: lineRequests } = await supabase
 863:           .from('sm_request_lines')
 864:           .select('request_id')
 865:           .in('id', assignments.map(a => a.request_line_id))
 866: 
 867:         const uniqueRequestIds = [...new Set((lineRequests ?? []).map(l => l.request_id))]
 868:         for (const reqId of uniqueRequestIds) {
 869:           notifyLineasProgramadas(newTripId, reqId).catch(console.error)
 870:         }
 871:         notifyViajeAsignadoConductor(newTripId).catch(console.error)
